337:     def _extract_title(self, content: str) -> str:
338:         for line in content.splitlines():
339:             stripped = line.strip()
340:             if stripped.startswith("#"):
341:                 return stripped.lstrip("#").strip()
342:         return ""
343:     def _extract_summary(self, content: str) -> str:
344:         lines = [line.strip() for line in content.splitlines()]
345:         in_fence = False
346:         for index, line in enumerate(lines):
347:             if line.startswith("```"):
348:                 in_fence = not in_fence
349:                 continue
350:             if in_fence:
351:                 continue
352:             if not line or line.startswith("#"):
353:                 continue
354:             if line.startswith("<!--"):
355:                 continue
356:             if line.startswith("-") or line.startswith("1."):
357:                 continue
358:             if line.startswith("|") or line.endswith(":"):
359:                 continue
360:             next_line = lines[index + 1] if index + 1 < len(lines) else ""
361:             if next_line.startswith("```") or next_line.startswith("|") or next_line.startswith("<!--"):
362:                 next_line = ""
363:             if next_line and not next_line.startswith("#"):
364:                 return f"{line} {next_line}".strip()
365:             return line
366:         return ""
367:     def _normalize_summary(self, summary: str, fallback: str) -> str:
368:         normalized = summary.strip()
369:         if len(normalized) < 24:
370:             return fallback
371:         return normalized
372:     def _slug_for(self, kind: str, path: Path) -> str:
373:         relative = self._relative(path)
374:         stem = path.name
375:         if path.name.lower() == "skill.md" and path.parent.name:
376:             stem = path.parent.name
377:         elif path.stem.lower() == "readme" and path.parent != self.repo_root:
378:             stem = f"{path.parent.name}-{path.name}"
379:         tokens = [kind, stem]
380:         if kind == "report" and "analysis_mcpee" in relative:
381:             tokens.insert(1, "autodocs")
382:         return self._slugify("-".join(tokens))
383:     def _slugify(self, value: str) -> str:
384:         normalized = []
385:         for char in value.lower():
386:             if char.isalnum():
387:                 normalized.append(char)
388:             else:
389:                 normalized.append("-")
390:         slug = "".join(normalized)
391:         while "--" in slug:
392:             slug = slug.replace("--", "-")
393:         return slug.strip("-") or "untitled"
394:     def _relative(self, path: Path) -> str:
395:         return path.relative_to(self.repo_root).as_posix()
396:     def _is_tracked(self, path: Path) -> bool:
397:         rel = self._relative(path)
398:         if not rel:
399:             return False
400:         try:
401:             result = subprocess.run(
402:                 ["git", "ls-files", "--error-unmatch", rel],
403:                 cwd=self.repo_root,
404:                 stdout=subprocess.DEVNULL,
405:                 stderr=subprocess.DEVNULL,
406:                 check=False,
407:             )
408:             return result.returncode == 0
409:         except OSError:
410:             return False
411:     def _owner_for(self, path: Path) -> str:
412:         relative = self._relative(path)
413:         parts = [segment for segment in relative.split("/") if segment]
414:         if len(parts) <= 1:
415:             return "repo"
416:         return parts[-2]
