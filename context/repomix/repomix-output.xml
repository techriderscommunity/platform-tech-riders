 47: def _load_dotenv_file(path: Path) -> dict[str, str]:
 48:     if not path.exists():
 49:         return {}
 50:     values: dict[str, str] = {}
 51:     for raw_line in path.read_text(encoding="utf-8").splitlines():
 52:         line = raw_line.strip()
 53:         if not line or line.startswith("#") or "=" not in line:
 54:             continue
 55:         key, value = line.split("=", 1)
 56:         env_key = key.strip()
 57:         if not env_key:
 58:             continue
 59:         env_value = value.strip()
 60:         if len(env_value) >= 2 and env_value[0] == env_value[-1] and env_value[0] in {'"', "'"}:
 61:             env_value = env_value[1:-1]
 62:         values[env_key] = env_value
 63:     return values
 64: def load_config(repo_root: Path) -> TelemetryConfig:
 65:     raw = _load_json_file(repo_root / "telemetry" / "config.json")
 66:     dotenv = _load_dotenv_file(repo_root / ".env")
 67:     telemetry_raw = raw.get("telemetry", {}) if isinstance(raw.get("telemetry"), dict) else {}
 68:     langsmith_raw = raw.get("langsmith", {}) if isinstance(raw.get("langsmith"), dict) else {}
 69:     def _get_env(name: str, default: str | None = None) -> str | None:
 70:         if name in os.environ:
 71:             value = os.environ.get(name)
 72:             return None if value is None else str(value)
 73:         return dotenv.get(name, default)
 74:     exporters = telemetry_raw.get("exporters", ["console", "json"])
 75:     if not isinstance(exporters, list):
 76:         exporters = ["console", "json"]
 77:     env_exporters = (_get_env("TELEMETRY_EXPORTERS", "") or "").strip()
 78:     if env_exporters:
 79:         exporters = [item.strip().lower() for item in env_exporters.split(",") if item.strip()]
 80:     cfg = TelemetryConfig(
 81:         enabled=_parse_bool(_get_env("TELEMETRY_ENABLED"), _parse_bool(telemetry_raw.get("enabled"), True)),
 82:         exporters=[str(item).lower() for item in exporters],
 83:         batch_size=max(1, int((_get_env("TELEMETRY_BATCH_SIZE", str(telemetry_raw.get("batch_size", 25))) or str(telemetry_raw.get("batch_size", 25))))),
 84:         telemetry_dir=str((_get_env("TELEMETRY_DIR", str(telemetry_raw.get("telemetry_dir", ".telemetry"))) or str(telemetry_raw.get("telemetry_dir", ".telemetry")))),
 85:         langsmith=LangSmithConfig(
 86:             enabled=_parse_bool(
 87:                 _get_env("LANGSMITH_ENABLED", _get_env("LANGSMITH_TRACING")),
 88:                 _parse_bool(langsmith_raw.get("enabled"), False),
 89:             ),
 90:             api_key=str((_get_env("LANGSMITH_API_KEY", str(langsmith_raw.get("api_key", ""))) or str(langsmith_raw.get("api_key", "")))),
 91:             project=str((_get_env("LANGSMITH_PROJECT", str(langsmith_raw.get("project", ""))) or str(langsmith_raw.get("project", "")))),
 92:             endpoint=str((_get_env("LANGSMITH_ENDPOINT", str(langsmith_raw.get("endpoint", ""))) or str(langsmith_raw.get("endpoint", "")))),
 93:             workspace_id=str((_get_env("LANGSMITH_WORKSPACE_ID", str(langsmith_raw.get("workspace_id", ""))) or str(langsmith_raw.get("workspace_id", "")))),
 94:             high_signal_only=_parse_bool(
 95:                 _get_env("LANGSMITH_HIGH_SIGNAL_ONLY"),
 96:                 _parse_bool(langsmith_raw.get("high_signal_only"), True),
 97:             ),
 98:             min_span_duration_ms=_parse_float(
 99:                 _get_env("LANGSMITH_MIN_SPAN_DURATION_MS"),
100:                 _parse_float(langsmith_raw.get("min_span_duration_ms"), 100.0),
101:             ),
102:             emit_execution_summary=_parse_bool(
103:                 _get_env("LANGSMITH_EMIT_EXECUTION_SUMMARY"),
104:                 _parse_bool(langsmith_raw.get("emit_execution_summary"), True),
105:             ),
106:         ),
107:     )
