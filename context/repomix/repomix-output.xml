<file path="techito/src/app/features/intranet/colaboradores/services/colaboradores.service.ts">
 1: import { HttpClient } from '@angular/common/http';
 2: import { Injectable, inject } from '@angular/core';
 3: import { environment } from '@env/environment';
 4: import { map } from 'rxjs/operators';
 5: import { ColaboradorItem, CreateColaboradorPayload, StaffUserResponse } from '../models/colaboradores.models';
 6: @Injectable({ providedIn: 'root' })
 7: export class ColaboradoresService {
 8:   private readonly http = inject(HttpClient);
 9:   private readonly baseUrl = environment.apiUrl;
10:   getColaboradores() {
11:     return this.http.get<StaffUserResponse[]>(`${this.baseUrl}/admin/staff/colaboradores`).pipe(
12:       map((items) => (items ?? []).map((item): ColaboradorItem => ({
13:         id: item.id,
14:         nombre: item.name,
15:         especialidad: item.roles.filter(role => role !== 'colaborador').join(', ') || 'Colaborador',
16:         proyectos: 0,
17:         pagos_pendientes: 0,
18:         estado: item.active ? 'activo' : 'inactivo',
19:         fecha_inicio: '',
20:         email: item.email,
21:         roles: item.roles,
22:       }))),
23:     );
24:   }
25:   createColaborador(payload: CreateColaboradorPayload) {
26:     return this.http.post(`${this.baseUrl}/admin/staff/colaboradores`, payload);
27:   }
28:   updateEstado(id: string, activo: boolean) {
29:     return this.http.put(`${this.baseUrl}/admin/staff/usuarios/${id}/estado`, { activo });
30:   }
31: }
</file>

