<file path="techito/tools/audit-shared-ui.mjs">
 1: import { readdirSync, readFileSync, statSync } from 'node:fs';
 2: import { join } from 'node:path';
 3: const root = process.cwd();
 4: const featuresDir = join(root, 'src', 'app', 'features');
 5: const nativeControlRegex = /<(input|textarea|select)\b|<button\b(?=[^>]*\bclass\s*=\s*["'][^"']*\bbtn-(primary|secondary|outline|text|small|sm|back|nav)\b)/gi;
 6: const allowList = new Set();
 7: function walk(dir) {
 8:   const files = [];
 9:   for (const entry of readdirSync(dir)) {
10:     const fullPath = join(dir, entry);
11:     const stats = statSync(fullPath);
12:     if (stats.isDirectory()) {
13:       files.push(...walk(fullPath));
14:       continue;
15:     }
16:     if (fullPath.endsWith('.html')) {
17:       files.push(fullPath);
18:     }
19:   }
20:   return files;
21: }
22: const htmlFiles = walk(featuresDir);
23: const violations = [];
24: for (const filePath of htmlFiles) {
25:   const relative = filePath.replace(/\\/g, '/').split('/techito/')[1];
26:   const source = readFileSync(filePath, 'utf-8');
27:   const hasNativeControls = nativeControlRegex.test(source);
28:   nativeControlRegex.lastIndex = 0;
29:   if (hasNativeControls && !allowList.has(relative)) {
30:     violations.push(relative);
31:   }
32: }
33: if (!violations.length) {
34:   console.log('Shared UI audit OK: no unmanaged native controls outside allowlist.');
35:   process.exit(0);
36: }
37: console.log('Shared UI audit: files pending migration (native controls found)');
38: for (const file of violations) {
39:   console.log(`- ${file}`);
40: }
41: if (process.argv.includes('--strict')) {
42:   process.exit(1);
43: }
</file>

