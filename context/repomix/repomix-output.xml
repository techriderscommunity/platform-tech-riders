 96:     expect(reloaded.user()).toBeNull();
 97:     expect(reloaded.userType()).toBeNull();
 98:     expect(localStorage.getItem('token')).toBeNull();
 99:     expect(localStorage.getItem('user')).toBeNull();
100:   });
