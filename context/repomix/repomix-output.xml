<file path="scripts/ops/emit-terminal-command-telemetry.py">
 1: from __future__ import annotations
 2: import argparse
 3: import hashlib
 4: import sys
 5: from pathlib import Path
 6: def _bootstrap_repo_root() -> Path:
 7:     repo_root = Path(__file__).resolve().parents[2]
 8:     if str(repo_root) not in sys.path:
 9:         sys.path.insert(0, str(repo_root))
10:     return repo_root
11: def _hash_command(command: str) -> str:
12:     return hashlib.sha256(command.encode("utf-8")).hexdigest()[:16]
13: def main() -> int:
14:     parser = argparse.ArgumentParser(description="Emit telemetry for an already executed terminal command.")
15:     parser.add_argument("--session-id", default="terminal-session", help="Session identifier")
16:     parser.add_argument("--cwd", default=".", help="Current working directory")
17:     parser.add_argument("--command", default="", help="Executed command text")
18:     parser.add_argument("--success", default="true", help="Whether command succeeded (true/false)")
19:     parser.add_argument("--exit-code", type=int, default=0, help="Exit code for native commands")
20:     args = parser.parse_args()
21:     command_text = (args.command or "").strip()
22:     if not command_text:
23:         return 0
24:     repo_root = _bootstrap_repo_root()
25:     from telemetry import build_telemetry_collector
26:     collector = build_telemetry_collector(repo_root)
27:     success = str(args.success).strip().lower() in {"1", "true", "yes", "ok"}
28:     normalized_cwd = str(Path(args.cwd).resolve())
29:     with collector.start_execution(
30:         operation="terminal.command",
31:         session_id=str(args.session_id).strip() or "terminal-session",
32:         model="powershell",
33:         provider="local-shell",
34:     ):
35:         with collector.start_span(
36:             name="terminal.executed_command",
37:             kind="TOOL",
38:             attributes={
39:                 "cwd": normalized_cwd,
40:                 "command_hash": _hash_command(command_text),
41:                 "success": success,
42:                 "exit_code": int(args.exit_code),
43:             },
44:         ):
45:             collector.record_event(
46:                 "RoutingResolved",
47:                 {
48:                     "source": "terminal-hook",
49:                     "cwd": normalized_cwd,
50:                     "success": success,
51:                     "exit_code": int(args.exit_code),
52:                 },
53:                 level="INFO",
54:             )
55:             collector.record_metric("terminal_command_count", 1.0, unit="count")
56:             collector.record_metric("terminal_last_exit_code", float(int(args.exit_code)), unit="code")
57:             if not success:
58:                 collector.record_event(
59:                     "ExceptionThrown",
60:                     {
61:                         "source": "terminal-hook",
62:                         "message": "command_reported_failure",
63:                         "exit_code": int(args.exit_code),
64:                     },
65:                     level="ERROR",
66:                 )
67:     return 0
68: if __name__ == "__main__":
69:     raise SystemExit(main())
</file>

