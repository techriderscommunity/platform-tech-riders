 4: namespace TechRiders.Infrastructure.Repositories;
 5: /// <summary>
 6: /// Implementación del patrón Unit of Work
 7: /// Coordina transacciones entre múltiples repositorios
 8: /// </summary>
 9: public class UnitOfWork : IUnitOfWork
10: {
11:     private readonly TechRidersDbContext _context;
12:     private IDbContextTransaction? _transaction;
13:     // Repositorios existentes
14:     private IEventRepository? _events;
15:     private ISessionRepository? _sessions;
16:     private IAmbassadorRepository? _ambassadors;
17:     private ICenterRepository? _centers;
18:     private IFPTourRepository? _fpTours;
19:     private ICategoryRepository? _categories;
20:     private IOfertaRepository? _ofertas;
21:     private ICandidaturaRepository? _candidaturas;
22:     private ITutorialRepository? _tutoriales;
23:     private IIntranetAuditLogRepository? _intranetAuditLogs;
24:     private IIntranetSettingRepository? _intranetSettings;
25:     private IIntranetUserCategoryRepository? _intranetUserCategories;
26:     public UnitOfWork(TechRidersDbContext context)
27:     {
28:         _context = context;
29:     }
30:     public IEventRepository Events => _events ??= new EventRepository(_context);
31:     public ISessionRepository Sessions => _sessions ??= new SessionRepository(_context);
