204:     $engineSummary = [ordered]@{
205:         codegraph = [ordered]@{
206:             command_available = Test-CommandAvailable -Name 'codegraph'
207:             index_present = Test-Path (Join-Path $RepoRoot '.codegraph')
208:             sync = Get-StepStatus -Name 'Refresh codegraph index sync'
209:             status = Get-StepStatus -Name 'Check codegraph status'
210:         }
211:         git = [ordered]@{
212:             command_available = Test-CommandAvailable -Name 'git'
213:             snapshot = Get-StepStatus -Name 'Collect git snapshot'
214:         }
215:         repomix = [ordered]@{
216:             refresh = Get-StepStatus -Name 'Refresh repomix context export'
217:         }
218:     }
219: 
220:     $artifactSummary = [ordered]@{
221:         repo_registry = Get-StepStatus -Name 'Validate repo registry (strict)'
222:         repo_intake = Get-StepStatus -Name 'Refresh repo intake artifacts'
223:         routing_evals = Get-StepStatus -Name 'Run routing evals'
