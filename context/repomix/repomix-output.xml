<file path="telemetry/collector/engine.py">
  1: from __future__ import annotations
  2: import uuid
  3: from contextlib import AbstractContextManager
  4: from dataclasses import dataclass
  5: from datetime import datetime, timezone
  6: from typing import Any
  7: from telemetry.context.propagation import (
  8:     TelemetryContext,
  9:     child_context,
 10:     get_current_context,
 11:     new_execution_context,
 12:     reset_current_context,
 13:     set_current_context,
 14: )
 15: from telemetry.events.catalog import CANONICAL_EVENTS
 16: from telemetry.events.factory import make_event
 17: from telemetry.metrics.aggregator import MetricsAggregator
 18: from telemetry.scoring.efficiency import compute_efficiency_score
 19: from telemetry.tracing.span import SpanRecord
 20: def utc_now() -> str:
 21:     return datetime.now(timezone.utc).isoformat()
 22: @dataclass
 23: class _ExecutionScope(AbstractContextManager[TelemetryContext]):
 24:     collector: "TelemetryCollector"
 25:     context: TelemetryContext
 26:     token: Any
 27:     operation: str
 28:     start_ts: str
 29:     def __enter__(self) -> TelemetryContext:
 30:         self.collector.record_event("ExecutionStarted", {"operation": self.operation, "started_at": self.start_ts})
 31:         return self.context
 32:     def __exit__(self, exc_type, exc, tb) -> bool:
 33:         if exc is not None:
 34:             self.collector.record_event("ExceptionThrown", {"operation": self.operation, "error": str(exc)}, level="ERROR")
 35:             self.collector.metrics.bump("error_count")
 36:         self.collector.metrics.snapshot.execution_time_ms = max(
 37:             0.0,
 38:             (datetime.fromisoformat(utc_now()) - datetime.fromisoformat(self.start_ts)).total_seconds() * 1000.0,
 39:         )
 40:         self.collector.record_metric("efficiency_score", compute_efficiency_score(self.collector.metrics.to_dict()), unit="score")
 41:         self.collector.record_event("ExecutionFinished", {"operation": self.operation, "finished_at": utc_now()})
 42:         self.collector.flush()
 43:         reset_current_context(self.token)
 44:         return False
 45: @dataclass
 46: class _SpanScope(AbstractContextManager[SpanRecord]):
 47:     collector: "TelemetryCollector"
 48:     span: SpanRecord
 49:     token: Any
 50:     def __enter__(self) -> SpanRecord:
 51:         self.collector.record_event(
 52:             "SpanStarted",
 53:             {
 54:                 "name": self.span.name,
 55:                 "span_id": self.span.span_id,
 56:                 "parent_span_id": self.span.parent_span_id,
 57:                 "kind": self.span.kind,
 58:             },
 59:         )
 60:         return self.span
 61:     def __exit__(self, exc_type, exc, tb) -> bool:
 62:         if exc is not None:
 63:             self.span.end(status="ERROR", error=str(exc))
 64:             self.collector.metrics.bump("error_count")
 65:             self.collector.record_event("ExceptionThrown", {"span": self.span.name, "error": str(exc)}, level="ERROR")
 66:         else:
 67:             self.span.end(status="OK")
 68:         if self.span.duration_ms is not None:
 69:             self.collector.metrics.add_duration(self.span.duration_ms)
 70:         self.collector._emit(
 71:             make_event(
 72:                 event_name="SpanFinished",
 73:                 event_type="span",
 74:                 context=get_current_context(),
 75:                 payload={
 76:                     "name": self.span.name,
 77:                     "kind": self.span.kind,
 78:                     "span_id": self.span.span_id,
 79:                     "parent_span_id": self.span.parent_span_id,
 80:                     "trace_id": self.span.trace_id,
 81:                     "execution_id": self.span.execution_id,
 82:                     "started_at": self.span.started_at,
 83:                     "ended_at": self.span.ended_at,
 84:                     "duration_ms": self.span.duration_ms,
 85:                     "status": self.span.status,
 86:                     "attributes": self.span.attributes,
 87:                     "events": self.span.events,
 88:                     "error": self.span.error,
 89:                 },
 90:             )
 91:         )
 92:         reset_current_context(self.token)
 93:         return False
 94: class TelemetryCollector:
 95:     def __init__(
 96:         self,
 97:         *,
 98:         exporters: list[Any],
 99:         enabled: bool = True,
100:         batch_size: int = 25,
101:     ) -> None:
102:         self.enabled = bool(enabled)
103:         self.exporters = exporters
104:         self.batch_size = max(1, int(batch_size))
105:         self.queue: list[dict[str, Any]] = []
106:         self.metrics = MetricsAggregator()
107:         self.warning_buffer: list[str] = []
108:     def start_execution(
109:         self,
110:         *,
111:         operation: str,
112:         request_id: str | None = None,
113:         session_id: str = "default-session",
114:         correlation_id: str | None = None,
115:         execution_id: str | None = None,
116:         user: str | None = None,
117:         provider: str | None = None,
118:         model: str | None = None,
119:     ) -> AbstractContextManager[TelemetryContext]:
120:         request = request_id or str(uuid.uuid4())
121:         correlation = correlation_id or request
122:         execution = execution_id or str(uuid.uuid4())
123:         context = new_execution_context(
124:             request_id=request,
125:             session_id=session_id,
126:             correlation_id=correlation,
127:             execution_id=execution,
128:             user=user,
129:             provider=provider,
130:             model=model,
131:         )
132:         token = set_current_context(context)
133:         return _ExecutionScope(self, context, token, operation, utc_now())
134:     def start_span(
135:         self,
136:         *,
137:         name: str,
138:         kind: str = "INTERNAL",
139:         attributes: dict[str, Any] | None = None,
140:     ) -> AbstractContextManager[SpanRecord]:
141:         current = get_current_context()
142:         if current is None:
143:             current = new_execution_context(
144:                 request_id=str(uuid.uuid4()),
145:                 session_id="implicit-session",
146:                 correlation_id=str(uuid.uuid4()),
147:                 execution_id=str(uuid.uuid4()),
148:             )
149:             token = set_current_context(current)
150:         else:
151:             child = child_context(current)
152:             token = set_current_context(child)
153:             current = child
154:         span = SpanRecord(
155:             name=name,
156:             kind=kind,
157:             span_id=current.span_id,
158:             parent_span_id=current.parent_span_id,
159:             trace_id=current.trace_id,
160:             execution_id=current.execution_id,
161:             started_at=utc_now(),
162:             attributes=attributes or {},
163:         )
164:         return _SpanScope(self, span, token)
165:     def record_event(self, event_name: str, payload: dict[str, Any] | None = None, *, level: str = "INFO") -> None:
166:         canonical = event_name if event_name in CANONICAL_EVENTS else "WarningGenerated"
167:         if canonical == "WarningGenerated" and event_name not in CANONICAL_EVENTS:
168:             payload = {"original_event": event_name, **(payload or {})}
169:         if level.upper() == "WARNING":
170:             self.metrics.bump("warning_count")
171:         self._emit(make_event(event_name=canonical, event_type="event", context=get_current_context(), payload=payload, level=level.upper()))
172:     def record_metric(self, metric_name: str, value: float, *, unit: str = "count", tags: dict[str, Any] | None = None) -> None:
173:         payload = {"name": metric_name, "value": value, "unit": unit, "tags": tags or {}}
174:         if metric_name == "estimated_cost":
175:             self.metrics.add_cost(float(value))
176:         self._emit(make_event(event_name="MetricCalculated", event_type="metric", context=get_current_context(), payload=payload))
177:     def record_usage(self, *, input_tokens: int, output_tokens: int, estimated_cost_usd: float) -> None:
178:         self.metrics.add_tokens(input_tokens, output_tokens)
179:         self.metrics.add_cost(estimated_cost_usd)
180:         self.record_metric("tokens_input", float(input_tokens), unit="tokens")
181:         self.record_metric("tokens_output", float(output_tokens), unit="tokens")
182:         self.record_metric("total_tokens", float(input_tokens + output_tokens), unit="tokens")
183:         self.record_metric("estimated_cost", float(estimated_cost_usd), unit="usd")
184:     def _emit(self, record: dict[str, Any]) -> None:
185:         if not self.enabled:
186:             return
187:         self.queue.append(record)
188:         if len(self.queue) >= self.batch_size:
189:             self.flush()
190:     def flush(self) -> None:
191:         if not self.enabled or not self.queue:
192:             return
193:         batch = self.queue[:]
194:         self.queue = []
195:         for exporter in self.exporters:
196:             try:
197:                 exporter_started = make_event(
198:                     event_name="ExporterStarted",
199:                     event_type="event",
200:                     context=get_current_context(),
201:                     payload={"exporter": exporter.name},
202:                 )
203:                 batch_with_started = [exporter_started, *batch]
204:                 exporter.export(batch_with_started)
205:                 exporter.flush()
206:                 exporter_finished = make_event(
207:                     event_name="ExporterFinished",
208:                     event_type="event",
209:                     context=get_current_context(),
210:                     payload={"exporter": exporter.name, "success": True},
211:                 )
212:                 exporter.export([exporter_finished])
213:             except Exception as exc:
214:                 self.warning_buffer.append(f"exporter_failed:{exporter.name}:{exc}")
215:                 warning = make_event(
216:                     event_name="WarningGenerated",
217:                     event_type="event",
218:                     context=get_current_context(),
219:                     payload={"warning": "exporter_failed", "exporter": exporter.name, "error": str(exc)},
220:                     level="WARNING",
221:                 )
222:                 for backup in self.exporters:
223:                     if backup.name == exporter.name:
224:                         continue
225:                     try:
226:                         backup.export([warning])
227:                     except Exception:
228:                         continue
229:     def shutdown(self) -> None:
230:         self.flush()
231:         for exporter in self.exporters:
232:             try:
233:                 exporter.shutdown()
234:             except Exception:
235:                 continue
