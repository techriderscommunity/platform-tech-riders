  1: import { ChangeDetectionStrategy, Component, DestroyRef, computed, inject, signal } from '@angular/core';
  2: import { FormsModule } from '@angular/forms';
  3: import { Router } from '@angular/router';
  4: import { takeUntilDestroyed, toSignal } from '@angular/core/rxjs-interop';
  5: import { catchError, combineLatest, of, tap } from 'rxjs';
  6: import { AuthService } from '@core/auth/auth.service';
  7: import { PublicContentService } from '@core/content/public-content.service';
  8: import { EmbajadoresService } from '../embajadores/services/embajadores.service';
  9: import { Embajador } from '../embajadores/models/embajadores.models';
 10: import { Sesion } from './models/sesiones.models';
 11: import { SesionesService } from './services/sesiones.service';
 12: import { UiTextField  } from '@shared/ui/text-field/text-field';
 13: import { UiSelect, UiSelectOption  } from '@shared/ui/select/select';
 14: import { UiButton } from '@shared/ui/button/button';
 15: @Component({
 16:   selector: 'app-sesiones',
 17:   standalone: true,
 18:   changeDetection: ChangeDetectionStrategy.OnPush,
 19:   imports: [FormsModule, UiTextField, UiSelect, UiButton],
 20:   templateUrl: './sesiones.html',
 21:   styleUrl: './sesiones.scss'
 22: })
 23: export class Sesiones {
 24:   private readonly authService = inject(AuthService);
 25:   private readonly sesionesService = inject(SesionesService);
 26:   private readonly embajadoresService = inject(EmbajadoresService);
 27:   private readonly publicContentService = inject(PublicContentService);
 28:   private readonly destroyRef = inject(DestroyRef);
 29:   private readonly router = inject(Router);
 30:   private readonly publicContent = toSignal(this.publicContentService.getPublicContent(), { initialValue: null });
 31:   readonly filtroCentro = signal('');
 32:   readonly filtroFecha = signal('');
 33:   readonly filtroCategoria = signal('');
 34:   readonly filtroEstado = signal('');
 35:   readonly filtroAlumnosMin = signal<number | null>(null);
 36:   readonly filtroAlumnosMax = signal<number | null>(null);
 37:   readonly loading = signal(false);
 38:   readonly error = signal<string | null>(null);
 39:   readonly success = signal<string | null>(null);
 40:   readonly sessionOverrides = signal<Record<string, Partial<Sesion>>>({});
 41:   readonly estados = computed(() => this.publicContent()?.intranet.sessionStatusOptions ?? []);
 42:   readonly sesiones = signal<Sesion[]>([]);
 43:   readonly embajadores = signal<Embajador[]>([]);
 44:   readonly categorias = computed(() => {
 45:     const categories = this.sesiones().map(s => s.categoria);
 46:     return [...new Set(categories)].sort();
 47:   });
 48:   readonly categoriasOptions = computed<UiSelectOption[]>(() => [
 49:     { label: 'Todas categorías', value: '' },
 50:     ...this.categorias().map(cat => ({ label: cat, value: cat }))
 51:   ]);
 52:   readonly estadoOptions = computed<UiSelectOption[]>(() => [
 53:     { label: 'Todos estados', value: '' },
 54:     ...this.estados().map(est => ({ label: est, value: est }))
 55:   ]);
 56:   readonly context = computed(() => {
 57:     const url = this.router.url;
 58:     if (url.includes('/intranet/fp-tour/mis-sesiones')) {
 59:       return {
 60:         title: 'FP Tour · Mis sesiones',
 61:         subtitle: 'Solicitudes y sesiones de FP Tour, ordenadas por estado operativo.',
 62:       };
 63:     }
 64:     return {
 65:       title: 'Sesiones · Mis sesiones',
 66:       subtitle: 'Listado general de sesiones (independientes y vinculadas a eventos).',
 67:     };
 68:   });
 69:   constructor() {
 70:     combineLatest([
 71:       this.sesionesService.getSesiones(1, 100),
 72:       this.embajadoresService.getEmbajadores(1, 100)
 73:     ])
 74:       .pipe(
 75:         tap(() => {
 76:           this.loading.set(true);
 77:           this.error.set(null);
 78:         }),
 79:         catchError(() => {
 80:           this.error.set('No se pudieron cargar las sesiones.');
 81:           return of([
 82:             { items: [] as Sesion[] },
 83:             { items: [] as Embajador[] }
 84:           ] as const);
 85:         }),
 86:         takeUntilDestroyed(this.destroyRef)
 87:       )
 88:       .subscribe(([sesionesResult, embajadoresResult]) => {
 89:         this.sesiones.set(sesionesResult.items);
 90:         this.embajadores.set(embajadoresResult.items);
 91:         this.loading.set(false);
 92:       });
 93:     this.sesionesService.getSessionWorkflow()
 94:       .pipe(
 95:         tap(actions => {
 96:           const mapped = Object.fromEntries(Object.entries(actions).map(([key, value]) => [key, {
 97:             estado: value.Status,
 98:             embajadorAsignadoId: value.AmbassadorAssignedId ?? null,
 99:           }]));
100:           this.sessionOverrides.update(current => ({ ...current, ...mapped }));
101:         }),
102:         catchError(() => of(null))
103:       )
104:       .subscribe();
105:   }
106:   readonly sesionesBase = computed(() => this.sesiones().map(session => ({
107:     ...session,
108:     ...(this.sessionOverrides()[session.id] ?? {})
109:   })));
110:   readonly resumen = computed(() => {
111:     const sesiones = this.sesionesBase();
112:     return {
113:       total: sesiones.length,
114:       pendientes: sesiones.filter(item => item.estado === 'Pendiente').length,
115:       confirmadas: sesiones.filter(item => item.estado === 'Confirmada').length,
116:       canceladas: sesiones.filter(item => item.estado === 'Cancelada').length,
117:     };
118:   });
119:   readonly sesionesFiltradas = computed(() => {
120:     const centro = this.filtroCentro();
121:     const fecha = this.filtroFecha();
122:     const categoria = this.filtroCategoria();
123:     const estado = this.filtroEstado();
124:     const min = this.filtroAlumnosMin();
125:     const max = this.filtroAlumnosMax();
126:     return this.sesionesBase().filter(s => {
127:       const centroMatch = centro ? s.centro.toLowerCase().includes(centro.toLowerCase()) : true;
128:       const fechaMatch = fecha ? s.fecha === fecha : true;
129:       const categoriaMatch = categoria ? s.categoria === categoria : true;
130:       const estadoMatch = estado ? s.estado === estado : true;
131:       const alumnosMatch = (min !== null ? s.numAlumnos >= min : true) && (max !== null ? s.numAlumnos <= max : true);
132:       return centroMatch && fechaMatch && categoriaMatch && estadoMatch && alumnosMatch;
133:     });
134:   });
135:   getEmbajadorNombre(embajadorId: string | null): string {
136:     if (!embajadorId) return '';
137:     return this.embajadores().find(e => e.id === embajadorId)?.nombre ?? '';
138:   }
139:   canSelfAssign(): boolean {
140:     return this.authService.hasRole(['embajador', 'colaborador']);
141:   }
142:   canManageSessions(): boolean {
143:     return this.authService.hasRole(['superadmin', 'staff', 'coordinador']);
144:   }
145:   asignarmeSesion(id: string) {
146:     const ownEmbajador = this.resolveCurrentEmbajador();
147:     if (!ownEmbajador) {
148:       this.success.set('No se encontró un perfil Ambassador asociado a tu usuario actual.');
149:       return;
150:     }
151:     this.patchSession(id, {
152:       embajadorAsignadoId: ownEmbajador.id,
153:       estado: 'Confirmada'
154:     }, 'Te has asignado la sesión en local.');
155:   }
156:   liberarSesion(id: string) {
157:     this.patchSession(id, {
158:       embajadorAsignadoId: null,
159:       estado: 'Pendiente'
160:     }, 'La sesión vuelve a estado pendiente en local.');
161:   }
162:   confirmarSesion(id: string) {
163:     this.patchSession(id, { estado: 'Confirmada' }, 'Sesión marcada como confirmada en local.');
164:   }
165:   cancelarSesion(id: string) {
166:     this.patchSession(id, { estado: 'Cancelada' }, 'Sesión marcada como cancelada en local.');
167:   }
168:   private patchSession(id: string, patch: Partial<Sesion>, successMessage: string) {
169:     this.sesionesService.updateSessionWorkflow(id, {
170:       status: patch.estado,
171:       ambassadorAssignedId: patch.embajadorAsignadoId ?? null,
172:     })
173:       .pipe(
174:         tap(() => {
175:           this.sessionOverrides.update(current => ({
176:             ...current,
177:             [id]: {
178:               ...(current[id] ?? {}),
179:               ...patch,
180:             }
181:           }));
182:           this.success.set(successMessage);
183:           this.error.set(null);
184:         }),
185:         catchError(() => {
186:           this.error.set('No se pudo guardar el estado de la sesión en backend.');
187:           return of(null);
188:         }),
189:         takeUntilDestroyed(this.destroyRef)
190:       )
191:       .subscribe();
192:   }
193:   private resolveCurrentEmbajador(): Embajador | null {
194:     const userEmail = this.authService.user()?.email?.toLowerCase();
195:     if (!userEmail) {
196:       return this.embajadores()[0] ?? null;
197:     }
198:     return this.embajadores().find(item => item.email.toLowerCase() === userEmail) ?? this.embajadores()[0] ?? null;
199:   }
200: }
