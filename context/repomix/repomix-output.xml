<file path="techito/src/app/features/intranet/empleo/empresa/ver-candidatos/ver-candidatos.ts">
  1: import { ChangeDetectionStrategy, Component, DestroyRef, inject, signal } from '@angular/core';
  2: import { ActivatedRoute, RouterLink } from '@angular/router';
  3: import { FormsModule } from '@angular/forms';
  4: import { AuthService } from '@core/auth/auth.service';
  5: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
  6: import { catchError, map, of, switchMap, tap } from 'rxjs';
  7: import { Candidato } from '../models/empresa.models';
  8: import { EmpresaService } from '../services/empresa.service';
  9: import { UiSelect, UiSelectOption  } from '@shared/ui/select/select';
 10: import { UiButton  } from '@shared/ui/button/button';
 11: @Component({
 12:   selector: 'app-ver-candidatos',
 13:   standalone: true,
 14:   changeDetection: ChangeDetectionStrategy.OnPush,
 15:   imports: [RouterLink, FormsModule, UiSelect, UiButton],
 16:   templateUrl: './ver-candidatos.html',
 17:   styleUrl: './ver-candidatos.scss'
 18: })
 19: export class VerCandidatos {
 20:   private readonly route = inject(ActivatedRoute);
 21:   private readonly empresaService = inject(EmpresaService);
 22:   private readonly authService = inject(AuthService);
 23:   private readonly destroyRef = inject(DestroyRef);
 24:   readonly ofertaId = signal('');
 25:   readonly candidatos = signal<Candidato[]>([]);
 26:   readonly loading = signal(false);
 27:   readonly error = signal<string | null>(null);
 28:   readonly estadoOptions: UiSelectOption[] = [
 29:     { label: 'Marcar Pendiente', value: 'pendiente' },
 30:     { label: 'Marcar para Entrevista', value: 'entrevista' },
 31:     { label: 'Hacer Oferta', value: 'oferta' }
 32:   ];
 33:   constructor() {
 34:     this.route.queryParamMap
 35:       .pipe(
 36:         map(params => params.get('ofertaId') ?? ''),
 37:         tap(ofertaId => {
 38:           this.ofertaId.set(ofertaId);
 39:           this.loading.set(true);
 40:           this.error.set(null);
 41:         }),
 42:         switchMap(ofertaId => {
 43:           if (!ofertaId) {
 44:             if (this.authService.hasRole('superadmin')) {
 45:               return this.empresaService.getCandidatosGovernance().pipe(
 46:                 catchError(() => {
 47:                   this.error.set('No se pudieron cargar las candidaturas globales.');
 48:                   return of([] as Candidato[]);
 49:                 })
 50:               );
 51:             }
 52:             return of([] as Candidato[]);
 53:           }
 54:           return this.empresaService.getCandidatos(ofertaId).pipe(
 55:             catchError(() => {
 56:               this.error.set('No se pudieron cargar los candidatos.');
 57:               return of([] as Candidato[]);
 58:             })
 59:           );
 60:         }),
 61:         takeUntilDestroyed(this.destroyRef)
 62:       )
 63:       .subscribe(candidatos => {
 64:         this.candidatos.set(candidatos);
 65:         this.loading.set(false);
 66:       });
 67:   }
 68:   cambiarEstado(id: string, nuevoEstado: string) {
 69:     if (this.authService.hasRole('superadmin')) {
 70:       this.empresaService.updateCandidaturaEstado(id, nuevoEstado)
 71:         .pipe(
 72:           catchError(() => {
 73:             this.error.set('No se pudo actualizar el estado de la candidatura.');
 74:             return of(void 0);
 75:           }),
 76:           takeUntilDestroyed(this.destroyRef)
 77:         )
 78:         .subscribe(() => {
 79:           this.candidatos.update(list => list.map(c =>
 80:             c.id === id ? { ...c, estado: nuevoEstado } : c
 81:           ));
 82:         });
 83:       return;
 84:     }
 85:     this.candidatos.update(list => list.map(c =>
 86:       c.id === id ? { ...c, estado: nuevoEstado } : c
 87:     ));
 88:   }
 89:   contactarCandidato(_: string) {
 90:     // TODO: conectar flujo real de contacto.
 91:   }
 92:   rechazarCandidato(id: string) {
 93:     this.candidatos.update(list => list.filter(c => c.id !== id));
 94:   }
 95:   getInitials(nombre: string): string {
 96:     return nombre
 97:       .split(' ')
 98:       .filter(Boolean)
 99:       .slice(0, 2)
100:       .map(part => part[0]!.toUpperCase())
101:       .join('');
102:   }
103: }
</file>

