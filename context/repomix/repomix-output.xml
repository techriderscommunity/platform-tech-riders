141: function Invoke-Step {
142:     param(
143:         [int]$Index,
144:         [int]$Total,
145:         [pscustomobject]$Step,
146:         [string]$RunFolder,
147:         [switch]$DryRun
148:     )
149: 
150:     $stepName = [string]$Step.name
151:     $question = [string]$Step.question
152:     $flow = @($Step.flow)
153:     $workingDir = [string]$Step.working_dir
154:     $command = [string]$Step.command
155:     $timeoutSec = if ($null -ne $Step.timeout_sec) { [int]$Step.timeout_sec } else { 1800 }
156:     $required = if ($null -ne $Step.required) { [bool]$Step.required } else { $true }
157: 
158:     $safeStep = ($stepName.ToLowerInvariant() -replace '[^a-z0-9_-]+', '-') -replace '(^-|-$)', ''
159:     $stdoutPath = Join-Path $RunFolder ("{0:D2}-{1}.stdout.log" -f $Index, $safeStep)
160:     $stderrPath = Join-Path $RunFolder ("{0:D2}-{1}.stderr.log" -f $Index, $safeStep)
161:     $combinedPath = Join-Path $RunFolder ("{0:D2}-{1}.log" -f $Index, $safeStep)
162: 
163:     Write-Host ("[{0}/{1}] {2}" -f $Index, $Total, $stepName) -ForegroundColor Cyan
164:     if (-not [string]::IsNullOrWhiteSpace($question)) {
165:         Write-Host ("  question: {0}" -f $question)
166:     }
167:     if ($flow.Count -gt 0) {
168:         Write-Host ("  flow: {0}" -f (($flow | ForEach-Object { [string]$_ }) -join ' -> '))
169:     }
170:     Write-Host ("  dir: {0}" -f $workingDir)
171:     Write-Host ("  cmd: {0}" -f $command)
172: 
173:     if ($DryRun) {
174:         return [ordered]@{
175:             name = $stepName
176:             required = $required
177:             status = 'dry-run'
178:             exit_code = 0
179:             started_at = (Get-Date).ToString('o')
180:             ended_at = (Get-Date).ToString('o')
181:             duration_sec = 0
182:             question = $question
183:             flow = @($flow)
184:             working_dir = $workingDir
185:             command = $command
186:             stdout_log = $stdoutPath
187:             stderr_log = $stderrPath
188:             combined_log = $combinedPath
189:             timeout_sec = $timeoutSec
190:             expected_patterns = @($Step.expected_patterns)
191:             missing_patterns = @()
192:             token_metrics = [ordered]@{
193:                 tokens_prompt = $null
194:                 tokens_context = $null
195:                 tokens_response = $null
196:                 tokens_total = $null
197:                 cost_estimated_usd = $null
198:                 source = 'dry-run'
199:             }
200:         }
201:     }
202: 
203:     if (-not (Test-Path $workingDir)) {
204:         return [ordered]@{
205:             name = $stepName
206:             required = $required
207:             status = 'failed'
208:             exit_code = -1
209:             started_at = (Get-Date).ToString('o')
210:             ended_at = (Get-Date).ToString('o')
211:             duration_sec = 0
212:             question = $question
213:             flow = @($flow)
214:             working_dir = $workingDir
215:             command = $command
216:             stdout_log = $stdoutPath
217:             stderr_log = $stderrPath
218:             combined_log = $combinedPath
219:             timeout_sec = $timeoutSec
220:             expected_patterns = @($Step.expected_patterns)
221:             missing_patterns = @("working_dir_not_found")
222:             message = "Working directory does not exist"
223:             token_metrics = [ordered]@{
224:                 tokens_prompt = $null
225:                 tokens_context = $null
226:                 tokens_response = $null
227:                 tokens_total = $null
228:                 cost_estimated_usd = $null
229:                 source = 'working-dir-missing'
230:             }
231:         }
232:     }
233: 
234:     $started = Get-Date
235:     $proc = Start-Process -FilePath 'pwsh' -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-Command', $command) -WorkingDirectory $workingDir -RedirectStandardOutput $stdoutPath -RedirectStandardError $stderrPath -PassThru
236: 
237:     $timedOut = $false
238:     try {
239:         $null = $proc.WaitForExit($timeoutSec * 1000)
240:         if (-not $proc.HasExited) {
241:             $timedOut = $true
242:             Stop-Process -Id $proc.Id -Force
243:         }
244:     }
245:     catch {
246:         if (-not $proc.HasExited) {
247:             Stop-Process -Id $proc.Id -Force
248:         }
249:         throw
250:     }
251: 
252:     $ended = Get-Date
253:     $durationSec = [math]::Round((($ended - $started).TotalSeconds), 2)
254: 
255:     $stdoutText = if (Test-Path $stdoutPath) { Get-Content $stdoutPath -Raw } else { '' }
256:     $stderrText = if (Test-Path $stderrPath) { Get-Content $stderrPath -Raw } else { '' }
257: 
258:     Set-Content -Path $combinedPath -Value ($stdoutText + [Environment]::NewLine + $stderrText) -Encoding UTF8
259:     $tokenMetrics = Get-TokenMetricsFromText -Text ($stdoutText + [Environment]::NewLine + $stderrText)
260: 
261:     $exitCode = if ($timedOut) { -2 } else { $proc.ExitCode }
262:     $status = if ($timedOut) { 'timeout' } elseif ($exitCode -eq 0) { 'ok' } else { 'failed' }
263: 
264:     $expectedPatterns = @($Step.expected_patterns)
265:     $missingPatterns = @()
266:     if ($expectedPatterns.Count -gt 0) {
267:         foreach ($pattern in $expectedPatterns) {
268:             $found = Select-String -Path $combinedPath -Pattern [string]$pattern -SimpleMatch -Quiet
269:             if (-not $found) {
270:                 $missingPatterns += [string]$pattern
271:             }
272:         }
273: 
274:         if ($missingPatterns.Count -gt 0 -and $status -eq 'ok') {
275:             $status = 'failed'
276:         }
277:     }
278: 
279:     Write-Host ("  status: {0} (exit={1}, {2}s)" -f $status, $exitCode, $durationSec) -ForegroundColor $(if ($status -eq 'ok') { 'Green' } else { 'Red' })
280: 
281:     return [ordered]@{
282:         name = $stepName
283:         required = $required
284:         status = $status
285:         exit_code = $exitCode
286:         started_at = $started.ToString('o')
287:         ended_at = $ended.ToString('o')
288:         duration_sec = $durationSec
289:         question = $question
290:         flow = @($flow)
291:         working_dir = $workingDir
292:         command = $command
293:         stdout_log = $stdoutPath
294:         stderr_log = $stderrPath
295:         combined_log = $combinedPath
296:         timeout_sec = $timeoutSec
297:         expected_patterns = $expectedPatterns
298:         missing_patterns = $missingPatterns
299:         timed_out = $timedOut
300:         token_metrics = $tokenMetrics
301:     }
302: }
