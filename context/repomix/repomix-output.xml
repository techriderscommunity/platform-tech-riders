<file path="techito/src/app/features/comuneras/comuneras.ts">
 1: import { ChangeDetectionStrategy, Component, computed, inject, signal } from '@angular/core';
 2: import { RouterLink } from '@angular/router';
 3: import { UiSelect, UiSelectOption } from '@shared/ui/select/select';
 4: import { UiTextField } from '@shared/ui/text-field/text-field';
 5: import { CommunityPartnersStore } from './services/community-partners.store';
 6: @Component({
 7:   selector: 'app-comuneras',
 8:   standalone: true,
 9:   imports: [RouterLink, UiSelect, UiTextField],
10:   templateUrl: './comuneras.html',
11:   styleUrl: './comuneras.scss',
12:   changeDetection: ChangeDetectionStrategy.OnPush,
13: })
14: export class Comuneras {
15:   private readonly store = inject(CommunityPartnersStore);
16:   readonly searchTerm = signal('');
17:   readonly scopeFilter = signal<'all' | 'local' | 'national' | 'international'>('all');
18:   readonly partners = this.store.approvedPartners;
19:   readonly subtitle =
20:     'Comunidades compañeras con las que compartimos camino, ideas y ganas de hacer cosas grandes.';
21:   readonly topicSummary = computed(() => {
22:     const topics = this.partners().flatMap(partner => partner.topics);
23:     return Array.from(new Set(topics)).slice(0, 7);
24:   });
25:   readonly filteredPartners = computed(() => {
26:     const term = this.searchTerm().trim().toLowerCase();
27:     const scope = this.scopeFilter();
28:     return this.partners().filter(partner => {
29:       const matchesScope = scope === 'all' || partner.scope === scope;
30:       const matchesTerm = !term
31:         || partner.name.toLowerCase().includes(term)
32:         || partner.shortDescription.toLowerCase().includes(term)
33:         || partner.cityOrScope.toLowerCase().includes(term)
34:         || partner.topics.some(topic => topic.toLowerCase().includes(term));
35:       return matchesScope && matchesTerm;
36:     });
37:   });
38:   readonly scopeOptions: UiSelectOption[] = [
