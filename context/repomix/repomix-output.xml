390:     [HttpPost]
391:     [SwaggerOperation(
392:         Summary = "Crear nuevo evento",
393:         Description = "Crea un nuevo evento en el sistema. La fecha de finalización debe ser posterior a la fecha de inicio.",
394:         OperationId = "CreateEvent"
395:     )]
396:     [SwaggerResponse(201, "Evento creado exitosamente", typeof(EventResponse))]
397:     [SwaggerResponse(400, "Datos inválidos o fechas incorrectas")]
398:     [ProducesResponseType(typeof(EventResponse), StatusCodes.Status201Created)]
399:     [ProducesResponseType(StatusCodes.Status400BadRequest)]
400:     public async Task<ActionResult<EventResponse>> CreateEvent(
401:         [FromBody] CreateEventRequest request,
402:         CancellationToken cancellationToken)
403:     {
404:         try
405:         {
406:             if (!ModelState.IsValid)
407:             {
408:                 return BadRequest(ModelState);
409:             }
410:             var evento = await _eventService.CreateEventAsync(request, cancellationToken);
411:             return CreatedAtAction(
412:                 nameof(GetEventById),
413:                 new { id = evento.Id },
414:                 evento);
415:         }
416:         catch (InvalidOperationException ex)
417:         {
418:             _logger.LogWarning(ex, "Validación de negocio fallida al crear evento");
419:             return BadRequest(ex.Message);
420:         }
421:         catch (Exception ex)
422:         {
423:             _logger.LogError(ex, "Error al crear evento");
424:             return StatusCode(500, "Error al crear el evento");
425:         }
426:     }
