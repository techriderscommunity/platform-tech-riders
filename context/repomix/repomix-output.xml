<file path="techito/src/app/features/login/login.ts">
 1: import { ChangeDetectionStrategy, Component, signal, inject } from '@angular/core';
 2: import { FormsModule } from '@angular/forms';
 3: import { ActivatedRoute, Router } from '@angular/router';
 4: import { AuthService  } from '@core/auth/auth.service';
 5: import { UiModal  } from '@shared/ui/modal/modal';
 6: import { UiTextField  } from '@shared/ui/text-field/text-field';
 7: import { UiButton  } from '@shared/ui/button/button';
 8: @Component({
 9:   selector: 'app-login',
10:   standalone: true,
11:   changeDetection: ChangeDetectionStrategy.OnPush,
12:   imports: [FormsModule, UiModal, UiTextField, UiButton],
13:   templateUrl: './login.html',
14:   styleUrl: './login.scss'
15: })
16: export class Login {
17:   private readonly authService = inject(AuthService);
18:   private readonly router = inject(Router);
19:   private readonly route = inject(ActivatedRoute);
20:   readonly email = signal('');
21:   readonly password = signal('');
22:   readonly error = signal('');
23:   readonly loading = signal(false);
24:   closeLogin(event?: Event | void) {
25:     if (event instanceof Event) {
26:       event.preventDefault();
27:     }
28:     const currentPath = this.router.url.split('?')[0];
29:     if (currentPath === '/login') {
30:       this.router.navigate(['/']);
31:       return;
32:     }
33:     this.router.navigate([], {
34:       queryParams: { login: null, returnUrl: null },
35:       queryParamsHandling: 'merge',
36:     });
37:   }
38:   private getReturnUrl(): string | null {
39:     const returnUrl = this.route.snapshot.queryParamMap.get('returnUrl');
40:     if (!returnUrl || !returnUrl.startsWith('/') || returnUrl.startsWith('/login')) {
41:       return null;
42:     }
43:     return returnUrl;
44:   }
45:   onSubmit(event?: Event) {
46:     if (event) event.preventDefault();
47:     this.loading.set(true);
48:     this.error.set('');
49:     this.authService.login(this.email(), this.password()).subscribe({
50:       next: () => {
51:         this.loading.set(false);
52:         const returnUrl = this.getReturnUrl();
53:         if (returnUrl) {
54:           this.router.navigateByUrl(returnUrl);
55:           return;
56:         }
57:         this.router.navigateByUrl(this.authService.getDefaultRoute());
58:       },
59:       error: () => {
60:         this.loading.set(false);
61:         this.error.set('Usuario o contraseña incorrectos');
62:       }
63:     });
64:   }
65: }
</file>

