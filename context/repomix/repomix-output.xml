23: export class Header implements OnInit, OnDestroy {
24:   private readonly router = inject(Router);
25:   private readonly authService = inject(AuthService);
26:   private readonly platformId = inject(PLATFORM_ID);
27:   private get isBrowser() { return isPlatformBrowser(this.platformId); }
28:   readonly isLoggedIn = computed(() => this.authService.isAuthenticated());
29:   readonly mobileMenuOpen = signal(false);
30:   readonly isScrolled = signal(false);
31:   readonly isDarkMode = signal(true);
32:   @HostListener('window:scroll')
33:   onScroll() {
34:     if (this.isBrowser) {
35:       this.isScrolled.set(window.scrollY > 10);
36:     }
37:   }
38:   toggleMobileMenu() {
39:     this.mobileMenuOpen.update((v) => !v);
40:   }
41:   toggleTheme() {
42:     const newMode = !this.isDarkMode();
43:     this.isDarkMode.set(newMode);
44:     if (this.isBrowser) {
45:       document.documentElement.setAttribute('data-theme', newMode ? 'dark' : 'light');
46:       localStorage.setItem('tr-theme', newMode ? 'dark' : 'light');
47:     }
48:   }
49:   closeMobileMenu() {
50:     this.mobileMenuOpen.set(false);
51:   }
52:   goToLogin() {
53:     this.closeMobileMenu();
54:     this.router.navigate([], {
55:       queryParams: {
56:         login: '1',
57:         returnUrl: this.router.url,
58:       },
59:       queryParamsHandling: 'merge',
60:     });
61:   }
62:   logout() {
63:     this.authService.logout();
64:     this.closeMobileMenu();
65:     this.router.navigate(['/']);
66:   }
67:   goToProfile(event: Event) {
68:     event?.stopPropagation();
69:     this.router.navigate(['/intranet/perfil-usuario']);
70:   }
71:   ngOnInit() {
72:     if (this.isBrowser) {
73:       // Restore theme preference
