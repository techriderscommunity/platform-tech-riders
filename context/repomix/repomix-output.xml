<file path="techito/src/app/features/intranet/fp-tour/admin-sesiones.html">
 1: <div class="admin-sesiones">
 2:   <div class="page-header">
 3:     <a routerLink="/intranet" class="btn-back">← Volver a Intranet</a>
 4:     <h1>{{ context().title }}</h1>
 5:     <p>{{ context().subtitle }}</p>
 6:   </div>
 7:   <!-- Stats -->
 8:   <div class="stats-row">
 9:     <div class="stat">
10:       <span>Eventos Totales</span>
11:       <p>{{eventos().length}}</p>
12:     </div>
13:     <div class="stat">
14:       <span>Programados</span>
15:         <p>{{eventosProgramados()}}</p>
16:     </div>
17:     <div class="stat">
18:       <span>Total Asistentes</span>
19:       <p>{{totalAsistentes()}}</p>
20:     </div>
21:   </div>
22:   @if (loading()) {
23:   <p>Cargando eventos...</p>
24:   }
25:   @if (error()) {
26:   <p>{{ error() }}</p>
27:   }
28:   <!-- Action Button -->
29:   <div class="action-bar">
30:     <app-ui-button type="button" class="btn-primary" (click)="crearEvento()">{{ context().createLabel }}</app-ui-button>
31:   </div>
32:   @if (loading()) {
33:   <div class="feedback loading">Cargando eventos...</div>
34:   }
35:   @if (error()) {
36:   <div class="feedback error">{{ error() }}</div>
37:   }
38:   @if (!loading() && !error() && eventos().length === 0) {
39:   <div class="empty-state">
40:     <h2>No hay eventos registrados</h2>
41:     <p>Empieza creando el primer evento para el calendario de la comunidad.</p>
42:   </div>
43:   }
44:   <!-- Eventos Cards -->
45:   <div class="eventos-grid">
46:     @for (evento of eventos(); track evento.id) {
47:     <article class="evento-card">
48:       <div class="evento-header">
49:         <h3>{{evento.titulo}}</h3>
50:         <span
51:           class="estado-badge"
52:           [class.pendiente]="evento.estado === 'Pendiente'"
53:           [class.realizada]="evento.estado === 'Realizada'"
54:           [class.cancelada]="evento.estado === 'Cancelada'"
55:         >{{evento.estado}}</span>
56:       </div>
57:       <div class="evento-details">
58:         <p><strong>🏫 Centro:</strong> {{evento.centro}}</p>
59:         <p><strong>📅 Fecha:</strong> {{evento.fecha}}</p>
60:         <p><strong>🏷️ Categoria:</strong> {{evento.categoria}}</p>
61:         <p><strong>👥 Asistentes:</strong> {{evento.numAlumnos}}</p>
62:       </div>
63:       <div class="evento-actions">
64:         <app-ui-button type="button" variant="secondary" class="btn-sm view" (click)="verAsistentes(evento.id)">👁️ Asistentes</app-ui-button>
65:         <app-ui-button type="button" variant="secondary" class="btn-sm edit" (click)="editarEvento(evento.id)">✏️ Editar</app-ui-button>
66:         @if (evento.estado === 'Pendiente') {
67:         <app-ui-button type="button" variant="secondary" class="btn-sm delete" (click)="cancelarEvento(evento.id)">❌ Cancelar</app-ui-button>
68:         }
69:       </div>
70:     </article>
71:     }
72:   </div>
73: </div>
</file>

