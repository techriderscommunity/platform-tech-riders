  9: import { Component, Input } from '@angular/core';
 10: // ===== FORM COMPONENTS ===== //
 11: /**
 12:  * Form Input with ARIA patterns
 13:  * Usage: <app-form-input [(ngModel)]="email" ariaLabel="Email Address" required aria-required="true"></app-form-input>
 14:  */
 15: @Component({
 16:   selector: 'app-form-input',
 17:   template: `
 18:     <div class="form-group">
 19:       <label [for]="inputId" [attr.aria-required]="required">{{ label }}</label>
 20:       <input
 21:         [id]="inputId"
 22:         type="{{ type }}"
 23:         [value]="value"
 24:         (change)="onChange($event)"
 25:         [disabled]="disabled"
 26:         [attr.aria-label]="ariaLabel"
 27:         [attr.aria-describedby]="helpTextId"
 28:         [attr.aria-invalid]="hasError"
 29:         [attr.required]="required"
 30:         [attr.aria-required]="required"
 31:         class="form-input"
 32:         [class.is-error]="hasError"
 33:         [class.is-success]="isSuccess"
 34:       />
 35:       @if (helpText) {
 36:         <p [id]="helpTextId" class="help-text">{{ helpText }}</p>
 37:       }
 38:       @if (hasError) {
 39:         <p
 40:           [id]="errorId"
 41:           role="alert"
 42:           class="error-message"
 43:           aria-live="polite"
 44:         >
 45:           {{ errorMessage }}
 46:         </p>
 47:       }
 48:     </div>
 49:   `,
 50: })
 51: export class FormInputComponent {
 52:   @Input() label: string = '';
 53:   @Input() type: string = 'text';
 54:   @Input() value: string = '';
 55:   @Input() required: boolean = false;
 56:   @Input() disabled: boolean = false;
 57:   @Input() ariaLabel: string = '';
 58:   @Input() helpText: string = '';
 59:   @Input() hasError: boolean = false;
 60:   @Input() isSuccess: boolean = false;
 61:   @Input() errorMessage: string = '';
 62:   inputId = `input-${Math.random().toString(36).substr(2, 9)}`;
 63:   helpTextId = `help-${this.inputId}`;
 64:   errorId = `error-${this.inputId}`;
 65:   onChange(event: Event) {
 66:     // Handle input change
 67:   }
 68: }
 69: // ===== BUTTON COMPONENTS ===== //
 70: /**
 71:  * Accessible Button with ARIA patterns
 72:  * Usage: <app-button aria-label="Submit form" (click)="submit()">Submit</app-button>
 73:  */
 74: @Component({
 75:   selector: 'app-button',
 76:   template: `
 77:     <button
 78:       [attr.aria-label]="ariaLabel"
 79:       [attr.aria-pressed]="ariaPressed"
 80:       [attr.aria-disabled]="disabled"
 81:       [disabled]="disabled"
 82:       [class.btn]="true"
 83:       [class.is-loading]="isLoading"
 84:     >
 85:       @if (!isLoading) {
 86:         <span>{{ label }}</span>
 87:       }
 88:       @if (isLoading) {
 89:         <span aria-live="polite" aria-atomic="true">Loading...</span>
 90:       }
 91:     </button>
 92:   `,
