<file path="techito/src/app/features/intranet/empleo/empresa/services/empresa.service.ts">
  1: import { Injectable, inject } from '@angular/core';
  2: import { HttpClient, HttpParams } from '@angular/common/http';
  3: import { forkJoin, of } from 'rxjs';
  4: import { map, switchMap } from 'rxjs/operators';
  5: import { environment } from '\.\./\.\./\.\./\.\./\.\./\.\./environments/environment';
  6: import { ApplicationApi, Candidato, EmpresaDashboard, Oferta, OfferApi, PagedResult } from '../models/empresa.models';
  7: @Injectable({ providedIn: 'root' })
  8: export class EmpresaService {
  9:   private readonly http = inject(HttpClient);
 10:   private readonly baseUrl = `${environment.apiUrl}`;
 11:   private mapOffer(item: OfferApi): Oferta {
 12:     return {
 13:       id: item.Id,
 14:       titulo: item.Titulo,
 15:       empresa: item.Empresa,
 16:       salario: `${item.Salario}`,
 17:       ubicacion: item.Ubicacion,
 18:       modalidad: this.mapModalidad(item.Modalidad),
 19:       estado: this.mapOfferStatus(item.Estado),
 20:       fechaPublicacion: item.FechaPublicacion,
 21:       candidatos: 0,
 22:     };
 23:   }
 24:   private mapCandidate(item: ApplicationApi): Candidato {
 25:     return {
 26:       id: item.Id,
 27:       ofertaId: item.OfertaId,
 28:       juniorId: item.JuniorId,
 29:       nombreJunior: item.NombreJunior,
 30:       nombre: item.NombreJunior,
 31:       emailJunior: item.EmailJunior,
 32:       puesto: '',
 33:       estado: this.mapApplicationStatus(item.Estado),
 34:       fechaSolicitud: item.FechaSolicitud,
 35:       fecha: item.FechaSolicitud,
 36:     };
 37:   }
 38:   private mapOfferStatus(status: number): string {
 39:     if (status === 1) return 'Activa';
 40:     if (status === 2) return 'Cerrada';
 41:     return 'Borrador';
 42:   }
 43:   private mapApplicationStatus(status: number): string {
 44:     if (status === 1) return 'entrevista';
 45:     if (status === 2) return 'rechazado';
 46:     if (status === 3) return 'oferta';
 47:     return 'pendiente';
 48:   }
 49:   private mapModalidad(modalidad: number): string {
 50:     if (modalidad === 1) return 'Hybrid';
 51:     if (modalidad === 2) return 'On-site';
 52:     return 'Remote';
 53:   }
 54:   getDashboard() {
 55:     return this.getOfertas(1, 6).pipe(
 56:       switchMap((offersResult) => {
 57:         const latestOffers = offersResult.items.slice(0, 3);
 58:         if (latestOffers.length === 0) {
 59:           return of({
 60:             nombreEmpresa: 'TechRiders Company',
 61:             stats: { ofertasActivas: 0, candidatosTotal: 0, enProceso: 0, contratados: 0 },
 62:             ultimasOfertas: [],
 63:             ultimosCandidatos: [],
 64:           } satisfies EmpresaDashboard);
 65:         }
 66:         return forkJoin(latestOffers.map((offer) => this.getCandidatos(offer.id))).pipe(
 67:           map((candidatesByOffer) => {
 68:             const allCandidates = candidatesByOffer.flat();
 69:             return {
 70:               nombreEmpresa: latestOffers[0]?.empresa ?? 'TechRiders Company',
 71:               stats: {
 72:                 ofertasActivas: offersResult.items.filter((offer) => offer.estado === 'Activa').length,
 73:                 candidatosTotal: allCandidates.length,
 74:                 enProceso: allCandidates.filter((candidate) => candidate.estado === 'entrevista').length,
 75:                 contratados: allCandidates.filter((candidate) => candidate.estado === 'oferta').length,
 76:               },
 77:               ultimasOfertas: latestOffers,
 78:               ultimosCandidatos: allCandidates.slice(0, 5),
 79:             } satisfies EmpresaDashboard;
 80:           })
 81:         );
 82:       })
 83:     );
 84:   }
 85:   getOfertas(page = 1, pageSize = 50, estado?: string, modalidad?: string) {
 86:     let params = new HttpParams()
 87:       .set('page', String(page))
 88:       .set('pageSize', String(pageSize));
 89:     if (estado) {
 90:       params = params.set('estado', estado);
 91:     }
 92:     if (modalidad) {
 93:       params = params.set('modalidad', modalidad);
 94:     }
 95:     return this.http.get<OfferApi[]>(`${this.baseUrl}/offers`, { params }).pipe(
 96:       map((items) => {
 97:         const mappedItems = (items ?? []).map((item) => this.mapOffer(item));
 98:         return {
 99:           items: mappedItems,
100:           totalCount: mappedItems.length,
101:           page,
102:           pageSize,
103:           totalPages: 1,
104:           hasNextPage: false,
105:           hasPreviousPage: false,
106:         } satisfies PagedResult<Oferta>;
107:       })
108:     );
109:   }
110:   getCandidatos(ofertaId: string) {
111:     return this.http.get<ApplicationApi[]>(`${this.baseUrl}/applications/offer/${ofertaId}`).pipe(
112:       map((items) => (items ?? []).map((item) => this.mapCandidate(item)))
113:     );
114:   }
115:   getCandidatosGovernance() {
116:     return of([] as Candidato[]);
117:   }
118:   updateCandidaturaEstado(candidaturaId: string, estado: string) {
119:     if (estado === 'entrevista') {
120:       return this.http.post<void>(`${this.baseUrl}/applications/${candidaturaId}/advance`, {});
121:     }
122:     if (estado === 'rechazado') {
123:       return this.http.post<void>(`${this.baseUrl}/applications/${candidaturaId}/reject`, {});
124:     }
125:     if (estado === 'oferta') {
126:       return this.http.post<void>(`${this.baseUrl}/applications/${candidaturaId}/hire`, {});
127:     }
128:     return of(void 0);
129:   }
130:   createOferta(oferta: { titulo: string; empresa: string; salario: string; ubicacion: string; modalidad: string; }) {
131:     return this.http.post<string>(`${this.baseUrl}/offers`, oferta);
132:   }
133:   enviarSolicitud(ofertaId: string, juniorId: string, nombreJunior: string, emailJunior: string) {
134:     return this.http.post(`${this.baseUrl}/applications`, {
135:       ofertaId,
136:       juniorId,
137:       nombreJunior,
138:       emailJunior,
139:       cartaPresentacion: null,
140:     });
141:   }
142: }
</file>

