352: # RUN Start-Process -Wait -FilePath 'msiexec.exe' -ArgumentList '/i', 'C:\Installers\your-package.msi', '/quiet', '/norestart'
353: 
354: # Register assemblies in GAC if needed (uncomment and modify as needed)
355: # COPY ./assemblies C:/Assemblies
356: # RUN C:\Windows\Microsoft.NET\Framework64\v4.0.30319\gacutil -i C:/Assemblies/YourAssembly.dll
357: 
358: # Register COM components if needed (uncomment and modify as needed)
359: # COPY ./com-components C:/Components
360: # RUN regsvr32 /s C:/Components/YourComponent.dll
361: 
362: # Add registry keys if needed (uncomment and modify as needed)
363: # RUN New-Item -Path 'HKLM:\Software\YourApp' -Force; `
364: #     Set-ItemProperty -Path 'HKLM:\Software\YourApp' -Name 'Setting' -Value 'Value'
365: 
366: # Configure IIS settings if needed (uncomment and modify as needed)
367: # RUN Import-Module WebAdministration; `
368: #     Set-ItemProperty 'IIS:\AppPools\DefaultAppPool' -Name somePropertyName -Value 'SomePropertyValue'; `
369: #     Set-ItemProperty 'IIS:\Sites\Default Web Site' -Name anotherPropertyName -Value 'AnotherPropertyValue'
370: 
371: # Expose necessary ports - By default, IIS uses port 80
372: EXPOSE 80
373: # EXPOSE 443  # Uncomment if using HTTPS
374: 
375: # Copy LogMonitor from the microsoft/windows-container-tools repository
376: WORKDIR /LogMonitor
377: RUN curl -fSLo LogMonitor.exe https://github.com/microsoft/windows-container-tools/releases/download/v2.1.1/LogMonitor.exe
378: 
379: # Copy LogMonitorConfig.json from local files
380: COPY LogMonitorConfig.json .
381: 
382: # Set non-administrator user
383: USER ContainerUser
384: 
385: # Override the container's default entry point to take advantage of the LogMonitor
386: ENTRYPOINT [ "C:\\LogMonitor\\LogMonitor.exe", "C:\\ServiceMonitor.exe", "w3svc" ]
387: ```
388: 
389: ## Adapting this Example
390: 
391: **Note:** Customize this template based on the specific requirements in the containerization settings. 
392: 
393: When adapting this example Dockerfile:
