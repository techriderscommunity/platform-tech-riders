  8: using TechRiders.Infrastructure.Data;
  9: using TechRiders.Infrastructure.Extensions;
 10: var builder = WebApplication.CreateBuilder(args);
 11: const string AzureAdScheme = "AzureAd";
 12: const string LocalJwtScheme = JwtBearerDefaults.AuthenticationScheme;
 13: // =====================================================================
 14: // CONFIGURACIÓN DE SERVICIOS - Dependency Injection
 15: // =====================================================================
 16: var localJwtSigningKey = builder.Configuration["LocalAuth:SigningKey"] ?? "techriders-local-auth-signing-key-2025";
 17: var authenticationBuilder = builder.Services.AddAuthentication(options =>
 18: {
 19:     options.DefaultScheme = LocalJwtScheme;
 20:     options.DefaultAuthenticateScheme = LocalJwtScheme;
 21:     options.DefaultChallengeScheme = LocalJwtScheme;
 22: });
 23: authenticationBuilder
 24:     .AddJwtBearer(LocalJwtScheme, options =>
 25:     {
 26:         options.RequireHttpsMetadata = false;
 27:         options.SaveToken = true;
 28:         options.TokenValidationParameters = new TokenValidationParameters
 29:         {
 30:             ValidateIssuer = true,
 31:             ValidateAudience = true,
 32:             ValidateLifetime = true,
 33:             ValidateIssuerSigningKey = true,
 34:             ValidIssuer = builder.Configuration["LocalAuth:Issuer"] ?? "TechRidersLocalAuth",
 35:             ValidAudience = builder.Configuration["LocalAuth:Audience"] ?? "TechRidersApi",
 36:             IssuerSigningKey = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(localJwtSigningKey)),
 37:             ClockSkew = TimeSpan.FromMinutes(1)
 38:         };
 39:     })
 40:     .AddMicrosoftIdentityWebApi(builder.Configuration.GetSection("AzureAd"), jwtBearerScheme: AzureAdScheme)
 41:         .EnableTokenAcquisitionToCallDownstreamApi()
 42:             .AddMicrosoftGraph(builder.Configuration.GetSection("MicrosoftGraph"))
 43:             .AddInMemoryTokenCaches();
 44: // 2. Configuración de servicios de infraestructura (DbContext con pooling, repositorios)
 45: builder.Services.AddInfrastructureServices(builder.Configuration);
 46: // 3. Configuración de servicios de aplicación (servicios de negocio, Mapster)
 47: builder.Services.AddApplicationServices();
 48: // 4. Configuración de Controllers con validación de modelo automática
 49: builder.Services.AddControllers(options =>
 50: {
 51:     // Deshabilitar validación automática para manejarla manualmente si es necesario
 52:     // options.SuppressModelStateInvalidFilter = false;
 53: })
 54: .AddJsonOptions(options =>
 55: {
 56:     // Configuración JSON para APIs
 57:     options.JsonSerializerOptions.PropertyNamingPolicy = null; // Mantener PascalCase
 58:     options.JsonSerializerOptions.WriteIndented = true; // JSON legible en desarrollo
 59: });
 60: // 5. Configuración de CORS (Cross-Origin Resource Sharing)
 61: builder.Services.AddCors(options =>
 62: {
 63:     options.AddPolicy("AllowAll", policy =>
 64:     {
 65:         policy.AllowAnyOrigin()
 66:               .AllowAnyMethod()
 67:               .AllowAnyHeader();
 68:     });
 69:     options.AddPolicy("Production", policy =>
 70:     {
 71:         policy.WithOrigins(builder.Configuration.GetSection("AllowedOrigins").Get<string[]>() ?? [])
 72:               .AllowAnyMethod()
 73:               .AllowAnyHeader()
 74:               .AllowCredentials();
 75:     });
 76: });
 77: // 6. Configuración de Swagger mejorado con documentación completa
 78: builder.Services.AddSwaggerDocumentation();
 79: // 7. Configuración de Health Checks
 80: var useInMemoryDatabase = bool.TryParse(builder.Configuration["Database:UseInMemory"], out var useInMemoryParsed)
 81:     && useInMemoryParsed;
 82: var healthChecks = builder.Services.AddHealthChecks();
 83: if (!useInMemoryDatabase)
 84: {
 85:     healthChecks.AddDbContextCheck<TechRiders.Infrastructure.Data.TechRidersDbContext>();
 86: }
 87: // 8. Configuración de compresión de respuestas
 88: builder.Services.AddResponseCompression(options =>
 89: {
 90:     options.EnableForHttps = true;
 91: });
 92: // 9. Configuración de caché
 93: builder.Services.AddMemoryCache();
 94: builder.Services.AddResponseCaching();
 95: // =====================================================================
 96: // CONSTRUCCIÓN DE LA APLICACIÓN
 97: // =====================================================================
 98: var app = builder.Build();
 99: // =====================================================================
100: // CONFIGURACIÓN DEL PIPELINE HTTP - Middleware
101: // =====================================================================
102: // 1. Manejo de excepciones y errores
103: if (app.Environment.IsDevelopment())
104: {
105:     app.UseDeveloperExceptionPage();
106: }
107: else
108: {
109:     app.UseExceptionHandler("/error");
110:     app.UseHsts(); // HTTP Strict Transport Security
111: }
112: // 2. Swagger - Disponible en todos los entornos
113: app.UseSwaggerDocumentation();
114: // 3. Redirección HTTPS
115: app.UseHttpsRedirection();
116: // 4. Archivos estáticos (para custom CSS de Swagger)
117: app.UseStaticFiles();
118: // 5. Routing
119: app.UseRouting();
120: // 6. CORS - Debe ir después de UseRouting y antes de UseAuthorization
121: app.UseCors(app.Environment.IsDevelopment() ? "AllowAll" : "Production");
122: // 7. Autenticación y Autorización
123: app.UseAuthentication();
124: app.UseAuthorization();
125: // 8. Compresión y caché de respuestas
126: app.UseResponseCompression();
127: app.UseResponseCaching();
128: // 9. Mapeo de endpoints
129: app.MapControllers();
130: // 10. Health checks endpoint
131: app.MapHealthChecks("/health");
132: // =====================================================================
133: // INICIALIZACIÓN Y EJECUCIÓN
134: // =====================================================================
135: // Inicialización de la base de datos al arrancar la API.
136: // Este proyecto usa un flujo code-first con Entity Framework Core: el modelo C# define el esquema
137: // y todas las bases relacionales se gestionan con migraciones.
138: using (var scope = app.Services.CreateScope())
139: {
140:     var dbContext = scope.ServiceProvider.GetRequiredService<TechRidersDbContext>();
141:     var configuration = scope.ServiceProvider.GetRequiredService<IConfiguration>();
142:     var logger = scope.ServiceProvider.GetRequiredService<ILoggerFactory>().CreateLogger("Startup");
143:     if (dbContext.Database.IsRelational())
144:     {
145:         var canConnect = dbContext.Database.CanConnect();
146:         if (!canConnect)
147:         {
148:             dbContext.Database.Migrate();
149:             app.Logger.LogInformation("La base de datos relacional no existía y se aplicaron las migraciones pendientes.");
150:         }
151:         else
152:         {
153:             dbContext.Database.Migrate();
154:             app.Logger.LogInformation("Base de datos relacional detectada, conectada y validada con migraciones code-first.");
155:         }
156:     }
157:     else
158:     {
159:         dbContext.Database.EnsureCreated();
160:         app.Logger.LogInformation("Base de datos en memoria creada con EnsureCreated().");
161:     }
162:     await LocalAuthService.EnsureDefaultAdminAsync(dbContext, configuration, logger);
163: }
164: // Logging de inicio
165: app.Logger.LogInformation("TechRiders API iniciando...");
166: app.Logger.LogInformation("Entorno: {Environment}", app.Environment.EnvironmentName);
167: app.Logger.LogInformation("Swagger UI disponible en: /swagger");
168: app.Run();
169: public partial class Program { }
