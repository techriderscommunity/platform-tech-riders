<file path="templates/ci.yml.template">
 1: name: CI
 2: 
 3: on:
 4:   push:
 5:     branches: [main, develop]
 6:   pull_request:
 7:     branches: [main, develop]
 8: 
 9: jobs:
10:   validate:
11:     runs-on: ubuntu-latest
12:     
13:     steps:
14:       - uses: actions/checkout@v4
15:       
16:       - name: Check structure
17:         run: |
18:           # Verify critical files exist
19:           files=("README.md" "LICENSE" ".github/CODEOWNERS")
20:           for file in "${files[@]}"; do
21:             if [ ! -f "$file" ]; then
22:               echo "❌ Missing: $file"
23:               exit 1
24:             fi
25:             echo "✅ Present: $file"
26:           done
27:       
28:       - name: Validate README
29:         run: |
30:           # Check README has required sections
31:           if ! grep -q "## Overview" README.md; then
32:             echo "❌ README missing '## Overview' section"
33:             exit 1
34:           fi
35:           if ! grep -q "## Quick Start" README.md; then
36:             echo "❌ README missing '## Quick Start' section"
37:             exit 1
38:           fi
39:           echo "✅ README structure valid"
40:       
41:       - name: Check License
42:         run: |
43:           if ! grep -q "MIT License" LICENSE; then
44:             echo "⚠️ License doesn't mention MIT"
45:           fi
46:           echo "✅ License file present"
47: 
48:   lint:
49:     runs-on: ubuntu-latest
50:     
51:     steps:
52:       - uses: actions/checkout@v4
53:       
54:       - name: Markdown lint
55:         uses: nosborn/github-action-markdown-cli@v3.3.0
56:         with:
57:           files: .
58:           config_file: .markdownlint.json
59:         continue-on-error: true
60: 
61:   security:
62:     runs-on: ubuntu-latest
63:     
64:     steps:
65:       - uses: actions/checkout@v4
66:       
67:       - name: Run Trivy scanner
68:         uses: aquasecurity/trivy-action@master
69:         with:
70:           scan-type: 'fs'
71:           scan-ref: '.'
72:           severity: 'MEDIUM,HIGH,CRITICAL'
73:         continue-on-error: true
</file>

