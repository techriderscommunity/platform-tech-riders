<file path="techito/src/app/features/calendario-publico/calendario-publico.ts">
  1: import { ChangeDetectionStrategy, Component, DestroyRef, OnInit, computed, inject, signal } from '@angular/core';
  2: import { RouterLink } from '@angular/router';
  3: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
  4: import { catchError, EMPTY, tap } from 'rxjs';
  5: import { UiTextField } from '@shared/ui/text-field/text-field';
  6: import { UiMetricsStrip } from '@shared/ui/metrics-strip/metrics-strip';
  7: import { UiResourceCardItem, UiResourceCards } from '@shared/ui/resource-cards/resource-cards';
  8: import {
  9:   PUBLIC_EVENT_MODALITIES,
 10:   PUBLIC_EVENT_TOPICS,
 11:   PUBLIC_EVENT_TYPES,
 12:   PublicEvent,
 13: } from './models/public-event.model';
 14: import { PublicEventsService } from './services/public-events.service';
 15: @Component({
 16:   selector: 'app-calendario-publico',
 17:   standalone: true,
 18:   changeDetection: ChangeDetectionStrategy.OnPush,
 19:   imports: [RouterLink, UiTextField, UiMetricsStrip, UiResourceCards],
 20:   templateUrl: './calendario-publico.html',
 21:   styleUrl: './calendario-publico.scss'
 22: })
 23: export class CalendarioPublico implements OnInit {
 24:   private readonly publicEventsService = inject(PublicEventsService);
 25:   private readonly destroyRef = inject(DestroyRef);
 26:   readonly events = signal<PublicEvent[]>([]);
 27:   readonly loading = signal(false);
 28:   readonly types = PUBLIC_EVENT_TYPES;
 29:   readonly modalities = PUBLIC_EVENT_MODALITIES;
 30:   readonly topics = PUBLIC_EVENT_TOPICS;
 31:   readonly selectedType = signal('');
 32:   readonly selectedModality = signal('');
 33:   readonly selectedTopic = signal('');
 34:   readonly searchText = signal('');
 35:   readonly filteredEvents = computed(() => {
 36:     const query = this.searchText().trim().toLowerCase();
 37:     return this.events().filter((event) => {
 38:       const byType = !this.selectedType() || event.type === this.selectedType();
 39:       const byModality = !this.selectedModality() || event.modality === this.selectedModality();
 40:       const byTopic = !this.selectedTopic() || event.topic === this.selectedTopic();
 41:       const bySearch = !query
 42:         || event.title.toLowerCase().includes(query)
 43:         || event.summary.toLowerCase().includes(query)
 44:         || event.place.toLowerCase().includes(query);
 45:       return byType && byModality && byTopic && bySearch;
 46:     });
 47:   });
 48:   readonly metrics = computed(() => [
 49:     { icon: '📅', value: String(this.filteredEvents().length), label: 'Eventos filtrados' },
 50:     { icon: '🧭', value: String(this.types.length), label: 'Tipos de actividad' },
 51:     { icon: '🌍', value: 'Abierto', label: 'Acceso para comunidad' },
 52:   ]);
 53:   readonly activeFilterLabel = computed(() => {
 54:     const labels = [this.selectedType(), this.selectedModality(), this.selectedTopic()].filter(Boolean);
 55:     return labels.length ? labels.join(' · ') : 'Todos';
 56:   });
 57:   readonly eventCards = computed<UiResourceCardItem[]>(() => this.filteredEvents().map((event) => ({
 58:     mode: event.type,
 59:     title: event.title,
 60:     summary: event.summary,
 61:     tags: [event.topic, event.modality],
 62:     meta: `${this.formatDate(event.date)} · ${event.place}`,
 63:     ctaLabel: 'Ver detalles y registro',
 64:     ctaHref: event.url
 65:   })));
 66:   private readonly dateFormatter = new Intl.DateTimeFormat('es-ES', {
 67:     day: '2-digit',
 68:     month: 'short',
 69:     year: 'numeric'
 70:   });
 71:   ngOnInit(): void {
 72:     this.loading.set(true);
 73:     this.publicEventsService
 74:       .getUpcomingEvents()
 75:       .pipe(
 76:         tap((events) => {
 77:           this.events.set(events);
 78:           this.loading.set(false);
 79:         }),
 80:         catchError(() => {
 81:           this.events.set([]);
 82:           this.loading.set(false);
 83:           return EMPTY;
 84:         }),
 85:         takeUntilDestroyed(this.destroyRef)
 86:       )
 87:       .subscribe();
 88:   }
 89:   setType(type: string): void {
 90:     this.selectedType.set(type);
 91:   }
 92:   setModality(modality: string): void {
 93:     this.selectedModality.set(modality);
 94:   }
 95:   setTopic(topic: string): void {
 96:     this.selectedTopic.set(topic);
 97:   }
 98:   updateSearch(value: string): void {
 99:     this.searchText.set(value);
100:   }
101:   clearFilters(): void {
102:     this.selectedType.set('');
103:     this.selectedModality.set('');
104:     this.selectedTopic.set('');
105:     this.searchText.set('');
106:   }
107:   private formatDate(dateText: string): string {
108:     const date = new Date(dateText);
109:     return Number.isNaN(date.getTime()) ? dateText : this.dateFormatter.format(date);
110:   }
111: }
</file>

