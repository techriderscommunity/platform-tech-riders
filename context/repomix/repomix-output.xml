<file path="techito/src/app/features/intranet/staff/admin-staff.ts">
  1: import { ChangeDetectionStrategy, Component, DestroyRef, computed, inject, signal } from '@angular/core';
  2: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
  3: import { RouterLink } from '@angular/router';
  4: import { UiButton  } from '@shared/ui/button/button';
  5: import { catchError, finalize } from 'rxjs/operators';
  6: import { of } from 'rxjs';
  7: import { StaffItem } from './models/staff-governance.models';
  8: import { StaffGovernanceService } from './services/staff-governance.service';
  9: @Component({
 10:   selector: 'app-admin-staff',
 11:   standalone: true,
 12:   changeDetection: ChangeDetectionStrategy.OnPush,
 13:   imports: [RouterLink, UiButton],
 14:   templateUrl: './admin-staff.html',
 15:   styleUrl: './admin-staff.scss'
 16: })
 17: export class AdminStaff {
 18:   private readonly staffGovernanceService = inject(StaffGovernanceService);
 19:   private readonly destroyRef = inject(DestroyRef);
 20:   readonly feedback = signal<string | null>(null);
 21:   readonly loading = signal(false);
 22:   readonly savingUserId = signal<string | null>(null);
 23:   readonly roleCatalog = signal<string[]>([]);
 24:   readonly staff = signal<StaffItem[]>([]);
 25:   readonly activeCount = computed(() => this.staff().filter(s => s.estado === 'activo').length);
 26:   readonly superAdminCount = computed(() => this.staff().filter(s => s.roles.includes('superadmin') && s.estado === 'activo').length);
 27:   constructor() {
 28:     this.loadGovernanceData();
 29:   }
 30:   loadGovernanceData() {
 31:     this.loading.set(true);
 32:     this.staffGovernanceService.getGovernanceData()
 33:       .pipe(
 34:         catchError(() => {
 35:           this.feedback.set('No se pudo cargar el panel de gobierno. Revisa permisos superadmin.');
 36:           return of({ staff: [], roles: [] as string[] });
 37:         }),
 38:         finalize(() => this.loading.set(false)),
 39:         takeUntilDestroyed(this.destroyRef),
 40:       )
 41:       .subscribe(({ staff, roles }) => {
 42:         this.roleCatalog.set(roles);
 43:         this.staff.set(staff);
 44:       });
 45:   }
 46:   agregarStaff() {
 47:     this.feedback.set('Alta de usuario en iteración siguiente. En esta fase se habilita gobierno de roles y estado.');
 48:   }
 49:   onPrimaryRoleChange(id: string, event: Event) {
 50:     const selected = (event.target as HTMLSelectElement).value;
 51:     const member = this.staff().find(item => item.id === id);
 52:     if (!member || !selected) return;
 53:     const nextRoles = member.roles.includes(selected)
 54:       ? member.roles
 55:       : [...member.roles, selected];
 56:     this.saveRoles(member.id, selected, nextRoles);
 57:   }
 58:   toggleRole(id: string, role: string, checked: boolean) {
 59:     const member = this.staff().find(item => item.id === id);
 60:     if (!member) return;
 61:     let nextRoles = checked
 62:       ? Array.from(new Set([...member.roles, role]))
 63:       : member.roles.filter(current => current !== role);
 64:     if (!nextRoles.length) {
 65:       this.feedback.set('Un usuario debe mantener al menos un rol activo.');
 66:       return;
 67:     }
 68:     let nextPrimaryRole = member.rolPrincipal;
 69:     if (!nextRoles.includes(nextPrimaryRole)) {
 70:       nextPrimaryRole = nextRoles[0];
 71:     }
 72:     this.saveRoles(member.id, nextPrimaryRole, nextRoles);
 73:   }
 74:   desactivarStaff(id: string) {
 75:     const member = this.staff().find(item => item.id === id);
 76:     if (!member) return;
 77:     const actionLabel = member.estado === 'activo' ? 'desactivar' : 'reactivar';
 78:     if (!confirm(`Vas a ${actionLabel} a ${member.nombre}. ¿Confirmas?`)) {
 79:       return;
 80:     }
 81:     const active = member.estado !== 'activo';
 82:     this.savingUserId.set(id);
 83:     this.staffGovernanceService.updateEstado(id, active)
 84:       .pipe(
 85:         finalize(() => this.savingUserId.set(null)),
 86:         takeUntilDestroyed(this.destroyRef),
 87:       )
 88:       .subscribe({
 89:         next: () => {
 90:           this.staff.update(items =>
 91:             items.map(item => item.id === id ? { ...item, estado: active ? 'activo' : 'inactivo' } : item),
 92:           );
 93:           this.feedback.set(`Usuario ${active ? 'reactivado' : 'desactivado'} correctamente.`);
 94:         },
 95:         error: (error) => {
 96:           const message = error?.error?.error ?? 'No se pudo actualizar el estado del usuario.';
 97:           this.feedback.set(message);
 98:         },
 99:       });
100:   }
101:   isRoleAssigned(member: StaffItem, role: string): boolean {
102:     return member.roles.includes(role);
103:   }
104:   private saveRoles(id: string, primaryRole: string, roles: string[]) {
105:     this.savingUserId.set(id);
106:     this.staffGovernanceService.updateRoles(id, primaryRole, roles)
107:       .pipe(
108:         finalize(() => this.savingUserId.set(null)),
109:         takeUntilDestroyed(this.destroyRef),
110:       )
111:       .subscribe({
112:         next: () => {
113:           this.staff.update(items =>
114:             items.map(item => item.id === id ? { ...item, rolPrincipal: primaryRole, roles: [...roles] } : item),
115:           );
116:           this.feedback.set('Roles actualizados correctamente.');
117:         },
118:         error: (error) => {
119:           const message = error?.error?.error ?? 'No se pudieron actualizar los roles.';
120:           this.feedback.set(message);
121:           this.loadGovernanceData();
122:         },
123:       });
124:   }
125:   limpiarFeedback() {
126:     this.feedback.set(null);
127:   }
128: }
</file>

