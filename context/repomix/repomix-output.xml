166:     capability_name = str(capability.get("capability") or "").strip()
167:     if kind == "capability":
168:         base = f"{title} expone una capacidad del dominio {domain}"
169:         if capability_name:
170:             base += f" llamada {capability_name}"
171:         if agent:
172:             base += f", servida por el agente {agent}"
173:         if engine:
174:             base += f" sobre {engine}"
175:         return base + "."
176:     manifest_repo = str(manifest.get("repo") or title)
177:     return f"{manifest_repo} se proyecta en AutoDocs como contenido de tipo {kind} del dominio {domain} a traves del proveedor {provider}."
