 92: def _safe_resolve_under(package_root: Path, relative_path: str) -> Path | None:
 93:     package_root_resolved = package_root.resolve()
 94:     path = (package_root / relative_path).resolve()
 95:     try:
 96:         path.relative_to(package_root_resolved)
 97:     except Exception:
 98:         return None
 99:     return path
100: def _matches_extensions(path: Path, extensions: set[str] | None) -> bool:
101:     if extensions is None:
102:         return True
103:     return path.suffix.lower() in extensions
104: def _append_candidate(
105:     *,
106:     candidates: list[dict],
107:     seen: set[str],
108:     source: Path,
109:     package_root: Path,
110:     category: str,
111:     repo_name: str,
112:     package_name: str,
113:     capability: str,
114:     source_mode: str,
115: ) -> None:
116:     resolved = source.resolve()
117:     key = str(resolved).replace('\\', '/').lower() + '|' + capability
118:     if key in seen:
119:         return
120:     seen.add(key)
121:     try:
122:         relative = resolved.relative_to(package_root.resolve()).as_posix()
123:     except Exception:
124:         relative = resolved.name
125:     candidates.append(
126:         {
127:             'category': category,
128:             'repo': repo_name,
129:             'package_name': package_name,
130:             'source_path': resolved,
131:             'relative_source_path': relative,
132:             'capability': capability,
133:             'source_mode': source_mode,
134:         }
135:     )
136: def _collect_artifact_candidates(
137:     *,
138:     package_root: Path,
139:     contract: dict,
140:     category: str,
141:     repo_name: str,
142:     package_name: str,
143:     contract_keys: list[str],
144:     capability_keys: list[str],
145:     fallback_globs: list[str],
146:     extensions: set[str] | None,
147: ) -> list[dict]:
148:     candidates: list[dict] = []
149:     seen: set[str] = set()
150:     for key in contract_keys:
151:         for rel in _normalize_path_entries(contract.get(key, [])):
152:             path = _safe_resolve_under(package_root, rel)
153:             if path is None or (not path.is_file()) or (not _matches_extensions(path, extensions)):
154:                 continue
155:             _append_candidate(
156:                 candidates=candidates,
157:                 seen=seen,
158:                 source=path,
159:                 package_root=package_root,
160:                 category=category,
161:                 repo_name=repo_name,
162:                 package_name=package_name,
163:                 capability='default',
164:                 source_mode='contract',
165:             )
166:     capabilities = contract.get('capabilities', []) if isinstance(contract.get('capabilities', []), list) else []
167:     for cap in capabilities:
168:         if not isinstance(cap, dict):
169:             continue
170:         capability_id = str(cap.get('id', '')).strip() or 'default'
171:         for key in capability_keys:
172:             for rel in _normalize_path_entries(cap.get(key, [])):
173:                 path = _safe_resolve_under(package_root, rel)
174:                 if path is None or (not path.is_file()) or (not _matches_extensions(path, extensions)):
175:                     continue
176:                 _append_candidate(
177:                     candidates=candidates,
178:                     seen=seen,
179:                     source=path,
180:                     package_root=package_root,
181:                     category=category,
182:                     repo_name=repo_name,
183:                     package_name=package_name,
184:                     capability=capability_id,
185:                     source_mode='capability',
186:                 )
187:     for pattern in fallback_globs:
188:         for path in sorted(package_root.glob(pattern)):
189:             if (not path.is_file()) or (not _matches_extensions(path, extensions)):
190:                 continue
191:             _append_candidate(
192:                 candidates=candidates,
193:                 seen=seen,
194:                 source=path,
195:                 package_root=package_root,
196:                 category=category,
197:                 repo_name=repo_name,
198:                 package_name=package_name,
199:                 capability='default',
200:                 source_mode='discovered',
201:             )
202:     return candidates
203: def _artifact_target_path(*, repo_root: Path, candidate: dict, managed_prefix: str) -> Path:
204:     category = str(candidate.get('category', '')).strip()
205:     package_name = str(candidate.get('package_name', '')).strip()
206:     relative_source = str(candidate.get('relative_source_path', '')).strip() or Path(str(candidate.get('source_path'))).name
207:     source_path = Path(str(candidate.get('source_path')))
208:     if category == 'instructions':
209:         rel_hash = hashlib.sha1(relative_source.encode('utf-8')).hexdigest()[:8]
210:         file_name = f"{managed_prefix}{slug(package_name)}--{slug(relative_source)}-{rel_hash}.instructions.md"
211:         return repo_root / '.github' / 'instructions' / file_name
212:     managed_dir = f"{managed_prefix}{slug(package_name)}"
213:     relative_name = Path(relative_source).as_posix()
214:     category_roots = {
215:         'agents': repo_root / '.github' / 'agents',
216:         'skills': repo_root / '.github' / 'skills',
217:         'prompts': repo_root / '.github' / 'prompts',
218:         'specs': repo_root / 'specs',
219:         'evals': repo_root / 'observability' / 'evals' / 'boosts',
220:     }
221:     target_root = category_roots.get(category)
222:     if target_root is None:
223:         raise ValueError(f'Unsupported category: {category}')
224:     preferred = target_root / managed_dir / relative_name
225:     if preferred.suffix:
226:         return preferred
227:     return preferred / source_path.name
