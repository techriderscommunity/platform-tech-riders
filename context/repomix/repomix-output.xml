<file path="techito/src/app/features/intranet/empleo/junior/mis-ofertas/mis-ofertas.ts">
 1: import { ChangeDetectionStrategy, Component, DestroyRef, computed, inject, signal } from '@angular/core';
 2: import { FormsModule } from '@angular/forms';
 3: import { catchError, finalize, of } from 'rxjs';
 4: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
 5: import { JuniorService } from '../services/junior.service';
 6: import { OfertaJunior } from '../models/junior.models';
 7: import { UiSelect, UiSelectOption  } from '@shared/ui/select/select';
 8: import { UiButton  } from '@shared/ui/button/button';
 9: @Component({
10:   selector: 'app-mis-ofertas',
11:   standalone: true,
12:   changeDetection: ChangeDetectionStrategy.OnPush,
13:   imports: [FormsModule, UiSelect, UiButton],
14:   templateUrl: './mis-ofertas.html',
15:   styleUrl: './mis-ofertas.scss'
16: })
17: export class MisOfertas {
18:   private readonly juniorService = inject(JuniorService);
19:   private readonly destroyRef = inject(DestroyRef);
20:   readonly filtroActual = signal('todas');
21:   readonly ordenar = signal('recientes');
22:   readonly loading = signal(false);
23:   readonly error = signal<string | null>(null);
24:   readonly info = signal<string | null>(null);
25:   readonly ofertas = signal<OfertaJunior[]>([]);
26:   readonly ordenarOptions: UiSelectOption[] = [
27:     { label: 'Más Recientes', value: 'recientes' },
28:     { label: 'Mayor Compatibilidad', value: 'match' },
29:     { label: 'Mayor Salario', value: 'salario' }
30:   ];
31:   constructor() {
32:     this.loading.set(true);
33:     this.error.set(null);
34:     this.juniorService.getOfertas(1, 100)
35:       .pipe(
36:         catchError(() => {
37:           this.error.set('No se pudieron cargar las ofertas.');
38:           return of({ items: [] as OfertaJunior[] });
39:         }),
40:         finalize(() => this.loading.set(false)),
41:         takeUntilDestroyed(this.destroyRef)
42:       )
43:       .subscribe(result => {
44:         this.ofertas.set(result.items);
45:       });
46:   }
47:   readonly ofertasFiltradas = computed(() => {
48:     const filtro = this.filtroActual();
49:     const orden = this.ordenar();
50:     let resultado = filtro === 'todas' ? [...this.ofertas()] : this.ofertas().filter(o => o.estado === filtro);
51:     if (orden === 'salario') {
52:       resultado = [...resultado].sort((a, b) => {
53:         const minA = parseInt(a.salario.split('-')[0] ?? '0', 10);
54:         const minB = parseInt(b.salario.split('-')[0] ?? '0', 10);
55:         return minB - minA;
56:       });
57:     }
58:     return resultado;
59:   });
60:   guardarOferta(_: string) {
61:     // TODO: endpoint de guardado de oferta por junior.
62:   }
63:   enviarSolicitud(ofertaId: string) {
