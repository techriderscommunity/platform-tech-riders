<file path="techito/src/app/core/content/public-content.service.ts">
 1: import { Injectable, inject } from '@angular/core';
 2: import { HttpClient } from '@angular/common/http';
 3: import { Observable, catchError, of, shareReplay, map } from 'rxjs';
 4: import { environment } from '@env/environment';
 5: import { PublicContentPayload } from './public-content.models';
 6: import { PUBLIC_CONTENT_FALLBACK } from './public-content.fallback';
 7: @Injectable({ providedIn: 'root' })
 8: export class PublicContentService {
 9:   private readonly http = inject(HttpClient);
10:   private readonly baseUrl = `${environment.apiUrl}/publiccontent`;
11:   private readonly publicContentRequest$ = this.http
12:     .get<PublicContentPayload>(this.baseUrl)
13:     .pipe(
14:       map((payload) => this.normalizePayload(payload)),
15:       catchError(() => of(PUBLIC_CONTENT_FALLBACK)),
16:       shareReplay({ bufferSize: 1, refCount: true })
17:     );
18:   getPublicContent(): Observable<PublicContentPayload> {
19:     return this.publicContentRequest$;
20:   }
21:   private normalizePayload(payload?: Partial<PublicContentPayload> | null): PublicContentPayload {
22:     if (!payload) {
23:       return PUBLIC_CONTENT_FALLBACK;
24:     }
25:     const homeLooksMinimal =
26:       !payload.home ||
27:       !payload.home.stats ||
28:       payload.home.stats.length < 6 ||
29:       !payload.home.profilePanelCards ||
30:       payload.home.profilePanelCards.length < 5;
31:     const eventsLooksMinimal =
32:       !payload.events ||
33:       !payload.events.galleryGroups ||
34:       payload.events.galleryGroups.length < 3;
35:     if (homeLooksMinimal || eventsLooksMinimal) {
36:       return PUBLIC_CONTENT_FALLBACK;
37:     }
38:     return payload as PublicContentPayload;
39:   }
40: }
</file>

