 1: from __future__ import annotations
 2: import contextvars
 3: import secrets
 4: from dataclasses import dataclass, replace
 5: from datetime import datetime, timezone
 6: def utc_now() -> str:
 7:     return datetime.now(timezone.utc).isoformat()
 8: def new_trace_id() -> str:
 9:     # 16 bytes -> 32 lowercase hex chars, aligned with OTel expectations.
10:     return secrets.token_hex(16)
11: def new_span_id() -> str:
12:     # 8 bytes -> 16 lowercase hex chars, aligned with OTel expectations.
13:     return secrets.token_hex(8)
14: @dataclass(frozen=True)
15: class TelemetryContext:
16:     execution_id: str
17:     trace_id: str
18:     span_id: str
19:     parent_span_id: str | None
20:     request_id: str
21:     session_id: str
22:     correlation_id: str
23:     timestamp: str
24:     user: str | None = None
25:     provider: str | None = None
26:     model: str | None = None
27: _context_var: contextvars.ContextVar[TelemetryContext | None] = contextvars.ContextVar("telemetry_context", default=None)
28: def get_current_context() -> TelemetryContext | None:
29:     return _context_var.get()
30: def set_current_context(context: TelemetryContext | None) -> contextvars.Token[TelemetryContext | None]:
31:     return _context_var.set(context)
32: def reset_current_context(token: contextvars.Token[TelemetryContext | None]) -> None:
33:     _context_var.reset(token)
34: def new_execution_context(
35:     *,
36:     request_id: str,
37:     session_id: str,
38:     correlation_id: str,
39:     execution_id: str,
40:     user: str | None = None,
41:     provider: str | None = None,
42:     model: str | None = None,
43: ) -> TelemetryContext:
44:     root_span_id = new_span_id()
45:     return TelemetryContext(
46:         execution_id=execution_id,
47:         trace_id=new_trace_id(),
48:         span_id=root_span_id,
49:         parent_span_id=None,
50:         request_id=request_id,
51:         session_id=session_id,
52:         correlation_id=correlation_id,
53:         timestamp=utc_now(),
54:         user=user,
55:         provider=provider,
56:         model=model,
57:     )
58: def child_context(parent: TelemetryContext) -> TelemetryContext:
59:     return replace(
60:         parent,
61:         span_id=new_span_id(),
62:         parent_span_id=parent.span_id,
63:         timestamp=utc_now(),
64:     )
