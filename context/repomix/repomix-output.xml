  7: from uuid import NAMESPACE_URL
  8: from typing import Any
  9: class LangSmithExporter:
 10:     name = "langsmith"
 11:     def __init__(
 12:         self,
 13:         *,
 14:         api_key: str,
 15:         project: str,
 16:         endpoint: str | None = None,
 17:         workspace_id: str | None = None,
 18:         high_signal_only: bool = True,
 19:         min_span_duration_ms: float = 100.0,
 20:         emit_execution_summary: bool = True,
 21:     ) -> None:
 22:         self.api_key = api_key.strip()
 23:         self.project = project.strip()
 24:         self.endpoint = (endpoint or "").strip() or None
 25:         self.workspace_id = (workspace_id or "").strip() or None
 26:         self.high_signal_only = bool(high_signal_only)
 27:         self.min_span_duration_ms = max(0.0, float(min_span_duration_ms))
 28:         self.emit_execution_summary = bool(emit_execution_summary)
 29:         self._client: Any | None = None
 30:         self._usage_by_execution: dict[str, dict[str, float]] = defaultdict(dict)
 31:         self._execution_state: dict[str, dict[str, Any]] = defaultdict(dict)
 32:         if not self.api_key or not self.project:
 33:             raise ValueError("LangSmith exporter requires api_key and project")
 34:     def _update_execution_state(self, record: dict[str, Any], timestamp: datetime) -> None:
 35:         context = record.get("context", {})
 36:         payload = record.get("payload", {})
 37:         execution_id = str(context.get("execution_id") or "")
 38:         if not execution_id:
 39:             return
 40:         state = self._execution_state[execution_id]
 41:         state.setdefault("warnings", 0)
 42:         state.setdefault("errors", 0)
 43:         state.setdefault("operation", payload.get("operation"))
 44:         state.setdefault("provider", context.get("provider"))
 45:         state.setdefault("model", context.get("model"))
 46:         event_name = str(record.get("event_name", ""))
 47:         record_type = str(record.get("type", "event"))
 48:         level = str(record.get("level", "INFO")).upper()
 49:         if event_name == "ExecutionStarted":
 50:             started_at = payload.get("started_at") or record.get("timestamp")
 51:             state["started_at"] = self._parse_timestamp(started_at)
 52:             if payload.get("operation"):
 53:                 state["operation"] = payload.get("operation")
 54:         elif event_name == "RoutingResolved":
 55:             if payload.get("agent"):
 56:                 state["agent"] = payload.get("agent")
 57:             if payload.get("engine"):
 58:                 state["engine"] = payload.get("engine")
 59:         elif event_name in {"WarningGenerated"} or level == "WARNING":
 60:             state["warnings"] = int(state.get("warnings", 0)) + 1
 61:         elif event_name in {"ExceptionThrown"} or level == "ERROR":
 62:             state["errors"] = int(state.get("errors", 0)) + 1
 63:             if payload.get("error"):
 64:                 state["last_error"] = payload.get("error")
 65:         if record_type == "span":
 66:             status = str(payload.get("status", "OK")).upper()
 67:             if status != "OK":
 68:                 state["errors"] = int(state.get("errors", 0)) + 1
 69:             state["last_span_duration_ms"] = payload.get("duration_ms")
 70:     def _build_execution_summary(self, execution_id: str, context: dict[str, Any], timestamp: datetime) -> dict[str, Any]:
 71:         state = self._execution_state.get(execution_id, {})
 72:         started_at = state.get("started_at")
 73:         if isinstance(started_at, datetime):
 74:             duration_ms = max(0.0, (timestamp - started_at).total_seconds() * 1000.0)
 75:         else:
 76:             duration_ms = 0.0
 77:         warnings = int(state.get("warnings", 0))
 78:         errors = int(state.get("errors", 0))
 79:         status = "error" if errors > 0 else "ok"
 80:         usage = self._usage_by_execution.get(execution_id, {})
 81:         usage_summary = {
 82:             "input_tokens": int(usage.get("tokens_input", 0.0)),
 83:             "output_tokens": int(usage.get("tokens_output", 0.0)),
 84:             "total_tokens": int(usage.get("total_tokens", 0.0)),
 85:             "total_cost": float(usage.get("estimated_cost", 0.0)),
 86:         }
 87:         summary = {
 88:             "name": "ExecutionSummary",
 89:             "run_type": "chain",
 90:             "inputs": {
 91:                 "execution_id": execution_id,
 92:                 "operation": state.get("operation"),
 93:                 "agent": state.get("agent"),
 94:                 "engine": state.get("engine"),
 95:             },
 96:             "outputs": {
 97:                 "status": status,
 98:                 "duration_ms": duration_ms,
 99:                 "warning_count": warnings,
100:                 "error_count": errors,
101:                 "usage_metadata": usage_summary,
102:                 "provider": context.get("provider") or state.get("provider"),
103:                 "model": context.get("model") or state.get("model"),
104:             },
105:             "extra": {
106:                 "metadata": {
107:                     "execution_id": execution_id,
108:                     "telemetry_kind": "execution_summary",
109:                     "last_error": state.get("last_error"),
110:                     "usage_metadata": usage_summary,
111:                     "ls_provider": context.get("provider") or state.get("provider"),
112:                     "ls_model_name": context.get("model") or state.get("model"),
113:                 }
114:             },
115:             "id": self._to_uuid(f"{execution_id}:execution-summary", salt="run"),
116:             "start_time": started_at if isinstance(started_at, datetime) else timestamp,
117:             "end_time": timestamp,
118:             "total_tokens": usage_summary["total_tokens"],
119:             "total_cost": usage_summary["total_cost"],
120:             "tags": ["telemetry", "execution", "summary"],
121:         }
122:         return summary
123:     def _is_high_signal_record(self, record: dict[str, Any]) -> bool:
124:         record_type = str(record.get("type", "event"))
125:         event_name = str(record.get("event_name", "TelemetryEvent"))
126:         payload = record.get("payload", {})
127:         level = str(record.get("level", "INFO")).upper()
128:         if level in {"ERROR", "WARNING"}:
129:             return True
130:         if record_type == "metric":
131:             # Emit only the per-execution summary for usage/cost to avoid noise.
132:             return False
133:         if record_type == "span":
134:             duration_ms = float(payload.get("duration_ms") or 0.0)
135:             status = str(payload.get("status", "OK")).upper()
136:             return status != "OK" or duration_ms >= self.min_span_duration_ms
137:         return event_name in {
138:             "ExecutionStarted",
139:             "ExecutionFinished",
140:             "RoutingResolved",
141:             "ExceptionThrown",
142:             "WarningGenerated",
143:         }
144:     def _to_uuid(self, value: Any, *, salt: str = "") -> str | None:
145:         if value is None:
146:             return None
147:         raw = str(value).strip()
148:         if not raw:
149:             return None
150:         try:
151:             return str(UUID(raw))
152:         except Exception:
153:             try:
154:                 return str(UUID(hex=raw))
155:             except Exception:
156:                 return str(uuid5(NAMESPACE_URL, f"mcpee:{salt}:{raw}"))
157:     def _parse_timestamp(self, value: Any) -> datetime:
158:         if isinstance(value, datetime):
159:             return value.astimezone(timezone.utc)
160:         if isinstance(value, str) and value:
161:             try:
162:                 return datetime.fromisoformat(value).astimezone(timezone.utc)
163:             except Exception:
164:                 pass
165:         return datetime.now(timezone.utc)
166:     def _build_usage_summary(self, execution_id: str, context: dict[str, Any], timestamp: datetime) -> dict[str, Any]:
167:         usage = self._usage_by_execution.get(execution_id, {})
168:         model = context.get("model")
169:         provider = context.get("provider")
170:         input_tokens = int(usage.get("tokens_input", 0.0))
171:         output_tokens = int(usage.get("tokens_output", 0.0))
172:         total_tokens = int(usage.get("total_tokens", 0.0))
173:         total_cost = float(usage.get("estimated_cost", 0.0))
174:         usage_metadata = {
175:             "input_tokens": input_tokens,
176:             "output_tokens": output_tokens,
177:             "total_tokens": total_tokens,
178:             "total_cost": total_cost,
179:         }
180:         return {
181:             "name": "UsageSummary",
182:             "run_type": "llm",
183:             "inputs": {
184:                 "execution_id": execution_id,
185:                 "provider": provider,
186:                 "model": model,
187:             },
188:             "outputs": {
189:                 "model": model,
190:                 "provider": provider,
191:                 "usage_metadata": usage_metadata,
192:                 "status": "recorded",
193:             },
194:             "extra": {
195:                 "metadata": {
196:                     "execution_id": execution_id,
197:                     "trace_id": context.get("trace_id"),
198:                     "provider": provider,
199:                     "model": model,
200:                     "ls_provider": provider,
201:                     "ls_model_name": model,
202:                     "usage_metadata": usage_metadata,
203:                     "telemetry_kind": "usage_summary",
204:                 }
205:             },
206:             "id": self._to_uuid(f"{execution_id}:usage-summary", salt="run"),
207:             "start_time": timestamp,
208:             "end_time": timestamp,
209:             "prompt_tokens": input_tokens,
210:             "completion_tokens": output_tokens,
211:             "total_tokens": total_tokens,
212:             "total_cost": total_cost,
213:             "tags": ["telemetry", "usage", "cost"],
214:         }
215:     def _run_payload(self, record: dict[str, Any], *, index: int) -> dict[str, Any]:
216:         event_name = str(record.get("event_name", "TelemetryEvent"))
217:         context = record.get("context", {})
218:         payload = record.get("payload", {})
219:         record_type = str(record.get("type", "event"))
220:         level = str(record.get("level", "INFO"))
221:         execution_id = str(context.get("execution_id") or "")
222:         provider = context.get("provider")
223:         model = context.get("model")
224:         timestamp = self._parse_timestamp(record.get("timestamp"))
225:         inputs: dict[str, Any] = {"event": event_name, "type": record_type}
226:         outputs: dict[str, Any] = {"status": "recorded", "level": level}
227:         run_type = "chain"
228:         prompt_tokens: int | None = None
229:         completion_tokens: int | None = None
230:         total_tokens: int | None = None
231:         total_cost: float | None = None
232:         if record_type == "metric":
233:             metric_name = str(payload.get("name", "unknown"))
234:             metric_value = payload.get("value")
235:             metric_unit = payload.get("unit")
236:             inputs = {
237:                 "metric": metric_name,
238:                 "value": metric_value,
239:                 "unit": metric_unit,
240:                 "execution_id": execution_id,
241:             }
242:             outputs = {
243:                 "metric": metric_name,
244:                 "value": metric_value,
245:                 "unit": metric_unit,
246:                 "provider": provider,
247:                 "model": model,
248:                 "status": "recorded",
249:             }
250:             if metric_name in {"tokens_input", "tokens_output", "total_tokens", "estimated_cost"} and execution_id:
251:                 self._usage_by_execution[execution_id][metric_name] = float(metric_value or 0.0)
252:                 run_type = "llm"
253:                 if metric_name == "tokens_input":
254:                     prompt_tokens = int(float(metric_value or 0.0))
255:                 elif metric_name == "tokens_output":
256:                     completion_tokens = int(float(metric_value or 0.0))
257:                 elif metric_name == "total_tokens":
258:                     total_tokens = int(float(metric_value or 0.0))
259:                 elif metric_name == "estimated_cost":
260:                     total_cost = float(metric_value or 0.0)
261:         elif record_type == "span":
262:             run_type = "tool"
263:             inputs = {
264:                 "span": payload.get("name"),
265:                 "kind": payload.get("kind"),
266:                 "execution_id": execution_id,
267:             }
268:             outputs = {
269:                 "status": payload.get("status", "recorded"),
270:                 "duration_ms": payload.get("duration_ms"),
271:                 "error": payload.get("error"),
272:                 "provider": provider,
273:                 "model": model,
274:             }
275:         else:
276:             inputs = {
277:                 "event": event_name,
278:                 "operation": payload.get("operation"),
279:                 "execution_id": execution_id,
280:             }
281:             outputs = {
282:                 "status": payload.get("status", "recorded"),
283:                 "provider": provider,
284:                 "model": model,
285:             }
286:         metadata = {
287:             "execution_id": context.get("execution_id"),
288:             "trace_id": context.get("trace_id"),
289:             "span_id": context.get("span_id"),
290:             "parent_span_id": context.get("parent_span_id"),
291:             "request_id": context.get("request_id"),
292:             "session_id": context.get("session_id"),
293:             "correlation_id": context.get("correlation_id"),
294:             "user": context.get("user"),
295:             "provider": provider,
296:             "model": model,
297:             "ls_provider": provider,
298:             "ls_model_name": model,
299:             "event_name": event_name,
300:             "type": record_type,
301:             "level": level,
302:             "payload": payload,
303:         }
304:         if prompt_tokens is not None or completion_tokens is not None or total_tokens is not None or total_cost is not None:
305:             metadata["usage_metadata"] = {
306:                 "input_tokens": prompt_tokens or 0,
307:                 "output_tokens": completion_tokens or 0,
308:                 "total_tokens": total_tokens or 0,
309:                 "total_cost": total_cost or 0.0,
310:             }
311:         run_id = self._to_uuid(
312:             f"{execution_id or 'no-exec'}:{context.get('span_id') or 'no-span'}:{event_name}:{record_type}:{index}",
313:             salt="run",
314:         )
315:         run_payload: dict[str, Any] = {
316:             "name": event_name,
317:             "run_type": run_type,
318:             "inputs": inputs,
319:             "outputs": outputs,
320:             "project_name": self.project,
321:             "extra": {"metadata": metadata},
322:             "id": run_id,
323:             "start_time": timestamp,
324:             "end_time": timestamp,
325:             "tags": ["telemetry", record_type],
326:             "_usage_ready": record_type == "metric" and str(payload.get("name", "")) == "estimated_cost" and bool(execution_id),
327:             "_execution_id": execution_id,
328:             "_context": context,
329:         }
330:         if prompt_tokens is not None:
331:             run_payload["prompt_tokens"] = prompt_tokens
332:         if completion_tokens is not None:
333:             run_payload["completion_tokens"] = completion_tokens
334:         if total_tokens is not None:
335:             run_payload["total_tokens"] = total_tokens
336:         if total_cost is not None:
337:             run_payload["total_cost"] = total_cost
338:         return run_payload
339:     def _get_client(self) -> Any:
340:         if self._client is not None:
341:             return self._client
342:         try:
343:             from langsmith import Client  # type: ignore
344:         except Exception as exc:
345:             raise RuntimeError("langsmith SDK is not installed") from exc
346:         kwargs: dict[str, Any] = {"api_key": self.api_key}
347:         if self.endpoint:
348:             kwargs["api_url"] = self.endpoint
349:         if self.workspace_id:
350:             kwargs["workspace_id"] = self.workspace_id
351:         self._client = Client(**kwargs)
352:         return self._client
353:     def export(self, records: list[dict]) -> None:
354:         client = self._get_client()
355:         for index, record in enumerate(records):
356:             run = self._run_payload(record, index=index)
357:             usage_ready = bool(run.pop("_usage_ready", False))
358:             execution_id = str(run.pop("_execution_id", "") or "")
359:             context = run.pop("_context", {})
360:             timestamp = run["end_time"]
361:             self._update_execution_state(record, timestamp)
362:             should_emit = True
363:             if self.high_signal_only:
364:                 should_emit = self._is_high_signal_record(record)
365:             if should_emit:
366:                 client.create_run(**run)
367:             if usage_ready and execution_id:
368:                 summary = self._build_usage_summary(execution_id, context, run["end_time"])
369:                 client.create_run(project_name=self.project, **summary)
370:             event_name = str(record.get("event_name", ""))
371:             if self.emit_execution_summary and execution_id and event_name == "ExecutionFinished":
372:                 execution_summary = self._build_execution_summary(execution_id, context, timestamp)
373:                 client.create_run(project_name=self.project, **execution_summary)
374:     def flush(self) -> None:
375:         return
376:     def shutdown(self) -> None:
377:         return
