 1: import { ChangeDetectionStrategy, Component, DestroyRef, computed, inject, signal } from '@angular/core';
 2: import { ActivatedRoute, RouterLink } from '@angular/router';
 3: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
 4: import { map } from 'rxjs/operators';
 5: import { CommunityPartnersStore } from './services/community-partners.store';
 6: @Component({
 7:   selector: 'app-community-partner-detail',
 8:   standalone: true,
 9:   imports: [RouterLink],
10:   templateUrl: './community-partner-detail.html',
11:   styleUrl: './community-partner-detail.scss',
12:   changeDetection: ChangeDetectionStrategy.OnPush,
13: })
14: export class CommunityPartnerDetail {
15:   private readonly route = inject(ActivatedRoute);
16:   private readonly destroyRef = inject(DestroyRef);
17:   private readonly store = inject(CommunityPartnersStore);
18:   readonly partnerId = signal('');
19:   readonly partner = computed(() => {
20:     const id = this.partnerId();
21:     if (!id) {
22:       return undefined;
23:     }
24:     return this.store.findById(id);
25:   });
26:   constructor() {
27:     this.route.paramMap
28:       .pipe(
29:         map(params => params.get('id') ?? ''),
30:         takeUntilDestroyed(this.destroyRef),
31:       )
32:       .subscribe(id => this.partnerId.set(id));
33:   }
34:   onCardClick(): void {
35:     const current = this.partner();
