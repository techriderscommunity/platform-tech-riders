 14: 
 15: ## 1. Complete pyproject.toml
 16: 
 17: ### setuptools + setuptools_scm (recommended for git-tag versioning)
 18: 
 19: ```toml
 20: [build-system]
 21: requires = ["setuptools>=68", "wheel", "setuptools_scm"]
 22: build-backend = "setuptools.build_meta"
 23: 
 24: [project]
 25: name = "your-package"
 26: dynamic = ["version"]           # Version comes from git tags via setuptools_scm
 27: description = "<your description> — <key feature 1>, <key feature 2>"
 28: readme = "README.md"
 29: requires-python = ">=3.10"
 30: license = "MIT"                # PEP 639 SPDX expression (string, not {text = "MIT"})
 31: license-files = ["LICENSE"]
 32: authors = [
 33:     {name = "Your Name", email = "you@example.com"},
 34: ]
 35: maintainers = [
 36:     {name = "Your Name", email = "you@example.com"},
 37: ]
 38: keywords = [
 39:     "python",
 40:     # Add 10-15 specific keywords that describe your library — they affect PyPI discoverability
 41: ]
 42: classifiers = [
 43:     "Development Status :: 3 - Alpha",          # Change to 5 at stable release
 44:     "Intended Audience :: Developers",
 45:     "License :: OSI Approved :: MIT License",
 46:     "Operating System :: OS Independent",
 47:     "Programming Language :: Python :: 3",
 48:     "Programming Language :: Python :: 3.10",
 49:     "Programming Language :: Python :: 3.11",
 50:     "Programming Language :: Python :: 3.12",
 51:     "Programming Language :: Python :: 3.13",
 52:     "Topic :: Software Development :: Libraries :: Python Modules",
 53:     "Typing :: Typed",          # Add this when shipping py.typed
 54: ]
 55: dependencies = [
 56:     # List your runtime dependencies here. Keep them minimal.
 57:     # Example: "httpx>=0.24", "pydantic>=2.0"
 58:     # Leave empty if your library has no required runtime deps.
 59: ]
 60: 
 61: [project.optional-dependencies]
 62: redis = [
 63:     "redis>=4.2",               # Optional heavy backend
 64: ]
 65: dev = [
 66:     "pytest>=7.0",
 67:     "pytest-asyncio>=0.21",
 68:     "httpx>=0.24",
 69:     "pytest-cov>=4.0",
 70:     "ruff>=0.4",
 71:     "black>=24.0",
 72:     "isort>=5.13",
 73:     "mypy>=1.0",
 74:     "pre-commit>=3.0",
 75:     "build",
 76:     "twine",
 77: ]
 78: 
 79: [project.urls]
 80: Homepage      = "https://github.com/yourusername/your-package"
 81: Documentation = "https://github.com/yourusername/your-package#readme"
 82: Repository    = "https://github.com/yourusername/your-package"
 83: "Bug Tracker" = "https://github.com/yourusername/your-package/issues"
 84: Changelog     = "https://github.com/yourusername/your-package/blob/master/CHANGELOG.md"
 85: 
 86: # --- Setuptools configuration ---
 87: [tool.setuptools.packages.find]
 88: include = ["your_package*"]   # flat layout
 89: # For src/ layout, use:
 90: # where = ["src"]
 91: 
 92: [tool.setuptools.package-data]
 93: your_package = ["py.typed"]  # Ship the py.typed marker in the wheel
 94: 
 95: # --- setuptools_scm: version from git tags ---
 96: [tool.setuptools_scm]
 97: version_scheme = "post-release"
 98: local_scheme   = "no-local-version"  # Prevents +local suffix breaking PyPI uploads
 99: 
100: # --- Ruff (linting) ---
101: [tool.ruff]
102: target-version = "py310"
103: line-length    = 100
104: 
105: [tool.ruff.lint]
106: select = ["E", "F", "W", "I", "N", "UP", "B", "SIM", "C4", "PTH", "RUF"]
107: ignore = ["E501"]   # Line length enforced by formatter
108: 
109: [tool.ruff.lint.per-file-ignores]
110: "tests/*"   = ["S101", "ANN"]    # Allow assert and missing annotations in tests
111: "scripts/*" = ["T201"]           # Allow print in scripts
112: 
113: [tool.ruff.format]
114: quote-style = "double"
115: 
116: # --- Black (formatting) ---
117: [tool.black]
118: line-length    = 100
119: target-version = ["py310", "py311", "py312", "py313"]
120: 
121: # --- isort (import sorting) ---
122: [tool.isort]
123: profile     = "black"
124: line_length = 100
125: 
126: # --- mypy (static type checking) ---
127: [tool.mypy]
128: python_version         = "3.10"
129: warn_return_any        = true
130: warn_unused_configs    = true
131: warn_unused_ignores    = true
132: disallow_untyped_defs  = true
133: disallow_any_generics  = true
134: ignore_missing_imports = true
135: strict                 = false     # Set true for maximum strictness
136: 
137: [[tool.mypy.overrides]]
138: module = "tests.*"
139: disallow_untyped_defs = false     # Relaxed in tests
140: 
141: # --- pytest ---
142: [tool.pytest.ini_options]
143: asyncio_mode  = "auto"
144: testpaths     = ["tests"]
145: pythonpath    = ["."]          # For flat layout; remove for src/
146: python_files  = "test_*.py"
147: python_classes = "Test*"
148: python_functions = "test_*"
149: addopts       = "-v --tb=short --cov=your_package --cov-report=term-missing"
150: 
151: # --- Coverage ---
152: [tool.coverage.run]
153: source = ["your_package"]
154: omit   = ["tests/*"]
155: 
156: [tool.coverage.report]
157: fail_under   = 80
158: show_missing = true
159: exclude_lines = [
160:     "pragma: no cover",
161:     "def __repr__",
162:     "raise NotImplementedError",
163:     "if TYPE_CHECKING:",
164:     "@abstractmethod",
165: ]
166: ```
167: 
168: ---
169: 
170: ## 2. hatchling (Modern, Zero-Config)
171: 
172: Best for new pure-Python projects that don't need C extensions. No `setup.py` needed. Use
173: `hatch-vcs` for git-tag versioning, or omit it for manual version bumps.
174: 
175: ```toml
176: [build-system]
177: requires = ["hatchling", "hatch-vcs"]     # hatch-vcs for git-tag versioning
178: build-backend = "hatchling.build"
179: 
180: [project]
181: name = "your-package"
182: dynamic = ["version"]            # Remove and add version = "1.0.0" for manual versioning
183: description = "One-line description"
184: readme = "README.md"
185: requires-python = ">=3.10"
186: license = "MIT"
187: license-files = ["LICENSE"]
188: authors = [{name = "Your Name", email = "you@example.com"}]
189: keywords = ["python"]
190: classifiers = [
191:     "Development Status :: 3 - Alpha",
192:     "Intended Audience :: Developers",
193:     "License :: OSI Approved :: MIT License",
194:     "Operating System :: OS Independent",
195:     "Programming Language :: Python :: 3",
196:     "Typing :: Typed",
197: ]
198: dependencies = []
199: 
200: [project.optional-dependencies]
201: dev = ["pytest>=8.0", "pytest-cov>=5.0", "ruff>=0.6", "mypy>=1.10"]
202: 
203: [project.urls]
204: Homepage  = "https://github.com/yourusername/your-package"
205: Changelog = "https://github.com/yourusername/your-package/blob/master/CHANGELOG.md"
206: 
207: # --- Hatchling build config ---
208: [tool.hatch.build.targets.wheel]
209: packages = ["src/your_package"]    # src/ layout
210: # packages = ["your_package"]      # ← flat layout
211: 
212: [tool.hatch.version]
213: source = "vcs"                     # git-tag versioning via hatch-vcs
214: 
215: [tool.hatch.version.raw-options]
216: local_scheme = "no-local-version"
217: 
218: # ruff, mypy, pytest, coverage sections — same as setuptools template above
219: ```
220: 
221: ---
222: 
223: ## 3. flit (Minimal, Version from `__version__`)
224: 
225: Best for very simple, single-module packages. Zero config. Version is read directly from
226: `your_package/__init__.py`. Always requires a **static string** for `__version__`.
227: 
228: ```toml
229: [build-system]
230: requires = ["flit_core>=3.9"]
231: build-backend = "flit_core.buildapi"
232: 
233: [project]
234: name = "your-package"
235: dynamic = ["version", "description"]  # Read from __init__.py __version__ and docstring
236: readme = "README.md"
237: requires-python = ">=3.10"
238: license = "MIT"
239: authors = [{name = "Your Name", email = "you@example.com"}]
240: classifiers = [
241:     "License :: OSI Approved :: MIT License",
242:     "Programming Language :: Python :: 3",
243:     "Typing :: Typed",
244: ]
245: dependencies = []
246: 
247: [project.urls]
248: Homepage = "https://github.com/yourusername/your-package"
249: 
250: # flit reads __version__ from your_package/__init__.py automatically.
251: # Ensure __init__.py has: __version__ = "1.0.0"  (static string — flit does NOT support
252: # importlib.metadata for dynamic version discovery)
253: ```
254: 
255: ---
256: 
257: ## 4. poetry (Integrated Dependency + Build Manager)
258: 
259: Best for teams that want a single tool to manage deps, build, and publish. Poetry v2+
260: supports the standard `[project]` table.
261: 
262: ```toml
263: [build-system]
264: requires = ["poetry-core>=2.0"]
265: build-backend = "poetry.core.masonry.api"
266: 
267: [project]
268: name = "your-package"
269: version = "1.0.0"
270: description = "One-line description"
271: readme = "README.md"
272: requires-python = ">=3.10"
273: license = "MIT"
274: authors = [{name = "Your Name", email = "you@example.com"}]
275: classifiers = [
276:     "Programming Language :: Python :: 3",
277:     "Typing :: Typed",
278: ]
279: dependencies = []   # poetry v2+ uses standard [project] table
280: 
281: [project.optional-dependencies]
282: dev = ["pytest>=8.0", "ruff>=0.6", "mypy>=1.10"]
283: 
284: # Optional: use [tool.poetry] only for poetry-specific features
285: [tool.poetry.group.dev.dependencies]
286: # Poetry-specific group syntax (alternative to [project.optional-dependencies])
287: pytest = ">=8.0"
288: ```
289: 
290: ---
291: 
292: ## 5. Versioning Strategy
293: 
294: ### PEP 440 — The Standard
295: 
296: ```
297: Canonical form:  N[.N]+[{a|b|rc}N][.postN][.devN]
298: 
299: Examples:
300:   1.0.0          Stable release
301:   1.0.0a1        Alpha (pre-release)
302:   1.0.0b2        Beta
303:   1.0.0rc1       Release candidate
304:   1.0.0.post1    Post-release (e.g., packaging fix only — no code change)
305:   1.0.0.dev1     Development snapshot (NOT for PyPI)
306: ```
307: 
308: ### Semantic Versioning (SemVer) — use this for every library
309: 
310: ```
311: MAJOR.MINOR.PATCH
312: 
313: MAJOR: Breaking API change (remove/rename public function/class/arg)
314: MINOR: New feature, fully backward-compatible
315: PATCH: Bug fix, no API change
316: ```
317: 
318: | Change | What bumps | Example |
319: |---|---|---|
320: | Remove / rename a public function | MAJOR | `1.2.3 → 2.0.0` |
321: | Add new public function | MINOR | `1.2.3 → 1.3.0` |
322: | Bug fix, no API change | PATCH | `1.2.3 → 1.2.4` |
323: | New pre-release | suffix | `2.0.0a1`, `2.0.0rc1` |
324: 
325: ### Version in code — read from package metadata
326: 
327: ```python
328: # your_package/__init__.py
329: from importlib.metadata import version, PackageNotFoundError
330: 
331: try:
332:     __version__ = version("your-package")
333: except PackageNotFoundError:
334:     __version__ = "0.0.0-dev"    # Fallback for uninstalled dev checkouts
335: ```
336: 
337: Never hardcode `__version__ = "1.0.0"` when using setuptools_scm — it goes stale after the
338: first git tag. Use `importlib.metadata` always.
339: 
340: ### Version specifier best practices for dependencies
341: 
342: ```toml
343: # In [project] dependencies — for a LIBRARY:
344: "httpx>=0.24"            # Minimum version — PREFERRED for libraries
345: "httpx>=0.24,<1.0"       # Upper bound only when a known breaking change exists
346: 
347: # ONLY for applications (never for libraries):
348: "httpx==0.27.0"          # Pin exactly — breaks dep resolution in libraries
349: 
350: # NEVER do this in a library:
351: # "httpx~=0.24.0"        # Compatible release operator — too tight
352: # "httpx==0.27.*"        # Wildcard pin — fragile
353: ```
354: 
355: ---
356: 
357: ## 6. Dynamic Versioning with `setuptools_scm`
358: 
359: `setuptools_scm` reads your git tags and sets the package version automatically — no more manually
360: editing version strings before each release.
361: 
362: ### How it works
363: 
364: ```
365: git tag v1.0.0        →  package version = 1.0.0
366: git tag v1.1.0        →  package version = 1.1.0
367: (commits after tag)   →  version = 1.1.0.post1+g<hash>  (stripped for PyPI)
368: ```
369: 
370: `local_scheme = "no-local-version"` strips the `+g<hash>` suffix so PyPI uploads never fail with
371: a "local version label not allowed" error.
372: 
373: ### Access version at runtime
374: 
375: ```python
376: # your_package/__init__.py
377: from importlib.metadata import version, PackageNotFoundError
378: 
379: try:
380:     __version__ = version("your-package")
381: except PackageNotFoundError:
382:     __version__ = "0.0.0-dev"  # Fallback for uninstalled dev checkouts
383: ```
384: 
385: Never hardcode `__version__ = "1.0.0"` when using setuptools_scm — it will go stale after the
386: first tag.
387: 
388: ### Full release flow (this is it — nothing else needed)
389: 
390: ```bash
391: git tag v1.2.0
392: git push origin master --tags
393: # GitHub Actions publish.yml triggers automatically
394: ```
395: 
396: ---
397: 
398: ## 7. `setup.py` Shim
399: 
400: Some older tools and IDEs still expect a `setup.py`. Keep it as a three-line shim — all real
401: configuration stays in `pyproject.toml`.
402: 
403: ```python
404: # setup.py — thin shim only. All config lives in pyproject.toml.
405: from setuptools import setup
406: 
407: setup()
408: ```
409: 
410: Never duplicate `name`, `version`, `dependencies`, or any other metadata from `pyproject.toml`
411: into `setup.py`. If you copy anything there it will eventually drift and cause confusing conflicts.
412: 
413: ---
414: 
415: ## 8. Typed Package (PEP 561)
416: 
417: A properly declared typed package means mypy, pyright, and IDEs automatically pick up your type
418: hints without any extra configuration from your users.
419: 
420: ### Step 1: Create the marker file
421: 
422: ```bash
423: # The file must exist; its content doesn't matter — its presence is the signal.
424: touch your_package/py.typed
425: ```
426: 
427: ### Step 2: Include it in the wheel
428: 
429: Already in the template above:
430: 
431: ```toml
432: [tool.setuptools.package-data]
433: your_package = ["py.typed"]
434: ```
435: 
436: ### Step 3: Add the PyPI classifier
437: 
438: ```toml
439: classifiers = [
440:     ...
441:     "Typing :: Typed",
442: ]
443: ```
444: 
445: ### Step 4: Type-annotate all public functions
446: 
447: ```python
448: # Good — fully typed
449: def process(
450:     self,
451:     data: dict[str, object],
452:     *,
453:     timeout: int = 30,
454: ) -> dict[str, object]:
455:     ...
456: 
457: # Bad — mypy will flag this, and IDEs give no completions to users
458: def process(self, data, timeout=30):
459:     ...
460: ```
461: 
462: ### Step 5: Verify py.typed ships in the wheel
463: 
464: ```bash
465: python -m build
466: unzip -l dist/your_package-*.whl | grep py.typed
467: # Must show: your_package/py.typed
468: ```
469: 
470: If it's missing, check your `[tool.setuptools.package-data]` config.
