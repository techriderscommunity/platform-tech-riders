<file path="techito/src/app/features/intranet/administracion/admin-configuracion.ts">
 1: import { ChangeDetectionStrategy, Component, computed, inject, signal } from '@angular/core';
 2: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
 3: import { RouterLink } from '@angular/router';
 4: import { catchError, of } from 'rxjs';
 5: import { finalize } from 'rxjs/operators';
 6: import { ConfigItem, IntranetSettingRecord } from './models/intranet-admin.models';
 7: import { IntranetAdminService } from './services/intranet-admin.service';
 8: import { UiMetricsStrip } from '@shared/ui/metrics-strip/metrics-strip';
 9: @Component({
10:   selector: 'app-admin-configuracion',
11:   standalone: true,
12:   changeDetection: ChangeDetectionStrategy.OnPush,
13:   imports: [RouterLink, UiMetricsStrip],
14:   templateUrl: './admin-configuracion.html',
15:   styleUrl: './admin-configuracion.scss'
16: })
17: export class AdminConfiguracion {
18:   private readonly intranetAdminService = inject(IntranetAdminService);
19:   readonly loading = signal(false);
20:   readonly error = signal<string | null>(null);
21:   readonly feedback = signal<string | null>(null);
22:   readonly items = signal<ConfigItem[]>([]);
23:   readonly savingByKey = signal<Record<string, boolean>>({});
24:   readonly inRevisionCount = computed(() => this.items().filter(item => item.estado === 'revision').length);
25:   readonly configMetrics = computed(() => [
26:     { icon: '🧱', value: String(this.items().length), label: 'Bloques de configuración' },
27:     { icon: '🧪', value: String(this.inRevisionCount()), label: 'En revisión' },
28:   ]);
29:   constructor() {
30:     this.load();
31:   }
32:   private load() {
33:     this.loading.set(true);
34:     this.error.set(null);
35:     this.intranetAdminService.getSettings()
36:       .pipe(
37:         catchError(() => {
38:           this.error.set('No se pudo cargar configuracion de intranet.');
39:           return of([] as IntranetSettingRecord[]);
40:         }),
41:         takeUntilDestroyed(),
42:       )
43:       .subscribe(rows => {
44:         this.items.set(rows.map(row => ({
45:           key: row.key,
46:           modulo: row.module,
47:           valor: row.value,
48:           estado: row.status === 'revision' ? 'revision' : 'activo',
49:         })));
50:         this.loading.set(false);
51:       });
52:   }
53:   updateModulo(key: string, value: string) {
54:     this.updateItem(key, { modulo: value });
55:   }
56:   updateValor(key: string, value: string) {
57:     this.updateItem(key, { valor: value });
58:   }
59:   updateEstado(key: string, value: string) {
60:     const estado = value === 'revision' ? 'revision' : 'activo';
61:     this.updateItem(key, { estado });
62:   }
63:   saveRow(item: ConfigItem) {
64:     this.feedback.set(null);
65:     this.setSaving(item.key, true);
66:     this.intranetAdminService.updateSetting({
67:       key: item.key,
68:       module: item.modulo,
69:       value: item.valor,
70:       status: item.estado,
71:     })
72:       .pipe(
73:         catchError(() => {
74:           this.feedback.set(`No se pudo guardar la fila ${item.key}.`);
75:           return of(null);
76:         }),
77:         finalize(() => this.setSaving(item.key, false)),
78:         takeUntilDestroyed(),
79:       )
80:       .subscribe(result => {
81:         if (result !== null) {
82:           this.feedback.set(`Fila ${item.key} guardada correctamente.`);
83:         }
84:       });
85:   }
86:   isSaving(key: string): boolean {
87:     return !!this.savingByKey()[key];
88:   }
89:   private updateItem(key: string, patch: Partial<ConfigItem>) {
90:     this.items.update(items => items.map(item => item.key === key ? { ...item, ...patch } : item));
91:   }
92:   private setSaving(key: string, value: boolean) {
93:     this.savingByKey.update(state => ({ ...state, [key]: value }));
94:   }
95: }
