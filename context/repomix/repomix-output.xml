75:       this.isDarkMode.set(savedTheme === 'dark');
76:       document.documentElement.setAttribute('data-theme', savedTheme);
77:       this.onScroll();
78:     }
79:   }
80:   ngOnDestroy() {
81:     // Cleanup if needed for future subscriptions
82:   }
