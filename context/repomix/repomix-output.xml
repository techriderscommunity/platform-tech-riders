<file path="techito/src/app/features/tutoriales/tutoriales.ts">
  1: import { ChangeDetectionStrategy, Component, DestroyRef, computed, inject, signal, PLATFORM_ID } from '@angular/core';
  2: import { isPlatformBrowser } from '@angular/common';
  3: import { takeUntilDestroyed, toObservable } from '@angular/core/rxjs-interop';
  4: import { catchError, of, switchMap, tap } from 'rxjs';
  5: import { TutorialesService } from './services/tutoriales.service';
  6: import { PagedResult, Tutorial } from './models/tutoriales.models';
  7: import { PublicContentService } from '@core/content/public-content.service';
  8: import { UiTextField  } from '@shared/ui/text-field/text-field';
  9: import { UiMetricsStrip } from '@shared/ui/metrics-strip/metrics-strip';
 10: import { UiResourceCardItem, UiResourceCards } from '@shared/ui/resource-cards/resource-cards';
 11: @Component({
 12:   selector: 'app-tutoriales',
 13:   standalone: true,
 14:   changeDetection: ChangeDetectionStrategy.OnPush,
 15:   imports: [UiTextField, UiMetricsStrip, UiResourceCards],
 16:   templateUrl: './tutoriales.html',
 17:   styleUrl: './tutoriales.scss'
 18: })
 19: export class Tutoriales {
 20:   readonly destroyRef = inject(DestroyRef);
 21:   readonly tutorialesService = inject(TutorialesService);
 22:   readonly publicContentService = inject(PublicContentService);
 23:   private readonly platformId = inject(PLATFORM_ID);
 24:   featuredCategories: string[] = [];
 25:   readonly pageSize = 12;
 26:   readonly selectedCategoria = signal('');
 27:   readonly searchText = signal('');
 28:   readonly currentPage = signal(1);
 29:   readonly loadingTutoriales = signal(false);
 30:   readonly tutorialesError = signal<string | null>(null);
 31:   readonly tutorialesPaged = signal<PagedResult<Tutorial>>({
 32:     items: [],
 33:     totalCount: 0,
 34:     page: 1,
 35:     pageSize: this.pageSize,
 36:     totalPages: 0,
 37:     hasNextPage: false,
 38:     hasPreviousPage: false
 39:   });
 40:   readonly tutorialesQuery = computed(() => ({
 41:     page: this.currentPage(),
 42:     pageSize: this.pageSize,
 43:     categoria: this.selectedCategoria() || undefined,
 44:     busqueda: this.searchText().trim() || undefined
 45:   }));
 46:   readonly tutorialesMetrics = computed(() => [
 47:     { icon: '📚', value: String(this.tutorialesPaged().totalCount), label: 'Recursos disponibles' },
 48:     { icon: '🏷️', value: String(this.featuredCategories.length), label: 'Categorías destacadas' },
 49:     { icon: '🔎', value: this.searchText().trim() ? 'Activa' : 'General', label: 'Búsqueda' },
 50:   ]);
 51:   readonly activeFilterLabel = computed(() => this.selectedCategoria() || 'Todos');
 52:   readonly tutorialCards = computed<UiResourceCardItem[]>(() => this.tutorialesPaged().items.map(tutorial => ({
 53:     mode: tutorial.categorias[0] || 'Digital',
 54:     title: tutorial.titulo,
 55:     summary: tutorial.extracto,
 56:     tags: tutorial.categorias,
 57:     meta: `${this.formatFecha(tutorial.fechaPublicacion)} · ${tutorial.autor}`,
 58:     ctaLabel: 'Registro y detalles',
 59:     ctaHref: tutorial.url
 60:   })));
 61:   private readonly dateFormatter = new Intl.DateTimeFormat('es-ES', {
 62:     day: '2-digit',
 63:     month: 'short',
 64:     year: 'numeric'
 65:   });
 66:   constructor() {
 67:     this.publicContentService
 68:       .getPublicContent()
 69:       .pipe(
 70:         tap((content) => {
 71:           this.featuredCategories = content.tutorials.featuredCategories;
 72:         }),
 73:         catchError(() => of(null)),
 74:         takeUntilDestroyed(this.destroyRef)
 75:       )
 76:       .subscribe();
 77:     if (isPlatformBrowser(this.platformId)) toObservable(this.tutorialesQuery)
 78:       .pipe(
 79:         tap(() => {
 80:           this.loadingTutoriales.set(true);
 81:           this.tutorialesError.set(null);
 82:         }),
 83:         switchMap(query => this.tutorialesService.getTutoriales(query).pipe(
 84:           catchError(() => {
 85:             this.tutorialesError.set('No se pudieron cargar los tutoriales.');
 86:             return of({
 87:               items: [],
 88:               totalCount: 0,
 89:               page: query.page,
 90:               pageSize: query.pageSize,
 91:               totalPages: 0,
 92:               hasNextPage: false,
 93:               hasPreviousPage: false
 94:             } satisfies PagedResult<Tutorial>);
 95:           })
 96:         )),
 97:         takeUntilDestroyed(this.destroyRef)
 98:       )
 99:       .subscribe(result => {
100:         this.tutorialesPaged.set(result);
101:         this.loadingTutoriales.set(false);
102:       });
103:   }
104:   setCategoria(categoria: string): void {
105:     this.selectedCategoria.set(categoria);
106:     this.currentPage.set(1);
107:   }
108:   updateSearch(term: string): void {
109:     this.searchText.set(term);
110:     this.currentPage.set(1);
111:   }
112:   nextTutorialesPage(): void {
113:     if (this.tutorialesPaged().hasNextPage) {
114:       this.currentPage.update(page => page + 1);
115:     }
116:   }
117:   prevTutorialesPage(): void {
118:     if (this.tutorialesPaged().hasPreviousPage) {
119:       this.currentPage.update(page => page - 1);
120:     }
121:   }
122:   formatFecha(fechaPublicacion: string): string {
123:     const date = new Date(fechaPublicacion);
124:     return Number.isNaN(date.getTime()) ? fechaPublicacion : this.dateFormatter.format(date);
125:   }
126: }
</file>

