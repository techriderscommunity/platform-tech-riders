 37: function Convert-ToNullableDouble {
 38:     param([string]$Value)
 39: 
 40:     if ([string]::IsNullOrWhiteSpace($Value)) {
 41:         return $null
 42:     }
 43: 
 44:     $normalized = $Value.Trim().Replace(',', '.')
 45:     $parsed = 0.0
 46:     if ([double]::TryParse($normalized, [System.Globalization.NumberStyles]::Float, [System.Globalization.CultureInfo]::InvariantCulture, [ref]$parsed)) {
 47:         return [double]$parsed
 48:     }
 49: 
 50:     return $null
 51: }
