 90: ### Idempotent Operations
 91: 
 92: ```bash
 93: # Always use --detect for auto-detection
 94: az devops configure --defaults organization=$ORG_URL project=$PROJECT
 95: 
 96: # Check existence before creation
 97: if ! az pipelines show --id $PIPELINE_ID 2>/dev/null; then
 98:   az pipelines create --name "$PIPELINE_NAME" --yaml-path azure-pipelines.yml
 99: fi
100: 
101: # Use --output tsv for shell parsing
102: PIPELINE_ID=$(az pipelines list --query "[?name=='MyPipeline'].id" --output tsv)
103: 
104: # Use --output json for programmatic access
105: BUILD_STATUS=$(az pipelines build show --id $BUILD_ID --query "status" --output json)
106: ```
