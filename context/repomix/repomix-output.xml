<file path="techito/src/app/features/intranet/admin-dashboard/admin-dashboard.ts">
 1: import { ChangeDetectionStrategy, Component, computed, signal, inject, DestroyRef } from '@angular/core';
 2: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
 3: import { RouterLink } from '@angular/router';
 4: import { tap, catchError } from 'rxjs/operators';
 5: import { of } from 'rxjs';
 6: import { AdminDashboardService, AdminDashboardApiResponse } from './services/admin-dashboard.service';
 7: import { UiMetricsStrip } from '@shared/ui/metrics-strip/metrics-strip';
 8: import { UiProgressCards } from '@shared/ui/progress-cards/progress-cards';
 9: @Component({
10:   selector: 'app-admin-dashboard',
11:   standalone: true,
12:   changeDetection: ChangeDetectionStrategy.OnPush,
13:   imports: [UiMetricsStrip, UiProgressCards, RouterLink],
14:   templateUrl: './admin-dashboard.html',
15:   styleUrl: './admin-dashboard.scss'
16: })
17: export class AdminDashboard {
18:   private readonly adminDashboardService = inject(AdminDashboardService);
19:   private readonly destroyRef = inject(DestroyRef);
20:   readonly loading = signal(true);
21:   readonly error = signal<string | null>(null);
22:   readonly stats = signal({ totalUsuarios: 0, activos: 0, superadmins: 0, eventos: 0, sesiones: 0, embajadores: 0, ofertas: 0, candidaturas: 0 });
23:   readonly ultimasAcciones = signal<Array<{ accion: string; detalle: string; fecha: string }>>([]);
24:   readonly systemeHealth = signal({ servers: '', database: '', uploads: '', cpu: '' });
25:   readonly dashboardMetrics = computed(() => {
26:     const stats = this.stats();
27:     return [
28:       { icon: '👥', value: String(stats.totalUsuarios), label: 'Usuarios totales' },
29:       { icon: '⭐', value: String(stats.superadmins), label: 'Superadmins' },
30:       { icon: '📅', value: String(stats.eventos), label: 'Eventos' },
31:       { icon: '🧩', value: String(stats.sesiones), label: 'Sesiones' },
32:     ];
33:   });
34:   readonly systemHealthCards = computed(() => {
35:     const health = this.systemeHealth();
36:     return [
37:       { title: 'Servidores', value: health.servers || 'N/D', detail: 'Estado de infraestructura', progress: health.servers === 'OK' ? 100 : 50, status: health.servers === 'OK' ? 'Operativo' : 'Revisar' },
38:       { title: 'Base de datos', value: health.database || 'N/D', detail: 'Disponibilidad y rendimiento', progress: health.database === 'OK' ? 100 : 50, status: health.database === 'OK' ? 'Operativo' : 'Revisar' },
39:       { title: 'Cargas', value: health.uploads || 'N/D', detail: 'Canal de subida de contenidos', progress: health.uploads === 'OK' ? 100 : 50, status: health.uploads === 'OK' ? 'Operativo' : 'Revisar' },
40:       { title: 'CPU', value: health.cpu || 'N/D', detail: 'Consumo general del sistema', progress: health.cpu === 'OK' ? 100 : 50, status: health.cpu === 'OK' ? 'Operativo' : 'Revisar' },
41:     ];
42:   });
43:   constructor() {
44:     this.loadDashboard();
45:   }
46:   private loadDashboard() {
47:     this.adminDashboardService.getDashboard()
48:       .pipe(
49:         tap((data: AdminDashboardApiResponse) => {
50:           const nextStats = data.Stats;
51:           this.stats.set({
52:             totalUsuarios: Number(nextStats.TotalUsers ?? 0),
53:             activos: Number(nextStats.ActiveUsers ?? 0),
54:             superadmins: Number(nextStats.SuperAdmins ?? 0),
55:             eventos: Number(nextStats.Events ?? 0),
56:             sesiones: Number(nextStats.Sessions ?? 0),
57:             embajadores: Number(nextStats.Ambassadors ?? 0),
58:             ofertas: Number(nextStats.JobOffers ?? 0),
59:             candidaturas: Number(nextStats.Applications ?? 0),
60:           });
61:           this.ultimasAcciones.set(data.RecentActions.map(item => ({
62:             accion: item.Action,
63:             detalle: item.Detail,
64:             fecha: item.CreatedUtc,
65:           })));
66:           this.systemeHealth.set({
67:             servers: data.SystemHealth.Servers,
68:             database: data.SystemHealth.Database,
69:             uploads: data.SystemHealth.Uploads,
70:             cpu: data.SystemHealth.Cpu,
71:           });
72:           this.loading.set(false);
73:         }),
74:         catchError(() => {
75:           this.error.set('No se pudo cargar el dashboard de admin');
76:           this.loading.set(false);
77:           return of(null);
78:         }),
79:         takeUntilDestroyed(this.destroyRef)
80:       )
81:       .subscribe();
82:   }
83: }
</file>

