 1: <div class="mis-ofertas">
 2:   <div class="page-header">
 3:     <h1>Mis Ofertas de Empleo</h1>
 4:     <p class="subtitle">Explora todas las oportunidades que tenemos para ti</p>
 5:   </div>
 6:   <!-- Filtros y Ordenamiento -->
 7:   <div class="filtros-container">
 8:     <div class="filtros">
 9:       <button class="filtro-btn" [class.activo]="filtroActual() === 'todas'" (click)="filtroActual.set('todas')">
10:         Todas
11:       </button>
12:       <button class="filtro-btn" [class.activo]="filtroActual() === 'guardada'" (click)="filtroActual.set('guardada')">
13:         ❤️ Guardadas
14:       </button>
15:       <button class="filtro-btn" [class.activo]="filtroActual() === 'solicitada'" (click)="filtroActual.set('solicitada')">
16:         📤 Solicitadas
17:       </button>
18:       <button class="filtro-btn" [class.activo]="filtroActual() === 'en_proceso'" (click)="filtroActual.set('en_proceso')">
19:         ⏳ En Proceso
20:       </button>
21:     </div>
22:     <div class="ordenamiento">
23:       <app-ui-select
24:         label="Ordenar"
25:         [options]="ordenarOptions"
26:         [value]="ordenar()"
27:         (valueChange)="ordenar.set($event)"
28:       ></app-ui-select>
29:     </div>
30:   </div>
31:   @if (loading()) {
32:     <div class="feedback-banner info" role="status" aria-live="polite">Cargando ofertas...</div>
33:   }
34:   @if (error()) {
35:     <div class="feedback-banner error" role="alert" aria-live="assertive">{{ error() }}</div>
36:     }
37:     @if (info()) {
38:     <div class="feedback-banner info" role="status" aria-live="polite">{{ info() }}</div>
39:   }
40:   <!-- Ofertas Grid -->
41:   <div class="ofertas-grid">
42:     @for (oferta of ofertasFiltradas(); track oferta.id) {
43:     <div class="oferta-card">
44:       <div class="oferta-header">
45:         <div>
46:           <h3>{{oferta.titulo}}</h3>
47:           <p class="empresa">{{oferta.empresa}}</p>
48:         </div>
49:         <div class="match-badge">{{oferta.modalidad}}</div>
50:       </div>
51:       <div class="oferta-meta">
52:         <span class="meta-item">
53:           <span class="icon">💰</span>
54:           {{oferta.salario}}
55:         </span>
56:         <span class="meta-item">
57:           <span class="icon">📍</span>
58:           {{oferta.ubicacion}}
59:         </span>
60:         <span class="meta-item">
61:           <span class="icon">⏰</span>
62:           {{oferta.modalidad}}
63:         </span>
64:       </div>
65:       <div class="oferta-footer">
66:         <span class="fecha">{{oferta.fechaPublicacion}}</span>
67:         <div class="estado-badge" [class]="oferta.estado">
68:           <span>{{oferta.estado}}</span>
69:         </div>
70:       </div>
71:       <div class="oferta-actions">
72:         <app-ui-button class="btn-outline" (click)="enviarSolicitud(oferta.id)">
73:           Solicitar
74:         </app-ui-button>
75:         <app-ui-button class="btn-primary" (click)="guardarOferta(oferta.id)">
76:           Guardar
77:         </app-ui-button>
78:         <app-ui-button class="btn-text" (click)="eliminarOferta(oferta.id)">Eliminar</app-ui-button>
79:       </div>
80:     </div>
81:     }
82:   </div>
83:   <!-- Sin ofertas -->
84:   @if (ofertasFiltradas().length === 0) {
85:   <div class="empty-state">
86:     <p>No hay ofertas que coincidan con tus filtros</p>
87:     <app-ui-button class="btn-primary" (click)="filtroActual.set('todas')">Ver todas las ofertas</app-ui-button>
88:   </div>
89:   }
90: </div>
