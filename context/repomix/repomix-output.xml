442: 
443: # Search marketplace extensions
444: az devops extension search --search-query "docker"
445: 
446: # Show extension details
447: az devops extension show --ext-id {extension-id} --org https://dev.azure.com/{org}
448: 
449: # Install extension
450: az devops extension install \
451:   --ext-id {extension-id} \
452:   --org https://dev.azure.com/{org} \
453:   --publisher {publisher-id}
454: 
455: # Enable extension
456: az devops extension enable \
457:   --ext-id {extension-id} \
458:   --org https://dev.azure.com/{org}
459: 
460: # Disable extension
461: az devops extension disable \
462:   --ext-id {extension-id} \
463:   --org https://dev.azure.com/{org}
464: 
465: # Uninstall extension
466: az devops extension uninstall \
467:   --ext-id {extension-id} \
468:   --org https://dev.azure.com/{org} --yes
469: ```
