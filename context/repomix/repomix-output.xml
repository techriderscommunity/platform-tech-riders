 543: function Test-LongRunningCommand {
 544:     param(
 545:         [string]$Name,
 546:         [string]$Command,
 547:         [int]$WarmupSec = 4,
 548:         [int]$TimeoutSec = 25
 549:     )
 550: 
 551:     $outFile = Join-Path $env:TEMP ("hi-mcp-{0}-{1}.out" -f $Name, ([guid]::NewGuid().ToString('N')))
 552:     $errFile = Join-Path $env:TEMP ("hi-mcp-{0}-{1}.err" -f $Name, ([guid]::NewGuid().ToString('N')))
 553: 
 554:     $proc = Start-Process -FilePath 'pwsh' -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-Command', $Command) -PassThru -RedirectStandardOutput $outFile -RedirectStandardError $errFile
 555:     $start = Get-Date
 556:     $deadline = $start.AddSeconds($TimeoutSec)
 557:     $isReady = $false
 558: 
 559:     while ((Get-Date) -lt $deadline) {
 560:         if ($proc.HasExited) {
 561:             if ($proc.ExitCode -eq 0) {
 562:                 $isReady = $true
 563:                 break
 564:             }
 565: 
 566:             $errText = ''
 567:             if (Test-Path $errFile) {
 568:                 $errText = (Get-Content $errFile -Raw)
 569:             }
 570:             throw "$Name failed to start. ExitCode=$($proc.ExitCode). $errText"
 571:         }
 572: 
 573:         if (((Get-Date) - $start).TotalSeconds -ge $WarmupSec) {
 574:             $isReady = $true
 575:             break
 576:         }
 577: 
 578:         Start-Sleep -Milliseconds 250
 579:     }
 580: 
 581:     if (-not $isReady) {
 582:         throw "$Name did not become ready within ${TimeoutSec}s"
 583:     }
 584: 
 585:     if (-not $proc.HasExited) {
 586:         Stop-Process -Id $proc.Id -Force
 587:     }
 588: 
 589:     Remove-Item $outFile, $errFile -ErrorAction SilentlyContinue
 590: }
