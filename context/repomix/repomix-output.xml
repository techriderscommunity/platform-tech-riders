340:   /**
341:    * Calcula posición y ancho para una sesión (basado en horario del día)
342:    */
343:   private calcularPosicionSesion(sesion: SesionEnEvento): { posicionX: number; ancho: number; carril: number } {
344:     const [hInicio, mInicio] = sesion.horaInicio.split(':').map(Number);
345:     const [hFin, mFin] = sesion.horaFin.split(':').map(Number);
346:     const minInicio = hInicio * 60 + mInicio;
347:     const minFin = hFin * 60 + mFin;
348:     const minTotalesDia = 24 * 60;
349:     const posicionX = (minInicio / minTotalesDia) * 100;
350:     const duracion = minFin - minInicio;
351:     const ancho = (duracion / minTotalesDia) * 100;
352:     // Por ahora carril 0; puede extenderse para detectar solapamientos
353:     const carril = 0;
354:     return { posicionX, ancho, carril };
355:   }
356:   // Navegación
357:   mesAnterior(): void {
358:     const nueva = new Date(this.currentDate());
359:     nueva.setMonth(nueva.getMonth() - 1);
360:     this.currentDate.set(nueva);
361:   }
362:   mesSiguiente(): void {
363:     const nueva = new Date(this.currentDate());
364:     nueva.setMonth(nueva.getMonth() + 1);
365:     this.currentDate.set(nueva);
366:   }
