<file path="techito/src/app/shared/ui/modal/modal.ts">
 1: import { ChangeDetectionStrategy, Component, EventEmitter, HostListener, Output, inject } from '@angular/core';
 2: import { DOCUMENT, isPlatformBrowser } from '@angular/common';
 3: import { PLATFORM_ID } from '@angular/core';
 4: @Component({
 5:   selector: 'app-ui-modal',
 6:   standalone: true,
 7:   templateUrl: './modal.html',
 8:   styleUrl: './modal.scss',
 9:   changeDetection: ChangeDetectionStrategy.OnPush,
10: })
11: export class UiModal {
12:   private static nextId = 0;
13:   private readonly documentRef = inject(DOCUMENT);
14:   private readonly platformId = inject(PLATFORM_ID);
15:   @Output() readonly close = new EventEmitter<void>();
16:   readonly titleId = `ui-modal-title-${UiModal.nextId++}`;
17:   constructor() {
18:     if (isPlatformBrowser(this.platformId)) {
19:       this.documentRef.body.classList.add('has-ui-modal');
20:     }
21:   }
22:   @HostListener('document:keydown.escape')
23:   onEscape() {
24:     this.close.emit();
25:   }
26:   onClose() {
27:     this.close.emit();
28:   }
29:   ngOnDestroy() {
30:     if (isPlatformBrowser(this.platformId)) {
31:       this.documentRef.body.classList.remove('has-ui-modal');
32:     }
33:   }
34: }
</file>

