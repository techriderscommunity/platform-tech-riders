221: ## Error Handling & Retry Patterns
222: 
223: ### Retry Logic for Transient Failures
224: 
225: ```bash
226: # Retry function for network operations
227: retry_command() {
228:   local max_attempts=3
229:   local attempt=1
230:   local delay=5
231: 
232:   while [[ $attempt -le $max_attempts ]]; do
233:     if "$@"; then
234:       return 0
235:     fi
236:     echo "Attempt $attempt failed. Retrying in ${delay}s..."
237:     sleep $delay
238:     ((attempt++))
239:     delay=$((delay * 2))
240:   done
241: 
242:   echo "All $max_attempts attempts failed"
243:   return 1
244: }
245: 
246: # Usage
247: retry_command az pipelines run --name "$PIPELINE_NAME"
248: ```
249: 
250: ### Check and Handle Errors
251: 
252: ```bash
253: # Check if pipeline exists before operations
254: PIPELINE_ID=$(az pipelines list --query "[?name=='$PIPELINE_NAME'].id" -o tsv)
255: 
256: if [[ -z "$PIPELINE_ID" ]]; then
257:   echo "Pipeline not found. Creating..."
258:   az pipelines create --name "$PIPELINE_NAME" --yaml-path azure-pipelines.yml
259: else
260:   echo "Pipeline exists with ID: $PIPELINE_ID"
261: fi
262: ```
263: 
264: ### Validate Inputs
265: 
266: ```bash
267: # Validate required parameters
268: if [[ -z "$PROJECT" || -z "$REPO" ]]; then
269:   echo "Error: PROJECT and REPO must be set"
270:   exit 1
271: fi
272: 
273: # Check if branch exists
274: if ! az repos ref list --repository "$REPO" --query "[?name=='refs/heads/$BRANCH']" -o tsv | grep -q .; then
275:   echo "Error: Branch $BRANCH does not exist"
276:   exit 1
277: fi
278: ```
279: 
280: ### Handle Permission Errors
281: 
282: ```bash
283: # Try operation, handle permission errors
284: if az devops security permission update \
285:   --id "$USER_ID" \
286:   --namespace "GitRepositories" \
287:   --project "$PROJECT" \
288:   --token "repoV2/$PROJECT/$REPO_ID" \
289:   --allow-bit 2 \
290:   --deny-bit 0 2>&1 | grep -q "unauthorized"; then
291:   echo "Error: Insufficient permissions to update repository permissions"
292:   exit 1
293: fi
294: ```
295: 
296: ### Pipeline Failure Notification
297: 
298: ```bash
299: # Run pipeline and check result
300: RUN_ID=$(az pipelines run --name "$PIPELINE_NAME" --query "id" -o tsv)
301: 
302: # Wait for completion
303: while true; do
304:   STATUS=$(az pipelines runs show --run-id $RUN_ID --query "status" -o tsv)
305:   if [[ "$STATUS" != "inProgress" && "$STATUS" != "notStarted" ]]; then
306:     break
307:   fi
308:   sleep 10
309: done
310: 
311: # Check result and create work item on failure
312: RESULT=$(az pipelines runs show --run-id $RUN_ID --query "result" -o tsv)
313: if [[ "$RESULT" != "succeeded" ]]; then
314:   BUILD_NUMBER=$(az pipelines runs show --run-id $RUN_ID --query "buildNumber" -o tsv)
315: 
316:   az boards work-item create \
317:     --title "Build $BUILD_NUMBER failed" \
318:     --type Bug \
319:     --description "Pipeline run $RUN_ID failed with result: $RESULT\n\nURL: $ORG_URL/$PROJECT/_build/results?buildId=$RUN_ID"
320: fi
321: ```
322: 
323: ### Graceful Degradation
324: 
325: ```bash
326: # Try to download artifact, fallback to alternative source
327: if ! az pipelines runs artifact download \
328:   --artifact-name 'webapp' \
329:   --path ./output \
330:   --run-id $RUN_ID 2>/dev/null; then
331:   echo "Warning: Failed to download from pipeline run. Falling back to backup source..."
332: 
333:   # Alternative download method
334:   curl -L "$BACKUP_URL" -o ./output/backup.zip
335: fi
336: ```
