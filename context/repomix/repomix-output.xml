<file path="techito/src/app/features/comuneras/community-partner-apply.ts">
  1: import { ChangeDetectionStrategy, Component, computed, inject, signal } from '@angular/core';
  2: import { RouterLink } from '@angular/router';
  3: import { UiButton } from '@shared/ui/button/button';
  4: import { UiSelect, UiSelectOption } from '@shared/ui/select/select';
  5: import { UiTextField } from '@shared/ui/text-field/text-field';
  6: import { UiTextarea } from '@shared/ui/textarea/textarea';
  7: import { CommunityPartnersStore } from './services/community-partners.store';
  8: import { CommunityPartnerScope } from './models/community-partner.models';
  9: @Component({
 10:   selector: 'app-community-partner-apply',
 11:   standalone: true,
 12:   imports: [RouterLink, UiButton, UiSelect, UiTextField, UiTextarea],
 13:   templateUrl: './community-partner-apply.html',
 14:   styleUrl: './community-partner-apply.scss',
 15:   changeDetection: ChangeDetectionStrategy.OnPush,
 16: })
 17: export class CommunityPartnerApply {
 18:   private readonly store = inject(CommunityPartnersStore);
 19:   readonly saving = signal(false);
 20:   readonly submitted = signal(false);
 21:   readonly error = signal<string | null>(null);
 22:   readonly name = signal('');
 23:   readonly logoUrl = signal('');
 24:   readonly website = signal('');
 25:   readonly contactEmail = signal('');
 26:   readonly contactName = signal('');
 27:   readonly whoYouAre = signal('');
 28:   readonly whatYouDo = signal('');
 29:   readonly mission = signal('');
 30:   readonly topicsRaw = signal('');
 31:   readonly scope = signal<CommunityPartnerScope>('local');
 32:   readonly linkedin = signal('');
 33:   readonly instagram = signal('');
 34:   readonly x = signal('');
 35:   readonly youtube = signal('');
 36:   readonly discord = signal('');
 37:   readonly telegram = signal('');
 38:   readonly motivation = signal('');
 39:   readonly collaborationIdeas = signal('');
 40:   readonly scopeOptions: UiSelectOption[] = [
 41:     { label: 'Local', value: 'local' },
 42:     { label: 'Nacional', value: 'national' },
 43:     { label: 'Internacional', value: 'international' },
 44:   ];
 45:   readonly canSubmit = computed(() => {
 46:     return Boolean(
 47:       this.name().trim() &&
 48:       this.website().trim() &&
 49:       this.contactEmail().trim() &&
 50:       this.contactName().trim() &&
 51:       this.whoYouAre().trim() &&
 52:       this.whatYouDo().trim() &&
 53:       this.mission().trim() &&
 54:       this.motivation().trim() &&
 55:       this.collaborationIdeas().trim(),
 56:     );
 57:   });
 58:   submit(event: Event): void {
 59:     event.preventDefault();
 60:     if (!this.canSubmit()) {
 61:       this.error.set('Completa los campos obligatorios antes de enviar la solicitud.');
 62:       return;
 63:     }
 64:     if (!this.isValidEmail(this.contactEmail())) {
 65:       this.error.set('El email de contacto no tiene un formato válido.');
 66:       return;
 67:     }
 68:     this.error.set(null);
 69:     this.saving.set(true);
 70:     try {
 71:       this.store.submitApplication({
 72:         name: this.name().trim(),
 73:         logoUrl: this.logoUrl().trim() || 'assets/logo.png',
 74:         website: this.website().trim(),
 75:         contactEmail: this.contactEmail().trim(),
 76:         contactName: this.contactName().trim(),
 77:         whoYouAre: this.whoYouAre().trim(),
 78:         whatYouDo: this.whatYouDo().trim(),
 79:         mission: this.mission().trim(),
 80:         topics: this.topicsRaw()
 81:           .split(',')
 82:           .map(item => item.trim())
 83:           .filter(Boolean),
 84:         scope: this.scope(),
 85:         linkedin: this.linkedin().trim() || undefined,
 86:         instagram: this.instagram().trim() || undefined,
 87:         x: this.x().trim() || undefined,
 88:         youtube: this.youtube().trim() || undefined,
 89:         discord: this.discord().trim() || undefined,
 90:         telegram: this.telegram().trim() || undefined,
 91:         motivation: this.motivation().trim(),
 92:         collaborationIdeas: this.collaborationIdeas().trim(),
 93:       });
 94:       this.submitted.set(true);
 95:     } catch (error) {
 96:       this.error.set(error instanceof Error ? error.message : 'No se pudo registrar la solicitud.');
 97:     } finally {
 98:       this.saving.set(false);
 99:     }
100:   }
101:   onScopeChange(value: string): void {
102:     if (value === 'local' || value === 'national' || value === 'international') {
103:       this.scope.set(value);
104:     }
105:   }
106:   private isValidEmail(email: string): boolean {
107:     return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim());
108:   }
109: }
</file>

