 2: namespace TechRiders.Domain.Interfaces;
 3: /// <summary>
 4: /// Interfaz genérica para operaciones CRUD básicas en el repositorio
 5: /// Implementa el principio de Interface Segregation y Dependency Inversion
 6: /// </summary>
 7: /// <typeparam name="T">Tipo de entidad del dominio</typeparam>
 8: public interface IRepository<T> where T : class
 9: {
10:     /// <summary>
11:     /// Obtiene una entidad por su identificador
12:     /// </summary>
13:     Task<T?> GetByIdAsync(Guid id, CancellationToken cancellationToken = default);
14:     /// <summary>
15:     /// Obtiene todas las entidades
16:     /// </summary>
17:     Task<IEnumerable<T>> GetAllAsync(CancellationToken cancellationToken = default);
18:     /// <summary>
19:     /// Obtiene entidades que cumplan una condición específica
20:     /// </summary>
21:     Task<IEnumerable<T>> FindAsync(Expression<Func<T, bool>> predicate, CancellationToken cancellationToken = default);
22:     /// <summary>
23:     /// Agrega una nueva entidad
24:     /// </summary>
25:     Task<T> AddAsync(T entity, CancellationToken cancellationToken = default);
26:     /// <summary>
27:     /// Agrega múltiples entidades
28:     /// </summary>
29:     Task AddRangeAsync(IEnumerable<T> entities, CancellationToken cancellationToken = default);
30:     /// <summary>
31:     /// Actualiza una entidad existente
32:     /// </summary>
33:     Task UpdateAsync(T entity, CancellationToken cancellationToken = default);
34:     /// <summary>
35:     /// Elimina una entidad
36:     /// </summary>
37:     Task DeleteAsync(T entity, CancellationToken cancellationToken = default);
38:     /// <summary>
39:     /// Verifica si existe una entidad que cumpla una condición
40:     /// </summary>
41:     Task<bool> ExistsAsync(Expression<Func<T, bool>> predicate, CancellationToken cancellationToken = default);
42:     /// <summary>
43:     /// Cuenta las entidades que cumplen una condición
44:     /// </summary>
45:     Task<int> CountAsync(Expression<Func<T, bool>>? predicate = null, CancellationToken cancellationToken = default);
