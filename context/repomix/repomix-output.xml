  1: import { ChangeDetectionStrategy, Component, DestroyRef, inject, signal } from '@angular/core';
  2: import { RouterLink } from '@angular/router';
  3: import { FormsModule } from '@angular/forms';
  4: import { catchError, of, tap } from 'rxjs';
  5: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
  6: import { EmpresaService } from '../services/empresa.service';
  7: import { NuevaOfertaForm, Oferta } from '../models/empresa.models';
  8: import { UiTextField  } from '@shared/ui/text-field/text-field';
  9: import { UiTextarea  } from '@shared/ui/textarea/textarea';
 10: import { UiSelect, UiSelectOption  } from '@shared/ui/select/select';
 11: import { UiButton  } from '@shared/ui/button/button';
 12: @Component({
 13:   selector: 'app-gestionar-ofertas',
 14:   standalone: true,
 15:   changeDetection: ChangeDetectionStrategy.OnPush,
 16:   imports: [RouterLink, FormsModule, UiTextField, UiTextarea, UiSelect, UiButton],
 17:   templateUrl: './gestionar-ofertas.html',
 18:   styleUrl: './gestionar-ofertas.scss'
 19: })
 20: export class GestionarOfertas {
 21:   private readonly empresaService = inject(EmpresaService);
 22:   private readonly destroyRef = inject(DestroyRef);
 23:   readonly vistaActual = signal<'lista' | 'crear' | 'editar'>('lista');
 24:   readonly loading = signal(false);
 25:   readonly error = signal<string | null>(null);
 26:   readonly ofertas = signal<Oferta[]>([]);
 27:   readonly nuevaOferta = signal<NuevaOfertaForm>({
 28:     titulo: '',
 29:     descripcion: '',
 30:     requisitos: '',
 31:     ubicacion: '',
 32:     salario: '',
 33:     tipo: 'Jornada completa',
 34:     modalidad: 'Remoto'
 35:   });
 36:   readonly modalidadOptions: UiSelectOption[] = [
 37:     { label: 'Remoto', value: 'Remoto' },
 38:     { label: 'Presencial', value: 'Presencial' },
 39:     { label: 'Híbrido', value: 'Híbrido' }
 40:   ];
 41:   readonly tipoOptions: UiSelectOption[] = [
 42:     { label: 'Jornada completa', value: 'Jornada completa' },
 43:     { label: 'Media jornada', value: 'Media jornada' },
 44:     { label: 'Prácticas', value: 'Prácticas' }
 45:   ];
 46:   constructor() {
 47:     this.cargarOfertas();
 48:   }
 49:   cargarOfertas(): void {
 50:     this.empresaService.getOfertas(1, 100)
 51:       .pipe(
 52:         tap(() => {
 53:           this.loading.set(true);
 54:           this.error.set(null);
 55:         }),
 56:         catchError(() => {
 57:           this.error.set('No se pudieron cargar las ofertas.');
 58:           return of({ items: [] as Oferta[] });
 59:         }),
 60:         takeUntilDestroyed(this.destroyRef)
 61:       )
 62:       .subscribe(result => {
 63:         this.ofertas.set(result.items);
 64:         this.loading.set(false);
 65:       });
 66:   }
 67:   mostrarCrearOferta() {
 68:     this.vistaActual.set('crear');
