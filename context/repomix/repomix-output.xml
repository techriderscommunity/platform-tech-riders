<file path="techito/src/app/features/orienta-tech/services/orienta-tech-playlists.service.ts">
 1: import { Injectable, inject } from '@angular/core';
 2: import { HttpClient, HttpParams } from '@angular/common/http';
 3: import { map } from 'rxjs/operators';
 4: import { Observable } from 'rxjs';
 5: import { environment } from '@env/environment';
 6: import { UiCarouselItem } from '@shared/ui/media-carousel/media-carousel';
 7: import { OrientaPlaylistKey, PlaylistVideoDto } from '../models/orienta-tech.models';
 8: @Injectable({ providedIn: 'root' })
 9: export class OrientaTechPlaylistsService {
10:   private readonly http = inject(HttpClient);
11:   private readonly baseUrl = `${environment.apiUrl}/events/podcast/videos`;
12:   getVideosByPlaylist(
13:     playlist: OrientaPlaylistKey,
14:     maxResults = 8
15:   ): Observable<UiCarouselItem[]> {
16:     const params = new HttpParams()
17:       .set('maxResults', String(maxResults))
18:       .set('playlist', playlist);
19:     return this.http.get<PlaylistVideoDto[]>(this.baseUrl, { params }).pipe(
20:       map((videos) =>
21:         (videos ?? []).map((video) => ({
22:           kind: 'video' as const,
23:           title: video.title,
24:           src: video.embedUrl,
25:         }))
26:       )
27:     );
28:   }
29: }
</file>

