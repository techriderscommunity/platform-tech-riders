<file path="scripts/bootstrap-portable.ps1">
 1: param(
 2:   [switch]$ForceTemplateRegistry,
 3:   [switch]$SkipCodebaseMemory,
 4:   [switch]$SkipTokenSaver,
 5:   [switch]$SkipCodegraph,
 6:   [switch]$SkipGitnexus,
 7:   [switch]$SkipGraphify,
 8:   [switch]$SkipRepomix,
 9:   [string]$Owner,
10:   [string]$RepoNamePrefix,
11:   [string]$InitialRepoName,
12:   [string]$InitialRepoDomain,
13:   [string]$InitialRepoLocation,
14:   [switch]$SkipInitialRepo
15: )
16: 
17: Set-StrictMode -Version Latest
18: $ErrorActionPreference = "Stop"
19: 
20: $repoRoot = (Resolve-Path (Join-Path $PSScriptRoot '..')).Path
21: Set-Location $repoRoot
22: 
23: $registryPath = Join-Path $repoRoot 'repo-registry\repos.yml'
24: $summaryReportPath = Join-Path $repoRoot 'repo-intake\generated\reports\SUMMARY.json'
25: $initRegistryArgs = @('.\scripts\intake\init-template-registry.ps1')
26: if (-not [string]::IsNullOrWhiteSpace($Owner)) { $initRegistryArgs += @('-Owner', $Owner) }
27: if (-not [string]::IsNullOrWhiteSpace($RepoNamePrefix)) { $initRegistryArgs += @('-RepoNamePrefix', $RepoNamePrefix) }
28: if (-not [string]::IsNullOrWhiteSpace($InitialRepoName)) { $initRegistryArgs += @('-InitialRepoName', $InitialRepoName) }
29: if (-not [string]::IsNullOrWhiteSpace($InitialRepoDomain)) { $initRegistryArgs += @('-InitialRepoDomain', $InitialRepoDomain) }
30: if (-not [string]::IsNullOrWhiteSpace($InitialRepoLocation)) { $initRegistryArgs += @('-InitialRepoLocation', $InitialRepoLocation) }
31: if ($SkipInitialRepo) { $initRegistryArgs += '-SkipInitialRepo' }
32: 
33: Write-Host '== Portable bootstrap ==' 
34: 
35: pwsh -NoProfile -ExecutionPolicy Bypass -File .\scripts\setup\setup-prerequisites.ps1 `
36:   -PortableMode `
37:   -SkipCodebaseMemory:$SkipCodebaseMemory `
38:   -SkipTokenSaver:$SkipTokenSaver `
39:   -SkipCodegraph:$SkipCodegraph `
40:   -SkipGitnexus:$SkipGitnexus `
41:   -SkipGraphify:$SkipGraphify `
42:   -SkipRepomix:$SkipRepomix
43: if ($LASTEXITCODE -ne 0) {
44:   throw 'Portable setup prerequisites failed.'
45: }
46: 
47: pwsh -NoProfile -ExecutionPolicy Bypass -File .\scripts\setup\validate-context.ps1 -PortableMode
48: if ($LASTEXITCODE -ne 0) {
49:   throw 'Portable context validation failed.'
50: }
51: 
52: if (-not (Test-Path $registryPath)) {
53:   Write-Host 'No repo registry found. Initializing portable template registry...'
54:   pwsh -NoProfile -ExecutionPolicy Bypass -File @initRegistryArgs
55:   if ($LASTEXITCODE -ne 0) {
56:     throw 'Template registry initialization failed.'
57:   }
58: }
59: elseif ($ForceTemplateRegistry) {
60:   Write-Host 'Forcing template registry initialization...'
61:   pwsh -NoProfile -ExecutionPolicy Bypass -File @($initRegistryArgs + '-Force')
62:   if ($LASTEXITCODE -ne 0) {
63:     throw 'Forced template registry initialization failed.'
64:   }
65: }
66: else {
67:   Write-Host 'Registry already exists. Reusing current repo-registry\repos.yml.'
68: }
69: 
70: pwsh -NoProfile -ExecutionPolicy Bypass -File .\scripts\intake\run-repo-intake.ps1 -WarnOnly
71: if ($LASTEXITCODE -ne 0) {
72:   Write-Warning 'Repo intake failed during portable bootstrap. Continuing because intake is optional in v2 happy path.'
73: }
74: 
75: Write-Host ''
76: Write-Host 'Portable bootstrap completed.'
77: if (Test-Path $registryPath) {
78:   $registry = Get-Content -Raw -Path $registryPath | ConvertFrom-Json -Depth 20
79:   $registryMode = if (($registry.PSObject.Properties.Name -contains 'registry_mode') -and -not [string]::IsNullOrWhiteSpace([string]$registry.registry_mode)) { [string]$registry.registry_mode } else { 'enterprise' }
80:   $repoCount = if (($registry.PSObject.Properties.Name -contains 'repos') -and $null -ne $registry.repos) { @($registry.repos).Count } else { 0 }
81:   Write-Host "Registry summary: mode=$registryMode, repos=$repoCount"
82: }
83: if (Test-Path $summaryReportPath) {
84:   $summary = Get-Content -Raw -Path $summaryReportPath | ConvertFrom-Json -Depth 20
85:   Write-Host "Intake summary: generated for $($summary.repos_count) repos"
86: }
87: Write-Host 'Artifacts:'
88: Write-Host '  - repo-intake/generated/reports/setup-validation.json'
89: Write-Host '  - repo-intake/generated/reports/repo-registry-validation.json'
90: Write-Host '  - repo-intake/generated/reports/SUMMARY.json'
</file>

<file path="scripts/README.md">
  1: # Scripts Index
  2: 
  3: Indice operativo de scripts del repositorio. Objetivo: crecer sin caos, con un punto unico de entrada.
  4: 
  5: ## Estructura canonica (viva)
  6: 
  7: - `scripts/setup/*`: bootstrap y validacion de entorno.
  8: - `scripts/intake/*`: registry, intake, routing y preflight.
  9: - `scripts/ops/*`: arranque y cierre diario.
 10: - `scripts/discovery/*`: descubrimiento y notas de proyecto.
 11: - `scripts/context/*`: construccion de contexto (Graphify/Repomix/Azure adapter).
 12: - `scripts/learning/*`: feedback, metricas y gates de aprendizaje.
 13: 
 14: Todas las ejecuciones deben usar rutas canonicas por subcarpeta.
 15: 
 16: ## Convenciones
 17: 
 18: - Preferir `cmd` wrappers en Windows cuando exista equivalente (`run-repo-intake.cmd`).
 19: - Scripts de verificacion y pipeline deben ser idempotentes.
 20: - Evitar rutas hardcodeadas fuera del repo.
 21: 
 22: ## Setup y bootstrap
 23: 
 24: - `bootstrap-portable.ps1`: orquesta setup portable + validacion + init registry + intake.
 25: - `bootstrap-portable.cmd`: wrapper CMD unico recomendado en Windows para bootstrap portable completo.
 26: - `setup/setup-prerequisites.ps1`: instala y prepara dependencias base (MCP + tooling).
 27: - `setup/setup-codegraph.ps1`: setup de CodeGraph.
 28: - `setup/setup-gitnexus.ps1`: setup de GitNexus.
 29: - `setup/optimize-engines.ps1`: auditoria/optimizacion exhaustiva de motores MCP (CodeGraph, GitNexus, Graphify, Repomix).
 30: - `setup/start-gitnexus.ps1`: indexa si hace falta, levanta backend web y abre UI local.
 31: - `setup/setup-graphify.ps1`: setup de Graphify.
 32: - `setup/validate-context.ps1`: verificacion de prerequisitos locales.
 33: - `../tooling/tooling.manifest.json`: fuente de verdad de CLIs externos requeridos.
 34: 
 35: ## Repo intake y routing
 36: 
 37: - `intake/validate-repo-registry.py`: valida `repo-registry/repos.yml` (strict opcional). Soporta `type=npm` (paquetes instalados en `node_modules`).
 38: - `intake/validate-repo-registry.ps1`: wrapper PowerShell de validacion del registry.
 39: - `intake/init-template-registry.ps1`: inicializa `repo-registry/repos.yml` desde la plantilla portable.
 40: - `intake/init-template-registry.cmd`: wrapper CMD recomendado en Windows para inicializar el registry plantilla.
 41: - `intake/repo-intake.py`: genera artefactos intake por paquete npm y extrae el catalogo de capacidades desde `mcpee.json`.
 42: - `intake/run-repo-intake.cmd`: wrapper recomendado en Windows para intake.
 43: - `intake/run-repo-intake.ps1`: wrapper PowerShell para intake.
 44: - `intake/resolve-routing.py`: resuelve ruta por capabilities/engine/fallback y puede registrar metricas de tokens por llamada con `--input-tokens --output-tokens`.
 45: - `intake/run-routing-evals.py`: ejecuta casos de prueba de routing.
 46: - `intake/agent-pipeline-preflight.py`: chequea integridad agente -> skills -> repos.
 47: 
 48: ## Operacion diaria
 49: 
 50: - `ops/hi.ps1`: preflight de inicio (contexto, intake, routing, salud).
 51: - `ops/bye.ps1`: cierre con refreshes, reportes y retencion automatica de logs de sesion (`observability/logs/session`) con `RetentionDays=15` por defecto.
 52: 
 53: ## Descubrimiento y sincronizacion
 54: 
 55: - `discovery/discover-boost-repos.py`: descubrimiento de repos boost.
 56: - `discovery/discover-boost-repos.cmd`: wrapper CMD para descubrimiento.
 57: - `discovery/refresh-project-notes.py`: refresca notas de proyecto desde observabilidad.
 58: 
 59: ## Contexto y snapshots
 60: 
 61: - `context/build-graphify.ps1`: reconstruye salida de Graphify.
 62: - `context/build-repomix.ps1`: genera snapshot Repomix.
 63: - `context/azure-rag-mcp-adapter.py`: adaptador para flujo Azure RAG MCP.
 64: 
 65: ## Learning y observabilidad
 66: 
 67: - `learning/record-learning-feedback.py`: registro de feedback de ejecucion.
 68: - `learning/record-iteration-metrics.py`: registro de metricas por iteracion.
 69: - `learning/ingest-copilot-session-usage.py`: ingesta best-effort de uso de tokens desde logs de sesion de VS Code Copilot hacia `iteration-metrics.jsonl` (incluye `copilot_credits` cuando el log lo expone).
 70: - `learning/chat-token-usage-report.py`: reporte agregado de tokens y costo en creditos solo de chat (`usage.source=copilot-session`) con salida JSON+Markdown. Soporta `--plan` (`free|pro|pro+|max|business|enterprise`) y `--seats` para calcular presupuesto mensual incluido y sobreconsumo. Referencia oficial de planes/precio cuando haga falta validar creditos incluidos: https://github.com/features/copilot/plans?ref_cta=View+pricing+and+plans&ref_loc=hero&ref_page=%2Ffeatures_copilot_copilot_business&plans=business
 71: - `learning/learning-loop-report.py`: reporte de aprendizaje continuo.
 72: - `learning/iteration-value-report.py`: reporte de valor por iteracion.
 73: - `learning/autolearning-gate.py`: gate automatizado de aprendizaje.
 74: 
 75: ## Flujos recomendados
 76: 
 77: Setup inicial:
 78: 
 79: ```powershell
 80: .\scripts\bootstrap-portable.cmd
 81: .\scripts\setup\setup-prerequisites.ps1
 82: .\scripts\setup\validate-context.ps1
 83: .\scripts\setup\optimize-engines.ps1 -InstallMissing
 84: ```
 85: 
 86: Optimización profunda (skills + embeddings en GitNexus):
 87: 
 88: ```powershell
 89: .\scripts\setup\optimize-engines.ps1 -DeepGitNexus
 90: ```
 91: 
 92: Validacion operativa minima:
 93: 
 94: ```powershell
 95: pwsh -ExecutionPolicy Bypass -NoProfile -File .\scripts\setup\validate-context.ps1 -PortableMode
 96: .\scripts\intake\init-template-registry.cmd
 97: py -3 .\scripts\intake\validate-repo-registry.py --strict
 98: .\scripts\intake\run-repo-intake.cmd
 99: py -3 .\scripts\intake\agent-pipeline-preflight.py
100: py -3 .\scripts\intake\run-routing-evals.py
101: ```
102: 
103: Operacion diaria:
104: 
105: ```powershell
106: .\scripts\ops\hi.ps1
107: # ... trabajo ...
108: .\scripts\ops\bye.ps1
109: ```
</file>

<file path="specs/mcpee-boost-mcpee-backend/specs/api-design.md">
 1: # API Design Spec
 2: 
 3: ## Purpose
 4: 
 5: Define stable, consumer-safe API contracts that are explicit, evolvable, and operationally clear.
 6: 
 7: This spec represents universal backend boost knowledge. It must not contain customer-specific documentation or project-specific one-off decisions.
 8: 
 9: ## Principles
10: 
11: - Model APIs around business resources and use consistent semantics for read/write behavior.
12: - Design contracts for forward/backward compatibility and explicit deprecation strategy.
13: - Standardize error and pagination contracts to reduce client integration ambiguity.
14: 
15: ## Validation Rules
16: 
17: - Every endpoint has clear ownership, auth requirements, and idempotency expectations.
18: - Breaking changes require version strategy, migration path, and consumer impact assessment.
19: - Error payloads and status codes are consistent across bounded contexts.
20: 
21: ## Anti-Patterns
22: 
23: - Inconsistent contract shapes across endpoints that force client-specific workarounds.
24: - Silent behavior changes under the same versioned contract.
25: - Leaking internal persistence models directly as public API contracts.
26: 
27: ## Evidence Required
28: 
29: Use route definitions, DTO schemas, API docs, and integration test coverage to validate contract quality.
30: 
