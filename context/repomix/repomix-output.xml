48:     /// <summary>
49:     /// Obtiene todas las candidaturas contratadas para una oferta
50:     /// </summary>
51:     public async Task<IEnumerable<Candidatura>> GetContratadasAsync(Guid ofertaId, CancellationToken cancellationToken = default)
52:     {
53:         var candidaturas = await FindAsync(
54:             predicate: c => c.IsActive && c.OfertaId == ofertaId && c.Estado == CandidaturaEstado.Contratada,
55:             cancellationToken: cancellationToken
56:         );
57:         return candidaturas.OrderByDescending(c => c.FechaSolicitud);
58:     }
59:     /// <summary>
60:     /// Verifica si existe una candidatura para una oferta y junior específicos
61:     /// </summary>
62:     public async Task<bool> ExisteCandidaturaAsync(Guid ofertaId, string juniorId, CancellationToken cancellationToken = default)
63:     {
64:         return await ExistsAsync(
65:             predicate: c => c.IsActive && c.OfertaId == ofertaId && c.JuniorId == juniorId,
66:             cancellationToken: cancellationToken
67:         );
68:     }
69: }
