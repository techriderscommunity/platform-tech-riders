242: ## Reference Materials
243: 
244: ### Example Dockerfile
245: 
246: An example Dockerfile for an ASP.NET (.NET Framework) application using a Windows Server Core base image.
247: 
248: ```dockerfile
249: # escape=`
250: # The escape directive changes the escape character from \ to `
251: # This is especially useful in Windows Dockerfiles where \ is the path separator
252: 
253: # ============================================================
254: # Stage 1: Build and publish the application
255: # ============================================================
256: 
257: # Base Image - Select the appropriate .NET Framework version and Windows Server Core version
258: # Possible tags include:
259: # - 4.8.1-windowsservercore-ltsc2025 (Windows Server 2025)
260: # - 4.8-windowsservercore-ltsc2022 (Windows Server 2022)
261: # - 4.8-windowsservercore-ltsc2019 (Windows Server 2019)
262: # - 4.8-windowsservercore-ltsc2016 (Windows Server 2016)
263: # - 4.7.2-windowsservercore-ltsc2019 (Windows Server 2019)
264: # - 4.7.2-windowsservercore-ltsc2016 (Windows Server 2016)
265: # - 4.7.1-windowsservercore-ltsc2016 (Windows Server 2016)
266: # - 4.7-windowsservercore-ltsc2016 (Windows Server 2016)
267: # - 4.6.2-windowsservercore-ltsc2016 (Windows Server 2016)
268: # - 3.5-windowsservercore-ltsc2025 (Windows Server 2025)
269: # - 3.5-windowsservercore-ltsc2022 (Windows Server 2022)
270: # - 3.5-windowsservercore-ltsc2019 (Windows Server 2019)
271: # - 3.5-windowsservercore-ltsc2019 (Windows Server 2016)
272: # Uses the .NET Framework SDK image for building the application
273: FROM mcr.microsoft.com/dotnet/framework/sdk:4.8-windowsservercore-ltsc2022 AS build
274: ARG BUILD_CONFIGURATION=Release
275: 
276: # Set the default shell to PowerShell
277: SHELL ["powershell", "-command"]
278: 
279: WORKDIR /app
280: 
281: # Copy the solution and project files
282: COPY YourSolution.sln .
283: COPY YourProject/*.csproj ./YourProject/
284: COPY YourOtherProject/*.csproj ./YourOtherProject/
285: 
286: # Copy packages.config files
287: COPY YourProject/packages.config ./YourProject/
288: COPY YourOtherProject/packages.config ./YourOtherProject/
289: 
290: # Restore NuGet packages
291: RUN nuget restore YourSolution.sln
292: 
293: # Copy source code
294: COPY . .
295: 
296: # Perform custom pre-build steps here, if needed
297: 
298: # Build and publish the application to C:\publish
299: RUN msbuild /p:Configuration=$BUILD_CONFIGURATION `
300:             /p:WebPublishMethod=FileSystem `
301:             /p:PublishUrl=C:\publish `
302:             /p:DeployDefaultTarget=WebPublish
303: 
304: # Perform custom post-build steps here, if needed
305: 
306: # ============================================================
307: # Stage 2: Final runtime image
308: # ============================================================
309: 
310: # Base Image - Select the appropriate .NET Framework version and Windows Server Core version
311: # Possible tags include:
312: # - 4.8.1-windowsservercore-ltsc2025 (Windows Server 2025)
313: # - 4.8-windowsservercore-ltsc2022 (Windows Server 2022)
314: # - 4.8-windowsservercore-ltsc2019 (Windows Server 2019)
315: # - 4.8-windowsservercore-ltsc2016 (Windows Server 2016)
316: # - 4.7.2-windowsservercore-ltsc2019 (Windows Server 2019)
317: # - 4.7.2-windowsservercore-ltsc2016 (Windows Server 2016)
318: # - 4.7.1-windowsservercore-ltsc2016 (Windows Server 2016)
319: # - 4.7-windowsservercore-ltsc2016 (Windows Server 2016)
320: # - 4.6.2-windowsservercore-ltsc2016 (Windows Server 2016)
321: # - 3.5-windowsservercore-ltsc2025 (Windows Server 2025)
322: # - 3.5-windowsservercore-ltsc2022 (Windows Server 2022)
323: # - 3.5-windowsservercore-ltsc2019 (Windows Server 2019)
324: # - 3.5-windowsservercore-ltsc2019 (Windows Server 2016)
325: # Uses the .NET Framework ASP.NET image for running the application
326: FROM mcr.microsoft.com/dotnet/framework/aspnet:4.8-windowsservercore-ltsc2022
327: 
328: # Set the default shell to PowerShell
329: SHELL ["powershell", "-command"]
330: 
331: WORKDIR /inetpub/wwwroot
332: 
333: # Copy from build stage
334: COPY --from=build /publish .
335: 
336: # Add any additional environment variables needed for your application (uncomment and modify as needed)
337: # ENV KEY=VALUE
338: 
339: # Install MSI packages (uncomment and modify as needed)
340: # COPY ./msi-installers C:/Installers
341: # RUN Start-Process -Wait -FilePath 'msiexec.exe' -ArgumentList '/i', 'C:\Installers\your-package.msi', '/quiet', '/norestart'
342: 
343: # Install custom Windows Server roles and features (uncomment and modify as needed)
344: # RUN dism /Online /Enable-Feature /FeatureName:YOUR-FEATURE-NAME
345: 
346: # Add additional Windows features (uncomment and modify as needed)
347: # RUN Add-WindowsFeature Some-Windows-Feature; `
348: #    Add-WindowsFeature Another-Windows-Feature
349: 
350: # Install MSI packages if needed (uncomment and modify as needed)
351: # COPY ./msi-installers C:/Installers
352: # RUN Start-Process -Wait -FilePath 'msiexec.exe' -ArgumentList '/i', 'C:\Installers\your-package.msi', '/quiet', '/norestart'
353: 
354: # Register assemblies in GAC if needed (uncomment and modify as needed)
355: # COPY ./assemblies C:/Assemblies
356: # RUN C:\Windows\Microsoft.NET\Framework64\v4.0.30319\gacutil -i C:/Assemblies/YourAssembly.dll
357: 
358: # Register COM components if needed (uncomment and modify as needed)
359: # COPY ./com-components C:/Components
360: # RUN regsvr32 /s C:/Components/YourComponent.dll
361: 
362: # Add registry keys if needed (uncomment and modify as needed)
363: # RUN New-Item -Path 'HKLM:\Software\YourApp' -Force; `
364: #     Set-ItemProperty -Path 'HKLM:\Software\YourApp' -Name 'Setting' -Value 'Value'
365: 
366: # Configure IIS settings if needed (uncomment and modify as needed)
367: # RUN Import-Module WebAdministration; `
368: #     Set-ItemProperty 'IIS:\AppPools\DefaultAppPool' -Name somePropertyName -Value 'SomePropertyValue'; `
369: #     Set-ItemProperty 'IIS:\Sites\Default Web Site' -Name anotherPropertyName -Value 'AnotherPropertyValue'
370: 
371: # Expose necessary ports - By default, IIS uses port 80
372: EXPOSE 80
373: # EXPOSE 443  # Uncomment if using HTTPS
374: 
375: # Copy LogMonitor from the microsoft/windows-container-tools repository
376: WORKDIR /LogMonitor
377: RUN curl -fSLo LogMonitor.exe https://github.com/microsoft/windows-container-tools/releases/download/v2.1.1/LogMonitor.exe
378: 
379: # Copy LogMonitorConfig.json from local files
380: COPY LogMonitorConfig.json .
381: 
382: # Set non-administrator user
383: USER ContainerUser
384: 
385: # Override the container's default entry point to take advantage of the LogMonitor
386: ENTRYPOINT [ "C:\\LogMonitor\\LogMonitor.exe", "C:\\ServiceMonitor.exe", "w3svc" ]
387: ```
