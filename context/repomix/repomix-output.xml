<file path="techito/src/app/features/intranet/fp-tour/services/sesiones.service.ts">
 1: import { Injectable, inject } from '@angular/core';
 2: import { HttpClient, HttpParams } from '@angular/common/http';
 3: import { map } from 'rxjs/operators';
 4: import { environment } from '\.\./\.\./\.\./\.\./\.\./environments/environment';
 5: import { PagedResult, Sesion, SessionApi, SessionWorkflowApi, UpdateSessionWorkflowRequest } from '../models/sesiones.models';
 6: @Injectable({ providedIn: 'root' })
 7: export class SesionesService {
 8:   private readonly http = inject(HttpClient);
 9:   private readonly baseUrl = `${environment.apiUrl}/sessions`;
10:   getSesiones(page = 1, pageSize = 50, estado?: string) {
11:     let params = new HttpParams()
12:       .set('page', String(page))
13:       .set('pageSize', String(pageSize));
14:     if (estado) {
15:       params = params.set('estado', estado);
16:     }
17:     return this.http.get<SessionApi[]>(this.baseUrl, { params }).pipe(
18:       map((items) => {
19:         const mappedItems = (items ?? []).map((item): Sesion => ({
20:           id: item.Id,
21:           titulo: item.Title,
22:           centro: item.Event?.Name ?? 'Unassigned event',
23:           fecha: item.Event?.StartDate?.substring(0, 10) ?? '',
24:           categoria: item.Level ?? 'General',
25:           estado: item.IsActive ? 'Pendiente' : 'Cancelada',
26:           numAlumnos: item.MaxCapacity ?? 0,
27:           embajadorAsignadoId: null,
28:         }));
29:         return {
30:           items: mappedItems,
31:           totalCount: mappedItems.length,
32:           page,
33:           pageSize,
34:           totalPages: 1,
35:           hasNextPage: false,
36:           hasPreviousPage: false,
37:         } satisfies PagedResult<Sesion>;
38:       })
39:     );
40:   }
41:   createSesion(sesion: Omit<Sesion, 'id' | 'estado' | 'embajadorAsignadoId'>) {
42:     return this.http.post<string>(this.baseUrl, sesion);
43:   }
44:   getSessionWorkflow() {
45:     return this.http.get<Record<string, SessionWorkflowApi>>(`${this.baseUrl}/workflow`);
46:   }
47:   updateSessionWorkflow(sessionId: string, request: UpdateSessionWorkflowRequest) {
48:     return this.http.put<SessionWorkflowApi>(`${this.baseUrl}/${sessionId}/workflow`, request);
49:   }
50:   updateSesion(id: string, sesion: { titulo: string; centro: string; fecha: string; categoria: string; numAlumnos: number; }) {
51:     return this.http.put<void>(`${this.baseUrl}/${id}`, sesion);
52:   }
53: }
</file>

