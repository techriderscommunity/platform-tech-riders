33:         self.error = error
34:         start_dt = datetime.fromisoformat(self.started_at)
35:         end_dt = datetime.fromisoformat(self.ended_at)
36:         self.duration_ms = max(0.0, (end_dt - start_dt).total_seconds() * 1000.0)
