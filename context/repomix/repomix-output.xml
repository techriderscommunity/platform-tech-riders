<file path="scripts/wiki/query_autodocs.py">
 1: import json
 2: import sys
 3: from pathlib import Path
 4: from typing import Any, Dict, List, cast
 5: REPO_ROOT = Path(__file__).resolve().parents[2]
 6: SEARCH_INDEX_PATH = REPO_ROOT / "autodocs" / "generated" / "search-index.json"
 7: SearchEntry = Dict[str, Any]
 8: def _load_index() -> List[SearchEntry]:
 9:     if not SEARCH_INDEX_PATH.exists():
10:         return []
11:     with SEARCH_INDEX_PATH.open("r", encoding="utf-8") as handle:
12:         payload = json.load(handle)
13:     if isinstance(payload, list):
14:         entries: List[SearchEntry] = []
15:         for item in cast(List[Any], payload):
16:             if isinstance(item, dict):
17:                 entries.append(cast(SearchEntry, item))
18:         return entries
19:     return []
20: def _matches(entry: SearchEntry, query: str) -> bool:
21:     haystack = " ".join(
22:         [
23:             str(entry.get("title", "")),
24:             str(entry.get("summary", "")),
25:             str(entry.get("kind", "")),
26:             str(entry.get("domain", "")),
27:             " ".join(str(tag) for tag in entry.get("tags", [])),
28:         ]
29:     ).lower()
30:     return query.lower() in haystack
31: def main() -> int:
32:     query = " ".join(sys.argv[1:]).strip()
33:     if not query:
34:         print("Usage: py -3 -m scripts.wiki.query_autodocs <query>")
35:         return 1
36:     results = [entry for entry in _load_index() if _matches(entry, query)]
37:     if not results:
38:         print("No matches")
39:         return 0
40:     for entry in results:
41:         print(f"- {entry.get('title', '')} [{entry.get('kind', '')}] -> {entry.get('path', '')}")
42:         print(f"  {entry.get('summary', '')}")
43:     return 0
44: if __name__ == "__main__":
45:     raise SystemExit(main())
