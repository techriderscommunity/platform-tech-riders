 121:             generated_at = (Get-Date).ToUniversalTime().ToString('o')
 122:             source = 'hi-autofix'
 123:             note = 'Manifest generated because graph.json exists and manifest.json was missing.'
 124:             graph = 'context/graphify-out/graph.json'
 125:         }
 126: 
 127:         New-Item -ItemType Directory -Path (Split-Path -Parent $manifestPath) -Force | Out-Null
 128:         $manifest | ConvertTo-Json -Depth 10 | Set-Content -Path $manifestPath -Encoding UTF8
 129:         Write-Host "[info] Graphify manifest missing; generated fallback manifest at $manifestPath" -ForegroundColor DarkYellow
 130:     }
 131: }
