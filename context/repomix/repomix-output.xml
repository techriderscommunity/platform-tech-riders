 1: from __future__ import annotations
 2: from pathlib import Path
 3: from telemetry.collector.engine import TelemetryCollector
 4: from telemetry.config import load_config
 5: from telemetry.exporters.console.exporter import ConsoleExporter
 6: from telemetry.exporters.json.exporter import JsonExporter
 7: from telemetry.exporters.langsmith.exporter import LangSmithExporter
 8: def build_telemetry_collector(repo_root: Path) -> TelemetryCollector:
 9:     cfg = load_config(repo_root)
10:     exporters: list[object] = []
11:     # Console exporter is always available in runtime.
12:     if "console" in cfg.exporters:
13:         exporters.append(ConsoleExporter())
14:     elif not cfg.exporters:
15:         exporters.append(ConsoleExporter())
16:     if "json" in cfg.exporters:
17:         exporters.append(JsonExporter((repo_root / cfg.telemetry_dir).resolve()))
18:     if "langsmith" in cfg.exporters and cfg.langsmith.enabled:
19:         has_langsmith_config = bool(cfg.langsmith.api_key.strip()) and bool(cfg.langsmith.project.strip())
20:         if has_langsmith_config:
21:             try:
22:                 exporters.append(
23:                     LangSmithExporter(
24:                         api_key=cfg.langsmith.api_key,
25:                         project=cfg.langsmith.project,
26:                         endpoint=cfg.langsmith.endpoint,
27:                         workspace_id=cfg.langsmith.workspace_id,
28:                         high_signal_only=cfg.langsmith.high_signal_only,
29:                         min_span_duration_ms=cfg.langsmith.min_span_duration_ms,
30:                         emit_execution_summary=cfg.langsmith.emit_execution_summary,
31:                     )
32:                 )
33:             except Exception:
34:                 # LangSmith is optional and must never break startup.
35:                 pass
36:     if not exporters:
37:         exporters.append(ConsoleExporter())
38:     return TelemetryCollector(exporters=exporters, enabled=cfg.enabled, batch_size=cfg.batch_size)
