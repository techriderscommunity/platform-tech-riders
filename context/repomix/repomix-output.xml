<file path="techito/src/app/features/intranet/empleo/empresa/dashboard-empresa/dashboard-empresa.ts">
 1: import { ChangeDetectionStrategy, Component, signal, inject, DestroyRef } from '@angular/core';
 2: import { RouterLink } from '@angular/router';
 3: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
 4: import { EmpresaService } from '../services/empresa.service';
 5: import { Candidato, EmpresaDashboardStats, Oferta } from '../models/empresa.models';
 6: import { catchError, finalize, tap } from 'rxjs/operators';
 7: import { of } from 'rxjs';
 8: import { UiButton  } from '@shared/ui/button/button';
 9: @Component({
10:   selector: 'app-dashboard-empresa',
11:   standalone: true,
12:   changeDetection: ChangeDetectionStrategy.OnPush,
13:   imports: [RouterLink, UiButton],
14:   templateUrl: './dashboard-empresa.html',
15:   styleUrl: './dashboard-empresa.scss'
16: })
17: export class DashboardEmpresa {
18:   private readonly empresaService = inject(EmpresaService);
19:   private readonly destroyRef = inject(DestroyRef);
20:   readonly loading = signal(true);
21:   readonly error = signal<string | null>(null);
22:   readonly info = signal<string | null>(null);
23:   readonly nombreEmpresa = signal('');
24:   readonly stats = signal<EmpresaDashboardStats>({ ofertasActivas: 0, candidatosTotal: 0, enProceso: 0, contratados: 0 });
25:   readonly ultimasOfertas = signal<Oferta[]>([]);
26:   readonly ultimosCandidatos = signal<Candidato[]>([]);
27:   constructor() {
28:     this.loadDashboard();
29:   }
30:   private loadDashboard() {
31:     this.loading.set(true);
32:     this.error.set(null);
33:     this.empresaService.getDashboard()
34:       .pipe(
35:         tap((data) => {
36:           if (!data) {
37:             return;
38:           }
39:           this.nombreEmpresa.set(data.nombreEmpresa);
40:           this.stats.set(data.stats);
41:           this.ultimasOfertas.set(data.ultimasOfertas);
42:           this.ultimosCandidatos.set(data.ultimosCandidatos);
43:           this.info.set(null);
44:         }),
45:         catchError(() => {
46:           this.error.set('No se pudo cargar el dashboard');
47:           return of(null);
48:         }),
49:         finalize(() => this.loading.set(false)),
50:         takeUntilDestroyed(this.destroyRef)
51:       )
52:       .subscribe();
53:   }
54:   reintentarCarga() {
55:     this.loadDashboard();
56:   }
57: }
</file>

