<file path="techito/src/app/features/intranet/empleo/junior/services/junior.service.ts">
 1: import { Injectable, inject, signal } from '@angular/core';
 2: import { HttpClient, HttpParams } from '@angular/common/http';
 3: import { map } from 'rxjs/operators';
 4: import { environment } from '\.\./\.\./\.\./\.\./\.\./\.\./environments/environment';
 5: import { Curso, Evento, OfertaJunior, OfferApi, PagedResult } from '../models/junior.models';
 6: @Injectable({ providedIn: 'root' })
 7: export class JuniorService {
 8:   private readonly http = inject(HttpClient);
 9:   private readonly baseUrl = `${environment.apiUrl}`;
10:   readonly loading = signal(false);
11:   readonly error = signal<string | null>(null);
12:   readonly cursos = signal<Curso[]>([]);
13:   readonly eventos = signal<Evento[]>([]);
14:   private mapOfferStatus(status: number): string {
15:     if (status === 1) return 'Activa';
16:     if (status === 2) return 'Cerrada';
17:     return 'Borrador';
18:   }
19:   private mapModalidad(modalidad: number): string {
20:     if (modalidad === 1) return 'Hybrid';
21:     if (modalidad === 2) return 'On-site';
22:     return 'Remote';
23:   }
24:   getDashboard() {
25:     return this.getOfertas(1, 6);
26:   }
27:   getOfertas(page = 1, pageSize = 50, estado?: string, modalidad?: string) {
28:     let params = new HttpParams()
29:       .set('page', String(page))
30:       .set('pageSize', String(pageSize));
31:     if (estado) {
32:       params = params.set('estado', estado);
33:     }
34:     if (modalidad) {
35:       params = params.set('modalidad', modalidad);
36:     }
37:     return this.http.get<OfferApi[]>(`${this.baseUrl}/offers`, { params }).pipe(
38:       map((items) => {
39:         const mappedItems = (items ?? []).map((item): OfertaJunior => ({
40:           id: item.Id,
41:           titulo: item.Titulo,
42:           empresa: item.Empresa,
43:           salario: `${item.Salario}`,
44:           ubicacion: item.Ubicacion,
45:           modalidad: this.mapModalidad(item.Modalidad),
46:           estado: this.mapOfferStatus(item.Estado),
47:           fechaPublicacion: item.FechaPublicacion,
48:         }));
49:         return {
50:           items: mappedItems,
51:           totalCount: mappedItems.length,
52:           page,
53:           pageSize,
54:           totalPages: 1,
55:           hasNextPage: false,
56:           hasPreviousPage: false,
57:         } satisfies PagedResult<OfertaJunior>;
58:       })
59:     );
60:   }
61:   enviarSolicitud(ofertaId: string, juniorId: string, nombreJunior: string, emailJunior: string) {
62:     return this.http.post(`${this.baseUrl}/applications`, {
63:       ofertaId,
64:       juniorId,
65:       nombreJunior,
66:       emailJunior,
67:       cartaPresentacion: null,
68:     });
69:   }
70: }
</file>

