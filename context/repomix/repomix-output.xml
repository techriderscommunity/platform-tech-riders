 476: function Get-StructureSnapshot {
 477:     param(
 478:         [string]$RepoRoot,
 479:         [object]$Repo
 480:     )
 481: 
 482:     $repoName = Get-RepoField -Repo $Repo -Name 'name'
 483:     $slug = $repoName.ToLower() -replace '[^a-z0-9_-]+', '-'
 484:     $repoPath = Resolve-RegistryRepoPath -Root $RepoRoot -Repo $Repo
 485:     $structurePath = Join-Path $RepoRoot ("repo-intake/generated/{0}/context-manifests/structure-min.json" -f $slug)
 486: 
 487:     $repoLatest = [datetime]::MinValue
 488:     if (Test-Path $repoPath) {
 489:         $pathsToCheck = @(
 490:             $repoPath,
 491:             (Join-Path $repoPath 'AGENTS.md'),
 492:             (Join-Path $repoPath 'README.md'),
 493:             (Join-Path $repoPath 'ARCHITECTURE.md'),
 494:             (Join-Path $repoPath '.github/skills'),
 495:             (Join-Path $repoPath '.github/prompts'),
 496:             (Join-Path $repoPath 'scripts'),
 497:             (Join-Path $repoPath 'specs')
 498:         )
 499: 
 500:         foreach ($path in $pathsToCheck) {
 501:             $lastWrite = Get-PathLastWriteUtc -Path $path
 502:             if ($lastWrite -gt $repoLatest) {
 503:                 $repoLatest = $lastWrite
 504:             }
 505:         }
 506:     }
 507: 
 508:     $exists = Test-Path $structurePath
 509:     $structureMtime = [datetime]::MinValue
 510:     $cacheFingerprint = ''
 511:     $structureRepoExists = $false
 512: 
 513:     if ($exists) {
 514:         $structureMtime = (Get-Item $structurePath).LastWriteTimeUtc
 515:         $structureData = Get-Content $structurePath -Raw | ConvertFrom-Json -Depth 20
 516:         $cacheFingerprint = [string]$structureData.cache_fingerprint
 517:         $structureRepoExists = [bool]$structureData.exists
 518:     }
 519: 
 520:     $status = 'fresh'
 521:     if (-not $exists) {
 522:         $status = 'missing'
 523:     }
 524:     elseif ((Test-Path $repoPath) -and $repoLatest -gt $structureMtime) {
 525:         $status = 'stale'
 526:     }
 527: 
 528:     return [ordered]@{
 529:         repo = $repoName
 530:         slug = $slug
 531:         version = '0'
 532:         repo_path = $repoPath
 533:         structure_path = $structurePath
 534:         structure_exists = $exists
 535:         structure_reports_repo_exists = $structureRepoExists
 536:         cache_fingerprint = $cacheFingerprint
 537:         repo_latest_change_utc = if ($repoLatest -eq [datetime]::MinValue) { '' } else { $repoLatest.ToString('o') }
 538:         structure_mtime_utc = if ($structureMtime -eq [datetime]::MinValue) { '' } else { $structureMtime.ToString('o') }
 539:         status = $status
 540:     }
 541: }
