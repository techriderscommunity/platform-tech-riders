133:   // 999px is effectively the same as radius-full
134:   { from: /\bborder-radius:\s*999px\b/g,   to: 'border-radius: var(--radius-full)' },
135: ];
136: // ─── File processing ─────────────────────────────────────────────────────────
137: function applyRules(content, rules) {
138:   let result = content;
139:   for (const rule of rules) {
140:     if (rule.onlyInValuePosition) {
141:       // Only replace 'white' when it appears after ':' (CSS value context)
142:       // Use a negative lookbehind to avoid matching class names / selectors
143:       result = result.replace(/(?<=:\s*(?:[^{};]*[,\s])?)\bwhite\b(?!\s*-)/g, 'var(--color-white)');
144:     } else {
145:       result = result.replace(rule.from, rule.to);
146:     }
147:   }
148:   return result;
149: }
150: function processFile(filePath) {
151:   let content = fs.readFileSync(filePath, 'utf8');
152:   const original = content;
153:   content = applyRules(content, COLOR_RULES);
154:   content = applyRules(content, SPACING_RULES);
155:   content = applyRules(content, SHADOW_RULES);
156:   content = applyRules(content, RADIUS_RULES);
157:   if (content !== original) {
158:     fs.writeFileSync(filePath, content, 'utf8');
159:     return true;
160:   }
161:   return false;
162: }
163: // ─── Walk src/app for SCSS files ─────────────────────────────────────────────
164: function walk(dir) {
165:   const results = [];
166:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
167:     const full = path.join(dir, entry.name);
168:     if (entry.isDirectory()) results.push(...walk(full));
169:     else if (entry.name.endsWith('.scss')) results.push(full);
170:   }
171:   return results;
172: }
173: const appDir = path.join(__dirname, '..', 'src', 'app');
174: const files = walk(appDir);
175: let changed = 0;
176: for (const f of files) {
177:   if (processFile(f)) {
178:     changed++;
179:     console.log(`✅ ${path.relative(appDir, f)}`);
180:   }
181: }
182: console.log(`\nDone. ${changed}/${files.length} files updated.`);
