504: def discover_installed_boost_repos(repo_root: Path, repo_name_prefix: str) -> list[dict]:
505:     discovered: list[dict] = []
506:     node_modules = repo_root / 'node_modules'
507:     if not node_modules.exists():
508:         return discovered
509:     contracts: list[Path] = []
510:     # Scoped packages: node_modules/@scope/pkg/mcpee.json
511:     for scope_dir in sorted(node_modules.glob('@*')):
512:         if not scope_dir.is_dir():
513:             continue
514:         contracts.extend(sorted(scope_dir.glob('*/mcpee.json')))
515:     # Unscoped packages: node_modules/pkg/mcpee.json
516:     contracts.extend(sorted(node_modules.glob('*/mcpee.json')))
517:     seen_packages: set[str] = set()
518:     for contract_path in contracts:
519:         try:
520:             contract = json.loads(contract_path.read_text(encoding='utf-8'))
521:         except Exception:
522:             continue
523:         if not isinstance(contract, dict):
524:             continue
525:         package_name = str(contract.get('name', '')).strip()
526:         if not package_name:
527:             try:
528:                 rel = contract_path.parent.relative_to(node_modules)
529:                 package_name = str(rel).replace('\\', '/')
530:             except Exception:
531:                 package_name = contract_path.parent.name
532:         if package_name in seen_packages:
533:             continue
534:         seen_packages.add(package_name)
535:         domain = str(contract.get('domain', '')).strip() or 'general'
536:         repo_name = f"{repo_name_prefix}{contract_path.parent.name}" if repo_name_prefix else contract_path.parent.name
537:         discovered.append(
538:             {
539:                 'name': repo_name,
540:                 'domain': domain,
541:                 'type': 'npm',
542:                 'package_name': package_name,
543:                 'package_path': str(contract_path.parent.relative_to(repo_root)).replace('\\', '/'),
544:                 'optional': False,
545:                 'dependencies': [],
546:                 'approval': {
547:                     'status': 'approved',
548:                     'approved_by': 'auto-discovery',
549:                     'approved_date': utc_now()[:10],
550:                     'review_ticket': 'AUTO-DISCOVERY',
551:                 },
552:                 'engines': {},
553:             }
554:         )
555:     return discovered
