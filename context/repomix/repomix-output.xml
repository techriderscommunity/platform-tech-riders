  1: import {
  2:   AfterViewInit,
  3:   ChangeDetectionStrategy,
  4:   Component,
  5:   ElementRef,
  6:   Input,
  7:   OnDestroy,
  8:   ViewChild,
  9: } from '@angular/core';
 10: import { DomSanitizer, SafeResourceUrl } from '@angular/platform-browser';
 11: import { RouterLink } from '@angular/router';
 12: export interface UiCarouselItem {
 13:   kind: 'image' | 'video';
 14:   src: string;
 15:   title: string;
 16:   alt?: string;
 17:   subtitle?: string;
 18:   link?: string | readonly string[];
 19:   socials?: Array<{
 20:     platform: 'linkedin' | 'github' | 'x' | 'instagram' | 'youtube';
 21:     href: string;
 22:   }>;
 23: }
 24: @Component({
 25:   selector: 'app-ui-media-carousel',
 26:   standalone: true,
 27:   imports: [RouterLink],
 28:   templateUrl: './media-carousel.html',
 29:   styleUrl: './media-carousel.scss',
 30:   changeDetection: ChangeDetectionStrategy.OnPush,
 31: })
 32: export class UiMediaCarousel implements AfterViewInit, OnDestroy {
 33:   @ViewChild('track', { static: false })
 34:   track?: ElementRef<HTMLDivElement>;
 35:   @Input() ariaLabel = 'Carrusel';
 36:   @Input() autoplay = false;
 37:   @Input() autoplayDelayMs = 3500;
 38:   @Input() showCaptions = true;
 39:   @Input() cardMinWidth = '260px';
 40:   @Input() fixedColumnsDesktop: number | null = null;
 41:   @Input()
 42:   set items(value: UiCarouselItem[]) {
 43:     this._items = value ?? [];
 44:     this.videoSrcMap.clear();
 45:   }
 46:   get items(): UiCarouselItem[] {
 47:     return this._items;
 48:   }
 49:   get hasMultipleItems(): boolean {
 50:     return this._items.length > 1;
 51:   }
 52:   get showControls(): boolean {
 53:     if (this.fixedColumnsDesktop === null || this.fixedColumnsDesktop === undefined) {
 54:       return this.hasMultipleItems;
 55:     }
 56:     return this._items.length > this.fixedColumnsDesktop;
 57:   }
 58:   private _items: UiCarouselItem[] = [];
 59:   private autoplayTimer: ReturnType<typeof setInterval> | null = null;
 60:   private touchStartX = 0;
 61:   private touchStartY = 0;
 62:   private readonly videoSrcMap = new Map<string, SafeResourceUrl>();
 63:   constructor(private readonly sanitizer: DomSanitizer) {}
 64:   ngAfterViewInit(): void {
 65:     this.startAutoplay();
 66:   }
 67:   ngOnDestroy(): void {
 68:     this.stopAutoplay();
 69:   }
 70:   prev(): void {
 71:     this.scrollByDirection(-1);
 72:   }
 73:   next(): void {
 74:     this.scrollByDirection(1);
 75:   }
 76:   onMouseEnter(): void {
 77:     this.stopAutoplay();
 78:   }
 79:   onMouseLeave(): void {
 80:     this.startAutoplay();
 81:   }
 82:   onFocusIn(): void {
 83:     this.stopAutoplay();
 84:   }
 85:   onFocusOut(): void {
 86:     this.startAutoplay();
 87:   }
 88:   onTouchStart(event: TouchEvent): void {
 89:     const touch = event.touches[0];
 90:     this.touchStartX = touch.clientX;
 91:     this.touchStartY = touch.clientY;
 92:     this.stopAutoplay();
 93:   }
 94:   onTouchEnd(event: TouchEvent): void {
 95:     const touch = event.changedTouches[0];
 96:     const deltaX = touch.clientX - this.touchStartX;
 97:     const deltaY = touch.clientY - this.touchStartY;
 98:     if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
 99:       this.scrollByDirection(deltaX < 0 ? 1 : -1);
100:     }
101:     this.startAutoplay();
102:   }
103:   getSafeVideoUrl(src: string): SafeResourceUrl {
104:     const existing = this.videoSrcMap.get(src);
105:     if (existing) {
106:       return existing;
107:     }
108:     const safeUrl = this.sanitizer.bypassSecurityTrustResourceUrl(src);
109:     this.videoSrcMap.set(src, safeUrl);
110:     return safeUrl;
111:   }
112:   private startAutoplay(): void {
113:     if (!this.autoplay || this.autoplayTimer || !this.track?.nativeElement || !this.showControls) {
114:       return;
115:     }
116:     this.autoplayTimer = setInterval(() => this.scrollByDirection(1), this.autoplayDelayMs);
117:   }
118:   private stopAutoplay(): void {
119:     if (!this.autoplayTimer) {
120:       return;
121:     }
122:     clearInterval(this.autoplayTimer);
123:     this.autoplayTimer = null;
124:   }
125:   private scrollByDirection(direction: 1 | -1): void {
126:     const trackEl = this.track?.nativeElement;
127:     if (!trackEl || !this.showControls) {
128:       return;
129:     }
130:     const maxScrollLeft = trackEl.scrollWidth - trackEl.clientWidth;
131:     const edgeTolerance = 2;
132:     if (direction > 0 && trackEl.scrollLeft >= maxScrollLeft - edgeTolerance) {
133:       trackEl.scrollTo({ left: 0, behavior: 'smooth' });
134:       return;
135:     }
136:     if (direction < 0 && trackEl.scrollLeft <= edgeTolerance) {
137:       trackEl.scrollTo({ left: maxScrollLeft, behavior: 'smooth' });
138:       return;
139:     }
140:     const slides = Array.from(trackEl.querySelectorAll<HTMLElement>('.ui-carousel-slide'));
141:     if (!slides.length) {
142:       return;
143:     }
144:     const currentScroll = trackEl.scrollLeft;
145:     let currentIndex = 0;
146:     let smallestDistance = Number.POSITIVE_INFINITY;
147:     for (let index = 0; index < slides.length; index += 1) {
148:       const distance = Math.abs(slides[index].offsetLeft - currentScroll);
149:       if (distance < smallestDistance) {
150:         smallestDistance = distance;
151:         currentIndex = index;
152:       }
153:     }
154:     const nextIndex = direction > 0
155:       ? (currentIndex + 1) % slides.length
156:       : (currentIndex - 1 + slides.length) % slides.length;
157:     trackEl.scrollTo({
158:       left: slides[nextIndex].offsetLeft,
159:       behavior: 'smooth',
160:     });
161:   }
