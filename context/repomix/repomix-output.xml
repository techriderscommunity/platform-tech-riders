135:         "prompt": "routing",
136:         "policy": "policies",
137:         "project": "projects",
138:         "spec": "specs",
139:         "report": "reports",
140:         "capability": "capabilities",
141:     }
142:     return mapping.get(kind, "misc")
143: def _source_refs(boost: str) -> List[str]:
144:     return [
145:         f"repo-intake/generated/{boost}/capabilities/capability.json",
146:         f"repo-intake/generated/{boost}/context-manifests/manifest.json",
147:     ]
148: def _tags(provider: str, domain: str, kind: str, engine: str, agent: str) -> List[str]:
149:     values = [provider, domain, kind, engine, agent]
150:     tags = []
151:     for value in values:
152:         normalized = str(value).strip().lower()
153:         if normalized and normalized not in tags:
154:             tags.append(normalized)
155:     return tags
156: def _summary_for_node(
157:     title: str,
158:     kind: str,
159:     domain: str,
160:     provider: str,
161:     capability: Dict[str, Any],
