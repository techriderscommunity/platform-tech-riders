<file path="techito/src/app/core/auth/auth.guard.spec.ts">
 1: import { TestBed } from '@angular/core/testing';
 2: import { provideRouter, Router, UrlTree } from '@angular/router';
 3: import { authGuard, roleGuard } from './auth.guard';
 4: import { AuthService } from './auth.service';
 5: describe('auth guards', () => {
 6:   let router: Router;
 7:   const authMock = {
 8:     isAuthenticated: jasmine.createSpy('isAuthenticated'),
 9:     user: jasmine.createSpy('user'),
10:     hasRole: jasmine.createSpy('hasRole'),
11:     getDefaultRoute: jasmine.createSpy('getDefaultRoute'),
12:   };
13:   beforeEach(() => {
14:     authMock.isAuthenticated.calls.reset();
15:     authMock.user.calls.reset();
16:     authMock.hasRole.calls.reset();
17:     authMock.getDefaultRoute.calls.reset();
18:     TestBed.configureTestingModule({
19:       providers: [
20:         provideRouter([]),
21:         { provide: AuthService, useValue: authMock },
22:       ],
23:     });
24:     router = TestBed.inject(Router);
25:   });
26:   it('authGuard should allow authenticated users', () => {
27:     authMock.isAuthenticated.and.returnValue(true);
28:     const result = TestBed.runInInjectionContext(() => authGuard({} as any, { url: '/intranet/admin' } as any));
29:     expect(result).toBeTrue();
30:   });
31:   it('authGuard should redirect anonymous users to login', () => {
32:     authMock.isAuthenticated.and.returnValue(false);
33:     const result = TestBed.runInInjectionContext(() => authGuard({} as any, { url: '/intranet/admin' } as any)) as UrlTree;
34:     expect(router.serializeUrl(result)).toBe('/?login=1&returnUrl=%2Fintranet%2Fadmin');
35:   });
36:   it('roleGuard should allow matching role', () => {
37:     authMock.isAuthenticated.and.returnValue(true);
38:     authMock.hasRole.and.returnValue(true);
39:     const result = TestBed.runInInjectionContext(() => roleGuard('admin')({} as any, {} as any));
40:     expect(result).toBeTrue();
41:   });
42:   it('roleGuard should redirect to role area on role mismatch', () => {
43:     authMock.isAuthenticated.and.returnValue(true);
44:     authMock.hasRole.and.returnValue(false);
45:     authMock.getDefaultRoute.and.returnValue('/intranet/empresa');
46:     const result = TestBed.runInInjectionContext(() => roleGuard('admin')({} as any, {} as any)) as UrlTree;
47:     expect(router.serializeUrl(result)).toBe('/intranet/empresa');
48:   });
49:   it('roleGuard should redirect anonymous users to login', () => {
50:     authMock.isAuthenticated.and.returnValue(false);
51:     authMock.user.and.returnValue(null);
52:     const result = TestBed.runInInjectionContext(() => roleGuard('junior')({} as any, { url: '/intranet/junior' } as any)) as UrlTree;
53:     expect(router.serializeUrl(result)).toBe('/?login=1&returnUrl=%2Fintranet%2Fjunior');
54:   });
55: });
</file>

