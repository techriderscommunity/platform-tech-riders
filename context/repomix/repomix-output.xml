 187: function Invoke-LoggedAction {
 188:     param(
 189:         [string]$StepName,
 190:         [scriptblock]$Action,
 191:         [string[]]$InfoLines = @()
 192:     )
 193: 
 194:     $logPath = New-StepLogPath -StepName $StepName
 195:     Write-Host ("[info] Running {0} (live log: {1})" -f $StepName, $logPath)
 196: 
 197:     try {
 198:         & {
 199:             & $Action
 200:         } *>&1 | Tee-Object -FilePath $logPath -Append | Out-Host
 201:     }
 202:     catch {
 203:         throw "$StepName failed. Log: $logPath. Error: $($_.Exception.Message)"
 204:     }
 205: 
 206:     $exitCode = $LASTEXITCODE
 207:     if ($exitCode -ne 0) {
 208:         throw "$StepName failed with exit code $exitCode. Log: $logPath"
 209:     }
 210: 
 211:     foreach ($infoLine in $InfoLines) {
 212:         Write-Host ("[info] {0}" -f $infoLine)
 213:     }
 214:     Write-Host ("[info] Log: {0}" -f $logPath)
 215: 
 216:     return $logPath
 217: }
