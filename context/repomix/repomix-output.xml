<file path="scripts/setup/setup-prerequisites.ps1">
  1: param(
  2:     [switch]$SkipCodebaseMemory,
  3:     [switch]$SkipTokenSaver,
  4:     [switch]$SkipCodegraph,
  5:     [switch]$SkipGitnexus,
  6:     [switch]$SkipGraphify,
  7:     [switch]$SkipRepomix,
  8:     [switch]$PortableMode,
  9:     [switch]$VerboseTrace
 10: )
 11: 
 12: $ErrorActionPreference = 'Stop'
 13: 
 14: $repoRoot = (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path
 15: Set-Location $repoRoot
 16: $toolingManifestPath = Join-Path $repoRoot 'tooling/tooling.manifest.json'
 17: 
 18: function Test-Command {
 19:     param([Parameter(Mandatory = $true)][string]$Name)
 20: 
 21:     return [bool](Get-Command -Name $Name -ErrorAction SilentlyContinue)
 22: }
 23: 
 24: function Write-TraceStep {
 25:     param(
 26:         [Parameter(Mandatory = $true)][string]$Message
 27:     )
 28: 
 29:     if ($VerboseTrace) {
 30:         $stamp = (Get-Date).ToString('HH:mm:ss')
 31:         Write-Host ("[trace {0}] {1}" -f $stamp, $Message) -ForegroundColor DarkGray
 32:     }
 33: }
 34: 
 35: function Install-NpmGlobalPackage {
 36:     param(
 37:         [Parameter(Mandatory = $true)][string]$Package,
 38:         [Parameter(Mandatory = $true)][string]$ExpectedCommand
 39:     )
 40: 
 41:     if (Test-Command $ExpectedCommand) {
 42:         Write-Host "[ok] $ExpectedCommand already installed"
 43:         return
 44:     }
 45: 
 46:     if (-not (Test-Command 'npm')) {
 47:         throw "npm is required to install $Package. Install Node.js first: https://nodejs.org/"
 48:     }
 49: 
 50:     Write-Host "[install] npm install -g $Package"
 51:     npm install -g $Package
 52: }
 53: 
 54: function Get-ToolingManifest {
 55:     param([Parameter(Mandatory = $true)][string]$Path)
 56: 
 57:     if (-not (Test-Path $Path)) {
 58:         throw "Missing tooling manifest: $Path"
 59:     }
 60: 
 61:     return Get-Content -Raw -Path $Path | ConvertFrom-Json -Depth 20
 62: }
 63: 
 64: function Install-ToolFromManifest {
 65:     param([Parameter(Mandatory = $true)][object]$Tool)
 66: 
 67:     $commandName = [string]$Tool.command
 68:     if (Test-Command $commandName) {
 69:         Write-Host "[ok] $commandName already installed"
 70:         return
 71:     }
 72: 
 73:     $install = $Tool.install
 74:     $installKind = [string]$install.kind
 75: 
 76:     switch ($installKind) {
 77:         'npm-global' {
 78:             Install-NpmGlobalPackage -Package ([string]$install.package) -ExpectedCommand $commandName
 79:         }
 80:         'powershell-script' {
 81:             $scriptUrl = [string]$install.script_url
 82:             if (-not $scriptUrl) {
 83:                 throw "Missing script_url for manifest tool $($Tool.name)"
 84:             }
 85: 
 86:             Write-Host "[install] $commandName via official Windows setup script"
 87:             Invoke-RestMethod $scriptUrl | Invoke-Expression
 88:         }
 89:         default {
 90:             throw "Unsupported install kind '$installKind' for manifest tool $($Tool.name)"
 91:         }
 92:     }
 93: }
 94: 
 95: function Test-PythonImport {
 96:     param(
 97:         [Parameter(Mandatory = $true)][string]$PythonCommand,
 98:         [string[]]$PythonArgs = @(),
 99:         [Parameter(Mandatory = $true)][string]$Module
100:     )
101: 
102:     & $PythonCommand @PythonArgs -c "import $Module" *> $null
103:     return ($LASTEXITCODE -eq 0)
104: }
105: 
106: function Install-PythonRequirements {
107:     param(
108:         [Parameter(Mandatory = $true)][string]$PythonCommand,
109:         [string[]]$PythonArgs = @(),
110:         [Parameter(Mandatory = $true)][string]$RequirementsPath
111:     )
112: 
113:     if (-not (Test-Path $RequirementsPath)) {
114:         throw "Missing Python requirements file: $RequirementsPath"
115:     }
116: 
117:     Write-Host "[install] $PythonCommand $($PythonArgs -join ' ') -m pip install -r $RequirementsPath"
118:     & $PythonCommand @PythonArgs -m pip install -r $RequirementsPath
119:     if ($LASTEXITCODE -ne 0) {
120:         throw "Failed to install Python requirements from $RequirementsPath"
121:     }
122: }
123: 
124: function Resolve-PythonCommand {
125:     if (Test-Command 'py') {
126:         return @('py', '-3')
127:     }
128:     if (Test-Command 'python') {
129:         return @('python')
130:     }
131:     throw 'Python 3 is required for MCP scripts. Install Python first: https://www.python.org/downloads/'
132: }
133: 
134: function Ensure-PythonModuleInstalled {
135:     param(
136:         [Parameter(Mandatory = $true)][string]$PythonCommand,
137:         [string[]]$PythonArgs = @(),
138:         [Parameter(Mandatory = $true)][string]$Module,
139:         [Parameter(Mandatory = $true)][string]$Package
140:     )
141: 
142:     if (Test-PythonImport -PythonCommand $PythonCommand -PythonArgs $PythonArgs -Module $Module) {
143:         Write-Host "[ok] Python module '$Module' already available"
144:         return
145:     }
146: 
147:     Write-Host "[install] $PythonCommand $($PythonArgs -join ' ') -m pip install $Package"
148:     & $PythonCommand @PythonArgs -m pip install $Package
149:     if ($LASTEXITCODE -ne 0) {
150:         throw "Failed to install Python package '$Package'"
151:     }
152: 
153:     if (-not (Test-PythonImport -PythonCommand $PythonCommand -PythonArgs $PythonArgs -Module $Module)) {
154:         throw "Python module '$Module' is still unavailable after installing '$Package'"
155:     }
156: }
157: 
158: function Sync-GraphifyArtifactsFromScripts {
159:     $scriptsGraphPath = 'scripts/graphify-out/graph.json'
160:     $contextGraphDir = 'context/graphify-out'
161:     $contextGraphPath = Join-Path $contextGraphDir 'graph.json'
162: 
163:     if (-not (Test-Path $scriptsGraphPath)) {
164:         return $false
165:     }
166: 
167:     New-Item -ItemType Directory -Path $contextGraphDir -Force | Out-Null
168:     Copy-Item -Path $scriptsGraphPath -Destination $contextGraphPath -Force
169: 
170:     $scriptsManifestPath = 'scripts/graphify-out/manifest.json'
171:     $contextManifestPath = Join-Path $contextGraphDir 'manifest.json'
172:     if (Test-Path $scriptsManifestPath) {
173:         Copy-Item -Path $scriptsManifestPath -Destination $contextManifestPath -Force
174:     }
175: 
176:     return $true
177: }
178: 
179: Write-Host '== MCP platform prerequisites setup =='
180: Write-TraceStep -Message ("repoRoot={0}" -f $repoRoot)
181: 
182: $toolingManifest = Get-ToolingManifest -Path $toolingManifestPath
183: $externalCliEntries = @($toolingManifest.external_clis)
184: $toolByCommand = @{}
185: foreach ($tool in $externalCliEntries) {
186:     $toolByCommand[[string]$tool.command] = $tool
187: }
188: 
189: if (-not $SkipCodebaseMemory) {
190:     Write-TraceStep -Message 'Installing codebase-memory-mcp from tooling manifest'
191:     Install-ToolFromManifest -Tool $toolByCommand['codebase-memory-mcp']
192: }
193: 
194: if (-not $SkipTokenSaver) {
195:     Write-TraceStep -Message 'Installing token-saver-mcp from tooling manifest'
196:     Install-ToolFromManifest -Tool $toolByCommand['token-saver-mcp']
197: }
198: 
199: if (-not $SkipCodegraph) {
200:     Write-TraceStep -Message 'Installing/verifying codegraph'
201:     Install-ToolFromManifest -Tool $toolByCommand['codegraph']
202:     Write-Host '[setup] codegraph install'
203:     codegraph install
204:     if (-not (Test-Path '.codegraph')) {
205:         Write-Host '[setup] codegraph init -i'
206:         codegraph init -i
207:     }
208:     else {
209:         Write-Host '[ok] .codegraph index already exists'
210:     }
211: }
212: 
213: if (-not $SkipGitnexus) {
214:     Write-TraceStep -Message 'Installing/verifying gitnexus'
215:     Install-ToolFromManifest -Tool $toolByCommand['gitnexus']
216:     Write-Host '[setup] gitnexus setup'
217:     gitnexus setup
218: }
219: 
220: if (-not $SkipRepomix) {
221:     Write-TraceStep -Message 'Installing/verifying repomix'
222:     Install-ToolFromManifest -Tool $toolByCommand['repomix']
223: }
224: 
225: $py = Resolve-PythonCommand
226: $pyCmd = $py[0]
227: $pyArgs = @()
228: if ($py.Length -gt 1) {
229:     $pyArgs = $py[1..($py.Length - 1)]
230: }
231: 
232: if ($py.Length -gt 1) {
233:     Write-Host "[setup] Using Python launcher: $($py -join ' ')"
234: }
235: else {
236:     Write-Host "[setup] Using Python launcher: $pyCmd"
237: }
238: 
239: # Core observability dependency used by KPI publishing and telemetry export.
240: Write-TraceStep -Message 'Ensuring Python module langsmith'
241: Ensure-PythonModuleInstalled -PythonCommand $pyCmd -PythonArgs $pyArgs -Module 'langsmith' -Package 'langsmith'
242: 
243: if (-not $SkipGraphify) {
244:     Write-TraceStep -Message 'Installing Python requirements for graphify runtime'
245:     Install-PythonRequirements -PythonCommand $pyCmd -PythonArgs $pyArgs -RequirementsPath 'requirements.txt'
246: 
247:     if (-not (Test-PythonImport -PythonCommand $pyCmd -PythonArgs $pyArgs -Module 'graphify.serve')) {
248:         throw 'graphify.serve import failed after installation.'
249:     }
250: 
251:     if (-not (Test-PythonImport -PythonCommand $pyCmd -PythonArgs $pyArgs -Module 'mcp')) {
252:         throw 'mcp module import failed after graphify installation.'
253:     }
254: 
255:     if (-not (Test-Path 'context/graphify-out/graph.json')) {
256:         Write-Host '[setup] graphify update scripts --no-cluster'
257:         Write-TraceStep -Message ("Running: {0} {1} -m graphify update scripts --no-cluster" -f $pyCmd, ($pyArgs -join ' '))
258:         & $pyCmd @pyArgs -m graphify update scripts --no-cluster
259:         if ($LASTEXITCODE -ne 0) {
260:             throw "graphify update failed with exit code $LASTEXITCODE"
261:         }
262: 
263:         if (Sync-GraphifyArtifactsFromScripts) {
264:             Write-Host '[ok] graphify output synced from scripts/graphify-out to context/graphify-out'
265:         }
266:     }
267:     else {
268:         Write-Host '[ok] context/graphify-out/graph.json already exists'
269:         Write-TraceStep -Message 'Skipping graphify update because context graph already exists'
270:     }
271: }
272: 
273: Write-Host ''
274: Write-Host 'Setup complete. Recommended next checks:'
275: if ($PortableMode) {
276:     Write-Host '  1) .\scripts\setup\validate-context.ps1 -PortableMode'
277: }
278: else {
279:     Write-Host '  1) .\scripts\setup\validate-context.ps1'
280: }
281: Write-Host '  2) .\scripts\intake\run-repo-intake.cmd'
282: Write-Host '  3) /mcp (in your agent) to verify servers are active'
</file>

<file path="scripts/setup/start-gitnexus.ps1">
 1: param(
 2:     [switch]$ForceReindex,
 3:     [switch]$NoServe,
 4:     [switch]$NoOpenBrowser,
 5:     [string]$BindHost = '127.0.0.1',
 6:     [int]$Port = 4747,
 7:     [int]$WaitSeconds = 12
 8: )
 9: 
10: $ErrorActionPreference = 'Stop'
11: 
12: function Test-GitNexusEndpoint {
13:     param(
14:         [string]$Url
15:     )
16: 
17:     try {
18:         $response = Invoke-WebRequest -UseBasicParsing -Uri $Url -TimeoutSec 2
19:         return ($response.StatusCode -ge 200 -and $response.StatusCode -lt 500)
20:     }
21:     catch {
22:         return $false
23:     }
24: }
25: 
26: if (-not (Get-Command gitnexus -ErrorAction SilentlyContinue)) {
27:     throw 'gitnexus no esta instalado o no esta en PATH. Ejecuta scripts/setup/setup-prerequisites.ps1 primero.'
28: }
29: 
30: $status = gitnexus status | Out-String
31: $needsIndex = $ForceReindex -or ($status -match 'Repository not indexed')
32: 
33: if ($needsIndex) {
34:     Write-Host '[gitnexus] Indexando repositorio actual...'
35:     gitnexus analyze .
36: }
37: else {
38:     Write-Host '[gitnexus] Repositorio ya indexado.'
39: }
40: 
41: $url = "http://$BindHost`:$Port"
42: 
43: if (-not $NoServe) {
44:     if (Test-GitNexusEndpoint -Url $url) {
45:         Write-Host "[gitnexus] Backend ya activo en $url"
46:     }
47:     else {
48:         Write-Host "[gitnexus] Iniciando backend en $url ..."
49:         Start-Process -FilePath 'cmd.exe' -ArgumentList "/c gitnexus serve --host $BindHost --port $Port" -WindowStyle Minimized | Out-Null
50: 
51:         $started = $false
52:         for ($i = 0; $i -lt $WaitSeconds; $i++) {
53:             Start-Sleep -Seconds 1
54:             if (Test-GitNexusEndpoint -Url $url) {
55:                 $started = $true
56:                 break
57:             }
58:         }
59: 
60:         if (-not $started) {
61:             Write-Host "[gitnexus] Aviso: no hubo respuesta HTTP en $url tras $WaitSeconds s." -ForegroundColor DarkYellow
62:         }
63:     }
64: }
65: 
66: if (-not $NoOpenBrowser) {
67:     Write-Host "[gitnexus] Abriendo UI: $url"
68:     Start-Process $url
69: }
70: 
71: Write-Host '[gitnexus] Listo.'
</file>

<file path="scripts/setup/validate-context.ps1">
  1: param(
  2:   [switch]$CIMode,
  3:   [switch]$PortableMode
  4: )
  5: 
  6: Set-StrictMode -Version Latest
  7: $ErrorActionPreference = 'Stop'
  8: 
  9: $repoRoot = (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path
 10: Set-Location $repoRoot
 11: $toolingManifestPath = Join-Path $repoRoot 'tooling/tooling.manifest.json'
 12: $setupValidationReportPath = Join-Path $repoRoot 'repo-intake/generated/reports/setup-validation.json'
 13: 
 14: $requiredCore = @(
 15:   'requirements.txt',
 16:   'tooling/tooling.manifest.json',
 17:   '.vscode/mcp.json',
 18:   'AGENTS.md',
 19:   'specs/architecture.spec.md',
 20:   'specs/security.spec.md',
 21:   'specs/routing.spec.md'
 22: )
 23: 
 24: $requiredEnterprise = @(
 25:   'orchestrator/router.md',
 26:   'policies/security-policy.md',
 27:   'repo-registry/repos.yml'
 28: )
 29: 
 30: function Get-ToolingManifest {
 31:   param([Parameter(Mandatory = $true)][string]$Path)
 32: 
 33:   if (-not (Test-Path $Path)) {
 34:     throw "Missing tooling manifest: $Path"
 35:   }
 36: 
 37:   return Get-Content -Raw -Path $Path | ConvertFrom-Json -Depth 20
 38: }
 39: 
 40: function Test-RequiredInMode {
 41:   param(
 42:     [Parameter(Mandatory = $true)][object]$Tool,
 43:     [Parameter(Mandatory = $true)][string]$Mode
 44:   )
 45: 
 46:   if (-not ($Tool.PSObject.Properties.Name -contains 'required_in')) {
 47:     return $true
 48:   }
 49: 
 50:   $requiredModes = @($Tool.required_in | ForEach-Object { [string]$_ })
 51:   if ($requiredModes.Count -eq 0) {
 52:     return $true
 53:   }
 54: 
 55:   return ($requiredModes -contains $Mode)
 56: }
 57: 
 58: function Write-SetupValidationReport {
 59:   param(
 60:     [Parameter(Mandatory = $true)][string]$Path,
 61:     [Parameter(Mandatory = $true)][hashtable]$Report
 62:   )
 63: 
 64:   $dir = Split-Path -Parent $Path
 65:   if (-not (Test-Path $dir)) {
 66:     New-Item -ItemType Directory -Path $dir -Force | Out-Null
 67:   }
 68: 
 69:   $Report | ConvertTo-Json -Depth 20 | Set-Content -Path $Path -Encoding utf8
 70: }
 71: 
 72: function Sync-GraphifyArtifactsIfNeeded {
 73:   $contextGraphDir = Join-Path $repoRoot 'context/graphify-out'
 74:   $contextGraphPath = Join-Path $contextGraphDir 'graph.json'
 75:   $scriptsGraphDir = Join-Path $repoRoot 'scripts/graphify-out'
 76:   $scriptsGraphPath = Join-Path $scriptsGraphDir 'graph.json'
 77: 
 78:   if ((-not (Test-Path $contextGraphPath)) -and (Test-Path $scriptsGraphPath)) {
 79:     New-Item -ItemType Directory -Path $contextGraphDir -Force | Out-Null
 80:     Copy-Item -Path $scriptsGraphPath -Destination $contextGraphPath -Force
 81: 
 82:     $scriptsManifestPath = Join-Path $scriptsGraphDir 'manifest.json'
 83:     $contextManifestPath = Join-Path $contextGraphDir 'manifest.json'
 84:     if ((-not (Test-Path $contextManifestPath)) -and (Test-Path $scriptsManifestPath)) {
 85:       Copy-Item -Path $scriptsManifestPath -Destination $contextManifestPath -Force
 86:     }
 87:   }
 88: }
 89: 
 90: function Resolve-PythonLauncher {
 91:   if (Get-Command py -ErrorAction SilentlyContinue) {
 92:     return [pscustomobject]@{
 93:       command = 'py'
 94:       args = @('-3')
 95:       printable = 'py -3'
 96:     }
 97:   }
 98: 
 99:   if (Get-Command python -ErrorAction SilentlyContinue) {
100:     return [pscustomobject]@{
101:       command = 'python'
102:       args = @()
103:       printable = 'python'
104:     }
105:   }
106: 
107:   return $null
108: }
109: 
110: # Ensure report directory exists
111: $reportDir = Split-Path -Parent $setupValidationReportPath
112: if (-not (Test-Path $reportDir)) {
113:   New-Item -ItemType Directory -Path $reportDir -Force | Out-Null
114: }
115: 
116: # ============================================
117: # CI MODE - Minimal file presence check
118: # ============================================
119: if ($CIMode) {
120:   Write-Host "Validating for CI (minimal checks)..."
121:   
122:   $requiredFiles = @(
123:     "requirements.txt",
124:     "AGENTS.md",
125:     "specs/architecture.spec.md",
126:     "specs/security.spec.md",
127:     "specs/routing.spec.md"
128:   )
129:   
130:   $errors = @()
131:   foreach ($file in $requiredFiles) {
132:     if (-not (Test-Path $file)) {
133:       $errors += "Missing $file"
134:     }
135:   }
136:   
137:   $report = @{
138:     timestamp = (Get-Date).ToUniversalTime().ToString('o')
139:     mode = 'ci'
140:     errors = $errors
141:     overall_status = if ($errors.Count -eq 0) { 'ok' } else { 'failed' }
142:   }
143:   
144:   $report | ConvertTo-Json -Depth 20 | Set-Content -Path $setupValidationReportPath -Encoding utf8
145:   
146:   if ($errors.Count -eq 0) {
147:     Write-Host "✓ CI validation OK"
148:     exit 0
149:   }
150:   else {
151:     $errors | ForEach-Object { Write-Host "✗ $_" }
152:     exit 1
153:   }
154: }
155: 
156: # If we reach here, CI mode is off
157: Write-Host "Validating setup (full checks)..."
158: 
159: $required = @($requiredCore)
160: if (-not $PortableMode) {
161:   $required += $requiredEnterprise
162: }
163: 
164: $errors=@()
165: $validationMode = if ($PortableMode) { 'portable' } else { 'enterprise' }
166: $setupValidationReport = @{
167:   timestamp = (Get-Date).ToUniversalTime().ToString('o')
168:   mode = $validationMode
169:   manifest_path = 'tooling/tooling.manifest.json'
170:   requirements_file = 'requirements.txt'
171:   python_requirements_ok = $false
172:   python_modules = @()
173:   external_clis = @()
174:   errors = @()
175:   warnings = @()
176:   overall_status = 'failed'
177: }
178: foreach($i in $required){ if(!(Test-Path $i)){ $errors += "Missing $i" } }
179: 
180: try {
181:   $toolingManifest = Get-ToolingManifest -Path $toolingManifestPath
182: }
183: catch {
184:   $errors += $_.Exception.Message
185:   $toolingManifest = $null
186: }
187: 
188: if (Test-Path 'requirements.txt') {
189:   $requirementsRaw = Get-Content -Raw -Path 'requirements.txt'
190:   if ($requirementsRaw -match 'graphifyy\[mcp\]') {
191:     $setupValidationReport.python_requirements_ok = $true
192:   }
193:   else {
194:     $errors += 'requirements.txt must include graphifyy[mcp] for the Graphify MCP runtime.'
195:   }
196: }
197: 
198: if ($toolingManifest -and ($toolingManifest.PSObject.Properties.Name -contains 'external_clis')) {
199:   foreach ($tool in @($toolingManifest.external_clis)) {
200:     if (-not (Test-RequiredInMode -Tool $tool -Mode $validationMode)) {
201:       continue
202:     }
203: 
204:     $commandName = [string]$tool.command
205:     $installed = [bool](Get-Command $commandName -ErrorAction SilentlyContinue)
206:     $toolPackage = ''
207:     $installKind = ''
208:     if (($tool.PSObject.Properties.Name -contains 'install') -and $tool.install) {
209:       if ($tool.install.PSObject.Properties.Name -contains 'package') {
210:         $toolPackage = [string]$tool.install.package
211:       }
212:       if ($tool.install.PSObject.Properties.Name -contains 'kind') {
213:         $installKind = [string]$tool.install.kind
214:       }
215:     }
216: 
217:     $setupValidationReport.external_clis += @{
218:       name = [string]$tool.name
219:       command = $commandName
220:       install_kind = $installKind
221:       package = $toolPackage
222:       installed = $installed
223:     }
224: 
225:     if (-not $installed) {
226:       $errors += "Missing command $commandName"
227:     }
228:   }
229: }
230: 
231: try {
232:   $mcpRaw = Get-Content -Raw -Path '.vscode/mcp.json' | ConvertFrom-Json -Depth 20
233:   $gitnexusCommand = [string]$mcpRaw.servers.gitnexus.command
234:   if ($gitnexusCommand -eq 'npx') {
235:     $errors += 'MCP gitnexus command should avoid `npx` (startup latency). Use local `gitnexus` or local wrapper script.'
236:   }
237:   $scanLimit = 0
238:   $gitnexusHasEnv = ($mcpRaw.servers.gitnexus.PSObject.Properties.Name -contains 'env')
239:   if ($gitnexusHasEnv -and $mcpRaw.servers.gitnexus.env) {
240:     $gitnexusEnv = $mcpRaw.servers.gitnexus.env
241:     $hasScanProp = ($gitnexusEnv.PSObject.Properties.Name -contains 'GITNEXUS_SEMANTIC_EXACT_SCAN_LIMIT')
242:     if ($hasScanProp) {
243:       [void][int]::TryParse([string]$gitnexusEnv.GITNEXUS_SEMANTIC_EXACT_SCAN_LIMIT, [ref]$scanLimit)
244:     }
245:   }
246:   if ($scanLimit -lt 20000) {
247:     $errors += 'MCP gitnexus env.GITNEXUS_SEMANTIC_EXACT_SCAN_LIMIT should be >= 20000 for better semantic fallback on Windows.'
248:   }
249:   if ($mcpRaw.servers.repomix.command -ne 'repomix') {
250:     $errors += 'MCP repomix command should be local `repomix` (avoid npx startup latency).'
251:   }
252: }
253: catch {
254:   $errors += "Unable to parse .vscode/mcp.json: $($_.Exception.Message)"
255: }
256: 
257: Sync-GraphifyArtifactsIfNeeded
258: 
259: $specFiles = @(
260:   "specs/architecture.spec.md",
261:   "specs/azure-rag.spec.md",
262:   "specs/coding-standards.spec.md",
263:   "specs/database.spec.md",
264:   "specs/migration.spec.md",
265:   "specs/observability.spec.md",
266:   "specs/optimization.spec.md",
267:   "specs/repo-intake.spec.md",
268:   "specs/rag.spec.md",
269:   "specs/routing.spec.md",
270:   "specs/security.spec.md"
271: )
272: 
273: $specContracts = @{
274:   "specs/architecture.spec.md"      = @("## Objetivo", "## Reglas", "## Validacion minima")
275:   "specs/azure-rag.spec.md"         = @("## Objetivo", "## Reglas", "## Validacion minima")
276:   "specs/coding-standards.spec.md"  = @("## Objetivo", "## Reglas", "## Validacion minima")
277:   "specs/database.spec.md"          = @("## Objetivo", "## Reglas", "## Validacion minima")
278:   "specs/migration.spec.md"         = @("## Objetivo", "## Reglas", "## Validacion minima")
279:   "specs/observability.spec.md"     = @("## Objetivo", "## Reglas", "## Validacion minima")
280:   "specs/optimization.spec.md"      = @("## Routing Robustness Contract (Production)", "## Token Efficiency Contract (Ahorro de Tokens)", "## Enforcement")
281:   "specs/repo-intake.spec.md"       = @("## Objetivo", "## Reglas", "## Validacion minima")
282:   "specs/rag.spec.md"               = @("## Objetivo", "## Reglas", "## Validacion minima")
283:   "specs/routing.spec.md"           = @("## Objetivo", "## Reglas", "## Validacion minima")
284:   "specs/security.spec.md"          = @("## Objetivo", "## Reglas", "## Validacion minima")
285: }
286: 
287: if (-not $PortableMode) {
288:   foreach ($spec in $specFiles) {
289:     if (-not (Test-Path $spec)) {
290:       continue
291:     }
292: 
293:     $raw = Get-Content -Raw -Path $spec
294:     $lineCount = (Get-Content -Path $spec | Measure-Object -Line).Lines
295: 
296:     if ($lineCount -lt 8) {
297:       $errors += "Spec too short (possible placeholder): $spec"
298:       continue
299:     }
300: 
301:     if ($raw -match "Reglas base del dominio") {
302:       $errors += "Spec still contains placeholder text: $spec"
303:     }
304: 
305:     foreach ($requiredHeading in $specContracts[$spec]) {
306:       if ($raw -notmatch [regex]::Escape($requiredHeading)) {
307:         $errors += "Spec missing required section '$requiredHeading': $spec"
308:       }
309:     }
310: 
311:     if ($spec -eq "specs/optimization.spec.md" -and $raw -notmatch [regex]::Escape("scripts\\intake\\run-routing-evals.py")) {
312:       $errors += "Spec enforcement command drift detected: $spec"
313:     }
314: 
315:     if ($raw -match [regex]::Escape("scripts\\learning\\run-routing-evals.py")) {
316:       $errors += "Deprecated routing-evals path referenced in spec: $spec"
317:     }
318:   }
319: }
320: 
321: if (-not (Get-Command codegraph -ErrorAction SilentlyContinue)) {
322:   if (-not ($CIMode)) {
323:     $errors += "Missing command codegraph"
324:   }
325: }
326: elseif (-not (Test-Path ".codegraph")) {
327:   if (-not ($CIMode)) {
328:     $errors += "Missing .codegraph index. Run: codegraph init -i"
329:   }
330: }
331: 
332: if (-not (Get-Command repomix -ErrorAction SilentlyContinue)) {
333:   if (-not ($CIMode)) {
334:     $errors += "Missing command repomix. Run: npm install -g repomix@latest"
335:   }
336: }
337: 
338: if (Get-Command codebase-memory-mcp -ErrorAction SilentlyContinue) {
339:   try {
340:     $cbmCfg = codebase-memory-mcp config list | Out-String
341:     if ($cbmCfg -notmatch 'auto_index\s*=\s*true') {
342:       $errors += 'codebase-memory-mcp auto_index must be true. Run: codebase-memory-mcp config set auto_index true'
343:     }
344:   }
345:   catch {
346:     $errors += "Unable to read codebase-memory-mcp config: $($_.Exception.Message)"
347:   }
348: }
349: 
350: if (-not (Get-Command py -ErrorAction SilentlyContinue) -and -not (Get-Command python -ErrorAction SilentlyContinue)) {
351:   if (-not ($CIMode)) {
352:     $errors += "Missing Python launcher (py/python) required for graphify MCP"
353:   }
354: }
355: else {
356:   $pythonLauncher = Resolve-PythonLauncher
357:   $pythonCmd = [string]$pythonLauncher.command
358:   $pythonArgs = @($pythonLauncher.args + @("-c", "import graphify.serve, mcp; print('ok')"))
359: 
360:   & $pythonCmd @pythonArgs *> $null
361:   $setupValidationReport.python_modules += @{
362:     launcher = [string]$pythonLauncher.printable
363:     args = $pythonArgs
364:     import_ok = ($LASTEXITCODE -eq 0)
365:   }
366:   if ($LASTEXITCODE -ne 0) {
367:     if (-not ($CIMode)) {
368:       $errors += "Graphify MCP runtime missing. Run: $($pythonLauncher.printable) -m pip install -r requirements.txt"
369:     }
370:   }
371: }
372: 
373: if ((-not (Test-Path "context/graphify-out/graph.json")) -and (-not (Test-Path "scripts/graphify-out/graph.json"))) {
374:   if (-not ($CIMode)) {
375:     $pythonLauncher = Resolve-PythonLauncher
376:     if ($null -ne $pythonLauncher) {
377:       $errors += "Missing graphify graph output. Run: $($pythonLauncher.printable) -m graphify update scripts --no-cluster"
378:     }
379:     else {
380:       $errors += 'Missing graphify graph output. Run: python -m graphify update scripts --no-cluster'
381:     }
382:   }
383: }
384: 
385: $setupValidationReport.errors = @($errors)
386: $setupValidationReport.warnings = @()
387: $setupValidationReport.overall_status = if ($errors.Count -eq 0) { 'ok' } else { 'failed' }
388: Write-SetupValidationReport -Path $setupValidationReportPath -Report $setupValidationReport
389: 
390: if($errors.Count -eq 0){
391:   if ($PortableMode) {
392:     Write-Host "Portable validation OK. Python requirements and local MCP runtime look consistent."
393:     Write-Host "Report: $setupValidationReportPath"
394:   }
395:   else {
396:     Write-Host "Validation OK. Always-on optimization documented."
397:     Write-Host "Running strict repo registry validation..."
398:     pwsh -NoProfile -File .\scripts\intake\validate-repo-registry.ps1 -Strict
399:   }
400: }
401: else {
402:   $errors | ForEach-Object { Write-Host $_ }
403:   Write-Host "Report: $setupValidationReportPath"
404:   exit 1
405: }
</file>

