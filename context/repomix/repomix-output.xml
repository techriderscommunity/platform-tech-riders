<file path="techito/src/app/features/intranet/colaboradores/admin-colaboradores.ts">
  1: import { ChangeDetectionStrategy, Component, signal, inject, DestroyRef } from '@angular/core';
  2: import { RouterLink } from '@angular/router';
  3: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
  4: import { tap, catchError } from 'rxjs/operators';
  5: import { of } from 'rxjs';
  6: import { UiButton  } from '@shared/ui/button/button';
  7: import { UiModal } from '@shared/ui/modal/modal';
  8: import { UiTextField } from '@shared/ui/text-field/text-field';
  9: import { ColaboradorItem } from './models/colaboradores.models';
 10: import { ColaboradoresService } from './services/colaboradores.service';
 11: @Component({
 12:   selector: 'app-admin-colaboradores',
 13:   standalone: true,
 14:   changeDetection: ChangeDetectionStrategy.OnPush,
 15:   imports: [RouterLink, UiButton, UiModal, UiTextField],
 16:   templateUrl: './admin-colaboradores.html',
 17:   styleUrl: './admin-colaboradores.scss'
 18: })
 19: export class AdminColaboradores {
 20:   private readonly colaboradoresService = inject(ColaboradoresService);
 21:   private readonly destroyRef = inject(DestroyRef);
 22:   readonly loading = signal(true);
 23:   readonly saving = signal(false);
 24:   readonly error = signal<string | null>(null);
 25:   readonly feedback = signal<string | null>(null);
 26:   readonly colaboradores = signal<ColaboradorItem[]>([]);
 27:   readonly showCreateModal = signal(false);
 28:   readonly showStatusModal = signal(false);
 29:   readonly modalError = signal<string | null>(null);
 30:   readonly formNombre = signal('');
 31:   readonly formEmail = signal('');
 32:   readonly formPassword = signal('');
 33:   readonly selectedColaborador = signal<ColaboradorItem | null>(null);
 34:   constructor() {
 35:     this.loadColaboradores();
 36:   }
 37:   private loadColaboradores() {
 38:     this.colaboradoresService.getColaboradores()
 39:       .pipe(
 40:         tap((data) => {
 41:           this.colaboradores.set(data);
 42:           this.loading.set(false);
 43:         }),
 44:         catchError(() => {
 45:           this.error.set('No se pudieron cargar los colaboradores');
 46:           this.loading.set(false);
 47:           return of([]);
 48:         }),
 49:         takeUntilDestroyed(this.destroyRef)
 50:       )
 51:       .subscribe();
 52:   }
 53:   agregarColaborador() {
 54:     this.modalError.set(null);
 55:     this.formNombre.set('');
 56:     this.formEmail.set('');
 57:     this.formPassword.set('');
 58:     this.showCreateModal.set(true);
 59:   }
 60:   closeCreateModal() {
 61:     this.showCreateModal.set(false);
 62:     this.modalError.set(null);
 63:   }
 64:   submitCreateColaborador(event?: Event) {
 65:     if (event) event.preventDefault();
 66:     const nombre = this.formNombre().trim();
 67:     const email = this.formEmail().trim();
 68:     const password = this.formPassword();
 69:     if (!nombre || !email || !password) {
 70:       this.modalError.set('Nombre, email y contraseña son obligatorios.');
 71:       return;
 72:     }
 73:     if (password.length < 8) {
 74:       this.modalError.set('La contraseña debe tener al menos 8 caracteres.');
 75:       return;
 76:     }
 77:     this.modalError.set(null);
 78:     this.saving.set(true);
 79:     this.colaboradoresService.createColaborador({
 80:       email,
 81:       nombre,
 82:       password,
 83:       primaryRole: 'colaborador',
 84:       roles: ['colaborador'],
 85:     })
 86:       .pipe(
 87:         tap(() => {
 88:           this.feedback.set('Colaborador creado correctamente.');
 89:           this.showCreateModal.set(false);
 90:           this.loadColaboradores();
 91:         }),
 92:         catchError((err) => {
 93:           this.modalError.set(err?.error?.error ?? 'No se pudo crear el colaborador.');
 94:           return of(null);
 95:         }),
 96:         tap(() => this.saving.set(false)),
 97:         takeUntilDestroyed(this.destroyRef)
 98:       )
 99:       .subscribe();
100:   }
101:   editarColaborador(id: string) {
102:     const item = this.colaboradores().find(colab => colab.id === id);
103:     if (!item) return;
104:     this.selectedColaborador.set(item);
105:     this.modalError.set(null);
106:     this.showStatusModal.set(true);
107:   }
108:   closeStatusModal() {
109:     this.showStatusModal.set(false);
110:     this.selectedColaborador.set(null);
111:     this.modalError.set(null);
112:   }
113:   confirmToggleEstado() {
114:     const item = this.selectedColaborador();
115:     if (!item) return;
116:     const activar = item.estado !== 'activo';
117:     this.saving.set(true);
118:     this.colaboradoresService.updateEstado(item.id, activar)
119:       .pipe(
120:         tap(() => {
121:           this.feedback.set(`Colaborador ${activar ? 'reactivado' : 'desactivado'} correctamente.`);
122:           this.colaboradores.update(list => list.map(colab =>
123:             colab.id === item.id ? { ...colab, estado: activar ? 'activo' : 'inactivo' } : colab
124:           ));
125:           this.showStatusModal.set(false);
126:           this.selectedColaborador.set(null);
127:         }),
128:         catchError((err) => {
129:           this.modalError.set(err?.error?.error ?? 'No se pudo actualizar el estado.');
130:           return of(null);
131:         }),
132:         tap(() => this.saving.set(false)),
133:         takeUntilDestroyed(this.destroyRef)
134:       )
135:       .subscribe();
136:   }
137:   verProyectos(id: string) {
138:     this.feedback.set(`Vista de proyectos para colaborador ${id} queda en siguiente iteración.`);
139:   }
140: }
</file>

