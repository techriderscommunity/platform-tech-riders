213: function Get-PatternSum {
214:     param(
215:         [string]$Text,
216:         [string]$Pattern
217:     )
218: 
219:     if ([string]::IsNullOrWhiteSpace($Text)) {
220:         return $null
221:     }
222: 
223:     $matches = [regex]::Matches($Text, $Pattern, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
224:     if ($matches.Count -eq 0) {
225:         return $null
226:     }
227: 
228:     $sum = 0.0
229:     $found = $false
230:     foreach ($m in $matches) {
231:         if ($m.Groups.Count -lt 2) {
232:             continue
233:         }
234:         $n = Convert-ToNullableDouble -Value $m.Groups[1].Value
235:         if ($null -ne $n) {
236:             $sum += $n
237:             $found = $true
238:         }
239:     }
240: 
241:     if (-not $found) {
242:         return $null
243:     }
244: 
245:     return [math]::Round($sum, 6)
246: }
