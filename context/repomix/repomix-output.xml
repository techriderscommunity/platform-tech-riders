231:             days = $RetentionDays
232:             deleted_files = [int]$script:RetentionCleanupReport.deleted_files
233:             deleted_bytes = [int64]$script:RetentionCleanupReport.deleted_bytes
234:         }
235:     }
236: 
237:     return [ordered]@{
238:         result = if ($script:HasFailures) { 'failed' } else { 'ok' }
239:         started_at = $StartedAt.ToString('o')
240:         ended_at = $EndedAt.ToString('o')
241:         duration_sec = [math]::Round((($EndedAt - $StartedAt).TotalSeconds), 2)
242:         steps = [ordered]@{
243:             total = @($script:Steps).Count
244:             ok = $okCount
245:             failed_required = $failedCount
246:             failed_optional = $optionalFailedCount
247:             skipped = $skipped.Count
248:         }
249:         engines = $engineSummary
250:         artifacts = $artifactSummary
251:         skipped_steps = $skipped
252:     }
253: }
