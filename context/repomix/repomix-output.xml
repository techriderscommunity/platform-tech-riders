<file path="backend/TechRiders.Application/Mappings/AmbassadorMappingConfig.cs">
 1: using Mapster;
 2: using TechRiders.Application.DTOs.Requests.Ambassador;
 3: using TechRiders.Application.DTOs.Responses.Ambassador;
 4: using TechRiders.Domain.Entities;
 5: namespace TechRiders.Application.Mappings;
 6: /// <summary>
 7: /// Mapster configuration for Ambassador domain
 8: /// </summary>
 9: public class AmbassadorMappingConfig : IRegister
10: {
11:     public void Register(TypeAdapterConfig config)
12:     {
13:         // Entity to Response
14:         config.NewConfig<User, AmbassadorResponse>()
15:             .Map(dest => dest.CategoryId, src => (int?)null)
16:             .Map(dest => dest.CategoryName, src => (string?)null)
17:             .Map(dest => dest.OtherCategory, src => (string?)null)
18:             .Map(dest => dest.Skill, src => (string?)null);
19:         // Request to Entity
20:         config.NewConfig<CreateAmbassadorRequest, User>()
21:             .Map(dest => dest.Nickname, src => string.IsNullOrWhiteSpace(src.Nickname) ? src.Email.Split('@')[0] : src.Nickname)
22:             .Map(dest => dest.IsActive, src => true);
23:         config.NewConfig<UpdateAmbassadorRequest, User>()
24:             .Map(dest => dest, src => src, src => src != null);
25:     }
26: }
</file>

