  7: import { UiTextarea } from '@shared/ui/textarea/textarea';
  8: import {
  9:   CommunityPartner,
 10:   CommunityPartnerStatus,
 11: } from '../../comuneras/models/community-partner.models';
 12: import { CommunityPartnersStore } from '../../comuneras/services/community-partners.store';
 13: @Component({
 14:   selector: 'app-admin-comuneras',
 15:   standalone: true,
 16:   imports: [RouterLink, UiButton, UiModal, UiSelect, UiTextField, UiTextarea],
 17:   templateUrl: './admin-comuneras.html',
 18:   styleUrl: './admin-comuneras.scss',
 19:   changeDetection: ChangeDetectionStrategy.OnPush,
 20: })
 21: export class AdminComuneras {
 22:   private readonly store = inject(CommunityPartnersStore);
 23:   readonly feedback = signal<string | null>(null);
 24:   readonly showEditModal = signal(false);
 25:   readonly selected = signal<CommunityPartner | null>(null);
 26:   readonly editShortDescription = signal('');
 27:   readonly editMission = signal('');
 28:   readonly searchTerm = signal('');
 29:   readonly statusFilter = signal<'all' | CommunityPartnerStatus>('all');
 30:   readonly items = this.store.allPartners;
 31:   readonly filteredItems = computed(() => {
 32:     const term = this.searchTerm().trim().toLowerCase();
 33:     const status = this.statusFilter();
 34:     return this.items().filter(item => {
 35:       const matchesStatus = status === 'all' || item.status === status;
 36:       const matchesTerm = !term
 37:         || item.name.toLowerCase().includes(term)
 38:         || item.contactName.toLowerCase().includes(term)
 39:         || item.contactEmail.toLowerCase().includes(term)
 40:         || item.topics.some(topic => topic.toLowerCase().includes(term));
 41:       return matchesStatus && matchesTerm;
 42:     });
 43:   });
 44:   readonly statusOptions: UiSelectOption[] = [
 45:     { label: 'Todos los estados', value: 'all' },
 46:     { label: 'Pendiente', value: 'pending' },
 47:     { label: 'En revisión', value: 'review' },
 48:     { label: 'Información solicitada', value: 'more-info' },
 49:     { label: 'Aprobada', value: 'approved' },
 50:     { label: 'Rechazada', value: 'rejected' },
 51:     { label: 'Suspendida', value: 'suspended' },
 52:   ];
 53:   readonly pendingCount = computed(() =>
 54:     this.items().filter(item => item.status === 'pending' || item.status === 'review').length,
 55:   );
 56:   openEdit(item: CommunityPartner): void {
 57:     this.selected.set(item);
 58:     this.editShortDescription.set(item.shortDescription);
 59:     this.editMission.set(item.mission);
 60:     this.showEditModal.set(true);
 61:   }
 62:   closeEdit(): void {
 63:     this.showEditModal.set(false);
 64:     this.selected.set(null);
 65:   }
 66:   applyStatus(item: CommunityPartner, status: CommunityPartnerStatus): void {
 67:     this.store.updateStatus(item.id, status);
 68:     const label = this.toStatusLabel(status);
 69:     this.feedback.set(`Estado actualizado a ${label} para ${item.name}.`);
 70:   }
 71:   saveEdit(): void {
 72:     const selected = this.selected();
 73:     if (!selected) {
 74:       return;
 75:     }
 76:     const nextDescription = this.editShortDescription().trim();
 77:     const nextMission = this.editMission().trim();
 78:     if (!nextDescription || !nextMission) {
 79:       this.feedback.set('Completa descripción corta y misión para guardar cambios.');
 80:       return;
 81:     }
 82:     this.store.updatePartner(selected.id, {
 83:       shortDescription: nextDescription,
 84:       mission: nextMission,
 85:     });
 86:     this.feedback.set(`Comuñera ${selected.name} actualizada.`);
 87:     this.closeEdit();
 88:   }
 89:   statusClass(status: CommunityPartnerStatus): string {
 90:     return `estado-${status}`;
 91:   }
 92:   toStatusLabel(status: CommunityPartnerStatus): string {
 93:     const labels: Record<CommunityPartnerStatus, string> = {
 94:       pending: 'Pendiente',
 95:       review: 'En revisión',
 96:       'more-info': 'Información solicitada',
 97:       approved: 'Aprobada',
 98:       rejected: 'Rechazada',
 99:       suspended: 'Suspendida',
100:     };
101:     return labels[status];
102:   }
103:   formatDate(date?: Date): string {
104:     if (!date) {
105:       return 'N/D';
106:     }
107:     return new Date(date).toLocaleDateString('es-ES');
108:   }
109:   onStatusFilterChange(value: string): void {
110:     if (
111:       value === 'all'
112:       || value === 'pending'
113:       || value === 'review'
114:       || value === 'more-info'
115:       || value === 'approved'
116:       || value === 'rejected'
117:       || value === 'suspended'
118:     ) {
119:       this.statusFilter.set(value);
120:     }
121:   }
122: }
</file>

