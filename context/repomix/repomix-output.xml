<file path="scripts/github/manage-issues.ps1">
  1: #Requires -Version 7
  2: 
  3: <#
  4: .SYNOPSIS
  5: Gestiona issues y PRs con asignación automática de Copilot.
  6: 
  7: .DESCRIPTION
  8: Realiza acciones automáticas en issues y PRs:
  9: - Asignar Copilot a issues sin asignar
 10: - Solicitar review de Copilot en PRs abiertas
 11: - Auto-cerrar issues cuando PR relacionada se mergea
 12: 
 13: .PARAMETER Repo
 14: Repositorio (owner/repo). Por defecto: Sertxito/mcp-efficiency-engine
 15: 
 16: .PARAMETER Action
 17: Acción a ejecutar: assign, review, close. Por defecto: assign
 18: 
 19: .PARAMETER State
 20: Estado de issues: open, closed. Por defecto: open
 21: 
 22: .PARAMETER DryRun
 23: No hacer cambios, solo mostrar lo que haría.
 24: 
 25: .EXAMPLE
 26: .\manage-issues.ps1 -Action assign
 27: 
 28: .EXAMPLE
 29: .\manage-issues.ps1 -Action review -DryRun
 30: 
 31: #>
 32: 
 33: param(
 34:   [string]$Repo = "Sertxito/mcp-efficiency-engine",
 35:   [ValidateSet("assign", "review", "close")]
 36:   [string]$Action = "assign",
 37:   [ValidateSet("open", "closed")]
 38:   [string]$State = "open",
 39:   [switch]$DryRun
 40: )
 41: 
 42: $ErrorActionPreference = "Stop"
 43: 
 44: # Obtener issues sin asignar
 45: function Get-UnassignedIssues {
 46:   param([string]$Repo)
 47:   
 48:   Write-Host "Buscando issues sin asignar..."
 49:   
 50:   try {
 51:     $issues = gh issue list --repo $Repo --state $State --assignee none --json number,title,labels
 52:     return $issues | ConvertFrom-Json
 53:   } catch {
 54:     Write-Host "Error obteniendo issues: $_"
 55:     return @()
 56:   }
 57: }
 58: 
 59: # Obtener PRs abiertas sin review
 60: function Get-OpenPullRequests {
 61:   param([string]$Repo)
 62:   
 63:   Write-Host "Buscando PRs abiertas..."
 64:   
 65:   try {
 66:     $prs = gh pr list --repo $Repo --state open --json number,title,author
 67:     return $prs | ConvertFrom-Json
 68:   } catch {
 69:     Write-Host "Error obteniendo PRs: $_"
 70:     return @()
 71:   }
 72: }
 73: 
 74: # Asignar Copilot a issue
 75: function Assign-CopilotToIssue {
 76:   param([string]$Repo, [int]$IssueNumber)
 77:   
 78:   Write-Host "  Asignando Copilot a issue #$IssueNumber..."
 79:   
 80:   if ($DryRun) {
 81:     Write-Host "  [DRY-RUN] Asignaría Copilot a issue #$IssueNumber"
 82:     return $true
 83:   }
 84:   
 85:   try {
 86:     # Usar GitHub MCP: assign_copilot_to_issue
 87:     $body = @{
 88:       assignee = "copilot"
 89:     } | ConvertTo-Json
 90:     
 91:     gh api repos/$Repo/issues/$IssueNumber \
 92:       -X PATCH \
 93:       -H "Accept: application/vnd.github+json" \
 94:       -f assignees=copilot | Out-Null
 95:     
 96:     Write-Host "  ✓ Copilot asignado a #$IssueNumber"
 97:     return $true
 98:   } catch {
 99:     Write-Host "  ⚠ Error asignando Copilot: $_"
100:     return $false
101:   }
102: }
103: 
104: # Solicitar review de Copilot en PR
105: function Request-CopilotReview {
106:   param([string]$Repo, [int]$PRNumber)
107:   
108:   Write-Host "  Solicitando review de Copilot para PR #$PRNumber..."
109:   
110:   if ($DryRun) {
111:     Write-Host "  [DRY-RUN] Solicitaría review de Copilot para PR #$PRNumber"
112:     return $true
113:   }
114:   
115:   try {
116:     # Usar GitHub MCP: request_copilot_review
117:     gh api repos/$Repo/pulls/$PRNumber/requested_reviewers \
118:       -X POST \
119:       -H "Accept: application/vnd.github+json" \
120:       -f reviewers=copilot | Out-Null
121:     
122:     Write-Host "  ✓ Review de Copilot solicitado para #$PRNumber"
123:     return $true
124:   } catch {
125:     Write-Host "  ⚠ Error solicitando review: $_"
126:     return $false
127:   }
128: }
129: 
130: # Auto-cerrar issue si PR relacionada merged
131: function Auto-CloseResolvedIssues {
132:   param([string]$Repo)
133:   
134:   Write-Host "Buscando issues para auto-cerrar..."
135:   
136:   try {
137:     $closedPRs = gh pr list --repo $Repo --state closed --merged --limit 20 `
138:       --json number,title,body,closedAt | ConvertFrom-Json
139:     
140:     $closed = 0
141:     foreach ($pr in $closedPRs) {
142:       # Buscar referencias a issues en PR (Closes #123, Fixes #456, etc.)
143:       $issueMatches = [regex]::Matches($pr.body, '#(\d+)')
144:       
145:       foreach ($match in $issueMatches) {
146:         $issueNum = $match.Groups[1].Value
147:         
148:         # Verificar si issue aún está abierta
149:         $issue = gh api repos/$Repo/issues/$issueNum | ConvertFrom-Json
150:         
151:         if ($issue.state -eq "open") {
152:           Write-Host "  Auto-cerrando issue #$issueNum (referenced en PR #$($pr.number))..."
153:           
154:           if ($DryRun) {
155:             Write-Host "  [DRY-RUN] Cerraría issue #$issueNum"
156:             $closed++
157:             continue
158:           }
159:           
160:           # Cerrar issue
161:           gh api repos/$Repo/issues/$issueNum \
162:             -X PATCH \
163:             -H "Accept: application/vnd.github+json" \
164:             -f state=closed \
165:             -f state_reason=completed | Out-Null
166:           
167:           Write-Host "  ✓ Issue #$issueNum cerrada"
168:           $closed++
169:         }
170:       }
171:     }
172:     
173:     return $closed
174:   } catch {
175:     Write-Host "Error en auto-close: $_"
176:     return 0
177:   }
178: }
179: 
180: # Agregar etiquetas a issues
181: function Add-LabelsToIssue {
182:   param([string]$Repo, [int]$IssueNumber, [array]$Labels)
183:   
184:   Write-Host "  Agregando etiquetas a issue #$IssueNumber..."
185:   
186:   if ($DryRun) {
187:     Write-Host "  [DRY-RUN] Agregaría etiquetas: $($Labels -join ', ')"
188:     return $true
189:   }
190:   
191:   try {
192:     $labelJson = $Labels | ConvertTo-Json
193:     
194:     gh api repos/$Repo/issues/$IssueNumber/labels \
195:       -X POST \
196:       -H "Accept: application/vnd.github+json" `
197:       --input - << $labelJson | Out-Null
198:     
199:     Write-Host "  ✓ Etiquetas agregadas"
200:     return $true
201:   } catch {
202:     Write-Host "  ⚠ Error agregando etiquetas: $_"
203:     return $false
204:   }
205: }
206: 
207: # Generar reporte de actividad
208: function Get-ActivityReport {
209:   param([string]$Repo, [int]$AssignedCount, [int]$ReviewsRequested, [int]$IssuesClosed)
210:   
211:   $report = @"
212: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
213: Reporte de Gestión de Issues
214: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
215: 
216: 📊 Actividad Realizada:
217: 
218:   🎯 Issues asignados a Copilot: $AssignedCount
219:   👁️  Reviews solicitados: $ReviewsRequested
220:   ✓ Issues auto-cerradas: $IssuesClosed
221: 
222: 📌 Próximos Pasos:
223: 
224:   1. Revisar issues asignados a Copilot
225:   2. Verificar reviews de Copilot en PRs
226:   3. Validar closes automáticos
227: 
228: 🔗 Repositorio: https://github.com/$Repo
229:    Issues: https://github.com/$Repo/issues
230:    PRs: https://github.com/$Repo/pulls
231: 
232: "@
233: 
234:   return $report
235: }
236: 
237: # ===================
238: # Main Execution
239: # ===================
240: 
241: Write-Host "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
242: Write-Host "GitHub MCP Issue Manager"
243: Write-Host "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
244: Write-Host ""
245: Write-Host "Repositorio: $Repo"
246: Write-Host "Acción: $Action"
247: Write-Host "Estado: $State"
248: 
249: if ($DryRun) {
250:   Write-Host "🔍 Modo DRY-RUN"
251: }
252: Write-Host ""
253: 
254: $assigned = 0
255: $reviewsRequested = 0
256: $closed = 0
257: 
258: switch ($Action) {
259:   "assign" {
260:     Write-Host "Asignando Copilot a issues sin asignar..."
261:     Write-Host ""
262:     
263:     $issues = Get-UnassignedIssues -Repo $Repo
264:     
265:     if ($issues.Count -eq 0) {
266:       Write-Host "✓ No hay issues sin asignar"
267:     } else {
268:       Write-Host "Encontrados $($issues.Count) issues:"
269:       Write-Host ""
270:       
271:       foreach ($issue in $issues) {
272:         Write-Host "  #$($issue.number) — $($issue.title)"
273:         
274:         # Asignar
275:         if (Assign-CopilotToIssue -Repo $Repo -IssueNumber $issue.number) {
276:           $assigned++
277:         }
278:       }
279:     }
280:     
281:     Write-Host ""
282:     Write-Host "✓ Asignación completada: $assigned issues"
283:   }
284:   
285:   "review" {
286:     Write-Host "Solicitando reviews de Copilot en PRs..."
287:     Write-Host ""
288:     
289:     $prs = Get-OpenPullRequests -Repo $Repo
290:     
291:     if ($prs.Count -eq 0) {
292:       Write-Host "✓ No hay PRs abiertas"
293:     } else {
294:       Write-Host "Encontradas $($prs.Count) PRs:"
295:       Write-Host ""
296:       
297:       foreach ($pr in $prs) {
298:         Write-Host "  #$($pr.number) — $($pr.title) (por @$($pr.author.login))"
299:         
300:         # Solicitar review
301:         if (Request-CopilotReview -Repo $Repo -PRNumber $pr.number) {
302:           $reviewsRequested++
303:         }
304:       }
305:     }
306:     
307:     Write-Host ""
308:     Write-Host "✓ Reviews solicitados: $reviewsRequested PRs"
309:   }
310:   
311:   "close" {
312:     Write-Host "Buscando issues para auto-cerrar..."
313:     Write-Host ""
314:     
315:     $closed = Auto-CloseResolvedIssues -Repo $Repo
316:     
317:     Write-Host ""
318:     Write-Host "✓ Issues auto-cerradas: $closed"
319:   }
320: }
321: 
322: Write-Host ""
323: 
324: # Mostrar reporte final
325: $report = Get-ActivityReport -Repo $Repo `
326:   -AssignedCount $assigned `
327:   -ReviewsRequested $reviewsRequested `
328:   -IssuesClosed $closed
329: 
330: Write-Host $report
331: 
332: Write-Host "✓ Gestión de issues completada"
</file>

<file path="scripts/github/README.md">
  1: # GitHub MCP Scripts
  2: 
  3: Scripts PowerShell para automatización de repositorio mediante GitHub CLI.
  4: 
  5: ⚠️ **IMPORTANTE:** Solo necesitas `gh` CLI + PowerShell 7. No necesitas `npm install -g`.
  6: 
  7: → **[GUÍA DE INSTALACIÓN AQUÍ](./INSTALL.md)**
  8: 
  9: ## Scripts Disponibles
 10: 
 11: ### 1. `sync-repo.ps1` — Sincronización Multi-Repo
 12: 
 13: Sincroniza cambios entre repositorios principales automáticamente.
 14: 
 15: **Uso:**
 16: ```powershell
 17: .\sync-repo.ps1 -FilesPattern "projects/**"
 18: ```
 19: 
 20: **Parámetros:**
 21: - `-SourceRepo` — Repo origen (default: Sertxito/mcp-efficiency-engine)
 22: - `-TargetRepo` — Repo destino (default: Sertxito/boost_sertxIA)
 23: - `-FilesPattern` — Patrón glob para filtrar archivos (default: projects/**)
 24: - `-BranchName` — Nombre de rama (default: sync/{timestamp})
 25: - `-DryRun` — Mostrar cambios sin hacer modificaciones
 26: 
 27: **Ejemplos:**
 28: ```powershell
 29: # Sincronizar especificaciones
 30: .\sync-repo.ps1 -FilesPattern ".github/specs/**"
 31: 
 32: # Modo dry-run para validar
 33: .\sync-repo.ps1 -FilesPattern "projects/**" -DryRun
 34: 
 35: # Repos personalizados
 36: .\sync-repo.ps1 -SourceRepo "Sertxito/repo-A" -TargetRepo "Sertxito/repo-B"
 37: ```
 38: 
 39: **Flujo:**
 40: 1. Detecta cambios en SourceRepo que coincidan con FilesPattern
 41: 2. Crea rama en TargetRepo
 42: 3. Sincroniza archivos
 43: 4. Crea PR de draft para revisión manual
 44: 
 45: **Output Esperado:**
 46: ```
 47: ✓ GitHub CLI disponible
 48: Detectando cambios en Sertxito/mcp-efficiency-engine/main...
 49: Encontrados 3 cambios
 50: Creando rama sync/20260704-120000 en Sertxito/boost_sertxIA...
 51: ✓ Rama creada: sync/20260704-120000
 52: Sincronizando 3 archivos...
 53:   Sincronizando: projects/project-a/spec.md
 54:   ✓ projects/project-a/spec.md sincronizado
 55:   ...
 56: ✓ PR creada: https://github.com/Sertxito/boost_sertxIA/pull/XXX
 57: ```
 58: 
 59: ---
 60: 
 61: ### 2. `create-devlog.ps1` — Generador de DevLog Técnico
 62: 
 63: Genera devlog automático a partir de commits recientes.
 64: 
 65: **Uso:**
 66: ```powershell
 67: .\create-devlog.ps1
 68: ```
 69: 
 70: **Parámetros:**
 71: - `-Repo` — Repositorio (default: Sertxito/mcp-efficiency-engine)
 72: - `-CommitsToAnalyze` — Cantidad de commits (default: 10)
 73: - `-OutputDir` — Directorio de salida (default: autodocs/site/devlog)
 74: - `-DryRun` — Mostrar contenido sin crear archivo
 75: 
 76: **Ejemplos:**
 77: ```powershell
 78: # Generar devlog con últimos 10 commits
 79: .\create-devlog.ps1
 80: 
 81: # Analizar más commits
 82: .\create-devlog.ps1 -CommitsToAnalyze 20
 83: 
 84: # Vista previa antes de crear
 85: .\create-devlog.ps1 -DryRun
 86: 
 87: # Repo específico
 88: .\create-devlog.ps1 -Repo "Sertxito/boost_sertxIA"
 89: ```
 90: 
 91: **Categorización Automática:**
 92: - 🎯 **Features** — Commits con "feat", "feature"
 93: - 🐛 **Fixes** — Commits con "fix", "bug"
 94: - 🔧 **Refactor** — Commits con "refactor"
 95: - 📝 **Docs** — Commits con "doc"
 96: - ✅ **Tests** — Commits con "test"
 97: - 📌 **Otros** — Resto de commits
 98: 
 99: **Output Esperado:**
100: ```
101: Obteniendo últimos 10 commits de Sertxito/mcp-efficiency-engine...
102: ✓ Obtenidos 10 commits
103: 
104: 📊 Cambios detectados:
105:   🎯 Features: 2
106:   🐛 Fixes: 3
107:   🔧 Refactor: 1
108:   📝 Docs: 2
109:   ✅ Tests: 1
110:   📌 Otros: 1
111: 
112: ✓ Archivo devlog creado: autodocs/site/devlog/devlog-2026-07-04.md
113: 
114: [DevLog markdown structure generated with all commits categorized]
115: ```
116: 
117: **Archivo Generado:**
118: ```markdown
119: # Devlog — 2026-07-04
120: 
121: | Categoría | Cantidad |
122: |-----------|----------|
123: | 🎯 Features | 2 |
124: | 🐛 Fixes | 3 |
125: 
126: ## 🎯 Features Nuevas
127: 
128: - **feat: GitHub MCP integration** — [`abc1234`](...)
129: - **feat: Add CI workflow** — [`def5678`](...)
130: 
131: ## 🐛 Fixes y Resoluciones
132: 
133: - **fix: Windows encoding issue** — [`ghi9012`](...)
134: ...
135: ```
136: 
137: ---
138: 
139: ### 3. `manage-issues.ps1` — Gestor Inteligente de Issues
140: 
141: Automatiza gestión de issues y PRs con Copilot.
142: 
143: **Uso:**
144: ```powershell
145: .\manage-issues.ps1 -Action assign
146: ```
147: 
148: **Parámetros:**
149: - `-Repo` — Repositorio (default: Sertxito/mcp-efficiency-engine)
150: - `-Action` — Acción: `assign`, `review`, `close` (default: assign)
151: - `-State` — Estado: `open`, `closed` (default: open)
152: - `-DryRun` — Mostrar cambios sin hacer modificaciones
153: 
154: **Acciones:**
155: 
156: #### `assign` — Asignar Copilot a Issues
157: ```powershell
158: .\manage-issues.ps1 -Action assign
159: 
160: # Output:
161: Buscando issues sin asignar...
162: Encontrados 3 issues:
163:   #42 — Implementar GitHub MCP integration
164:   ✓ Copilot asignado a #42
165:   #43 — Documentar CI workflow
166:   ✓ Copilot asignado a #43
167:   #44 — Add test coverage
168:   ✓ Copilot asignado a #44
169: 
170: ✓ Asignación completada: 3 issues
171: ```
172: 
173: #### `review` — Solicitar Review de Copilot
174: ```powershell
175: .\manage-issues.ps1 -Action review
176: 
177: # Output:
178: Buscando PRs abiertas...
179: Encontradas 2 PRs:
180:   #50 — Add sync-repo script (por @sertxito)
181:   ✓ Review de Copilot solicitado para #50
182:   #51 — Update documentation (por @sertxito)
183:   ✓ Review de Copilot solicitado para #51
184: 
185: ✓ Reviews solicitados: 2 PRs
186: ```
187: 
188: #### `close` — Auto-cerrar Issues Resueltas
189: ```powershell
190: .\manage-issues.ps1 -Action close
191: 
192: # Output:
193: Buscando issues para auto-cerrar...
194:   Auto-cerrando issue #42 (referenced en PR #50)
195:   ✓ Issue #42 cerrada
196:   Auto-cerrando issue #43 (referenced en PR #50)
197:   ✓ Issue #43 cerrada
198: 
199: ✓ Issues auto-cerradas: 2
200: ```
201: 
202: ---
203: 
204: ## Configuración Inicial
205: 
206: ### 1. Instalar MCP GitHub Server
207: 
208: ```bash
209: # Opción 1: npm
210: npm install -g @github/mcp-github-server
211: 
212: # Opción 2: desde source
213: git clone https://github.com/github/github-mcp-server
214: cd github-mcp-server
215: npm install && npm run build
216: ```
217: 
218: ### 2. Configurar GitHub Token
219: 
220: ```bash
221: # Windows - Credential Manager
222: cmdkey /add:github.com /user:your-username /pass:ghp_xxxxxxxxxxxx
223: 
224: # PowerShell - Variable de entorno
225: $env:GITHUB_TOKEN = "ghp_xxxxxxxxxxxx"
226: 
227: # Permanente en Profile
228: Add-Content $PROFILE `n'$env:GITHUB_TOKEN = "ghp_xxxxxxxxxxxx"'
229: 
230: # Verificar
231: gh auth status
232: ```
233: 
234: ### 3. Ejecutar Scripts
235: 
236: ```bash
237: # Permitir scripts locales (si es necesario)
238: Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser
239: 
240: # Ejecutar script
241: cd scripts/github
242: .\sync-repo.ps1
243: ```
244: 
245: ---
246: 
247: ## Automatización en GitHub Actions
248: 
249: ### Workflow: Auto-Sync on Push
250: 
251: ```yaml
252: # .github/workflows/auto-sync.yml
253: name: Auto-Sync to boost_sertxIA
254: 
255: on:
256:   push:
257:     branches: [main]
258:     paths:
259:       - 'projects/**'
260: 
261: jobs:
262:   sync:
263:     runs-on: ubuntu-latest
264:     steps:
265:       - uses: actions/checkout@v4
266:       
267:       - name: Setup PowerShell
268:         run: |
269:           sudo apt-get update
270:           sudo apt-get install -y powershell
271:       
272:       - name: Setup MCP GitHub
273:         run: npm install -g @github/mcp-github-server
274:       
275:       - name: Run sync
276:         run: pwsh scripts/github/sync-repo.ps1
277:         env:
278:           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
279:       
280:       - name: Create issue if sync failed
281:         if: failure()
282:         run: |
283:           gh issue create \
284:             --title "⚠️ Sync to boost_sertxIA failed" \
285:             --body "Check workflow: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
286:         env:
287:           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
288: ```
289: 
290: ### Workflow: Auto-DevLog
291: 
292: ```yaml
293: # .github/workflows/auto-devlog.yml
294: name: Generate DevLog
295: 
296: on:
297:   push:
298:     branches: [main]
299: 
300: jobs:
301:   devlog:
302:     runs-on: ubuntu-latest
303:     steps:
304:       - uses: actions/checkout@v4
305:       - uses: actions/setup-node@v4
306:       
307:       - name: Setup PowerShell
308:         run: sudo apt-get install -y powershell
309:       
310:       - name: Generate devlog
311:         run: pwsh scripts/github/create-devlog.ps1
312:         env:
313:           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
314:       
315:       - name: Commit and push
316:         if: success()
317:         run: |
318:           git config --local user.email "action@github.com"
319:           git config --local user.name "GitHub Action"
320:           git add autodocs/site/devlog/
321:           git commit -m "docs: auto-generated devlog" || exit 0
322:           git push
323: ```
324: 
325: ### Workflow: Auto-Issue Management
326: 
327: ```yaml
328: # .github/workflows/auto-issue-management.yml
329: name: Auto-Manage Issues
330: 
331: on:
332:   schedule:
333:     - cron: '0 9 * * 1'  # Lunes 9 AM
334:   workflow_dispatch:
335: 
336: jobs:
337:   manage:
338:     runs-on: ubuntu-latest
339:     steps:
340:       - uses: actions/checkout@v4
341:       - name: Setup PowerShell
342:         run: sudo apt-get install -y powershell
343:       
344:       - name: Assign Copilot
345:         run: pwsh scripts/github/manage-issues.ps1 -Action assign
346:         env:
347:           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
348:       
349:       - name: Request reviews
350:         run: pwsh scripts/github/manage-issues.ps1 -Action review
351:         env:
352:           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
353:       
354:       - name: Close resolved
355:         run: pwsh scripts/github/manage-issues.ps1 -Action close
356:         env:
357:           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
358: ```
359: 
360: ---
361: 
362: ## Troubleshooting
363: 
364: ### Error: "GitHub CLI no disponible"
365: ```bash
366: # Instalar gh CLI
367: # Windows
368: winget install GitHub.cli
369: 
370: # macOS
371: brew install gh
372: 
373: # Linux
374: sudo apt install gh
375: ```
376: 
377: ### Error: "No token provided"
378: ```bash
379: # Verificar token
380: $env:GITHUB_TOKEN
381: 
382: # Configurar si falta
383: $env:GITHUB_TOKEN = "ghp_xxxxxxxxxxxx"
384: 
385: # Verificar acceso
386: gh auth status
387: ```
388: 
389: ### Error: "API rate limit exceeded"
390: - GitHub tiene límites de rate: 60 req/hora (unauthenticated), 5000/hora (authenticated)
391: - Esperar o reducir cantidad de operaciones
392: - Considerar usar GitHub Graphql para operaciones en batch
393: 
394: ### Error: "Repository not found"
395: - Verificar nombre exact del repo
396: - Verificar permisos del token
397: - El repo debe existir y ser accesible
398: 
