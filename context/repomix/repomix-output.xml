<file path="orchestrator/wiki/graph_consolidator.py">
  1: import json
  2: import os
  3: import hashlib
  4: from pathlib import Path
  5: from typing import Any, Dict, List
  6: from scripts.wiki.normalizer import normalize_node, section_catalog
  7: SECTIONS = section_catalog()
  8: class GraphConsolidator:
  9:     def __init__(self, output_graph_path: Path, markdown_output_dir: Path, telemetry_collector: Any | None = None) -> None:
 10:         self.output_graph_path = output_graph_path
 11:         self.markdown_output_dir = markdown_output_dir
 12:         self.generated_output_dir = output_graph_path.parent
 13:         self._telemetry = telemetry_collector
 14:     def consolidate(self, provider_contracts: List[Dict[str, Any]]) -> Dict[str, Any]:
 15:         if self._telemetry is not None:
 16:             self._telemetry.record_event(
 17:                 "KnowledgeGenerated",
 18:                 {
 19:                     "operation": "graph_consolidate_start",
 20:                     "provider_contracts": len(provider_contracts),
 21:                 },
 22:             )
 23:         raw_nodes: Dict[str, Dict[str, Any]] = {}
 24:         wiki_nodes: Dict[str, Dict[str, Any]] = {}
 25:         for contract in provider_contracts:
 26:             provider_id = str(contract.get("provider_id", "unknown"))
 27:             entities = contract.get("entities", [])
 28:             if not isinstance(entities, list):
 29:                 continue
 30:             for entity in entities:
 31:                 if not isinstance(entity, dict):
 32:                     continue
 33:                 entity_id = str(entity.get("id", "")).strip()
 34:                 if not entity_id:
 35:                     continue
 36:                 node_key = f"{provider_id}::{entity_id}"
 37:                 relations = self._normalize_relations(provider_id, entity.get("relations", []))
 38:                 raw_data = entity.get("raw_data", {})
 39:                 metadata = raw_data if isinstance(raw_data, dict) else {}
 40:                 raw_node = {
 41:                     "node_id": node_key,
 42:                     "provider": provider_id,
 43:                     "type": str(entity.get("type", "unknown")),
 44:                     "checksum": str(entity.get("checksum", "")),
 45:                     "metadata": metadata,
 46:                     "relations": relations,
 47:                     "semantic_summary": str(metadata.get("semantic_summary", "")),
 48:                 }
 49:                 raw_nodes[node_key] = raw_node
 50:                 wiki_nodes[node_key] = normalize_node(node_key, raw_node)
 51:         navigation_tree = self._build_navigation_tree(wiki_nodes)
 52:         search_index = self._build_search_index(wiki_nodes)
 53:         relations_index = self._build_relations_index(wiki_nodes)
 54:         section_manifest = self._build_section_manifest(wiki_nodes)
 55:         if self._telemetry is not None:
 56:             self._telemetry.record_metric("tool_invocations", float(len(provider_contracts)), unit="count")
 57:             self._telemetry.record_metric("cache_misses", 0.0, unit="count")
 58:             self._telemetry.record_event(
 59:                 "KnowledgeGenerated",
 60:                 {
 61:                     "operation": "graph_consolidate_finish",
 62:                     "nodes": len(wiki_nodes),
 63:                 },
 64:             )
 65:         return {
 66:             "last_updated": self._deterministic_marker(wiki_nodes),
 67:             "nodes": wiki_nodes,
 68:             "raw_nodes": raw_nodes,
 69:             "wiki_nodes": wiki_nodes,
 70:             "navigation_tree": navigation_tree,
 71:             "search_index": search_index,
 72:             "relations_index": relations_index,
 73:             "section_manifest": section_manifest,
 74:         }
 75:     def _deterministic_marker(self, wiki_nodes: Dict[str, Dict[str, Any]]) -> str:
 76:         payload = json.dumps(wiki_nodes, sort_keys=True, ensure_ascii=True, separators=(",", ":"))
 77:         digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
 78:         return f"sha256:{digest}"
 79:     def persist_graph(self, unified_graph: Dict[str, Any]) -> None:
