 43:     }
 44: 
 45:     return [pscustomobject]@{
 46:         Name = $dirs[0].Name
 47:         Path = $summaryPath
 48:         Data = (Get-Content -Path $summaryPath -Raw | ConvertFrom-Json -Depth 20)
 49:     }
