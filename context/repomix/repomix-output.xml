 89:           this.participationTracks = content.orientaTech.participationTracks;
 90:           this.studySections = content.orientaTech.studySections;
 91:         }),
 92:         catchError(() => EMPTY),
 93:         takeUntilDestroyed(this.destroyRef)
 94:       )
 95:       .subscribe();
 96:     this.loadPlaylist('profiles', this.profilesItems, this.profilesFallback, this.loadingProfiles);
 97:     this.loadPlaylist('success-stories', this.successStoriesItems, this.successStoriesFallback, this.loadingSuccessStories);
 98:     this.loadPlaylist('interviews', this.interviewsItems, this.interviewsFallback, this.loadingInterviews);
 99:   }
100:   private loadPlaylist(
101:     playlist: OrientaPlaylistKey,
102:     target: WritableSignal<UiCarouselItem[]>,
103:     fallback: UiCarouselItem[],
104:     loading: WritableSignal<boolean>
105:   ): void {
106:     loading.set(true);
107:     this.orientaTechPlaylistsService
108:       .getVideosByPlaylist(playlist, 8)
109:       .pipe(
110:         tap((items) => {
111:           if (items.length === 0) {
112:             target.set(fallback);
113:           } else if (items.length < 5) {
114:             const existingSrc = new Set(items.map((item) => item.src));
115:             const missingFromFallback = fallback.filter((item) => !existingSrc.has(item.src));
116:             target.set([...items, ...missingFromFallback].slice(0, 8));
117:           } else {
118:             target.set(items);
119:           }
120:           loading.set(false);
121:         }),
122:         catchError(() => {
123:           target.set(fallback);
124:           loading.set(false);
125:           return EMPTY;
126:         }),
127:         takeUntilDestroyed(this.destroyRef)
128:       )
129:       .subscribe();
130:   }
131:   sectionItems(section: YoutubePlaylistSection): UiCarouselItem[] {
132:     if (section.key === 'profiles') {
133:       return this.profilesItems();
134:     }
135:     if (section.key === 'success-stories') {
136:       return this.successStoriesItems();
137:     }
138:     return this.interviewsItems();
139:   }
140:   sectionLoading(section: YoutubePlaylistSection): boolean {
141:     if (section.key === 'profiles') {
142:       return this.loadingProfiles();
143:     }
144:     if (section.key === 'success-stories') {
145:       return this.loadingSuccessStories();
146:     }
147:     return this.loadingInterviews();
148:   }
149: }
