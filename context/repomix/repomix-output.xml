  2: import hashlib
  3: from pathlib import Path
  4: from typing import Any, Dict, List
  5: from scripts.wiki.normalizer import section_catalog
  6: from telemetry import build_telemetry_collector
  7: class WikiValidator:
  8:     def __init__(self, schema_path: Path, telemetry_collector: Any | None = None) -> None:
  9:         self.schema_path = schema_path
 10:         self.allowed_sections = {section["id"] for section in section_catalog()}
 11:         self.allowed_kinds = {
 12:             "agent",
 13:             "skill",
 14:             "prompt",
 15:             "policy",
 16:             "project",
 17:             "spec",
 18:             "report",
 19:             "capability",
 20:         }
 21:         self._telemetry = telemetry_collector
