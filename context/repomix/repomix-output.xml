<file path="techito/src/app/features/intranet/empleo/junior/dashboard-junior/dashboard-junior.ts">
 1: import { ChangeDetectionStrategy, Component, signal, inject, DestroyRef, computed } from '@angular/core';
 2: import { RouterLink } from '@angular/router';
 3: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
 4: import { JuniorService } from '../services/junior.service';
 5: import { tap, catchError } from 'rxjs/operators';
 6: import { of } from 'rxjs';
 7: import { UiButton  } from '@shared/ui/button/button';
 8: @Component({
 9:   selector: 'app-dashboard-junior',
10:   standalone: true,
11:   changeDetection: ChangeDetectionStrategy.OnPush,
12:   imports: [RouterLink, UiButton],
13:   templateUrl: './dashboard-junior.html',
14:   styleUrl: './dashboard-junior.scss'
15: })
16: export class DashboardJunior {
17:   private readonly juniorService = inject(JuniorService);
18:   private readonly destroyRef = inject(DestroyRef);
19:   readonly loading = signal(true);
20:   readonly error = signal<string | null>(null);
21:   readonly nombreUsuario = signal('');
22:   readonly especializacion = signal('');
23:   readonly stats = signal({ ofertasGuardadas: 0, solicitudesEnviadas: 0, enProceso: 0, mensajes: 0 });
24:   readonly ofertasRecomendadas = signal<any[]>([]);
25:   readonly misCursos = signal<any[]>([]);
26:   readonly ultimosEventos = signal<any[]>([]);
27:   constructor() {
28:     this.loadDashboard();
29:   }
30:   private loadDashboard() {
31:     this.juniorService.getOfertas(1, 6)
32:       .pipe(
33:         tap((data) => {
34:           this.nombreUsuario.set('Junior TechRider');
35:           this.especializacion.set('Tecnologia');
36:           this.stats.set({
37:             ofertasGuardadas: data.items.length,
38:             solicitudesEnviadas: 0,
39:             enProceso: data.items.filter(oferta => oferta.estado === 'Activa').length,
40:             mensajes: 0
41:           });
42:           this.ofertasRecomendadas.set(data.items.map(oferta => ({ ...oferta, guardada: false })));
43:           this.misCursos.set([]);
44:           this.ultimosEventos.set([]);
45:           this.loading.set(false);
46:         }),
47:         catchError(() => {
48:           this.error.set('No se pudo cargar el dashboard');
49:           this.loading.set(false);
50:           return of(null);
51:         }),
52:         takeUntilDestroyed(this.destroyRef)
53:       )
54:       .subscribe();
55:   }
56: }
</file>

