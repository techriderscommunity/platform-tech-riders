<file path="techito/scripts/scss-auditor.js">
  1: #!/usr/bin/env node
  2: /**
  3:  * SCSS Compliance Auditor
  4:  *
  5:  * Verifica que los archivos SCSS cumplan con los estándares de TechRiders:
  6:  * - No hardcoded colors (hex, named colors, rgb)
  7:  * - No hardcoded box-shadows
  8:  * - No hardcoded border-radius
  9:  * - No duplicación de componentes
 10:  * - Uso de design-tokens
 11:  */
 12: const fs = require('fs');
 13: const path = require('path');
 14: class SCSSAuditor {
 15:   constructor(filePath) {
 16:     this.filePath = filePath;
 17:     this.content = fs.readFileSync(filePath, 'utf-8');
 18:     this.lines = this.content.split('\n');
 19:     this.issues = [];
 20:   }
 21:   audit() {
 22:     console.log(`\n📋 Auditing: ${path.relative(process.cwd(), this.filePath)}\n`);
 23:     this.checkHardcodedColors();
 24:     this.checkHardcodedShadows();
 25:     this.checkHardcodedBorderRadius();
 26:     this.checkComponentDuplication();
 27:     this.checkDesignTokenUsage();
 28:     this.report();
 29:     return this.issues;
 30:   }
 31:   checkHardcodedColors() {
 32:     const hexPattern = /#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})(?![0-9a-fA-F])/g;
 33:     const namedColorsPattern = /\b(white|black|red|blue|green|yellow|gray|grey|orange|purple|pink|cyan|magenta|lime|navy|teal|olive|coral|salmon|gold|silver|maroon|crimson|indigo|turquoise|khaki|orchid|violet|tan|chocolate)\b/gi;
 34:     const rgbPattern = /rgb\([^)]+\)/g;
 35:     this.lines.forEach((line, idx) => {
 36:       if (line.includes('//') && line.indexOf('//') < line.search(/[\s]?(#|rgb|white|black)/)) return; // Skip comments
 37:       // Hex colors (but allow in comments)
 38:       if (!line.trim().startsWith('//') && line.match(hexPattern)) {
 39:         this.issues.push({
 40:           line: idx + 1,
 41:           severity: 'error',
 42:           rule: 'no-hardcoded-hex',
 43:           message: `Hardcoded hex color found: "${line.trim()}"`,
 44:           suggestion: 'Use design-token variable (e.g., var(--tr-blue))'
 45:         });
 46:       }
 47:       // Named colors (except in comments)
 48:       if (!line.trim().startsWith('//') && line.match(namedColorsPattern)) {
 49:         const match = line.match(namedColorsPattern);
 50:         if (match && !line.includes('var(--')) {
 51:           this.issues.push({
 52:             line: idx + 1,
 53:             severity: 'error',
 54:             rule: 'no-hardcoded-named-color',
 55:             message: `Hardcoded named color found: "${line.trim()}"`,
 56:             suggestion: 'Use design-token variable (e.g., var(--text-primary))'
 57:           });
 58:         }
 59:       }
 60:       // RGB colors
 61:       if (!line.trim().startsWith('//') && line.match(rgbPattern)) {
 62:         this.issues.push({
 63:           line: idx + 1,
 64:           severity: 'error',
 65:           rule: 'no-hardcoded-rgb',
 66:           message: `Hardcoded rgb color found: "${line.trim()}"`,
 67:           suggestion: 'Use design-token variable'
 68:         });
 69:       }
 70:     });
 71:   }
 72:   checkHardcodedShadows() {
 73:     const shadowPattern = /box-shadow:\s*0\s+\d+px/i;
 74:     this.lines.forEach((line, idx) => {
 75:       if (!line.trim().startsWith('//') && line.match(shadowPattern)) {
 76:         this.issues.push({
 77:           line: idx + 1,
 78:           severity: 'error',
 79:           rule: 'no-hardcoded-shadow',
 80:           message: `Hardcoded box-shadow found: "${line.trim()}"`,
 81:           suggestion: 'Use design-token variable (e.g., var(--shadow-md))'
 82:         });
 83:       }
 84:     });
 85:   }
 86:   checkHardcodedBorderRadius() {
 87:     const radiusPattern = /border-radius:\s*[\d.]+(?:px|rem)\b/i;
 88:     this.lines.forEach((line, idx) => {
 89:       if (!line.trim().startsWith('//') && line.match(radiusPattern)) {
 90:         this.issues.push({
 91:           line: idx + 1,
 92:           severity: 'error',
 93:           rule: 'no-hardcoded-radius',
 94:           message: `Hardcoded border-radius found: "${line.trim()}"`,
 95:           suggestion: 'Use design-token variable (e.g., var(--radius-md))'
 96:         });
 97:       }
 98:     });
 99:   }
100:   checkComponentDuplication() {
101:     const componentPatterns = [
102:       { name: '.card', pattern: /^\s*\.card\s*{/ },
103:       { name: '.btn', pattern: /^\s*\.btn[^-]/ },
104:       { name: '.stat-card', pattern: /^\s*\.stat-card\s*{/ },
105:       { name: '.input-field', pattern: /^\s*\.input-field\s*{/ },
106:       { name: '.table', pattern: /^\s*\.table\s*{/ },
107:       { name: '.badge', pattern: /^\s*\.badge(?!-)\s*{/ },
108:     ];
109:     componentPatterns.forEach(comp => {
110:       const matches = this.lines.filter((line, idx) => {
111:         return line.match(comp.pattern) && !line.trim().startsWith('//');
112:       });
113:       if (matches.length > 0) {
114:         this.issues.push({
115:           line: -1,
116:           severity: 'warning',
117:           rule: 'component-redefinition',
118:           message: `Component '${comp.name}' redefined (found ${matches.length} definition(s))`,
119:           suggestion: `Use '@extend ${comp.name}' instead of redefining. Check _components.scss for base definition.`
120:         });
121:       }
122:     });
123:   }
124:   checkDesignTokenUsage() {
125:     const hardcodedSpaces = /(?:padding|margin|gap):\s*[\d.]+(?:px|rem)(?!\s*\/\/)/i;
126:     this.lines.forEach((line, idx) => {
127:       if (!line.trim().startsWith('//') && line.match(hardcodedSpaces) && !line.includes('var(--space')) {
128:         this.issues.push({
129:           line: idx + 1,
130:           severity: 'warning',
131:           rule: 'hardcoded-spacing',
132:           message: `Hardcoded spacing value found: "${line.trim()}"`,
133:           suggestion: 'Consider using design-token variables (e.g., var(--space-4))'
134:         });
135:       }
136:     });
137:   }
138:   report() {
139:     if (this.issues.length === 0) {
140:       console.log('✅ PASS: No issues found!\n');
141:       return;
142:     }
143:     const errors = this.issues.filter(i => i.severity === 'error');
144:     const warnings = this.issues.filter(i => i.severity === 'warning');
145:     if (errors.length > 0) {
146:       console.log(`❌ ERRORS (${errors.length}):`);
147:       errors.forEach(issue => {
148:         console.log(`  Line ${issue.line}: [${issue.rule}]`);
149:         console.log(`    ${issue.message}`);
150:         console.log(`    💡 ${issue.suggestion}\n`);
151:       });
152:     }
153:     if (warnings.length > 0) {
154:       console.log(`⚠️  WARNINGS (${warnings.length}):`);
155:       warnings.forEach(issue => {
156:         console.log(`  [${issue.rule}]`);
157:         console.log(`    ${issue.message}`);
158:         console.log(`    💡 ${issue.suggestion}\n`);
159:       });
160:     }
161:     const totalIssues = errors.length + warnings.length;
162:     console.log(`\n📊 Summary: ${errors.length} errors, ${warnings.length} warnings\n`);
163:     if (errors.length > 0) {
164:       process.exit(1);
165:     }
166:   }
167: }
168: // CLI
169: const filePath = process.argv[2];
170: if (!filePath) {
171:   console.log('Usage: node scss-auditor.js <path-to-scss-file>');
172:   console.log('Example: node scss-auditor.js src/app/features/admin/admin-dashboard.scss');
173:   process.exit(1);
174: }
175: if (!fs.existsSync(filePath)) {
176:   console.log(`❌ File not found: ${filePath}`);
177:   process.exit(1);
178: }
179: const auditor = new SCSSAuditor(filePath);
180: auditor.audit();
</file>

<file path="techito/scripts/scss-tokenize.js">
  1: /**
  2:  * scss-tokenize.js
  3:  * Batch-replaces hardcoded values with design token references in SCSS files.
  4:  * Usage: node scripts/scss-tokenize.js
  5:  */
  6: const fs = require('fs');
  7: const path = require('path');
  8: // ─── Replacement rules (ordered: most specific first) ───────────────────────
  9: const COLOR_RULES = [
 10:   // Extended palette — indigo/gray (mis-cursos)
 11:   { from: /#4f46e5\b/gi,   to: 'var(--palette-indigo-500)' },
 12:   { from: /#2563eb\b/gi,   to: 'var(--palette-indigo-600)' },
 13:   { from: /#1d4ed8\b/gi,   to: 'var(--palette-indigo-700)' },
 14:   { from: /#f3f4f6\b/gi,   to: 'var(--palette-gray-100)' },
 15:   { from: /#6b7280\b/gi,   to: 'var(--palette-gray-500)' },
 16:   // Emerald badge (perfil-candidato)
 17:   { from: /#d1fae5\b/gi,   to: 'var(--badge-light-emerald-bg)' },
 18:   { from: /#065f46\b/gi,   to: 'var(--badge-light-emerald-text)' },
 19:   // Error red (already a token)
 20:   { from: /#ef4444\b/gi,   to: 'var(--accent-error)' },
 21:   // Utility
 22:   { from: /#fff\b/g,       to: 'var(--color-white)' },
 23:   { from: /#ffffff\b/gi,   to: 'var(--color-white)' },
 24:   { from: /\bwhite\b/g,    to: 'var(--color-white)', onlyInValuePosition: true },
 25:   { from: /#000\b/g,       to: 'var(--color-black)' },
 26:   { from: /#000000\b/gi,   to: 'var(--color-black)' },
 27:   // Brand
 28:   { from: /#ea4335\b/gi,   to: 'var(--brand-google)' },
 29:   { from: /#4267b2\b/gi,   to: 'var(--brand-facebook)' },
 30:   // Error light
 31:   { from: /#ff7676\b/gi,   to: 'var(--accent-error-light)' },
 32:   // Progress track
 33:   { from: /#e5e7eb\b/gi,   to: 'var(--progress-track-bg)' },
 34:   // Light-mode badge backgrounds
 35:   { from: /#dcfce7\b/gi,   to: 'var(--badge-light-success-bg)' },
 36:   { from: /#166534\b/gi,   to: 'var(--badge-light-success-text)' },
 37:   { from: /#fef3c7\b/gi,   to: 'var(--badge-light-warning-bg)' },
 38:   { from: /#92400e\b/gi,   to: 'var(--badge-light-warning-text)' },
 39:   { from: /#dbeafe\b/gi,   to: 'var(--badge-light-info-bg)' },
 40:   { from: /#1e40af\b/gi,   to: 'var(--badge-light-info-text)' },
 41:   { from: /#fce7f3\b/gi,   to: 'var(--badge-light-accent-bg)' },
 42:   { from: /#9d174d\b/gi,   to: 'var(--badge-light-accent-text)' },
 43:   // Orienta-tech light palette
 44:   { from: /#e3f2fd\b/gi,   to: 'var(--palette-light-blue-50)' },
 45:   { from: /#b3e5fc\b/gi,   to: 'var(--palette-light-blue-100)' },
 46:   { from: /#1a237e\b/gi,   to: 'var(--palette-navy-800)' },
 47:   { from: /#1976d2\b/gi,   to: 'var(--palette-blue-700)' },
 48:   { from: /#00bcd4\b/gi,   to: 'var(--palette-cyan-500)' },
 49:   { from: /#fdf2f8\b/gi,   to: 'var(--palette-pink-100)' },
 50:   { from: /#ec4899\b/gi,   to: 'var(--palette-pink-500)' },
 51:   // Placeholder gradients (quienes-somos)
 52:   { from: /#1e4a8a\b/gi,   to: 'var(--placeholder-blue-from)' },
 53:   { from: /#0c6ea6\b/gi,   to: 'var(--placeholder-blue-to)' },
 54:   { from: /#5b3a9e\b/gi,   to: 'var(--placeholder-purple-from)' },
 55:   // Note: #8b2d6e is used as both purple-to and pink-from — purple-to wins
 56:   { from: /#8b2d6e\b/gi,   to: 'var(--placeholder-purple-to)' },
 57:   { from: /#047a8a\b/gi,   to: 'var(--placeholder-teal-from)' },
 58:   { from: /#a12b42\b/gi,   to: 'var(--placeholder-pink-to)' },
 59:   { from: /#a85210\b/gi,   to: 'var(--placeholder-orange-from)' },
 60:   { from: /#b56a22\b/gi,   to: 'var(--placeholder-orange-to)' },
 61:   { from: /#a88414\b/gi,   to: 'var(--placeholder-gold-from)' },
 62:   { from: /#a8690b\b/gi,   to: 'var(--placeholder-gold-to)' },
 63:   // Note: #0a7a5e appears as teal-to and green-from — use green-from
 64:   { from: /#0a7a5e\b/gi,   to: 'var(--placeholder-green-from)' },
 65:   { from: /#0d8a7a\b/gi,   to: 'var(--placeholder-green-to)' },
 66: ];
 67: // Only replace in css value context (after a colon), avoid class names/selectors
 68: const SPACING_RULES = [
 69:   // Exact px values → numbered tokens
 70:   { from: /\bgap:\s*8px\b/g,               to: 'gap: var(--space-2)' },
 71:   { from: /\bgap:\s*12px\b/g,              to: 'gap: var(--space-3)' },
 72:   { from: /\bgap:\s*16px\b/g,              to: 'gap: var(--space-4)' },
 73:   { from: /\bgap:\s*24px\b/g,              to: 'gap: var(--space-6)' },
 74:   { from: /\bgap:\s*32px\b/g,              to: 'gap: var(--space-8)' },
 75:   { from: /\bgap:\s*40px\b/g,              to: 'gap: var(--space-10)' },
 76:   // Rem gap values → fine-grained tokens
 77:   { from: /\bgap:\s*0\.3rem\b/g,           to: 'gap: var(--space-0-3)' },
 78:   { from: /\bgap:\s*0\.4rem\b/g,           to: 'gap: var(--space-0-4)' },
 79:   { from: /\bgap:\s*0\.6rem\b/g,           to: 'gap: var(--space-0-6)' },
 80:   { from: /\bgap:\s*0\.7rem\b/g,           to: 'gap: var(--space-0-7)' },
 81:   { from: /\bgap:\s*0\.8rem\b/g,           to: 'gap: var(--space-0-8)' },
 82:   { from: /\bgap:\s*1\.2rem\b/g,           to: 'gap: var(--space-1-2)' },
 83:   { from: /\bgap:\s*2\.5rem\b/g,           to: 'gap: var(--space-10)' },
