<file path="backend/TechRiders.Tests/AuthFlowIntegrationTests.cs">
  1: using System.Net;
  2: using System.Net.Http.Json;
  3: using Microsoft.AspNetCore.Hosting;
  4: using Microsoft.AspNetCore.Mvc.Testing;
  5: using Microsoft.EntityFrameworkCore;
  6: using Microsoft.Extensions.Configuration;
  7: using Microsoft.Extensions.DependencyInjection;
  8: using TechRiders.Api.Contracts.Requests.Auth;
  9: using TechRiders.Api.Contracts.Responses.Auth;
 10: using TechRiders.Infrastructure.Data;
 11: using Xunit;
 12: namespace TechRiders.Tests;
 13: public sealed class AuthFlowIntegrationTests : IClassFixture<AuthApiFactory>
 14: {
 15:     private readonly AuthApiFactory _factory;
 16:     public AuthFlowIntegrationTests(AuthApiFactory factory)
 17:     {
 18:         _factory = factory;
 19:     }
 20:     [Fact]
 21:     public async Task Local_admin_seed_should_create_admin_role_and_allow_login_with_test_credentials()
 22:     {
 23:         using var client = _factory.CreateClient(new WebApplicationFactoryClientOptions
 24:         {
 25:             AllowAutoRedirect = false
 26:         });
 27:         const string email = "shierroc@gmail.com";
 28:         const string password = "TechAdmin";
 29:         var loginResponse = await client.PostAsJsonAsync("/api/Auth/login", new LoginRequest
 30:         {
 31:             Email = email,
 32:             Password = password
 33:         });
 34:         Assert.Equal(HttpStatusCode.OK, loginResponse.StatusCode);
 35:         var loginResult = await loginResponse.Content.ReadFromJsonAsync<LocalLoginResponse>();
 36:         Assert.NotNull(loginResult);
 37:         Assert.False(string.IsNullOrWhiteSpace(loginResult!.Token));
 38:         Assert.Equal("admin", loginResult.User.Role);
 39:         using var scope = _factory.Services.CreateScope();
 40:         var dbContext = scope.ServiceProvider.GetRequiredService<TechRidersDbContext>();
 41:         var user = await dbContext.Users
 42:             .Include(u => u.UserRoles)
 43:             .ThenInclude(ur => ur.Role)
 44:             .SingleAsync(u => u.Email == email);
 45:         Assert.NotNull(user.PasswordHash);
 46:         Assert.Contains(user.UserRoles, ur => string.Equals(ur.Role.Name, "Admin", StringComparison.OrdinalIgnoreCase));
 47:         Assert.True(TechRiders.Api.Services.LocalAuthService.VerifyPassword(password, user.PasswordHash!));
 48:     }
 49:     [Fact]
 50:     public async Task Register_login_forgot_password_and_reset_password_should_work_end_to_end()
 51:     {
 52:         using var client = _factory.CreateClient(new WebApplicationFactoryClientOptions
 53:         {
 54:             AllowAutoRedirect = false
 55:         });
 56:         const string email = "maria.perez@techriders.test";
 57:         const string oldPassword = "Password123!";
 58:         const string newPassword = "Password456!";
 59:         var registerRequest = new RegisterRequest
 60:         {
 61:             Nickname = "maria",
 62:             Name = "María",
 63:             LastName = "Pérez",
 64:             Email = email,
 65:             Password = oldPassword
 66:         };
 67:         var registerResponse = await client.PostAsJsonAsync("/api/Auth/register", registerRequest);
 68:         Assert.Equal(HttpStatusCode.OK, registerResponse.StatusCode);
 69:         var registerResult = await registerResponse.Content.ReadFromJsonAsync<RegisterResponse>();
 70:         Assert.NotNull(registerResult);
 71:         Assert.Equal(email, registerResult!.Email);
 72:         var loginResponse = await client.PostAsJsonAsync("/api/Auth/login", new LoginRequest
 73:         {
 74:             Email = email,
 75:             Password = oldPassword
 76:         });
 77:         Assert.Equal(HttpStatusCode.OK, loginResponse.StatusCode);
 78:         var loginResult = await loginResponse.Content.ReadFromJsonAsync<LocalLoginResponse>();
 79:         Assert.NotNull(loginResult);
 80:         Assert.False(string.IsNullOrWhiteSpace(loginResult!.Token));
 81:         var forgotResponse = await client.PostAsJsonAsync("/api/Auth/forgot-password", new ForgotPasswordRequest
 82:         {
 83:             Email = email
 84:         });
 85:         Assert.Equal(HttpStatusCode.OK, forgotResponse.StatusCode);
 86:         var forgotResult = await forgotResponse.Content.ReadFromJsonAsync<ForgotPasswordResponse>();
 87:         Assert.NotNull(forgotResult);
 88:         Assert.False(string.IsNullOrWhiteSpace(forgotResult!.Token));
 89:         var resetResponse = await client.PostAsJsonAsync("/api/Auth/reset-password", new ResetPasswordRequest
 90:         {
 91:             Email = email,
 92:             Token = forgotResult.Token,
 93:             NewPassword = newPassword
 94:         });
 95:         Assert.Equal(HttpStatusCode.OK, resetResponse.StatusCode);
 96:         var oldPasswordLoginResponse = await client.PostAsJsonAsync("/api/Auth/login", new LoginRequest
 97:         {
 98:             Email = email,
 99:             Password = oldPassword
100:         });
101:         Assert.Equal(HttpStatusCode.Unauthorized, oldPasswordLoginResponse.StatusCode);
102:         var newPasswordLoginResponse = await client.PostAsJsonAsync("/api/Auth/login", new LoginRequest
103:         {
104:             Email = email,
105:             Password = newPassword
106:         });
