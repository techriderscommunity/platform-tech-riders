12: 			<p><strong>Rol comunidad:</strong> {{ communityRole() }}</p>
13: 		</article>
14: 		<article class="perfil-card">
15: 			<h3>Mi perfil</h3>
16: 			<div class="perfil-form">
17: 				<app-ui-text-field label="Nombre" type="text" name="perfil-nombre" [value]="nombre()" (valueChange)="updateNombre($event)"></app-ui-text-field>
18: 				<app-ui-text-field label="Email" type="email" name="perfil-email" [value]="email()" (valueChange)="updateEmail($event)"></app-ui-text-field>
19: 				<app-ui-text-field label="Centro, empresa u organización" type="text" name="perfil-organizacion" [value]="organizacion()" (valueChange)="updateOrganizacion($event)"></app-ui-text-field>
20: 				<app-ui-select label="Perfil funcional" [options]="audienceOptions" [value]="audience()" (valueChange)="updateAudience($event)"></app-ui-select>
21: 				<app-ui-textarea label="Bio / presentación" name="perfil-bio" [rows]="4" [value]="bio()" (valueChange)="updateBio($event)"></app-ui-textarea>
22: 				<app-ui-textarea label="Mis intereses" name="perfil-intereses" [rows]="3" [value]="intereses()" (valueChange)="updateIntereses($event)"></app-ui-textarea>
23: 				<div class="perfil-actions">
24: 					<app-ui-button type="button" (click)="guardarCambios()">Guardar perfil</app-ui-button>
25: 					<a routerLink="/join" class="perfil-link-action">Solicitar ser Ambassador</a>
26: 				</div>
27: 				@if (success()) {
28: 					<p class="status-message status-message-success">{{ success() }}</p>
29: 				}
30: 			</div>
31: 		</article>
32: 		<article class="perfil-card">
33: 			<h3>Próximas actividades</h3>
34: 			<ul class="perfil-list">
35: 				@for (item of proximasActividades(); track item.titulo) {
36: 					<li>
37: 						<strong>{{ item.titulo }}</strong>
38: 						<span>{{ item.detalle }}</span>
39: 					</li>
40: 				}
41: 			</ul>
42: 		</article>
43: 	</div>
44: </section>
</file>

<file path="techito/src/app/features/perfil-usuario/perfil-usuario.ts">
  1: import { ChangeDetectionStrategy, Component, computed, signal, inject } from '@angular/core';
  2: import { FormsModule } from '@angular/forms';
  3: import { RouterLink } from '@angular/router';
  4: import { AuthService } from '@core/auth/auth.service';
  5: import { catchError, of, tap } from 'rxjs';
  6: import { UiTextField  } from '@shared/ui/text-field/text-field';
  7: import { UiSelect, UiSelectOption } from '@shared/ui/select/select';
  8: import { UiTextarea  } from '@shared/ui/textarea/textarea';
  9: import { UiButton } from '@shared/ui/button/button';
 10: import { MemberProfileApi, MemberProfileService } from './services/member-profile.service';
 11: @Component({
 12:   selector: 'app-perfil-usuario',
 13:   standalone: true,
 14:   changeDetection: ChangeDetectionStrategy.OnPush,
 15:   imports: [FormsModule, RouterLink, UiTextField, UiSelect, UiTextarea, UiButton],
 16:   templateUrl: './perfil-usuario.html',
 17:   styleUrl: './perfil-usuario.scss'
 18: })
 19: export class PerfilUsuario {
 20:   private readonly authService = inject(AuthService);
 21:   private readonly memberProfileService = inject(MemberProfileService);
 22:   readonly audienceOptions: UiSelectOption[] = [
 23:     { label: 'Estudiante / junior', value: 'junior' },
 24:     { label: 'Profesional senior', value: 'senior' },
 25:     { label: 'Profesor / orientador', value: 'educator' },
 26:     { label: 'Centro educativo', value: 'centre' },
 27:     { label: 'Empresa', value: 'company' }
 28:   ];
 29:   readonly loading = signal(false);
 30:   readonly success = signal<string | null>(null);
 31:   readonly nombre = signal('');
 32:   readonly email = signal('');
 33:   readonly bio = signal('');
 34:   readonly intereses = signal('FP Tour, eventos, comunidad y aprendizaje práctico');
 35:   readonly audience = signal('junior');
 36:   readonly communityRole = signal('member');
 37:   readonly organizacion = signal('');
 38:   readonly currentUserName = computed(() => this.authService.user()?.name || this.nombre() || 'Miembro Tech Riders');
 39:   readonly currentRoles = computed(() => this.authService.user()?.roles ?? []);
 40:   readonly proximasActividades = signal([
 41:     { titulo: 'Calendario de comunidad', detalle: 'Revisa sesiones y eventos próximos desde intranet.' },
 42:     { titulo: 'Solicitud Ambassador', detalle: 'Puedes iniciar o continuar tu paso a rol activo cuando tenga sentido.' },
 43:     { titulo: 'Conocimiento compartido', detalle: 'El banco de conocimiento llegará en la siguiente release del roadmap.' },
 44:   ]);
 45:   constructor() {
 46:     this.hydrateMemberProfile();
 47:   }
 48:   guardarCambios() {
 49:     const payload = {
 50:       userKey: this.resolveUserKey(),
 51:       name: this.nombre(),
 52:       email: this.email(),
 53:       bio: this.bio(),
 54:       interests: this.intereses(),
 55:       audience: this.audience(),
 56:       communityRole: this.communityRole(),
 57:       organization: this.organizacion(),
 58:     };
 59:     this.memberProfileService.saveProfile(payload)
 60:       .pipe(
 61:         tap(() => {
 62:           if (typeof localStorage !== 'undefined') {
 63:             localStorage.setItem('techriders.mvp.memberProfile', JSON.stringify({
 64:               nombre: this.nombre(),
 65:               email: this.email(),
 66:               bio: this.bio(),
 67:               intereses: this.intereses(),
 68:               audience: this.audience(),
 69:               communityRole: this.communityRole(),
 70:               organizacion: this.organizacion(),
 71:             }));
 72:           }
 73:           this.success.set('Perfil member guardado en backend y en caché local.');
 74:         }),
 75:         catchError(() => {
 76:           if (typeof localStorage !== 'undefined') {
 77:             localStorage.setItem('techriders.mvp.memberProfile', JSON.stringify({
 78:               nombre: this.nombre(),
 79:               email: this.email(),
 80:               bio: this.bio(),
 81:               intereses: this.intereses(),
 82:               audience: this.audience(),
 83:               communityRole: this.communityRole(),
 84:               organizacion: this.organizacion(),
 85:             }));
 86:           }
 87:           this.success.set('Perfil guardado solo en caché local; el backend no respondió.');
 88:           return of(null);
 89:         })
 90:       )
 91:       .subscribe();
 92:   }
 93:   updateNombre(value: string) {
 94:     this.nombre.set(value);
 95:   }
 96:   updateEmail(value: string) {
 97:     this.email.set(value);
 98:   }
 99:   updateBio(value: string) {
100:     this.bio.set(value);
101:   }
102:   updateIntereses(value: string) {
103:     this.intereses.set(value);
104:   }
105:   updateAudience(value: string) {
106:     this.audience.set(value);
107:   }
108:   updateOrganizacion(value: string) {
109:     this.organizacion.set(value);
110:   }
111:   private hydrateMemberProfile() {
112:     const currentUser = this.authService.user();
113:     this.nombre.set(currentUser?.name ?? '');
114:     this.email.set(currentUser?.email ?? '');
115:     this.memberProfileService.getProfile(this.resolveUserKey(), currentUser?.email ?? this.resolveFallbackEmail())
116:       .pipe(
117:         tap(profile => {
118:           this.nombre.set(profile.Name);
119:           this.email.set(profile.Email);
120:           this.bio.set(profile.Bio);
121:           this.intereses.set(profile.Interests);
122:           this.audience.set(profile.Audience);
123:           this.communityRole.set(profile.CommunityRole);
124:           this.organizacion.set(profile.Organization);
125:         }),
126:         catchError(() => of(null))
127:       )
128:       .subscribe();
129:     if (typeof localStorage === 'undefined') {
130:       return;
131:     }
132:     const stored = localStorage.getItem('techriders.mvp.memberProfile');
133:     if (!stored) {
134:       return;
135:     }
136:     try {
137:       const parsed = JSON.parse(stored) as {
138:         nombre?: string;
139:         email?: string;
140:         bio?: string;
141:         intereses?: string;
142:         audience?: string;
143:         communityRole?: string;
144:         organizacion?: string;
145:       };
146:       if (parsed.nombre) this.nombre.set(parsed.nombre);
147:       if (parsed.email) this.email.set(parsed.email);
148:       if (parsed.bio) this.bio.set(parsed.bio);
149:       if (parsed.intereses) this.intereses.set(parsed.intereses);
150:       if (parsed.audience) this.audience.set(parsed.audience);
151:       if (parsed.communityRole) this.communityRole.set(parsed.communityRole);
152:       if (parsed.organizacion) this.organizacion.set(parsed.organizacion);
153:     }
154:     catch {
155:       // Ignore malformed local MVP profile data.
156:     }
157:   }
158:   private resolveUserKey(): string {
159:     return this.authService.user()?.email || this.resolveFallbackEmail();
160:   }
161:   private resolveFallbackEmail(): string {
162:     if (typeof localStorage === 'undefined') {
163:       return 'local-user@techriders.local';
164:     }
165:     const stored = localStorage.getItem('techriders.mvp.memberProfile');
166:     if (!stored) {
167:       return 'local-user@techriders.local';
168:     }
169:     try {
170:       const parsed = JSON.parse(stored) as { email?: string };
171:       return parsed.email || 'local-user@techriders.local';
172:     }
173:     catch {
174:       return 'local-user@techriders.local';
175:     }
176:   }
177: }
</file>

