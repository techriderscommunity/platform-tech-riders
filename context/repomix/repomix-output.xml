 79:     stat = path.stat()
 80:     digest = hashlib.sha256(path.read_bytes()).hexdigest()[:16]
 81:     return {
 82:         'size_bytes': stat.st_size,
 83:         'mtime_utc': datetime.fromtimestamp(stat.st_mtime, tz=timezone.utc).isoformat(),
