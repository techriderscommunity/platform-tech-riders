<file path="telemetry/scoring/efficiency.py">
 1: from __future__ import annotations
 2: from typing import Any
 3: DEFAULT_WEIGHTS = {
 4:     "time": 0.18,
 5:     "cost": 0.16,
 6:     "tokens": 0.14,
 7:     "cache": 0.12,
 8:     "parallelism": 0.10,
 9:     "reuse": 0.10,
10:     "calls": 0.10,
11:     "compression": 0.10,
12: }
13: def _clamp(value: float, lo: float = 0.0, hi: float = 1.0) -> float:
14:     return max(lo, min(hi, value))
15: def _safe_ratio(numerator: float, denominator: float) -> float:
16:     if denominator <= 0:
17:         return 0.0
18:     return numerator / denominator
19: def compute_efficiency_score(metrics: dict[str, Any], weights: dict[str, float] | None = None) -> float:
20:     w = dict(DEFAULT_WEIGHTS)
21:     if weights:
22:         w.update(weights)
23:     duration = float(metrics.get("execution_time_ms", 0.0))
24:     cost = float(metrics.get("estimated_cost", 0.0))
25:     total_tokens = float(metrics.get("total_tokens", 0.0))
26:     cache_hits = float(metrics.get("cache_hits", 0.0))
27:     cache_misses = float(metrics.get("cache_misses", 0.0))
28:     parallel_eff = float(metrics.get("parallel_efficiency", 0.0))
29:     prompt_reduction = float(metrics.get("prompt_reduction", 0.0))
30:     context_reduction = float(metrics.get("context_reduction", 0.0))
31:     calls = float(
32:         metrics.get("tool_invocations", 0)
33:         + metrics.get("provider_calls", 0)
34:         + metrics.get("llm_calls", 0)
35:         + metrics.get("mcp_calls", 0)
36:     )
37:     compression = float(metrics.get("compression_ratio", 0.0))
38:     time_score = 1.0 - _clamp(duration / 120000.0)
39:     cost_score = 1.0 - _clamp(cost / 2.0)
40:     token_score = 1.0 - _clamp(total_tokens / 200000.0)
41:     cache_score = _clamp(_safe_ratio(cache_hits, cache_hits + cache_misses))
42:     parallel_score = _clamp(parallel_eff)
43:     reuse_score = _clamp((prompt_reduction + context_reduction) / 2.0)
44:     call_score = 1.0 - _clamp(calls / 200.0)
45:     compression_score = _clamp(compression)
46:     weighted = (
47:         time_score * w["time"]
48:         + cost_score * w["cost"]
49:         + token_score * w["tokens"]
50:         + cache_score * w["cache"]
51:         + parallel_score * w["parallelism"]
52:         + reuse_score * w["reuse"]
53:         + call_score * w["calls"]
54:         + compression_score * w["compression"]
55:     )
56:     return round(_clamp(weighted) * 100.0, 2)
</file>

