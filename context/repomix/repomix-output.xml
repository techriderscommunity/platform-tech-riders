 1: using TechRiders.Application.DTOs.Responses.Intranet.AdminDashboard;
 2: using TechRiders.Application.Interfaces;
 3: using TechRiders.Domain.Interfaces;
 4: namespace TechRiders.Application.Services;
 5: public sealed class AdminDashboardService : IAdminDashboardService
 6: {
 7:     private readonly IUnitOfWork _unitOfWork;
 8:     private readonly IIntranetService _intranetService;
 9:     public AdminDashboardService(IUnitOfWork unitOfWork, IIntranetService intranetService)
10:     {
11:         _unitOfWork = unitOfWork ?? throw new ArgumentNullException(nameof(unitOfWork));
12:         _intranetService = intranetService ?? throw new ArgumentNullException(nameof(intranetService));
13:     }
14:     public async Task<AdminDashboardResponse> GetDashboardAsync(CancellationToken cancellationToken = default)
15:     {
16:         var allUserCategories = (await _unitOfWork.IntranetUserCategories.GetAllAsync(cancellationToken)).ToArray();
17:         var activeUserCategories = (await _unitOfWork.IntranetUserCategories.GetActiveAsync(cancellationToken)).ToArray();
18:         var auditLogs = (await _intranetService.GetAllAuditLogsAsync(cancellationToken))
19:             .OrderByDescending(item => item.CreatedUtc)
20:             .Take(5)
21:             .ToArray();
22:         var stats = new AdminDashboardStatsResponse
23:         {
24:             TotalUsers = allUserCategories.Select(item => item.UserId).Distinct().Count(),
25:             ActiveUsers = activeUserCategories.Select(item => item.UserId).Distinct().Count(),
26:             SuperAdmins = allUserCategories
27:                 .Where(item => string.Equals(item.Category, "Admin", StringComparison.OrdinalIgnoreCase)
28:                     || string.Equals(item.Category, "SuperAdmin", StringComparison.OrdinalIgnoreCase))
29:                 .Select(item => item.UserId)
30:                 .Distinct()
31:                 .Count(),
32:             Events = await _unitOfWork.Events.CountAsync(cancellationToken: cancellationToken),
33:             Sessions = await _unitOfWork.Sessions.CountAsync(cancellationToken: cancellationToken),
34:             Ambassadors = await _unitOfWork.Ambassadors.CountActiveAmbassadorsAsync(cancellationToken),
35:             JobOffers = await _unitOfWork.Ofertas.CountAsync(cancellationToken: cancellationToken),
36:             Applications = await _unitOfWork.Candidaturas.CountAsync(cancellationToken: cancellationToken),
37:         };
38:         return new AdminDashboardResponse
39:         {
40:             Stats = stats,
41:             RecentActions = auditLogs.Select(item => new AdminDashboardRecentActionResponse
42:             {
43:                 Action = item.Action,
44:                 Detail = string.IsNullOrWhiteSpace(item.Detail)
45:                     ? (string.IsNullOrWhiteSpace(item.ActorEmail) ? item.Module : item.ActorEmail)
46:                     : item.Detail,
47:                 CreatedUtc = item.CreatedUtc,
48:             }).ToArray(),
49:             SystemHealth = new AdminDashboardSystemHealthResponse
50:             {
51:                 Servers = "Online",
52:                 Database = "Healthy",
53:                 Uploads = "No incidents",
54:                 Cpu = "Normal",
55:             },
56:         };
57:     }
58: }
