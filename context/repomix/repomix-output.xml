 243: function Get-HiSummary {
 244:     param(
 245:         [string]$RepoRoot,
 246:         [datetime]$StartedAt,
 247:         [datetime]$EndedAt
 248:     )
 249: 
 250:     $okCount = @($script:Steps | Where-Object { $_.success }).Count
 251:     $failedCount = @($script:Steps | Where-Object { -not $_.success -and $_.required }).Count
 252:     $optionalFailedCount = @($script:Steps | Where-Object { -not $_.success -and -not $_.required }).Count
 253:     $skipped = @()
 254: 
 255:     if ($SkipSiblingReposChecks) { $skipped += 'Validate sibling repos operability' }
 256:     if ($SkipAgentPipelinePreflight) { $skipped += 'Validate agent pipeline preflight' }
 257:     if ($SkipMcpStartupChecks) { $skipped += 'Validate MCP servers start/listen capability' }
 258:     if ($SkipGraphRefresh) { $skipped += 'Refresh codegraph index sync' }
 259:     if ($SkipIntake) { $skipped += 'Run repo intake' }
 260:     if ($SkipRoutingEvals) { $skipped += 'Run routing evals' }
 261:     if ($SkipProjectNotesRefresh) { $skipped += 'Refresh project notes from observability' }
 262:     if ($SkipCopilotUsageIngest) { $skipped += 'Ingest Copilot session token usage (best effort)' }
 263:     if ($SkipChatTokenUsageReport) { $skipped += 'Refresh chat token usage report' }
 264:     if ($SkipCodegraphStatus) { $skipped += 'Check codegraph status' }
 265: 
 266:     $engineSummary = [ordered]@{
 267:         memory = [ordered]@{
 268:             command_available = Test-CommandAvailable -Name 'codebase-memory-mcp'
 269:             startup_check = Get-StepStatus -Name 'Validate MCP servers start/listen capability'
 270:         }
 271:         token_saver = [ordered]@{
 272:             command_available = Test-CommandAvailable -Name 'token-saver-mcp'
 273:             mode = Get-TokenSaverMode -RepoRoot $RepoRoot
 274:             startup_check = Get-StepStatus -Name 'Validate MCP servers start/listen capability'
 275:         }
 276:         codegraph = [ordered]@{
 277:             command_available = Test-CommandAvailable -Name 'codegraph'
 278:             index_present = Test-Path (Join-Path $RepoRoot '.codegraph')
 279:             sync = Get-StepStatus -Name 'Refresh codegraph index sync'
 280:             status = Get-StepStatus -Name 'Check codegraph status'
 281:         }
 282:         gitnexus = [ordered]@{
 283:             command_available = Test-CommandAvailable -Name 'npx'
 284:             index_present = Test-Path (Join-Path $RepoRoot '.gitnexus')
 285:             startup_check = Get-StepStatus -Name 'Validate MCP servers start/listen capability'
 286:         }
 287:         repomix = [ordered]@{
 288:             command_available = Test-CommandAvailable -Name 'npx'
 289:             startup_check = Get-StepStatus -Name 'Validate MCP servers start/listen capability'
 290:         }
 291:         graphify = [ordered]@{
 292:             graph_present = Test-Path (Join-Path $RepoRoot 'context/graphify-out/graph.json')
 293:             manifest_present = Test-Path (Join-Path $RepoRoot 'context/graphify-out/manifest.json')
 294:             startup_check = Get-StepStatus -Name 'Validate MCP servers start/listen capability'
 295:         }
 296:     }
 297: 
 298:     $artifactSummary = [ordered]@{
 299:         repo_registry_report = Test-Path (Join-Path $RepoRoot 'repo-intake/generated/reports/repo-registry-validation.json')
 300:         repo_intake = Get-StepStatus -Name 'Run repo intake'
 301:         routing_evals = Get-StepStatus -Name 'Run routing evals'
 302:         project_notes = Get-StepStatus -Name 'Refresh project notes from observability'
 303:         learning_loop = Get-StepStatus -Name 'Refresh learning loop report'
 304:         copilot_usage_ingest = Get-StepStatus -Name 'Ingest Copilot session token usage (best effort)'
 305:         chat_token_usage_report = Get-StepStatus -Name 'Refresh chat token usage report'
 306:         sibling_repos = Get-StepStatus -Name 'Validate sibling repos operability'
 307:         structure_cache = [ordered]@{
 308:             refreshed = [bool]$script:StructureCacheReport.refreshed
 309:             refresh_reason = [string]$script:StructureCacheReport.refresh_reason
 310:             changed_repos = @($script:StructureCacheReport.changed_repos).Count
 311:         }
 312:     }
 313: 
 314:     return [ordered]@{
 315:         result = if ($script:HasFailures) { 'failed' } else { 'ok' }
 316:         started_at = $StartedAt.ToString('o')
 317:         ended_at = $EndedAt.ToString('o')
 318:         duration_sec = [math]::Round((($EndedAt - $StartedAt).TotalSeconds), 2)
 319:         steps = [ordered]@{
 320:             total = @($script:Steps).Count
 321:             ok = $okCount
 322:             failed_required = $failedCount
 323:             failed_optional = $optionalFailedCount
 324:             skipped = $skipped.Count
 325:         }
 326:         engines = $engineSummary
 327:         artifacts = $artifactSummary
 328:         skipped_steps = $skipped
 329:     }
 330: }
