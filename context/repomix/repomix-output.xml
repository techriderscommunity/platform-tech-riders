 1: import { ChangeDetectionStrategy, Component, DestroyRef, computed, inject } from '@angular/core';
 2: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
 3: import { Router, RouterLink, RouterLinkActive, RouterOutlet } from '@angular/router';
 4: import { AuthService } from '@core/auth/auth.service';
 5: import { catchError, interval, of, startWith, switchMap } from 'rxjs';
 6: import { IntranetLayoutTraceService } from './services/intranet-layout-trace.service';
 7: import { INTRANET_NAV_SECTIONS, IntranetNavItem, IntranetNavSection } from './intranet-nav.config';
 8: @Component({
 9:   selector: 'app-intranet-layout',
10:   standalone: true,
11:   changeDetection: ChangeDetectionStrategy.OnPush,
12:   imports: [RouterOutlet, RouterLink, RouterLinkActive],
13:   templateUrl: './intranet-layout.html',
14:   styleUrl: './intranet-layout.scss'
15: })
16: export class IntranetLayout {
17:   private readonly authService = inject(AuthService);
18:   private readonly router = inject(Router);
19:   private readonly intranetLayoutTraceService = inject(IntranetLayoutTraceService);
20:   private readonly destroyRef = inject(DestroyRef);
21:   private readonly navSections: IntranetNavSection[] = INTRANET_NAV_SECTIONS;
22:   readonly userType = computed(() => this.authService.userType() || 'junior');
23:   readonly currentUserName = computed(() => this.authService.user()?.name || 'Usuario');
24:   readonly visibleSections = computed(() =>
25:     this.navSections
26:       .map(section => ({
27:         ...section,
28:         items: section.items.filter(item => this.authService.hasRole(item.roles)),
29:       }))
30:       .filter(section => section.items.length > 0),
31:   );
32:   constructor() {
33:     this.startHeartbeatTrace();
34:   }
35:   trackSection(_index: number, section: IntranetNavSection): string {
36:     return section.title;
37:   }
38:   trackItem(_index: number, item: IntranetNavItem): string {
39:     return `${item.label}-${item.route ?? 'disabled'}`;
40:   }
41:   goToDefaultArea() {
42:     this.router.navigateByUrl(this.authService.getDefaultRoute());
43:   }
44:   private startHeartbeatTrace() {
45:     interval(5 * 60 * 1000)
46:       .pipe(
47:         startWith(0),
48:         switchMap(() => this.intranetLayoutTraceService.emitHeartbeatTrace(this.router.url).pipe(catchError(() => of(null)))),
49:         takeUntilDestroyed(this.destroyRef),
50:       )
51:       .subscribe();
52:   }
53: }
