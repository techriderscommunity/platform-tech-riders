<file path="backend/TechRiders.API/Controllers/BaseApiController.cs">
 1: using Microsoft.AspNetCore.Mvc;
 2: namespace TechRiders.Api.Controllers;
 3: /// <summary>
 4: /// Controlador base con configuración común para todos los controladores
 5: /// </summary>
 6: [ApiController]
 7: [Route("api/[controller]")]
 8: [Produces("application/json")]
 9: [Consumes("application/json")]
10: public abstract class BaseApiController : ControllerBase
11: {
12:     /// <summary>
13:     /// Crea una respuesta de error estandarizada
14:     /// </summary>
15:     protected IActionResult CreateErrorResponse(string message, int statusCode = 400)
16:     {
17:         return StatusCode(statusCode, new
18:         {
19:             Success = false,
20:             Message = message,
21:             Timestamp = DateTime.UtcNow
22:         });
23:     }
24:     /// <summary>
25:     /// Crea una respuesta de éxito estandarizada
26:     /// </summary>
27:     protected IActionResult CreateSuccessResponse<T>(T data, string? message = null)
28:     {
29:         return Ok(new
30:         {
31:             Success = true,
32:             Message = message,
33:             Data = data,
34:             Timestamp = DateTime.UtcNow
35:         });
36:     }
37: }
</file>

