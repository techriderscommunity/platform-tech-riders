<file path="techito/src/app/features/tutoriales/services/tutoriales.service.ts">
 1: import { Injectable, inject } from '@angular/core';
 2: import { HttpClient, HttpParams } from '@angular/common/http';
 3: import { environment } from '@env/environment';
 4: import { map } from 'rxjs/operators';
 5: import { PagedResult, Tutorial, TutorialApi, TutorialesQueryParams, TutorialPagedApi } from '../models/tutoriales.models';
 6: @Injectable({ providedIn: 'root' })
 7: export class TutorialesService {
 8:   private readonly http = inject(HttpClient);
 9:   private readonly baseUrl = `${environment.apiUrl}/tutorials`;
10:   getTutoriales(params: TutorialesQueryParams) {
11:     let httpParams = new HttpParams()
12:       .set('page', String(params.page))
13:       .set('pageSize', String(params.pageSize));
14:     if (params.categoria) {
15:       httpParams = httpParams.set('category', params.categoria);
16:     }
17:     if (params.busqueda) {
18:       httpParams = httpParams.set('search', params.busqueda);
19:     }
20:     return this.http.get<TutorialPagedApi>(`${this.baseUrl}/paginated`, { params: httpParams }).pipe(
21:       map((result) => {
22:         const items = (result?.items ?? []).map((item): Tutorial => ({
23:           id: item.Id,
24:           slug: item.Slug,
25:           titulo: item.Titulo,
26:           extracto: item.Extracto,
27:           autor: item.Autor,
28:           fechaPublicacion: item.FechaPublicacion,
29:           categorias: JSON.parse(item.CategoriasJson || '[]') as string[],
30:           url: item.Url,
31:         }));
32:         const totalCount = result?.totalCount ?? 0;
33:         const page = result?.pageNumber ?? params.page;
34:         const totalPages = Math.ceil(totalCount / params.pageSize);
35:         return {
36:           items,
37:           totalCount,
38:           page,
39:           pageSize: result?.pageSize ?? params.pageSize,
40:           totalPages,
41:           hasNextPage: page < totalPages,
42:           hasPreviousPage: page > 1,
43:         } satisfies PagedResult<Tutorial>;
44:       })
45:     );
46:   }
47: }
</file>

