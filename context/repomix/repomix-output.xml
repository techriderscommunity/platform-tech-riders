 1: import { ChangeDetectionStrategy, Component, DestroyRef, computed, inject, signal } from '@angular/core';
 2: import { Router, RouterLink } from '@angular/router';
 3: import { catchError, of, tap } from 'rxjs';
 4: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
 5: import { Sesion } from './models/sesiones.models';
 6: import { SesionesService } from './services/sesiones.service';
 7: import { UiButton  } from '@shared/ui/button/button';
 8: @Component({
 9:   selector: 'app-admin-sesiones',
10:   standalone: true,
11:   changeDetection: ChangeDetectionStrategy.OnPush,
12:   imports: [RouterLink, UiButton],
13:   templateUrl: './admin-sesiones.html',
14:   styleUrl: './admin-sesiones.scss'
15: })
16: export class AdminSesiones {
17:   private readonly sesionesService = inject(SesionesService);
18:   private readonly destroyRef = inject(DestroyRef);
19:   private readonly router = inject(Router);
20:   readonly loading = signal(false);
21:   readonly error = signal<string | null>(null);
22:   readonly eventos = signal<Sesion[]>([]);
23:   readonly eventosProgramados = computed(() => this.eventos().filter(s => s.estado === 'Pendiente').length);
24:   readonly totalAsistentes = computed(() => this.eventos().reduce((sum, s) => sum + s.numAlumnos, 0));
25:   readonly context = computed(() => {
26:     const url = this.router.url;
27:     if (url.includes('/intranet/fp-tour/centers')) {
28:       return {
29:         title: 'FP Tour · Centros',
30:         subtitle: 'Solicitudes por centro con prioridad en pendientes y gestion de estados.',
31:         createLabel: '➕ Solicitar sesion',
32:       };
33:     }
34:     if (url.includes('/intranet/events/management')) {
35:       return {
36:         title: 'Eventos · Gestion',
37:         subtitle: 'Panel operativo para alta, edicion y seguimiento de eventos internos y externos.',
38:         createLabel: '➕ Crear evento',
39:       };
40:     }
41:     if (url.includes('/intranet/administration/centers')) {
42:       return {
43:         title: 'Administracion · Centros',
44:         subtitle: 'Control maestro de centros y su actividad operativa en la intranet.',
45:         createLabel: '➕ Alta de centro',
46:       };
47:     }
48:     return {
49:       title: 'FP Tour · Gestion',
50:       subtitle: 'Administra sesiones y solicitudes operativas dentro de Intranet.',
51:       createLabel: '➕ Crear registro',
52:     };
53:   });
54:   constructor() {
55:     this.sesionesService.getSesiones(1, 100)
56:       .pipe(
57:         tap(() => {
58:           this.loading.set(true);
59:           this.error.set(null);
60:         }),
61:         catchError(() => {
