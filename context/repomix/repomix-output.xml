36:     }
37:     /// <summary>
38:     /// Obtiene candidaturas por estado
39:     /// </summary>
40:     public async Task<IEnumerable<Candidatura>> GetByEstadoAsync(CandidaturaEstado estado, CancellationToken cancellationToken = default)
41:     {
42:         var candidaturas = await FindAsync(
