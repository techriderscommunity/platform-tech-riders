187: const COMMUNITY_PARTNERS_STORAGE_KEY = 'techriders.community-partners.v2';
188: @Injectable({ providedIn: 'root' })
189: export class CommunityPartnersStore {
190:   private readonly partnersState = signal<CommunityPartner[]>(this.loadInitialState());
191:   readonly allPartners = computed(() => this.partnersState());
192:   readonly approvedPartners = computed(() =>
193:     this.partnersState().filter(partner => partner.status === 'approved'),
194:   );
195:   constructor(private readonly analytics: CommunityPartnerAnalyticsService) {
196:     effect(() => {
197:       this.persistState(this.partnersState());
198:     });
199:   }
200:   findById(id: string): CommunityPartner | undefined {
201:     const partner = this.partnersState().find(item => item.id === id);
202:     if (partner) {
203:       this.analytics.track('community_partner_viewed', { id: partner.id, name: partner.name });
204:     }
205:     return partner;
206:   }
207:   submitApplication(payload: CommunityPartnerApplication): CommunityPartner {
208:     if (this.hasDuplicate(payload)) {
209:       throw new Error('Ya existe una Comuñera o solicitud con ese nombre, web o email de contacto.');
210:     }
211:     const created: CommunityPartner = {
212:       id: this.toId(payload.name),
213:       name: payload.name,
214:       logoUrl: payload.logoUrl || 'assets/logo.png',
215:       shortDescription: payload.whatYouDo,
216:       description: payload.whoYouAre,
217:       mission: payload.mission,
218:       cityOrScope: this.toScopeLabel(payload.scope),
219:       website: payload.website,
220:       linkedin: payload.linkedin,
221:       instagram: payload.instagram,
222:       x: payload.x,
223:       youtube: payload.youtube,
224:       discord: payload.discord,
225:       telegram: payload.telegram,
226:       topics: payload.topics,
227:       scope: payload.scope,
228:       contactName: payload.contactName,
229:       contactEmail: payload.contactEmail,
230:       requestedAt: new Date(),
231:       collaborations: [payload.collaborationIdeas],
232:       status: 'pending',
233:     };
234:     this.partnersState.update(list => [created, ...list]);
235:     this.analytics.track('community_partner_application_submitted', {
236:       id: created.id,
237:       name: created.name,
238:       scope: created.scope,
239:     });
240:     return created;
241:   }
242:   updateStatus(id: string, status: CommunityPartnerStatus): void {
243:     this.partnersState.update(list =>
244:       list.map(item => {
245:         if (item.id !== id) {
246:           return item;
247:         }
248:         const joinedAt = status === 'approved' ? item.joinedAt ?? new Date() : item.joinedAt;
249:         return { ...item, status, joinedAt };
250:       }),
251:     );
252:     if (status === 'approved') {
253:       this.analytics.track('community_partner_approved', { id });
254:     }
255:   }
256:   updatePartner(id: string, patch: Pick<CommunityPartner, 'shortDescription' | 'mission'>): void {
257:     this.partnersState.update(list =>
258:       list.map(item => {
259:         if (item.id !== id) {
260:           return item;
261:         }
262:         return {
263:           ...item,
264:           shortDescription: patch.shortDescription,
265:           mission: patch.mission,
266:         };
267:       }),
268:     );
269:   }
270:   trackCardClick(id: string, name: string): void {
271:     this.analytics.track('community_partner_card_clicked', { id, name });
272:   }
273:   trackApplyClick(origin: string): void {
274:     this.analytics.track('community_partner_apply_clicked', { origin });
275:   }
276:   private toId(name: string): string {
277:     const base = name
278:       .normalize('NFD')
279:       .replace(/[\u0300-\u036f]/g, '')
280:       .toLowerCase()
281:       .replace(/[^a-z0-9]+/g, '-')
282:       .replace(/(^-|-$)/g, '');
283:     return `${base || 'comunera'}-${Date.now()}`;
284:   }
285:   private toScopeLabel(scope: CommunityPartner['scope']): string {
286:     if (scope === 'local') {
287:       return 'Local';
288:     }
289:     if (scope === 'national') {
290:       return 'Nacional';
291:     }
292:     return 'Internacional';
293:   }
294:   private hasDuplicate(payload: CommunityPartnerApplication): boolean {
295:     const normalizedName = payload.name.trim().toLowerCase();
296:     const normalizedWebsite = payload.website.trim().toLowerCase();
297:     const normalizedEmail = payload.contactEmail.trim().toLowerCase();
298:     return this.partnersState().some(item =>
299:       item.name.trim().toLowerCase() === normalizedName
300:       || (item.website?.trim().toLowerCase() ?? '') === normalizedWebsite
301:       || item.contactEmail.trim().toLowerCase() === normalizedEmail,
302:     );
303:   }
304:   private loadInitialState(): CommunityPartner[] {
305:     if (typeof localStorage === 'undefined') {
306:       return INITIAL_PARTNERS;
307:     }
308:     const raw = localStorage.getItem(COMMUNITY_PARTNERS_STORAGE_KEY);
309:     if (!raw) {
310:       return INITIAL_PARTNERS;
311:     }
312:     try {
313:       const parsed = JSON.parse(raw) as Array<CommunityPartner & { requestedAt?: string; joinedAt?: string }>;
314:       return parsed.map(item => this.hydratePartner(item));
315:     } catch {
316:       return INITIAL_PARTNERS;
317:     }
318:   }
319:   private persistState(partners: CommunityPartner[]): void {
320:     if (typeof localStorage === 'undefined') {
321:       return;
322:     }
323:     localStorage.setItem(COMMUNITY_PARTNERS_STORAGE_KEY, JSON.stringify(partners));
324:   }
325:   private hydratePartner(
326:     item: CommunityPartner & { requestedAt?: string | Date; joinedAt?: string | Date },
327:   ): CommunityPartner {
328:     return {
329:       ...item,
330:       requestedAt: item.requestedAt ? new Date(item.requestedAt) : undefined,
331:       joinedAt: item.joinedAt ? new Date(item.joinedAt) : undefined,
332:     };
333:   }
334: }
</file>

