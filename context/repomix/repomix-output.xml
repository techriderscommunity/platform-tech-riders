<file path=".github/workflows/autodocs-sync.yml">
  1: name: AutoDocs Sync
  2: on:
  3:   push:
  4:     branches: [ main, develop ]
  5:   pull_request:
  6:     branches: [ main, develop ]
  7:   workflow_dispatch:
  8: permissions:
  9:   contents: read
 10: jobs:
 11:   autodocs-pr-check:
 12:     if: github.event_name == 'pull_request'
 13:     runs-on: windows-latest
 14:     steps:
 15:       - name: Checkout
 16:         uses: actions/checkout@v5
 17:         with:
 18:           fetch-depth: 0
 19:       - name: Setup Python
 20:         uses: actions/setup-python@v6
 21:         with:
 22:           python-version: '3.11'
 23:       - name: Setup Node
 24:         uses: actions/setup-node@v4
 25:         with:
 26:           node-version: '20'
 27:       - name: Compile AutoDocs
 28:         run: py -3 -m scripts.wiki.wiki_compiler
 29:         shell: pwsh
 30:       - name: Ensure npm README is updated when package surface changes
 31:         shell: pwsh
 32:         env:
 33:           BASE_SHA: ${{ github.event.pull_request.base.sha }}
 34:         run: |
 35:           $script = @'
 36:           const fs = require("node:fs");
 37:           const { execSync } = require("node:child_process");
 38:           const baseSha = process.env.BASE_SHA;
 39:           if (!baseSha) {
 40:             console.log("BASE_SHA is not available; skipping npm README check.");
 41:             process.exit(0);
 42:           }
 43:           const pkg = JSON.parse(fs.readFileSync("package.json", "utf8"));
 44:           const publishEntries = (pkg.files || []).map((entry) =>
 45:             entry.startsWith("./") ? entry.slice(2) : entry
 46:           );
 47:           const changed = execSync("git diff --name-only " + baseSha + "...HEAD", { encoding: "utf8" })
 48:             .split(/\r?\n/)
 49:             .map((line) => line.trim())
 50:             .filter(Boolean);
 51:           const readmeChanged = changed.includes("README.md");
 52:           const isNpmRelevant = (file) =>
 53:             file === "package.json" ||
 54:             file === "package-lock.json" ||
 55:             publishEntries.some((entry) => (entry.endsWith("/") ? file.startsWith(entry) : file === entry));
 56:           const npmRelevantChanges = changed.filter((file) => file !== "README.md" && isNpmRelevant(file));
 57:           if (npmRelevantChanges.length > 0 && !readmeChanged) {
 58:             console.error("Detected npm-impacting changes without README.md update.");
 59:             console.error("npm-impacting files:");
 60:             for (const file of npmRelevantChanges) console.error("- " + file);
 61:             console.error("Please update README.md (npm docs) in the same PR.");
 62:             process.exit(1);
 63:           }
 64:           if (npmRelevantChanges.length > 0) {
 65:             console.log("npm-impacting changes detected and README.md was updated.");
 66:           } else {
 67:             console.log("No npm-impacting changes detected.");
 68:           }
 69:           '@
 70:           node -e $script
 71:       - name: Validate generated artifacts are committed
 72:         shell: pwsh
 73:         run: |
 74:           git add autodocs/generated
 75:           git add autodocs/site
 76:           $changes = git status --porcelain -- autodocs/generated autodocs/site
 77:           if ([string]::IsNullOrWhiteSpace($changes)) {
 78:             Write-Host "AutoDocs artifacts are up to date"
 79:           } else {
 80:             Write-Host "Detected generated drift:"
 81:             Write-Host $changes
 82:             Write-Error "AutoDocs artifacts are outdated. Run: py -3 -m scripts.wiki.wiki_compiler and commit generated changes."
 83:             exit 1
 84:           }
 85:       - name: Summary
 86:         shell: pwsh
 87:         run: |
 88:           echo "## AutoDocs PR Check" >> $env:GITHUB_STEP_SUMMARY
 89:           echo "- Validation mode: strict" >> $env:GITHUB_STEP_SUMMARY
 90:           echo "- Entrypoint: py -3 -m scripts.wiki.wiki_compiler" >> $env:GITHUB_STEP_SUMMARY
 91:           echo "- Required artifacts: autodocs/generated + autodocs/site" >> $env:GITHUB_STEP_SUMMARY
 92:   autodocs-sync:
 93:     if: github.actor != 'github-actions[bot]'
 94:     permissions:
 95:       contents: write
 96:     runs-on: windows-latest
 97:     steps:
 98:       - name: Checkout
 99:         uses: actions/checkout@v5
100:         with:
101:           fetch-depth: 0
102:       - name: Setup Python
103:         uses: actions/setup-python@v6
104:         with:
105:           python-version: '3.11'
106:       - name: Setup Node
107:         uses: actions/setup-node@v4
108:         with:
109:           node-version: '20'
110:       - name: Compile AutoDocs
111:         run: py -3 -m scripts.wiki.wiki_compiler
112:         shell: pwsh
113:       - name: Commit projected docs and unified graph
114:         if: github.event_name != 'pull_request'
115:         shell: pwsh
116:         run: |
117:           git config user.name "github-actions[bot]"
118:           git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
119:           git add autodocs/generated
120:           git add autodocs/site
121:           $changes = git status --porcelain -- autodocs/generated autodocs/site
122:           if ([string]::IsNullOrWhiteSpace($changes)) {
123:             Write-Host "No AutoDocs changes to commit"
124:           } else {
125:             Write-Host "Detected generated drift:"
126:             Write-Host $changes
127:             git commit -m "chore(autodocs): refresh unified graph and projection"
128:             git push
129:           }
130:       - name: Summary
131:         shell: pwsh
132:         run: |
133:           echo "## AutoDocs Sync" >> $env:GITHUB_STEP_SUMMARY
134:           echo "- Entrypoint: py -3 -m scripts.wiki.wiki_compiler" >> $env:GITHUB_STEP_SUMMARY
135:           echo "- Output graph: autodocs/generated/unified-graph.json" >> $env:GITHUB_STEP_SUMMARY
136:           echo "- Projection dir: autodocs/site" >> $env:GITHUB_STEP_SUMMARY
</file>

<file path=".github/workflows/ci.yml">
 1: name: CI General — Spec Validation
 2: on:
 3:   push:
 4:     branches: [ main, develop ]
 5:   pull_request:
 6:     branches: [ main, develop ]
 7: permissions:
 8:   contents: read
 9:   pull-requests: write
10: jobs:
11:   validate:
12:     name: Validate Specs & Code (Windows)
13:     runs-on: windows-latest
14:     steps:
15:       - name: Checkout code
16:         uses: actions/checkout@v4
17:       - name: Set up Python 3.11
18:         uses: actions/setup-python@v5
19:         with:
20:           python-version: '3.11'
21:       - name: Compile Python scripts
22:         run: python -m compileall -q .\scripts
23:         shell: pwsh
24:         env:
25:           PYTHONIOENCODING: utf-8
26:       - name: Validate routing evals
27:         run: py -3 .\scripts\intake\run-routing-evals.py
28:         shell: pwsh
29:         env:
30:           PYTHONIOENCODING: utf-8
31:       - name: Validate security
32:         run: py -3 .\scripts\intake\validate-security.py
33:         shell: pwsh
34:         env:
35:           PYTHONIOENCODING: utf-8
36:       - name: Validate database routing
37:         run: py -3 .\scripts\intake\validate-database-routing.py
38:         shell: pwsh
39:         env:
40:           PYTHONIOENCODING: utf-8
41:       - name: Validate RAG routing
42:         run: py -3 .\scripts\intake\validate-rag-routing.py
43:         shell: pwsh
44:         env:
45:           PYTHONIOENCODING: utf-8
46:       - name: Validate context
47:         run: pwsh -NoProfile -ExecutionPolicy Bypass -File .\scripts\setup\validate-context.ps1 -CIMode
48:         shell: pwsh
