 86: def _normalize_path_entries(value) -> list[str]:
 87:     if isinstance(value, str):
 88:         return [value.strip()] if value.strip() else []
 89:     if isinstance(value, list):
 90:         return [entry.strip() for entry in value if isinstance(entry, str) and entry.strip()]
