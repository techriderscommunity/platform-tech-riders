 64:             ?? throw new KeyNotFoundException($"Oferta {id} not found");
 65:         offer.Publicar();
 66:         await _unitOfWork.Ofertas.UpdateAsync(offer, cancellationToken);
 67:         await _unitOfWork.SaveChangesAsync(cancellationToken);
 68:         return _mapper.Map<OfertaResponse>(offer);
 69:     }
