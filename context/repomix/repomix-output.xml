 1: using System.Linq.Expressions;
 2: using Microsoft.EntityFrameworkCore;
 3: using TechRiders.Domain.Interfaces;
 4: using TechRiders.Infrastructure.Data;
 5: namespace TechRiders.Infrastructure.Repositories;
 6: /// <summary>
 7: /// Implementación genérica del repositorio base
 8: /// Proporciona operaciones CRUD comunes para todas las entidades
 9: /// </summary>
10: public class Repository<T> : IRepository<T> where T : class
11: {
12:     protected readonly TechRidersDbContext _context;
13:     protected readonly DbSet<T> _dbSet;
14:     public Repository(TechRidersDbContext context)
15:     {
16:         _context = context;
17:         _dbSet = context.Set<T>();
18:     }
19:     public virtual async Task<T?> GetByIdAsync(Guid id, CancellationToken cancellationToken = default)
20:     {
21:         return await _dbSet.FindAsync([id], cancellationToken);
22:     }
23:     public virtual async Task<IEnumerable<T>> GetAllAsync(CancellationToken cancellationToken = default)
24:     {
25:         return await _dbSet.ToListAsync(cancellationToken);
26:     }
27:     public virtual async Task<IEnumerable<T>> FindAsync(Expression<Func<T, bool>> predicate, CancellationToken cancellationToken = default)
28:     {
29:         return await _dbSet.Where(predicate).ToListAsync(cancellationToken);
30:     }
31:     public virtual async Task<T> AddAsync(T entity, CancellationToken cancellationToken = default)
32:     {
33:         await _dbSet.AddAsync(entity, cancellationToken);
34:         return entity;
35:     }
36:     public virtual async Task AddRangeAsync(IEnumerable<T> entities, CancellationToken cancellationToken = default)
37:     {
38:         await _dbSet.AddRangeAsync(entities, cancellationToken);
39:     }
40:     public virtual Task UpdateAsync(T entity, CancellationToken cancellationToken = default)
41:     {
42:         _dbSet.Update(entity);
43:         return Task.CompletedTask;
44:     }
45:     public virtual Task DeleteAsync(T entity, CancellationToken cancellationToken = default)
46:     {
47:         _dbSet.Remove(entity);
48:         return Task.CompletedTask;
49:     }
50:     public virtual async Task<bool> ExistsAsync(Expression<Func<T, bool>> predicate, CancellationToken cancellationToken = default)
51:     {
52:         return await _dbSet.AnyAsync(predicate, cancellationToken);
53:     }
54:     public virtual async Task<int> CountAsync(Expression<Func<T, bool>>? predicate = null, CancellationToken cancellationToken = default)
55:     {
56:         return predicate == null 
57:             ? await _dbSet.CountAsync(cancellationToken)
58:             : await _dbSet.CountAsync(predicate, cancellationToken);
59:     }
60: }
</file>

