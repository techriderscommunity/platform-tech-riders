<file path="techito/src/app/features/intranet/fp-tour/calendar-eventos.ts">
  1: import { Component, OnInit, ChangeDetectionStrategy, DestroyRef, inject } from '@angular/core';
  2: import { CommonModule } from '@angular/common';
  3: import { signal, computed } from '@angular/core';
  4: import { Router } from '@angular/router';
  5: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
  6: import { EventosService } from './services/eventos.service';
  7: import { tap, catchError } from 'rxjs/operators';
  8: import { EMPTY } from 'rxjs';
  9: import { UiButton  } from '@shared/ui/button/button';
 10: export interface SesionEnEvento {
 11:   id: string;
 12:   titulo: string;
 13:   fecha: string; // 'YYYY-MM-DD' — fecha dentro del evento
 14:   horaInicio: string; // 'HH:mm'
 15:   horaFin: string; // 'HH:mm'
 16:   descripcion?: string;
 17:   ponente?: string;
 18:   sala?: string;
 19: }
 20: export interface EventoCalendario {
 21:   id: string;
 22:   titulo: string;
 23:   fechaInicio: string; // 'YYYY-MM-DD'
 24:   fechaFin: string; // 'YYYY-MM-DD'
 25:   categoria: 'FPTour' | 'TajamarTech' | 'TechRiders' | 'Colaboradores';
 26:   descripcion?: string;
 27:   centro?: string;
 28:   sesiones: SesionEnEvento[];
 29: }
 30: export interface SesionEnCarril {
 31:   sesion: SesionEnEvento;
 32:   evento: EventoCalendario;
 33:   posicionX: number; // % de desplazamiento
 34:   ancho: number; // % de ancho
 35:   carril: number; // índice de fila en el día
 36: }
 37: export interface DiaEventos {
 38:   fecha: string; // 'YYYY-MM-DD'
 39:   diasEnEventoActual?: number; // qué día del evento es este
 40:   sesionesEnCarril: SesionEnCarril[];
 41: }
 42: @Component({
 43:   selector: 'app-calendar-eventos',
 44:   standalone: true,
 45:   changeDetection: ChangeDetectionStrategy.OnPush,
 46:   imports: [CommonModule, UiButton],
 47:   templateUrl: './calendar-eventos.html',
 48:   styleUrl: './calendar-eventos.scss',
 49: })
 50: export class CalendarEventos implements OnInit {
 51:   private readonly eventosService = inject(EventosService);
 52:   private readonly destroyRef = inject(DestroyRef);
 53:   private readonly router = inject(Router);
 54:   readonly currentDate = signal(new Date());
 55:   readonly eventos = signal<EventoCalendario[]>([]);
 56:   readonly loading = signal(false);
 57:   readonly error = signal<string | null>(null);
 58:   // Categorías disponibles en orden
 59:   readonly categorias = signal<Array<'FPTour' | 'TajamarTech' | 'TechRiders' | 'Colaboradores'>>([
 60:     'FPTour',
 61:     'TajamarTech',
 62:     'TechRiders',
 63:     'Colaboradores',
 64:   ]);
 65:   // Eventos agrupados por fecha en el mes actual
 66:   readonly eventosAgrupados = computed(() => {
 67:     const eventosList = this.eventos();
 68:     const current = this.currentDate();
 69:     const mes = current.getMonth();
 70:     const año = current.getFullYear();
 71:     // Obtener todos los días del mes actual
 72:     const diasDelMes = new Date(año, mes + 1, 0).getDate();
 73:     const dias: DiaEventos[] = [];
 74:     for (let dia = 1; dia <= diasDelMes; dia++) {
 75:       const fecha = new Date(año, mes, dia);
 76:       const fechaStr = fecha.toISOString().split('T')[0];
 77:       // Encontrar todas las sesiones que ocurren en este día
 78:       const sesionesDelDia: SesionEnCarril[] = [];
 79:       eventosList.forEach((evento) => {
 80:         // Verificar si este evento incluye este día
 81:         const fechaInicioEvento = new Date(evento.fechaInicio);
 82:         const fechaFinEvento = new Date(evento.fechaFin);
 83:         const fechaActual = new Date(año, mes, dia);
 84:         if (fechaActual >= fechaInicioEvento && fechaActual <= fechaFinEvento) {
 85:           // Este evento ocurre en este día, agregar sus sesiones
 86:           evento.sesiones.forEach((sesion) => {
 87:             if (sesion.fecha === fechaStr) {
 88:               const posicion = this.calcularPosicionSesion(sesion);
 89:               sesionesDelDia.push({
 90:                 sesion,
 91:                 evento,
 92:                 posicionX: posicion.posicionX,
 93:                 ancho: posicion.ancho,
 94:                 carril: posicion.carril,
 95:               });
 96:             }
 97:           });
 98:         }
 99:       });
100:       if (sesionesDelDia.length > 0) {
101:         dias.push({
102:           fecha: fechaStr,
103:           sesionesEnCarril: sesionesDelDia,
104:         });
105:       }
106:     }
107:     return dias;
108:   });
109:   // Estadísticas
110:   readonly totalEventos = computed(() => this.eventos().length);
111:   readonly sesionesEstesMes = computed(() => {
112:     const eventosList = this.eventos();
113:     const current = this.currentDate();
