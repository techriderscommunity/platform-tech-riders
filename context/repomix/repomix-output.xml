 451: function Get-PathLastWriteUtc {
 452:     param(
 453:         [string]$Path
 454:     )
 455: 
 456:     if (-not (Test-Path $Path)) {
 457:         return [datetime]::MinValue
 458:     }
 459: 
 460:     $item = Get-Item $Path -ErrorAction Stop
 461:     if (-not $item.PSIsContainer) {
 462:         return $item.LastWriteTimeUtc
 463:     }
 464: 
 465:     $max = $item.LastWriteTimeUtc
 466:     $children = Get-ChildItem -Path $Path -Recurse -File -ErrorAction SilentlyContinue
 467:     foreach ($child in $children) {
 468:         if ($child.LastWriteTimeUtc -gt $max) {
 469:             $max = $child.LastWriteTimeUtc
 470:         }
 471:     }
 472: 
 473:     return $max
 474: }
