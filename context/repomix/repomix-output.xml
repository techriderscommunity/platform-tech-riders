<file path="backend/TechRiders.Infrastructure/Extensions/DependencyInjection.cs">
 1: using Microsoft.EntityFrameworkCore;
 2: using Microsoft.Extensions.Configuration;
 3: using Microsoft.Extensions.DependencyInjection;
 4: using TechRiders.Domain.Interfaces;
 5: using TechRiders.Infrastructure.Data;
 6: using TechRiders.Infrastructure.Repositories;
 7: namespace TechRiders.Infrastructure.Extensions;
 8: /// <summary>
 9: /// Extensiones para registrar los servicios y dependencias de infraestructura.
10: /// </summary>
11: public static class InfrastructureServiceCollectionExtensions
12: {
13:     /// <summary>
14:     /// Registra el contexto de datos y los servicios de persistencia de la infraestructura.
15:     /// </summary>
16:     public static IServiceCollection AddInfrastructureServices(this IServiceCollection services, IConfiguration configuration)
17:     {
18:         var useInMemoryDatabase = bool.TryParse(configuration["Database:UseInMemory"], out var parsedValue)
19:             && parsedValue;
20:         if (useInMemoryDatabase)
21:         {
22:             services.AddDbContext<TechRidersDbContext>(options =>
23:             {
24:                 options.UseInMemoryDatabase("TechRidersDb");
25:             });
26:         }
27:         else
28:         {
29:             var connectionString = configuration.GetConnectionString("DefaultConnection")
30:                 ?? throw new InvalidOperationException("Connection string 'DefaultConnection' was not found in configuration.");
31:             services.AddDbContext<TechRidersDbContext>(options =>
32:             {
33:                 options.UseSqlServer(connectionString, sqlOptions =>
34:                 {
35:                     sqlOptions.EnableRetryOnFailure();
36:                 });
37:             });
38:         }
39:         services.AddScoped<IUnitOfWork, UnitOfWork>();
40:         return services;
41:     }
42: }
</file>

