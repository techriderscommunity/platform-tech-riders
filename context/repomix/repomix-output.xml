 1: from __future__ import annotations
 2: from dataclasses import dataclass, field
 3: @dataclass
 4: class MetricsSnapshot:
 5:     execution_time_ms: float = 0.0
 6:     tool_duration_ms: float = 0.0
 7:     average_duration_ms: float = 0.0
 8:     parallel_tasks: int = 0
 9:     sequential_tasks: int = 0
10:     retry_count: int = 0
11:     error_count: int = 0
12:     warning_count: int = 0
13:     llm_calls: int = 0
14:     provider_calls: int = 0
15:     mcp_calls: int = 0
16:     tool_invocations: int = 0
17:     tokens_input: int = 0
18:     tokens_output: int = 0
19:     total_tokens: int = 0
20:     estimated_cost: float = 0.0
21:     cache_hits: int = 0
22:     cache_misses: int = 0
23:     compression_ratio: float = 0.0
24:     parallel_efficiency: float = 0.0
25:     prompt_reduction: float = 0.0
26:     context_reduction: float = 0.0
27: @dataclass
28: class MetricsAggregator:
29:     durations: list[float] = field(default_factory=list)
30:     snapshot: MetricsSnapshot = field(default_factory=MetricsSnapshot)
31:     def add_duration(self, value_ms: float) -> None:
32:         safe = max(0.0, float(value_ms))
33:         self.durations.append(safe)
34:         self.snapshot.tool_duration_ms += safe
35:         if self.durations:
36:             self.snapshot.average_duration_ms = self.snapshot.tool_duration_ms / len(self.durations)
37:     def add_tokens(self, input_tokens: int, output_tokens: int) -> None:
38:         self.snapshot.tokens_input += max(0, int(input_tokens))
39:         self.snapshot.tokens_output += max(0, int(output_tokens))
40:         self.snapshot.total_tokens = self.snapshot.tokens_input + self.snapshot.tokens_output
41:     def add_cost(self, estimated_cost: float) -> None:
42:         self.snapshot.estimated_cost += max(0.0, float(estimated_cost))
43:     def bump(self, metric_name: str, value: int = 1) -> None:
44:         if not hasattr(self.snapshot, metric_name):
45:             return
46:         current = getattr(self.snapshot, metric_name)
47:         if isinstance(current, int):
48:             setattr(self.snapshot, metric_name, max(0, current + int(value)))
49:     def to_dict(self) -> dict[str, float | int]:
50:         return self.snapshot.__dict__.copy()
