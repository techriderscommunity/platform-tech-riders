<file path="techito/batch-refactor.ps1">
 1: $files = @(
 2:   'src\app\features\capacitacion\solicita.scss',
 3:   'src\app\features\empleo\embajador.scss',
 4:   'src\app\features\onboarding\perfil-usuario.scss'
 5: )
 6: 
 7: foreach ($file in $files) {
 8:   if (Test-Path $file) {
 9:     Write-Host "Processing: $(Split-Path $file -Leaf)"
10:     $content = Get-Content $file -Raw
11:     
12:     # Standard replacements
13:     $content = $content -replace 'padding:\s*2rem\b', 'padding: var(--space-8)'
14:     $content = $content -replace 'margin:\s*2rem\b', 'margin: var(--space-8)'
15:     $content = $content -replace 'gap:\s*1rem\b', 'gap: var(--space-4)'
16:     $content = $content -replace 'padding:\s*1rem\b', 'padding: var(--space-4)'
17:     $content = $content -replace 'margin-bottom:\s*1rem\b', 'margin-bottom: var(--space-4)'
18:     $content = $content -replace 'padding:\s*1\.5rem\b', 'padding: var(--space-6)'
19:     $content = $content -replace 'gap:\s*1\.5rem\b', 'gap: var(--space-6)'
20:     $content = $content -replace 'margin-bottom:\s*1\.5rem\b', 'margin-bottom: var(--space-6)'
21:     $content = $content -replace '\bwhite\b(?!-)', 'var(--text-inverse)'
22:     $content = $content -replace 'var\(--primary-color\)', 'var(--tr-blue)'
23:     $content = $content -replace 'var\(--text-dark\)', 'var(--text-primary)'
24:     $content = $content -replace 'var\(--text-gray\)', 'var(--text-secondary)'
25:     
26:     Set-Content $file -Value $content
27:     Write-Host "  ✓ Updated"
28:   }
29: }
</file>

