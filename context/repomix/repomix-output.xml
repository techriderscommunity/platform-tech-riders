226:         learning_loop = Get-StepStatus -Name 'Refresh learning loop report'
227:         iteration_value = Get-StepStatus -Name 'Refresh iteration value report'
228:         repomix_output = Test-Path (Join-Path $RepoRoot 'context/repomix/repomix-output.xml')
229:         retention_cleanup = [ordered]@{
