126:   { from: /\bborder-radius:\s*2rem\b/g,    to: 'border-radius: var(--radius-full)' },
127:   { from: /\bborder-radius:\s*1rem\b/g,    to: 'border-radius: var(--radius-full)' },
128:   { from: /\bborder-radius:\s*1\.5rem\b/g, to: 'border-radius: var(--radius-2xl)' },
