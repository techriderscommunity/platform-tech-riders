<file path="techito/src/app/features/intranet/empleo/junior/editar-perfil/editar-perfil.html">
  1: <div class="editar-perfil">
  2:   <div class="page-header">
  3:     <h1>Editar Mi Perfil</h1>
  4:     <p class="subtitle">Mantén tu perfil actualizado para atraer a las mejores oportunidades</p>
  5:   </div>
  6:   <!-- Tabs -->
  7:   <div class="tabs">
  8:     <button class="tab" [class.activo]="tabActiva() === 'publico'" (click)="tabActiva.set('publico')">
  9:       👤 Perfil Público
 10:     </button>
 11:     <button class="tab" [class.activo]="tabActiva() === 'privado'" (click)="tabActiva.set('privado')">
 12:       🔒 Datos Privados
 13:     </button>
 14:   </div>
 15:   <!-- Perfil Público -->
 16:   @if (tabActiva() === 'publico') {
 17:   <div class="tab-content">
 18:     <div class="formulario">
 19:       <div class="form-section">
 20:         <h3>Información Básica</h3>
 21:         <div class="form-group">
 22:           <app-ui-text-field
 23:             label="Nombre Completo"
 24:             type="text"
 25:             name="junior-nombre"
 26:             [value]="perfilPublico().nombre"
 27:             (valueChange)="updatePerfilPublico('nombre', $event)"
 28:           ></app-ui-text-field>
 29:         </div>
 30:         <div class="form-group">
 31:           <app-ui-text-field
 32:             label="Título Profesional"
 33:             type="text"
 34:             name="junior-titulo"
 35:             [value]="perfilPublico().titulo"
 36:             (valueChange)="updatePerfilPublico('titulo', $event)"
 37:             placeholder="Ej: Desarrollador Frontend"
 38:           ></app-ui-text-field>
 39:         </div>
 40:         <div class="form-group">
 41:           <app-ui-text-field
 42:             label="Ubicación"
 43:             type="text"
 44:             name="junior-ubicacion"
 45:             [value]="perfilPublico().ubicacion"
 46:             (valueChange)="updatePerfilPublico('ubicacion', $event)"
 47:           ></app-ui-text-field>
 48:         </div>
 49:         <div class="form-group">
 50:           <app-ui-textarea
 51:             label="Resumen Profesional"
 52:             name="junior-resumen"
 53:             [value]="perfilPublico().resumen"
 54:             (valueChange)="updatePerfilPublico('resumen', $event)"
 55:             [rows]="6"
 56:             placeholder="Cuéntales quién eres y qué buscas..."
 57:           ></app-ui-textarea>
 58:         </div>
 59:       </div>
 60:       <div class="form-section">
 61:         <h3>Habilidades Técnicas</h3>
 62:         <div class="habilidades-container">
 63:           <div class="habilidades-actuales">
 64:             @for (hab of perfilPublico().habilidades; track hab) {
 65:             <div class="habilidad-tag">
 66:               {{hab}}
 67:               <button type="button" class="remove-btn" (click)="eliminarHabilidad(hab)">×</button>
 68:             </div>
 69:             }
 70:           </div>
 71:           <div class="agregar-habilidad">
 72:             <app-ui-select
 73:               [options]="habilidadesOptions()"
 74:               [value]="nuevaHabilidad()"
 75:               (valueChange)="nuevaHabilidad.set($event)"
 76:             ></app-ui-select>
 77:             <app-ui-button type="button" class="btn-small" (click)="agregarHabilidad()">+ Agregar</app-ui-button>
 78:           </div>
 79:         </div>
 80:       </div>
 81:       <div class="form-section">
 82:         <h3>Experiencia</h3>
 83:         <div class="form-group">
 84:           <app-ui-textarea
 85:             label="Resumen de Experiencia"
 86:             name="junior-experiencia"
 87:             [value]="perfilPublico().experiencia"
 88:             (valueChange)="updatePerfilPublico('experiencia', $event)"
 89:             [rows]="4"
 90:           ></app-ui-textarea>
 91:         </div>
 92:       </div>
 93:       <div class="form-actions">
 94:         <app-ui-button class="btn-primary" (click)="guardarCambios('perfil público')">Guardar Cambios</app-ui-button>
 95:       </div>
 96:     </div>
 97:   </div>
 98:   }
 99:   <!-- Datos Privados -->
100:   @if (tabActiva() === 'privado') {
101:   <div class="tab-content">
102:     <div class="formulario">
103:       <div class="form-section">
104:         <h3>Información de Contacto</h3>
105:         <div class="form-group">
106:           <app-ui-text-field
107:             label="Email"
108:             type="email"
109:             name="junior-email"
110:             [value]="perfilPrivado().email"
111:           ></app-ui-text-field>
112:           <small>Tu email no se puede cambiar</small>
113:         </div>
114:         <div class="form-group">
115:           <app-ui-text-field
116:             label="Teléfono"
117:             type="tel"
118:             name="junior-telefono"
119:             [value]="perfilPrivado().telefono"
120:             (valueChange)="updatePerfilPrivado('telefono', $event)"
121:           ></app-ui-text-field>
122:         </div>
123:       </div>
124:       <div class="form-section">
125:         <h3>Información Personal</h3>
126:         <div class="form-row">
127:           <div class="form-group">
128:             <app-ui-text-field
129:               label="Edad"
130:               type="number"
131:               name="junior-edad"
132:               [value]="'' + perfilPrivado().edad"
133:               (valueChange)="updatePerfilPrivado('edad', +$event)"
134:             ></app-ui-text-field>
135:           </div>
136:           <div class="form-group">
137:             <app-ui-select
138:               label="Disponibilidad"
139:               [options]="disponibilidadOptions()"
140:               [value]="perfilPrivado().disponibilidad"
141:               (valueChange)="updatePerfilPrivado('disponibilidad', $event)"
142:             ></app-ui-select>
143:           </div>
144:         </div>
145:       </div>
146:       <div class="form-section">
147:         <h3>Formación Académica</h3>
148:         <div class="form-group">
149:           <app-ui-text-field
150:             label="Grado/Título"
151:             type="text"
152:             name="junior-grado"
153:             [value]="perfilPrivado().gradoAcademico"
154:             (valueChange)="updatePerfilPrivado('gradoAcademico', $event)"
155:           ></app-ui-text-field>
156:         </div>
157:         <div class="form-group">
158:           <app-ui-text-field
159:             label="Universidad/Centro"
160:             type="text"
161:             name="junior-universidad"
162:             [value]="perfilPrivado().universidad"
163:             (valueChange)="updatePerfilPrivado('universidad', $event)"
164:           ></app-ui-text-field>
165:         </div>
166:       </div>
167:       <div class="form-section">
168:         <h3>Datos Laborales</h3>
169:         <div class="form-group">
170:           <app-ui-text-field
171:             label="Pretensión Salarial"
172:             type="text"
173:             name="junior-pretension"
174:             [value]="perfilPrivado().pretensionSalarial"
175:             (valueChange)="updatePerfilPrivado('pretensionSalarial', $event)"
176:             placeholder="24.000 - 30.000€"
177:           ></app-ui-text-field>
178:         </div>
179:       </div>
180:       <div class="form-actions">
181:         <app-ui-button class="btn-primary" (click)="guardarCambios('datos privados')">Guardar Cambios</app-ui-button>
182:       </div>
183:     </div>
184:   </div>
185:   }
186: </div>
</file>

<file path="techito/src/app/features/intranet/empleo/junior/editar-perfil/editar-perfil.ts">
 1: import { ChangeDetectionStrategy, Component, computed, inject, signal } from '@angular/core';
 2: import { toSignal } from '@angular/core/rxjs-interop';
 3: import { FormsModule } from '@angular/forms';
 4: import { PublicContentService } from '@core/content/public-content.service';
 5: import { UiTextField  } from '@shared/ui/text-field/text-field';
 6: import { UiTextarea  } from '@shared/ui/textarea/textarea';
 7: import { UiSelect, UiSelectOption  } from '@shared/ui/select/select';
 8: import { UiButton  } from '@shared/ui/button/button';
 9: import { PerfilPrivado, PerfilPublico } from '../models/junior.models';
10: @Component({
11:   selector: 'app-editar-perfil',
12:   standalone: true,
13:   changeDetection: ChangeDetectionStrategy.OnPush,
14:   imports: [FormsModule, UiTextField, UiTextarea, UiSelect, UiButton],
15:   templateUrl: './editar-perfil.html',
16:   styleUrl: './editar-perfil.scss'
17: })
18: export class EditarPerfil {
19:   private readonly publicContentService = inject(PublicContentService);
20:   private readonly publicContent = toSignal(this.publicContentService.getPublicContent(), { initialValue: null });
21:   readonly tabActiva = signal<'publico' | 'privado'>('publico');
22:   readonly perfilPublico = signal<PerfilPublico>({
23:     nombre: 'Ana García',
24:     titulo: 'Desarrollador Frontend',
25:     ubicacion: 'Madrid, España',
26:     resumen: 'Desarrolladora frontend apasionada por React y crear interfaces intuitivas...',
27:     habilidades: ['JavaScript', 'React', 'CSS', 'HTML', 'Git'],
28:     experiencia: 'Junior con 6 meses de experiencia en desarrollo web',
29:     foto: 'AG'
30:   });
31:   readonly perfilPrivado = signal<PerfilPrivado>({
32:     email: 'ana.garcia@email.com',
33:     telefono: '+34 612 345 678',
34:     edad: 22,
35:     gradoAcademico: 'Grado en Ingeniería Informática',
36:     universidad: 'Universidad Autónoma de Madrid',
37:     disponibilidad: 'Inmediata',
38:     pretensionSalarial: '24.000 - 30.000€'
39:   });
40:   readonly habilidadesDisponibles = computed(() => this.publicContent()?.intranet.juniorSkillOptions ?? []);
41:   readonly habilidadesOptions = computed<UiSelectOption[]>(() => [
42:     { label: 'Selecciona una habilidad...', value: '' },
43:     ...this.habilidadesDisponibles().map(hab => ({ label: hab, value: hab }))
44:   ]);
45:   readonly disponibilidadOptions = computed<UiSelectOption[]>(
46:     () => this.publicContent()?.intranet.juniorAvailabilityOptions ?? []
47:   );
48:   readonly nuevaHabilidad = signal('');
49:   guardarCambios(tipo: string) {
50:     alert(`Cambios en ${tipo} guardados correctamente`);
51:   }
52:   updatePerfilPublico(field: keyof PerfilPublico, value: string) {
53:     this.perfilPublico.update(v => ({ ...v, [field]: value }));
54:   }
55:   updatePerfilPrivado(field: keyof PerfilPrivado, value: string | number) {
56:     this.perfilPrivado.update(v => ({ ...v, [field]: value }));
57:   }
58:   agregarHabilidad() {
59:     const hab = this.nuevaHabilidad();
60:     if (hab && !this.perfilPublico().habilidades.includes(hab)) {
61:       this.perfilPublico.update(v => ({ ...v, habilidades: [...v.habilidades, hab] }));
62:       this.nuevaHabilidad.set('');
63:     }
64:   }
65:   eliminarHabilidad(habilidad: string) {
66:     this.perfilPublico.update(v => ({ ...v, habilidades: v.habilidades.filter(h => h !== habilidad) }));
67:   }
68: }
</file>

