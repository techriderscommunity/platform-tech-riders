 95:   @Input() label: string = '';
 96:   @Input() ariaLabel: string = '';
 97:   @Input() ariaPressed: boolean = false;
 98:   @Input() disabled: boolean = false;
 99:   @Input() isLoading: boolean = false;
100: }
101: // ===== DIALOG / MODAL COMPONENTS ===== //
102: /**
103:  * Accessible Modal with ARIA patterns
104:  * Usage: <app-modal [open]="isOpen" ariaLabelledby="modalTitle" (close)="isOpen = false"></app-modal>
105:  */
106: @Component({
107:   selector: 'app-modal',
108:   template: `
109:     @if (open) {
110:       <div
111:         role="dialog"
112:         [attr.aria-labelledby]="ariaLabelledby"
113:         [attr.aria-modal]="true"
114:         class="modal-backdrop"
115:         (keydown.escape)="close()"
116:       >
117:         <div class="modal-content">
118:           <h2 [id]="ariaLabelledby">{{ title }}</h2>
119:           <ng-content></ng-content>
120:           <button aria-label="Close dialog" (click)="close()">×</button>
121:         </div>
122:       </div>
123:     }
124:   `,
125: })
126: export class ModalComponent {
127:   @Input() open: boolean = false;
128:   @Input() title: string = '';
129:   @Input() ariaLabelledby: string = '';
130:   close() {
131:     this.open = false;
132:   }
133: }
134: // ===== ALERT / NOTIFICATION COMPONENTS ===== //
135: /**
136:  * Accessible Alert with ARIA patterns
137:  * Usage: <app-alert role="alert" aria-live="polite">Form submitted successfully!</app-alert>
138:  */
139: @Component({
140:   selector: 'app-alert',
141:   template: `
142:     <div
143:       role="alert"
144:       [attr.aria-live]="liveRegion"
145:       [attr.aria-atomic]="true"
146:       class="alert"
147:       [class.alert-info]="type === 'info'"
148:       [class.alert-success]="type === 'success'"
149:       [class.alert-error]="type === 'error'"
150:       [class.alert-warning]="type === 'warning'"
151:     >
152:       @if (icon) {
153:         <span class="alert-icon">{{ icon }}</span>
154:       }
155:       <ng-content></ng-content>
156:     </div>
157:   `,
158: })
159: export class AlertComponent {
160:   @Input() type: 'info' | 'success' | 'error' | 'warning' = 'info';
161:   @Input() liveRegion: 'polite' | 'assertive' = 'polite';
162:   @Input() icon: string = '';
163: }
164: // ===== NAVIGATION PATTERNS ===== //
165: /**
166:  * Accessible Navigation Menu
167:  * ARIA patterns for nested menus, active states, and keyboard navigation
168:  */
169: export class NavigationPatterns {
170:   /**
171:    * Main nav should use role="navigation" or semantic <nav>
172:    * Active link: aria-current="page"
173:    * Submenus: aria-expanded="true/false", aria-controls="submenu-id"
174:    */
175:   /* HTML Structure:
176:   <nav aria-label="Main navigation">
177:     <ul role="menubar">
178:       <li role="presentation">
179:         <a href="/home" aria-current="page">Home</a>
180:       </li>
181:       <li role="presentation">
182:         <button
183:           aria-expanded="false"
184:           aria-controls="submenu-features"
185:           aria-haspopup="true"
186:         >
187:           Features
188:         </button>
189:         <ul
190:           id="submenu-features"
191:           role="menu"
192:           hidden
193:           aria-label="Features submenu"
194:         >
195:           <li role="presentation"><a href="/features/1">Feature 1</a></li>
196:           <li role="presentation"><a href="/features/2">Feature 2</a></li>
197:         </ul>
198:       </li>
199:     </ul>
200:   </nav>
201:   */
202:   /**
203:    * Keyboard navigation:
204:    * - Tab: Move to next focusable element
205:    * - Shift+Tab: Move to previous focusable element
206:    * - Enter: Activate button/link
207:    * - Space: Toggle menu/checkbox
208:    * - Arrow keys: Navigate menu items (role="menubar")
209:    */
210: }
211: // ===== FORM VALIDATION PATTERNS ===== //
212: /**
213:  * Form Validation with ARIA
214:  * Pattern: aria-invalid="true" + aria-describedby for error messages
215:  */
216: export class FormValidationPattern {
217:   /*
218:   <div class="form-group">
219:     <label for="email">Email</label>
220:     <input
221:       id="email"
222:       type="email"
223:       aria-invalid="true"
224:       aria-describedby="email-error"
225:       class="is-error"
226:     />
227:     <p id="email-error" role="alert" class="error-message">
228:       Please enter a valid email address
229:     </p>
230:   </div>
231:   Success state:
232:   <input
233:     id="password"
234:     type="password"
235:     aria-invalid="false"
236:     class="is-success"
237:   />
238:   */
239: }
240: // ===== PROGRESSIVE DISCLOSURE (Show/Hide) ===== //
241: /**
242:  * Show/Hide Pattern with ARIA
243:  * Pattern: aria-expanded + aria-controls
244:  */
245: export class DisclosurePattern {
246:   /*
247:   <button
248:     aria-expanded="false"
249:     aria-controls="details-section"
250:   >
251:     Show more details
252:   </button>
253:   <div id="details-section" hidden>
254:     <!-- Hidden content -->
255:   </div>
256:   On toggle:
257:   - Set aria-expanded="true/false" on button
258:   - Toggle hidden attribute on content div
259:   */
260: }
261: // ===== LOADING STATES ===== //
262: /**
263:  * Loading indicator with ARIA live regions
264:  * Pattern: aria-live="polite" for non-intrusive updates
265:  *          aria-live="assertive" for urgent updates
266:  */
267: export class LoadingPattern {
268:   /*
269:   <div aria-live="polite" aria-busy="true" role="status">
270:     Loading data...
271:   </div>
272:   When done:
273:   <div aria-live="polite" aria-busy="false" role="status">
274:     Data loaded successfully
275:   </div>
276:   */
277: }
278: // ===== ACCESSIBILITY CHECKLIST ===== //
279: /**
280:  * Before shipping any component, verify:
281:  *
282:  * ✓ Semantic HTML: Use <button>, <input>, <nav>, <main>, etc.
283:  * ✓ ARIA roles: Only when semantic HTML cannot be used
284:  * ✓ ARIA labels: aria-label, aria-labelledby, aria-describedby
285:  * ✓ Form labels: <label for="id"> linked to input
286:  * ✓ Error messages: role="alert", aria-invalid="true"
287:  * ✓ Keyboard nav: Tab, Shift+Tab, Enter, Space, Arrow keys
288:  * ✓ Focus visible: :focus-visible style defined
289:  * ✓ Focus trap: Modal should trap focus inside
290:  * ✓ Skip links: Allow users to skip repetitive content
291:  * ✓ Color contrast: WCAG AA (4.5:1 for text, 3:1 for UI)
292:  * ✓ Font size: Minimum 14px for body text
293:  * ✓ Touch targets: Minimum 44px (WCAG 2.1 Level AAA)
294:  * ✓ Alt text: All images must have meaningful alt text
295:  * ✓ Live regions: Use aria-live for dynamic updates
296:  * ✓ Landmarks: Use <nav>, <main>, <aside>, <footer>
297:  * ✓ Screen reader testing: Test with NVDA, JAWS, or VoiceOver
298:  */
299: // ===== TESTING COMMANDS ===== //
300: /**
301:  * Accessibility testing:
302:  *
303:  * 1. Keyboard navigation:
304:  *    - Tab through entire page
305:  *    - Verify focus is visible and logical
306:  *    - Verify modals trap focus
307:  *
308:  * 2. Screen reader testing (NVDA on Windows):
309:  *    - Start NVDA
310:  *    - Navigate with arrow keys
311:  *    - Verify form labels, error messages, buttons are announced
312:  *
313:  * 3. Color contrast (axe DevTools extension):
314:  *    - Open Chrome DevTools → axe DevTools
315:  *    - Verify WCAG AA compliance
316:  *
317:  * 4. Automated testing:
318:  *    npm run a11y
319:  *    ngx-testing-library with axe-core for unit tests
320:  */
</file>

