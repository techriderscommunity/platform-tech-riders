<file path="techito/src/app/features/intranet/staff/services/staff-governance.service.ts">
 1: import { HttpClient } from '@angular/common/http';
 2: import { Injectable, inject } from '@angular/core';
 3: import { environment } from '@env/environment';
 4: import { forkJoin } from 'rxjs';
 5: import { map } from 'rxjs/operators';
 6: import { GovernanceData, GovernanceRoleResponse, GovernanceUserResponse, StaffItem } from '../models/staff-governance.models';
 7: @Injectable({ providedIn: 'root' })
 8: export class StaffGovernanceService {
 9:   private readonly http = inject(HttpClient);
10:   private readonly baseUrl = environment.apiUrl;
11:   getGovernanceData() {
12:     return forkJoin({
13:       users: this.http.get<GovernanceUserResponse[]>(`${this.baseUrl}/admin/staff/usuarios`),
14:       roles: this.http.get<GovernanceRoleResponse[]>(`${this.baseUrl}/admin/staff/roles`),
15:     }).pipe(
16:       map(({ users, roles }) => ({
17:         staff: (users ?? []).map((user): StaffItem => ({
18:           id: user.id,
19:           nombre: user.name,
20:           email: user.email,
21:           rolPrincipal: user.primaryRole,
22:           roles: user.roles ?? [user.primaryRole],
23:           estado: user.active ? 'activo' : 'inactivo',
24:         })),
25:         roles: (roles ?? []).map(role => role.name),
26:       } satisfies GovernanceData)),
27:     );
28:   }
29:   updateEstado(id: string, active: boolean) {
30:     return this.http.put(`${this.baseUrl}/admin/staff/usuarios/${id}/estado`, { activo: active });
31:   }
32:   updateRoles(id: string, primaryRole: string, roles: string[]) {
33:     return this.http.put(`${this.baseUrl}/admin/staff/usuarios/${id}/roles`, {
34:       primaryRole,
35:       roles,
36:     });
37:   }
38: }
</file>

