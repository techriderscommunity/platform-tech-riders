63:           return of({ items: [] as Sesion[] });
64:         }),
65:         takeUntilDestroyed(this.destroyRef)
66:       )
67:       .subscribe(result => {
68:         this.eventos.set(result.items);
69:         this.loading.set(false);
70:       });
