16:     for k, v in kwargs.items():
17:         cmd += [f"--{k.replace('_', '-')}", v]
18:     # Use utf-8 encoding and errors='replace' to handle non-ASCII chars
19:     proc = subprocess.run(
20:         cmd,
21:         cwd=str(REPO_ROOT),
22:         capture_output=True,
23:         text=True,
24:         encoding="utf-8",
25:         errors="replace"
26:     )
27:     stdout = proc.stdout or ""
28:     brace = stdout.find("{")
29:     if brace == -1:
30:         raise ValueError(f"No JSON in output: {stdout[:200]}")
31:     decoder = json.JSONDecoder()
32:     payload, _ = decoder.raw_decode(stdout[brace:])
33:     return payload
