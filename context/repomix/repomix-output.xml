<file path="scripts/intake/repo-intake.py">
  1: import argparse
  2: from pathlib import Path
  3: import json
  4: import re
  5: import shutil
  6: import hashlib
  7: from datetime import datetime, timezone
  8: try:
  9:     import yaml  # type: ignore
 10: except Exception:
 11:     yaml = None
 12: def parse_simple_yml(path):
 13:     repos = []
 14:     cur = None
 15:     for line in Path(path).read_text(encoding='utf-8').splitlines():
 16:         st = line.strip()
 17:         if st.startswith('- name:'):
 18:             if cur:
 19:                 repos.append(cur)
 20:             cur = {'name': st.split(':', 1)[1].strip()}
 21:         elif cur and ':' in st and not st.startswith('#'):
 22:             k, v = st.split(':', 1)
 23:             k = k.strip()
 24:             v = v.strip().strip('"')
 25:             if k in ['domain', 'type', 'version', 'package_name', 'package_path']:
 26:                 cur[k] = v
 27:     if cur:
 28:         repos.append(cur)
 29:     return {'schema_version': '1.0', 'repos': repos}
 30: def load_registry(path):
 31:     content = Path(path).read_text(encoding='utf-8')
 32:     if content.lstrip().startswith('{'):
 33:         return json.loads(content)
 34:     if yaml is not None:
 35:         data = yaml.safe_load(content) or {}
 36:         if isinstance(data, dict) and data.get('repos'):
 37:             return data
 38:     return parse_simple_yml(path)
 39: def slug(s):
 40:     return re.sub(r'[^A-Za-z0-9_-]+', '-', s).strip('-').lower()
 41: def utc_now():
 42:     return datetime.now(timezone.utc).isoformat()
 43: def resolve_package_path(repo_root: Path, package_name: str, package_path: str = '') -> Path:
 44:     if package_path.strip():
 45:         path = Path(package_path.strip())
 46:         if path.is_absolute():
 47:             return path.resolve()
 48:         return (repo_root / path).resolve()
 49:     return (repo_root / 'node_modules' / package_name).resolve()
 50: def materialize_repo(repo_root: Path, repo: dict) -> tuple[Path, dict]:
 51:     package_name = str(repo.get('package_name', '')).strip()
 52:     package_path = str(repo.get('package_path', '')).strip()
 53:     resolved_path = resolve_package_path(repo_root, package_name, package_path)
 54:     contract_path = resolved_path / 'mcpee.json'
 55:     status = 'installed'
 56:     if not resolved_path.exists():
 57:         status = 'missing_package'
 58:     elif not contract_path.exists():
 59:         status = 'missing_contract'
 60:     return resolved_path, {
 61:         'mode': 'npm',
 62:         'package_name': package_name,
 63:         'package_path': package_path or f"node_modules/{package_name}",
 64:         'resolved_path': str(resolved_path).replace('\\', '/'),
 65:         'status': status,
 66:     }
