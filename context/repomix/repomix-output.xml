151:         {
152:             Success = true,
153:             Message = "Si la cuenta existe, recibirás el enlace de recuperación en tu correo.",
154:             Token = resetToken
155:         };
156:     }
157:     public static async Task<bool> ResetPasswordAsync(TechRidersDbContext dbContext, string email, string token, string newPassword, CancellationToken cancellationToken = default)
158:     {
159:         var normalizedEmail = email.Trim();
160:         var normalizedToken = token.Trim();
161:         if (string.IsNullOrWhiteSpace(normalizedToken) || string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 8)
162:         {
163:             return false;
164:         }
165:         var user = await dbContext.Users
166:             .FirstOrDefaultAsync(u => u.Email == normalizedEmail && u.IsActive, cancellationToken);
167:         if (user is null) return false;
168:         if (string.IsNullOrWhiteSpace(user.PasswordResetToken) || !string.Equals(user.PasswordResetToken, normalizedToken, StringComparison.Ordinal))
169:         {
170:             return false;
171:         }
172:         if (user.PasswordResetTokenExpiresAt is null || user.PasswordResetTokenExpiresAt.Value < DateTime.UtcNow)
173:         {
174:             return false;
175:         }
176:         user.PasswordHash = HashPassword(newPassword);
177:         user.PasswordResetToken = null;
178:         user.PasswordResetTokenExpiresAt = null;
179:         user.UpdatedAt = DateTime.UtcNow;
180:         await dbContext.SaveChangesAsync(cancellationToken);
181:         return true;
182:     }
183:     public static string CreateToken(User user, IConfiguration configuration)
184:     {
185:         var localAuthSettings = configuration.GetSection("LocalAuth");
186:         var issuer = localAuthSettings["Issuer"] ?? "TechRidersLocalAuth";
187:         var audience = localAuthSettings["Audience"] ?? "TechRidersApi";
188:         var signingKey = localAuthSettings["SigningKey"] ?? "techriders-local-auth-signing-key-2025";
189:         var lifetimeHours = localAuthSettings.GetValue<int?>("TokenLifetimeHours") ?? 8;
190:         var roles = user.UserRoles
191:             .Select(ur => ur.Role.Name)
192:             .Where(name => !string.IsNullOrWhiteSpace(name))
193:             .Distinct(StringComparer.OrdinalIgnoreCase)
194:             .DefaultIfEmpty("Admin")
195:             .ToArray();
196:         var claims = new List<Claim>
197:         {
198:             new(JwtRegisteredClaimNames.Sub, user.Id.ToString()),
199:             new(JwtRegisteredClaimNames.Email, user.Email),
200:             new(ClaimTypes.NameIdentifier, user.Id.ToString()),
201:             new(ClaimTypes.Name, user.Name + " " + user.LastName),
202:             new(ClaimTypes.Email, user.Email),
203:         };
204:         claims.AddRange(roles.Select(role => new Claim(ClaimTypes.Role, role)));
205:         var securityKey = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(signingKey));
206:         var signingCredentials = new SigningCredentials(securityKey, SecurityAlgorithms.HmacSha256);
207:         var token = new JwtSecurityToken(
208:             issuer: issuer,
209:             audience: audience,
210:             claims: claims,
211:             notBefore: DateTime.UtcNow,
212:             expires: DateTime.UtcNow.AddHours(lifetimeHours),
213:             signingCredentials: signingCredentials);
214:         return new JwtSecurityTokenHandler().WriteToken(token);
215:     }
216:     public static LocalUserProfile BuildUserProfile(User user)
217:     {
218:         var roles = user.UserRoles
219:             .Select(ur => ur.Role.Name)
220:             .Where(name => !string.IsNullOrWhiteSpace(name))
221:             .Select(NormalizeRole)
222:             .Where(name => !string.IsNullOrWhiteSpace(name))
223:             .Distinct(StringComparer.OrdinalIgnoreCase)
224:             .ToArray();
225:         if (roles.Length == 0)
226:         {
227:             roles = ["admin"];
228:         }
229:         return new LocalUserProfile
230:         {
231:             Id = user.Id.ToString(),
232:             Email = user.Email,
233:             Name = user.Name + " " + user.LastName,
234:             Role = roles[0],
235:             Roles = roles,
236:         };
237:     }
238:     public static string HashPassword(string password)
239:     {
240:         var salt = RandomNumberGenerator.GetBytes(16);
241:         var hash = new Rfc2898DeriveBytes(password, salt, PBKDF2Iterations, HashAlgorithmName.SHA256).GetBytes(KeyBytes);
242:         var payload = Convert.ToBase64String(salt) + ":" + Convert.ToBase64String(hash);
243:         return payload;
244:     }
245:     public static bool VerifyPassword(string password, string storedHash)
246:     {
247:         if (string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(storedHash))
248:         {
249:             return false;
250:         }
251:         var separatorIndex = storedHash.IndexOf(':');
252:         if (separatorIndex <= 0 || separatorIndex == storedHash.Length - 1)
253:         {
254:             return false;
255:         }
256:         try
257:         {
258:             var salt = Convert.FromBase64String(storedHash[..separatorIndex]);
259:             var expectedHash = Convert.FromBase64String(storedHash[(separatorIndex + 1)..]);
260:             var actualHash = new Rfc2898DeriveBytes(password, salt, PBKDF2Iterations, HashAlgorithmName.SHA256).GetBytes(expectedHash.Length);
261:             return CryptographicOperations.FixedTimeEquals(actualHash, expectedHash);
262:         }
263:         catch (FormatException)
264:         {
265:             return false;
266:         }
267:     }
268:     private static async Task<Role> GetOrCreateRoleAsync(TechRidersDbContext dbContext, string roleName, CancellationToken cancellationToken)
269:     {
270:         var normalizedRoleName = roleName.Trim();
271:         var existing = await dbContext.Set<Role>()
272:             .FirstOrDefaultAsync(r => r.Name == normalizedRoleName, cancellationToken);
273:         if (existing is not null)
274:         {
275:             return existing;
276:         }
277:         var role = new Role
278:         {
279:             Id = Guid.NewGuid(),
280:             Name = normalizedRoleName,
281:             Description = "Rol generado por el flujo local de autenticación.",
282:             CreatedAt = DateTime.UtcNow,
283:         };
284:         await dbContext.Set<Role>().AddAsync(role, cancellationToken);
285:         await dbContext.SaveChangesAsync(cancellationToken);
286:         return role;
287:     }
288:     private static string NormalizeRole(string role)
289:     {
290:         var normalized = role.Trim();
291:         if (normalized.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase)) return "superadmin";
292:         if (normalized.Equals("Admin", StringComparison.OrdinalIgnoreCase)) return "admin";
293:         if (normalized.Equals("Staff", StringComparison.OrdinalIgnoreCase)) return "staff";
294:         if (normalized.Equals("Coordinador", StringComparison.OrdinalIgnoreCase)) return "coordinador";
295:         if (normalized.Equals("Empresa", StringComparison.OrdinalIgnoreCase)) return "empresa";
296:         if (normalized.Equals("Junior", StringComparison.OrdinalIgnoreCase)) return "junior";
297:         if (normalized.Equals("Colaborador", StringComparison.OrdinalIgnoreCase)) return "colaborador";
298:         if (normalized.Equals("Ambassador", StringComparison.OrdinalIgnoreCase) || normalized.Equals("Embajador", StringComparison.OrdinalIgnoreCase)) return "embajador";
299:         if (normalized.Equals("Member", StringComparison.OrdinalIgnoreCase)) return "member";
300:         return normalized.ToLowerInvariant();
301:     }
302: }
</file>

