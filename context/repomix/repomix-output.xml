 943: ## Security Headers Template
 944: 
 945: ### helmet.js (Express)
 946: 
 947: ```typescript
 948: import helmet from 'helmet';
 949: 
 950: app.use(helmet({
 951:   contentSecurityPolicy: {
 952:     directives: {
 953:       defaultSrc: ["'self'"],
 954:       scriptSrc: ["'self'"],
 955:       styleSrc: ["'self'"],
 956:       imgSrc: ["'self'", "data:", "https:"],
 957:       fontSrc: ["'self'"],
 958:       connectSrc: ["'self'"],
 959:       frameAncestors: ["'none'"],
 960:       objectSrc: ["'none'"],
 961:       baseUri: ["'self'"],
 962:       formAction: ["'self'"],
 963:       upgradeInsecureRequests: [],
 964:     },
 965:   },
 966:   hsts: { maxAge: 31536000, includeSubDomains: true, preload: true },
 967:   frameguard: { action: 'deny' },
 968:   referrerPolicy: { policy: 'strict-origin-when-cross-origin' },
 969:   crossOriginOpenerPolicy: { policy: 'same-origin' },
 970:   crossOriginResourcePolicy: { policy: 'same-origin' },
 971: }));
 972: app.disable('x-powered-by');
 973: ```
