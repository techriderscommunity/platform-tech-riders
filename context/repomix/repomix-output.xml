 10: /// </summary>
 11: public class EmploymentService : IEmploymentService
 12: {
 13:     private readonly IUnitOfWork _unitOfWork;
 14:     private readonly IMapper _mapper;
 15:     public EmploymentService(IUnitOfWork unitOfWork, IMapper mapper)
 16:     {
 17:         _unitOfWork = unitOfWork ?? throw new ArgumentNullException(nameof(unitOfWork));
 18:         _mapper = mapper ?? throw new ArgumentNullException(nameof(mapper));
 19:     }
 20:     public async Task<IEnumerable<OfertaResponse>> GetAllOfertasAsync(CancellationToken cancellationToken = default)
 21:     {
 22:         var offers = await _unitOfWork.Ofertas.GetAllAsync(cancellationToken);
 23:         return _mapper.Map<IEnumerable<OfertaResponse>>(offers);
 24:     }
 25:     public async Task<OfertaResponse?> GetOfertaByIdAsync(Guid id, CancellationToken cancellationToken = default)
 26:     {
 27:         var offer = await _unitOfWork.Ofertas.GetByIdAsync(id, cancellationToken);
 28:         return _mapper.Map<OfertaResponse?>(offer);
 29:     }
 30:     public async Task<OfertaResponse> CreateOfertaAsync(CreateOfertaRequest request, CancellationToken cancellationToken = default)
 31:     {
 32:         var offer = Oferta.Create(
 33:             titulo: request.Titulo,
 34:             empresa: request.Empresa,
 35:             descripcion: request.Descripcion,
 36:             salario: request.Salario,
 37:             ubicacion: request.Ubicacion,
 38:             modalidad: (Modalidad)request.Modalidad,
 39:             requisitos: request.Requisitos
 40:         );
 41:         await _unitOfWork.Ofertas.AddAsync(offer, cancellationToken);
 42:         await _unitOfWork.SaveChangesAsync(cancellationToken);
 43:         return _mapper.Map<OfertaResponse>(offer);
 44:     }
 45:     public async Task<OfertaResponse> UpdateOfertaAsync(UpdateOfertaRequest request, CancellationToken cancellationToken = default)
 46:     {
 47:         var offer = await _unitOfWork.Ofertas.GetByIdAsync(request.Id, cancellationToken)
 48:             ?? throw new KeyNotFoundException($"Oferta {request.Id} not found");
 49:         if (!string.IsNullOrEmpty(request.Titulo)) offer.Titulo = request.Titulo;
 50:         if (!string.IsNullOrEmpty(request.Empresa)) offer.Empresa = request.Empresa;
 51:         if (!string.IsNullOrEmpty(request.Descripcion)) offer.Descripcion = request.Descripcion;
 52:         if (request.Salario.HasValue) offer.Salario = request.Salario.Value;
 53:         if (!string.IsNullOrEmpty(request.Ubicacion)) offer.Ubicacion = request.Ubicacion;
 54:         if (request.Modalidad.HasValue) offer.Modalidad = (Modalidad)request.Modalidad.Value;
 55:         if (!string.IsNullOrEmpty(request.Requisitos)) offer.Requisitos = request.Requisitos;
 56:         if (request.Estado.HasValue) offer.Estado = (OfertaEstado)request.Estado.Value;
 57:         await _unitOfWork.Ofertas.UpdateAsync(offer, cancellationToken);
 58:         await _unitOfWork.SaveChangesAsync(cancellationToken);
 59:         return _mapper.Map<OfertaResponse>(offer);
 60:     }
