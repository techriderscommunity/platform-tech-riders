 82:     workspaceResourceId: logAnalyticsWorkspace.outputs.resourceId
 83:     tags: normalizedTags
 84:   }
 85: }
 86: 
 87: module keyVault 'br/public:avm/res/key-vault/vault:0.14.0' = {
 88:   name: 'keyVaultDeployment'
 89:   params: {
 90:     name: keyVaultName
 91:     location: location
 92:     tags: normalizedTags
 93:   }
 94: }
 95: 
 96: module appServicePlan 'br/public:avm/res/web/serverfarm:0.7.0' = {
 97:   name: 'appServicePlanDeployment'
 98:   params: {
 99:     name: appServicePlanName
100:     location: location
101:     skuName: appServicePlanSkuName
102:     tags: normalizedTags
103:   }
104: }
105: 
106: module sqlServer 'br/public:avm/res/sql/server:0.22.0' = {
107:   name: 'sqlServerDeployment'
108:   params: {
109:     name: sqlServerName
110:     location: location
111:     administratorLogin: sqlAdministratorLogin
112:     administratorLoginPassword: sqlAdministratorPassword
113:     databases: [
114:       {
115:         availabilityZone: -1
116:         name: sqlDatabaseName
117:       }
118:     ]
119:     minimalTlsVersion: '1.2'
120:     publicNetworkAccess: 'Enabled'
121:     secretsExportConfiguration: {
122:       keyVaultResourceId: keyVault.outputs.resourceId
123:       sqlAdminPasswordSecretName: sqlAdminPasswordSecretName
124:       sqlAzureConnectionStringSecretName: sqlConnectionStringSecretName
125:     }
126:     tags: normalizedTags
127:   }
128: }
129: 
130: module webApp 'br/public:avm/res/web/site:0.24.0' = {
131:   name: 'webAppDeployment'
132:   params: {
133:     name: webAppName
134:     location: location
135:     serverFarmResourceId: appServicePlan.outputs.resourceId
136:     httpsOnly: true
137:     kind: 'app'
138:     tags: normalizedTags
139:   }
140: }
