464: ## Real-World Workflows
465: 
466: ### CI/CD Pipeline Setup
467: 
468: ```bash
469: # Setup complete CI/CD pipeline
470: setup_cicd_pipeline() {
471:   local project=$1
472:   local repo=$2
473:   local branch=$3
474: 
475:   # Create variable groups
476:   VG_DEV=$(ensure_variable_group "dev-vars" "ENV=dev API_URL=api-dev.com")
477:   VG_PROD=$(ensure_variable_group "prod-vars" "ENV=prod API_URL=api-prod.com")
478: 
479:   # Create CI pipeline
480:   az pipelines create \
481:     --name "$repo-CI" \
482:     --repository "$repo" \
483:     --branch "$branch" \
484:     --yaml-path .azure/pipelines/ci.yml \
485:     --skip-run true
486: 
487:   # Create CD pipeline
488:   az pipelines create \
489:     --name "$repo-CD" \
490:     --repository "$repo" \
491:     --branch "$branch" \
492:     --yaml-path .azure/pipelines/cd.yml \
493:     --skip-run true
494: 
495:   echo "CI/CD pipeline setup complete"
496: }
497: ```
498: 
499: ### Automated PR Creation
500: 
501: ```bash
502: # Create PR from feature branch with automation
503: create_automated_pr() {
504:   local branch=$1
505:   local title=$2
506: 
507:   # Get branch info
508:   LAST_COMMIT=$(git log -1 --pretty=%B "$branch")
509:   COMMIT_SHA=$(git rev-parse "$branch")
510: 
511:   # Find related work items
512:   WORK_ITEMS=$(az boards query \
513:     --wiql "SELECT ID FROM WorkItems WHERE [System.ChangedBy] = @Me AND [System.State] = 'Active'" \
514:     --query "[].id" -o tsv)
515: 
516:   # Create PR
517:   PR_ID=$(az repos pr create \
518:     --source-branch "$branch" \
519:     --target-branch main \
520:     --title "$title" \
521:     --description "$LAST_COMMIT" \
522:     --work-items $WORK_ITEMS \
523:     --auto-complete true \
524:     --query "pullRequestId" -o tsv)
525: 
526:   # Set required reviewers
527:   az repos pr reviewer add \
528:     --id $PR_ID \
529:     --reviewers $(git log -1 --pretty=format:'%ae' "$branch") \
530:     --required true
531: 
532:   echo "Created PR #$PR_ID"
533: }
534: ```
535: 
536: ### Pipeline Monitoring and Alerting
537: 
538: ```bash
539: # Monitor pipeline and alert on failure
540: monitor_pipeline() {
541:   local pipeline_name=$1
542:   local slack_webhook=$2
543: 
544:   while true; do
545:     # Get latest run
546:     RUN_ID=$(az pipelines list --query "[?name=='$pipeline_name'] | [0].id" -o tsv)
547:     RUNS=$(az pipelines runs list --pipeline $RUN_ID --top 1)
548: 
549:     LATEST_RUN_ID=$(echo "$RUNS" | jq -r '.[0].id')
550:     RESULT=$(echo "$RUNS" | jq -r '.[0].result')
551: 
552:     # Check if failed and not already processed
553:     if [[ "$RESULT" == "failed" ]]; then
554:       # Send Slack alert
555:       curl -X POST "$slack_webhook" \
556:         -H 'Content-Type: application/json' \
557:         -d "{\"text\": \"Pipeline $pipeline_name failed! Run ID: $LATEST_RUN_ID\"}"
558:     fi
559: 
560:     sleep 300 # Check every 5 minutes
561:   done
562: }
563: ```
564: 
565: ### Bulk Work Item Management
566: 
567: ```bash
568: # Bulk update work items based on query
569: bulk_update_work_items() {
570:   local wiql=$1
571:   local updates=("$@")
572: 
573:   # Query work items
574:   WI_IDS=$(az boards query --wiql "$wiql" --query "[].id" -o tsv)
575: 
576:   # Update each work item
577:   for wi_id in $WI_IDS; do
578:     az boards work-item update --id $wi_id "${updates[@]}"
579:     echo "Updated work item: $wi_id"
580:   done
581: }
582: 
583: # Usage: bulk_update_work_items "SELECT ID FROM WorkItems WHERE State='New'" --state "Active" --assigned-to "user@example.com"
584: ```
585: 
586: ### Branch Policy Automation
587: 
588: ```bash
589: # Apply branch policies to all repositories
590: apply_branch_policies() {
591:   local branch=$1
592:   local project=$2
593: 
594:   # Get all repositories
595:   REPOS=$(az repos list --project "$project" --query "[].id" -o tsv)
596: 
597:   for repo_id in $REPOS; do
598:     echo "Applying policies to repo: $repo_id"
599: 
600:     # Require minimum approvers
601:     az repos policy approver-count create \
602:       --blocking true \
603:       --enabled true \
604:       --branch "$branch" \
605:       --repository-id "$repo_id" \
606:       --minimum-approver-count 2 \
607:       --creator-vote-counts true
608: 
609:     # Require work item linking
610:     az repos policy work-item-linking create \
611:       --blocking true \
612:       --branch "$branch" \
613:       --enabled true \
614:       --repository-id "$repo_id"
615: 
616:     # Require build validation
617:     BUILD_ID=$(az pipelines list --query "[?name=='CI'].id" -o tsv | head -1)
618:     az repos policy build create \
619:       --blocking true \
620:       --enabled true \
621:       --branch "$branch" \
622:       --repository-id "$repo_id" \
623:       --build-definition-id "$BUILD_ID" \
624:       --queue-on-source-update-only true
625:   done
626: }
627: ```
628: 
629: ### Multi-Environment Deployment
630: 
631: ```bash
632: # Deploy across multiple environments
633: deploy_to_environments() {
634:   local run_id=$1
635:   shift
636:   local environments=("$@")
637: 
638:   # Download artifacts
639:   ARTIFACT_NAME=$(az pipelines runs artifact list --run-id $run_id --query "[0].name" -o tsv)
640:   az pipelines runs artifact download \
641:     --artifact-name "$ARTIFACT_NAME" \
642:     --path ./artifacts \
643:     --run-id $run_id
644: 
645:   # Deploy to each environment
646:   for env in "${environments[@]}"; do
647:     echo "Deploying to: $env"
648: 
649:     # Get environment-specific variables
650:     VG_ID=$(az pipelines variable-group list --query "[?name=='$env-vars'].id" -o tsv)
651: 
652:     # Run deployment pipeline
653:     DEPLOY_RUN_ID=$(az pipelines run \
654:       --name "Deploy-$env" \
655:       --variables ARTIFACT_PATH=./artifacts ENV="$env" \
656:       --query "id" -o tsv)
657: 
658:     # Wait for deployment
659:     while true; do
660:       STATUS=$(az pipelines runs show --run-id $DEPLOY_RUN_ID --query "status" -o tsv)
661:       if [[ "$STATUS" != "inProgress" ]]; then
662:         break
663:       fi
664:       sleep 10
665:     done
666:   done
667: }
668: ```
</file>

