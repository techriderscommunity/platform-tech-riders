<file path=".github/workflows/release-npm.yml">
  1: name: Release & Publish NPM
  2: on:
  3:   push:
  4:     branches: [ main ]
  5:   workflow_dispatch:
  6:     inputs:
  7:       npm_version:
  8:         description: "Version especifica a publicar (ej. 0.2.0). Si se omite, se autoajusta."
  9:         required: false
 10:         type: string
 11: permissions:
 12:   contents: write
 13: jobs:
 14:   release-and-publish:
 15:     runs-on: ubuntu-latest
 16:     steps:
 17:       - name: Checkout
 18:         uses: actions/checkout@v5
 19:         with:
 20:           fetch-depth: 0
 21:       - name: Setup Node.js
 22:         uses: actions/setup-node@v4
 23:         with:
 24:           node-version: 22
 25:           registry-url: https://registry.npmjs.org
 26:       - name: Resolve publish version
 27:         id: version
 28:         run: |
 29:           PACKAGE_NAME=$(node -p "require('./package.json').name")
 30:           BASE_VERSION=$(node -p "require('./package.json').version")
 31:           REQUESTED_VERSION="${{ github.event.inputs.npm_version || '' }}"
 32:           version_exists() {
 33:             npm view "$PACKAGE_NAME@$1" version >/dev/null 2>&1
 34:           }
 35:           if [ -n "$REQUESTED_VERSION" ]; then
 36:             TARGET_VERSION="$REQUESTED_VERSION"
 37:             MODE="explicit"
 38:           else
 39:             TARGET_VERSION="$BASE_VERSION"
 40:             MODE="auto"
 41:           fi
 42:           if [ "$MODE" = "explicit" ]; then
 43:             if version_exists "$TARGET_VERSION"; then
 44:               echo "Requested version $TARGET_VERSION is already published in npm."
 45:               exit 1
 46:             fi
 47:           else
 48:             CANDIDATE="$TARGET_VERSION"
 49:             while version_exists "$CANDIDATE"; do
 50:               CANDIDATE=$(node -e "const parts = process.argv[1].split('.').map(Number); if (parts.length !== 3 || parts.some(Number.isNaN)) { process.exit(2); } parts[2] += 1; process.stdout.write(parts.join('.'));" "$CANDIDATE") || {
 51:                 echo "Cannot auto-bump non x.y.z version: $CANDIDATE"
 52:                 exit 1
 53:               }
 54:             done
 55:             TARGET_VERSION="$CANDIDATE"
 56:           fi
 57:           CHANGED=false
 58:           if [ "$TARGET_VERSION" != "$BASE_VERSION" ]; then
 59:             npm version "$TARGET_VERSION" --no-git-tag-version
 60:             CHANGED=true
 61:           fi
 62:           echo "version=$TARGET_VERSION" >> "$GITHUB_OUTPUT"
 63:           echo "tag=v$TARGET_VERSION" >> "$GITHUB_OUTPUT"
 64:           echo "changed=$CHANGED" >> "$GITHUB_OUTPUT"
 65:           echo "mode=$MODE" >> "$GITHUB_OUTPUT"
 66:       - name: Ensure NPM token is configured
 67:         run: |
 68:           if [ -z "${NODE_AUTH_TOKEN}" ]; then
 69:             echo "Missing NODE_AUTH_TOKEN/NPM_TOKEN secret. Configure repository secret NPM_TOKEN."
 70:             exit 1
 71:           fi
 72:         env:
 73:           NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
 74:       - name: Remove Python cache artifacts from workspace
 75:         run: |
 76:           find . -type d -name "__pycache__" -prune -exec rm -rf {} +
 77:           find . -type f -name "*.pyc" -delete
 78:       - name: Publish to npm
 79:         run: npm publish --access public
 80:         env:
 81:           NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
 82:       - name: Record package.json sync requirement
 83:         if: steps.version.outputs.changed == 'true'
 84:         run: |
 85:           echo "package.json was bumped in CI to publish an available npm version (${{ steps.version.outputs.tag }})."
 86:           echo "Repository sync is skipped because main is protected and requires PR-based updates."
 87:           echo "Open a follow-up PR to align package.json with npm published version."
 88:       - name: Release summary
 89:         run: |
 90:           echo "## NPM Release" >> "$GITHUB_STEP_SUMMARY"
 91:           echo "- mode: ${{ steps.version.outputs.mode }}" >> "$GITHUB_STEP_SUMMARY"
 92:           echo "- published: ${{ steps.version.outputs.tag }}" >> "$GITHUB_STEP_SUMMARY"
 93:           if [ "${{ steps.version.outputs.changed }}" = "true" ]; then
 94:             echo "- package.json sync: skipped (protected branch, requires PR)" >> "$GITHUB_STEP_SUMMARY"
 95:           else
 96:             echo "- package.json sync: not required" >> "$GITHUB_STEP_SUMMARY"
 97:           fi
 98:       - name: Create GitHub release
 99:         uses: softprops/action-gh-release@v2
100:         with:
101:           tag_name: ${{ steps.version.outputs.tag }}
102:           name: ${{ steps.version.outputs.tag }}
103:           generate_release_notes: true
</file>

<file path=".github/workflows/routing-evals.yml">
 1: name: Routing Evals Gate
 2: on:
 3:   pull_request:
 4:   push:
 5:     branches:
 6:       - main
 7:   workflow_dispatch:
 8: permissions:
 9:   contents: read
10: concurrency:
11:   group: routing-evals-${{ github.ref }}
12:   cancel-in-progress: true
13: jobs:
14:   routing-evals:
15:     runs-on: ubuntu-latest
16:     timeout-minutes: 10
17:     steps:
18:       - name: Checkout
19:         uses: actions/checkout@v4
20:       - name: Set up Python
21:         uses: actions/setup-python@v5
22:         with:
23:           python-version: '3.12'
24:       - name: Run routing evals
25:         run: python ./scripts/intake/run-routing-evals.py
26:       - name: Verify all tests passed
27:         run: |
28:           python - <<'PY'
29:           import json
30:           from pathlib import Path
31:           report = Path('observability/evals/routing-eval-report.json')
32:           if not report.exists():
33:               raise SystemExit('routing-eval-report.json not found')
34:           data = json.loads(report.read_text(encoding='utf-8'))
35:           failed = int(data.get('cases_failed', 0))
36:           total = int(data.get('cases_total', 0))
37:           passed = int(data.get('cases_passed', 0))
38:           print(f'Routing evals: {passed}/{total} passed, failed={failed}')
39:           if failed > 0:
40:               raise SystemExit(1)
41:           PY
42:       - name: Upload eval report
43:         if: always()
44:         uses: actions/upload-artifact@v4
45:         with:
46:           name: routing-eval-report
47:           path: observability/evals/routing-eval-report.json
48:           retention-days: 30
</file>

<file path=".github/workflows/techriders-coverage-effective.yml">
 1: name: TechRiders Effective Coverage Gate
 2: on:
 3:   push:
 4:     branches: [ main, develop ]
 5:     paths:
 6:       - 'projects/techriders/**'
 7:       - '.github/workflows/techriders-coverage-effective.yml'
 8:   pull_request:
 9:     branches: [ main, develop ]
10:     paths:
11:       - 'projects/techriders/**'
12:       - '.github/workflows/techriders-coverage-effective.yml'
13: permissions:
14:   contents: read
15: env:
16:   TECHRIDERS_EFFECTIVE_COVERAGE_MIN: '80'
17: jobs:
18:   techriders-coverage-effective:
19:     name: TechRiders Effective Coverage Gate (Windows)
20:     runs-on: windows-latest
21:     env:
22:       TECHRIDERS_BACKEND_PATH: projects/techriders/backend
23:     steps:
24:       - name: Checkout code
25:         uses: actions/checkout@v4
26:       - name: Set up .NET 10 SDK
27:         uses: actions/setup-dotnet@v4
28:         with:
29:           dotnet-version: '10.0.x'
30:       - name: Detect TechRiders backend path
31:         id: detect_backend
32:         shell: pwsh
33:         run: |
34:           if (Test-Path "$env:TECHRIDERS_BACKEND_PATH") {
35:             "available=true" | Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
36:             "TechRiders backend detected at $env:TECHRIDERS_BACKEND_PATH" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
37:           }
38:           else {
39:             "available=false" | Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
40:             "TechRiders backend not found in this checkout. Coverage gate skipped." | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
41:           }
42:       - name: Run TechRiders tests with effective coverage
43:         if: steps.detect_backend.outputs.available == 'true'
44:         run: |
45:           dotnet test "$env:TECHRIDERS_BACKEND_PATH\tests\TechRiders.Api.Tests\TechRiders.Api.Tests.csproj" --collect:"XPlat Code Coverage" --settings "$env:TECHRIDERS_BACKEND_PATH\tests\coverage.effective.runsettings"
46:         shell: pwsh
47:       - name: Evaluate effective coverage threshold
48:         id: coverage_gate
49:         if: steps.detect_backend.outputs.available == 'true'
50:         run: |
51:           $coverageFile = Get-ChildItem -Path "$env:TECHRIDERS_BACKEND_PATH\tests\TechRiders.Api.Tests\TestResults" -Recurse -Filter coverage.cobertura.xml |
52:             Sort-Object LastWriteTime -Descending |
53:             Select-Object -First 1
54:           if (-not $coverageFile) {
55:             throw "coverage.cobertura.xml was not generated."
56:           }
57:           [xml]$coverageXml = Get-Content $coverageFile.FullName
58:           $overall = [math]::Round(([double]$coverageXml.coverage.'line-rate') * 100, 2)
59:           $minimum = [double]$env:TECHRIDERS_EFFECTIVE_COVERAGE_MIN
60:           "coverage_file=$($coverageFile.FullName)" | Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
61:           "coverage_overall=$overall" | Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
62:           "## TechRiders Effective Coverage" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
63:           "- Coverage file: $($coverageFile.FullName)" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
64:           "- Overall line coverage: $overall%" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
65:           "- Minimum required: $minimum%" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
66:           if ($overall -lt $minimum) {
67:             throw "Effective coverage gate failed: $overall% < $minimum%"
68:           }
69:         shell: pwsh
70:       - name: Upload effective coverage report
71:         if: always() && steps.detect_backend.outputs.available == 'true'
72:         uses: actions/upload-artifact@v4
73:         with:
74:           name: techriders-effective-coverage
75:           path: projects/techriders/backend/tests/TechRiders.Api.Tests/TestResults/**/coverage.cobertura.xml
76:           retention-days: 30
</file>

