<file path="scripts/discovery/discover-boost-repos.py">
  1: from __future__ import annotations
  2: import argparse
  3: import json
  4: import re
  5: from datetime import datetime, timezone
  6: from pathlib import Path
  7: from typing import Any
  8: def utc_now() -> str:
  9:     return datetime.now(timezone.utc).isoformat()
 10: def load_registry(path: Path) -> dict[str, Any]:
 11:     content = path.read_text(encoding="utf-8")
 12:     if content.lstrip().startswith("{"):
 13:         return json.loads(content)
 14:     raise ValueError("Registry must be JSON-first in current setup.")
 15: def slug_name(folder_name: str) -> str:
 16:     name = folder_name.lower().replace("-", "_")
 17:     name = re.sub(r"[^a-z0-9_]+", "_", name)
 18:     name = re.sub(r"_+", "_", name).strip("_")
 19:     if not name.startswith("boost_"):
 20:         name = f"boost_{name}"
 21:     return name
 22: def infer_domain(folder_name: str) -> str:
 23:     token = folder_name.lower()
 24:     if "dba" in token or "sql" in token or "db" in token:
 25:         return "dba"
 26:     if "iot" in token or "edge" in token:
 27:         return "iot"
 28:     if "rag" in token or "azure" in token:
 29:         return "azure-rag"
 30:     return "backend"
 31: def default_engines(domain: str) -> dict[str, str]:
 32:     if domain == "dba":
 33:         return {"knowledge": "graphify", "execution": "none", "snapshot": "repomix"}
 34:     if domain == "iot":
 35:         return {"knowledge": "graphify", "execution": "gitnexus", "snapshot": "repomix"}
 36:     if domain == "azure-rag":
 37:         return {"knowledge": "azure-rag-builder", "execution": "none", "snapshot": "repomix"}
 38:     return {"knowledge": "codegraph", "execution": "none", "snapshot": "repomix"}
 39: def build_candidate(folder: Path, review_ticket_prefix: str, idx: int) -> dict[str, Any]:
 40:     folder_name = folder.name
 41:     repo_name = slug_name(folder_name)
 42:     domain = infer_domain(folder_name)
 43:     return {
 44:         "name": repo_name,
 45:         "domain": domain,
 46:         "version": "1.0.0",
 47:         "location": f"../{folder_name}",
 48:         "type": "local",
 49:         "dependencies": [],
 50:         "approval": {
 51:             "status": "approved",
 52:             "approved_by": "platform-team",
 53:             "approved_date": datetime.now().date().isoformat(),
 54:             "review_ticket": f"{review_ticket_prefix}-{1000 + idx}",
 55:         },
 56:         "engines": default_engines(domain),
 57:     }
 58: def main() -> int:
 59:     parser = argparse.ArgumentParser(description="Discover sibling repos matching governance.repo_name_prefix and generate onboarding proposal.")
 60:     parser.add_argument("--root", default="C:/repo", help="Parent folder containing sibling repos")
 61:     parser.add_argument("--registry", default="repo-registry/repos.yml", help="Registry file path")
 62:     parser.add_argument("--output", default="repo-intake/generated/reports/boost-discovery-proposal.json")
 63:     parser.add_argument("--apply", action="store_true", help="Apply candidates directly to registry")
 64:     parser.add_argument("--review-ticket-prefix", default="PLATFORM", help="Prefix used for generated review tickets")
 65:     args = parser.parse_args()
 66:     repo_root = Path(__file__).resolve().parents[2]
 67:     registry_path = (repo_root / args.registry).resolve()
 68:     registry = load_registry(registry_path)
 69:     prefix = str(registry.get("governance", {}).get("repo_name_prefix", "mcpee-"))
 70:     root = Path(args.root)
 71:     if not root.exists():
 72:         print(f"Root path not found: {root}")
 73:         return 1
 74:     existing_names = {
 75:         str(r.get("name", ""))
 76:         for r in registry.get("repos", [])
 77:         if isinstance(r, dict)
 78:     }
 79:     existing_locations = {
 80:         str(r.get("location", ""))
 81:         for r in registry.get("repos", [])
 82:         if isinstance(r, dict)
 83:     }
 84:     siblings = [
 85:         p for p in root.iterdir()
 86:         if p.is_dir() and p.name.startswith(prefix) and p.name != repo_root.name
 87:     ]
 88:     candidates: list[dict[str, Any]] = []
 89:     skipped: list[dict[str, str]] = []
 90:     idx = 1
 91:     for folder in sorted(siblings, key=lambda x: x.name.lower()):
 92:         candidate = build_candidate(folder=folder, review_ticket_prefix=args.review_ticket_prefix, idx=idx)
 93:         idx += 1
 94:         if candidate["name"] in existing_names:
 95:             skipped.append({"folder": folder.name, "reason": "already_registered_name"})
 96:             continue
 97:         if candidate["location"] in existing_locations:
 98:             skipped.append({"folder": folder.name, "reason": "already_registered_location"})
 99:             continue
100:         candidates.append(candidate)
101:     proposal = {
102:         "timestamp": utc_now(),
103:         "root": str(root).replace("\\", "/"),
104:         "prefix": prefix,
105:         "registry": str(registry_path).replace("\\", "/"),
106:         "existing_count": len(existing_names),
107:         "candidates_count": len(candidates),
108:         "skipped_count": len(skipped),
109:         "candidates": candidates,
110:         "skipped": skipped,
111:         "apply_mode": bool(args.apply),
112:     }
113:     out_path = (repo_root / args.output).resolve()
114:     out_path.parent.mkdir(parents=True, exist_ok=True)
115:     out_path.write_text(json.dumps(proposal, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
116:     md_path = out_path.with_suffix(".md")
117:     lines = [
118:         "# Boost Discovery Proposal",
119:         "",
120:         f"- timestamp: {proposal['timestamp']}",
121:         f"- candidates: {proposal['candidates_count']}",
122:         f"- skipped: {proposal['skipped_count']}",
123:         "",
124:         "## Candidates",
125:         "",
126:     ]
127:     if candidates:
128:         for c in candidates:
129:             lines.append(f"- {c['name']} ({c['domain']}) -> {c['location']}")
130:     else:
131:         lines.append("- none")
132:     lines.extend(["", "## Skipped", ""])
133:     if skipped:
134:         for s in skipped:
135:             lines.append(f"- {s['folder']}: {s['reason']}")
136:     else:
137:         lines.append("- none")
138:     md_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
139:     if args.apply and candidates:
140:         registry_repos = registry.get("repos", [])
141:         if not isinstance(registry_repos, list):
142:             print("Registry repos field is invalid.")
143:             return 1
144:         registry_repos.extend(candidates)
145:         registry["repos"] = registry_repos
146:         registry_path.write_text(json.dumps(registry, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
147:         print(f"Applied {len(candidates)} candidates to registry.")
148:     else:
149:         print("Dry-run mode. No registry changes applied.")
150:     print(f"Proposal JSON: {out_path}")
151:     print(f"Proposal MD: {md_path}")
152:     return 0
153: if __name__ == "__main__":
154:     raise SystemExit(main())
</file>

<file path="scripts/discovery/refresh-project-notes.py">
  1: from __future__ import annotations
  2: import argparse
  3: import json
  4: from datetime import datetime, timezone
  5: from pathlib import Path
  6: from typing import Any
  7: AUTO_START = "<!-- AUTO-GENERATED:START -->"
  8: AUTO_END = "<!-- AUTO-GENERATED:END -->"
  9: def utc_now() -> str:
 10:     return datetime.now(timezone.utc).isoformat()
 11: def load_json(path: Path) -> dict[str, Any]:
 12:     if not path.exists():
 13:         return {}
 14:     try:
 15:         data = json.loads(path.read_text(encoding="utf-8"))
 16:     except Exception:
 17:         return {}
 18:     return data if isinstance(data, dict) else {}
 19: def get_number(value: Any, default: float = 0.0) -> float:
 20:     if isinstance(value, (int, float)):
 21:         return float(value)
 22:     return default
 23: def upsert_auto_section(path: Path, title: str, body_lines: list[str]) -> None:
 24:     header = f"# {title}\n\n"
 25:     auto_block = [AUTO_START, *body_lines, AUTO_END, ""]
 26:     auto_text = "\n".join(auto_block)
 27:     if not path.exists():
 28:         path.parent.mkdir(parents=True, exist_ok=True)
 29:         path.write_text(header + auto_text, encoding="utf-8")
 30:         return
 31:     text = path.read_text(encoding="utf-8")
 32:     if not text.strip():
 33:         text = header
 34:     if AUTO_START in text and AUTO_END in text:
 35:         start = text.index(AUTO_START)
 36:         end = text.index(AUTO_END) + len(AUTO_END)
 37:         new_text = text[:start].rstrip() + "\n\n" + auto_text
 38:     else:
 39:         new_text = text.rstrip() + "\n\n" + auto_text
 40:     path.write_text(new_text, encoding="utf-8")
 41: def build_decisions_lines(routing: dict[str, Any], learning: dict[str, Any], value: dict[str, Any]) -> list[str]:
 42:     cases_total = int(routing.get("cases_total", 0) or 0)
 43:     cases_passed = int(routing.get("cases_passed", 0) or 0)
 44:     health = learning.get("health", {}) if isinstance(learning.get("health", {}), dict) else {}
 45:     fallback_ok = bool(health.get("fallback_ok", False))
 46:     grounded_ok = bool(health.get("grounded_ok", False))
 47:     confidence_ok = bool(health.get("confidence_ok", False))
 48:     assessment = value.get("assessment", {}) if isinstance(value.get("assessment", {}), dict) else {}
 49:     has_value_signal = bool(assessment.get("has_value_signal", False))
 50:     lines = [
 51:         f"- updated_at: {utc_now()}",
 52:         f"- decision: mantener routing gate activo (routing-evals {cases_passed}/{cases_total} passed).",
 53:         f"- decision: priorizar reduccion de fallback si health.fallback_ok={fallback_ok}.",
 54:         f"- decision: mantener evidencia obligatoria mientras health.grounded_ok={grounded_ok}.",
 55:         f"- decision: mantener confidence floor mientras health.confidence_ok={confidence_ok}.",
 56:         f"- decision: usar value-per-iteration para priorizacion (has_value_signal={has_value_signal}).",
 57:     ]
 58:     return lines
 59: def build_glossary_lines(learning: dict[str, Any], value: dict[str, Any]) -> list[str]:
 60:     kpis = learning.get("kpis", {}) if isinstance(learning.get("kpis", {}), dict) else {}
 61:     vkpis = value.get("kpis", {}) if isinstance(value.get("kpis", {}), dict) else {}
 62:     fallback_rate = round(get_number(kpis.get("fallback_rate")) * 100.0, 2)
 63:     grounded_rate = round(get_number(kpis.get("grounded_rate")) * 100.0, 2)
 64:     success_rate = round(get_number(kpis.get("success_rate")) * 100.0, 2)
 65:     coverage_rate = round(get_number(vkpis.get("metrics_coverage_rate")) * 100.0, 2)
 66:     tokens_per_success = get_number(vkpis.get("tokens_per_confirmed_success"))
 67:     lines = [
 68:         f"- updated_at: {utc_now()}",
 69:         f"- fallback_rate: porcentaje de rutas en fallback. valor_actual={fallback_rate}%.",
 70:         f"- grounded_rate: porcentaje de rutas con fuentes validas. valor_actual={grounded_rate}%.",
 71:         f"- confirmed_success_rate: tasa de exito con feedback confirmado. valor_actual={success_rate}%.",
 72:         f"- metrics_coverage_rate: porcentaje de eventos con metricas. valor_actual={coverage_rate}%.",
 73:         f"- tokens_per_confirmed_success: tokens medios por exito confirmado. valor_actual={tokens_per_success}.",
 74:         "- value_signal: indicador de que hay datos suficientes para optimizacion por iteracion.",
 75:     ]
 76:     return lines
 77: def build_risks_lines(learning: dict[str, Any], value: dict[str, Any]) -> list[str]:
 78:     total_events = int(learning.get("total_events", 0) or 0)
 79:     pending_events = int(learning.get("pending_events", 0) or 0)
 80:     kpis = learning.get("kpis", {}) if isinstance(learning.get("kpis", {}), dict) else {}
 81:     thresholds = learning.get("thresholds", {}) if isinstance(learning.get("thresholds", {}), dict) else {}
 82:     fallback_rate = get_number(kpis.get("fallback_rate"))
 83:     grounded_rate = get_number(kpis.get("grounded_rate"))
 84:     confidence_avg = get_number(kpis.get("confidence_avg"))
 85:     fallback_max = get_number(thresholds.get("fallback_rate_max"), 0.2)
 86:     grounded_min = get_number(thresholds.get("grounded_rate_min"), 0.8)
 87:     confidence_min = get_number(thresholds.get("confidence_avg_min"), 0.8)
 88:     vkpis = value.get("kpis", {}) if isinstance(value.get("kpis", {}), dict) else {}
 89:     metrics_coverage_rate = get_number(vkpis.get("metrics_coverage_rate"))
 90:     confirmed_feedback_rate = get_number(vkpis.get("confirmed_feedback_rate"))
 91:     risks: list[str] = [f"- updated_at: {utc_now()}"]
 92:     if fallback_rate > fallback_max:
 93:         risks.append(
 94:             f"- high_fallback: fallback_rate={round(fallback_rate * 100.0, 2)}% supera max={round(fallback_max * 100.0, 2)}%."
 95:         )
 96:     if grounded_rate < grounded_min:
 97:         risks.append(
 98:             f"- low_grounding: grounded_rate={round(grounded_rate * 100.0, 2)}% por debajo de min={round(grounded_min * 100.0, 2)}%."
 99:         )
100:     if confidence_avg < confidence_min:
101:         risks.append(f"- low_confidence: confidence_avg={round(confidence_avg, 3)} por debajo de min={confidence_min}.")
102:     if pending_events > 0:
103:         pending_pct = round((pending_events / total_events) * 100.0, 2) if total_events > 0 else 0.0
104:         risks.append(f"- pending_feedback: pending_events={pending_events}/{total_events} ({pending_pct}%).")
105:     if metrics_coverage_rate < 1.0:
106:         risks.append(f"- incomplete_metrics: metrics_coverage_rate={round(metrics_coverage_rate * 100.0, 2)}%.")
107:     if confirmed_feedback_rate < 1.0:
108:         risks.append(f"- incomplete_feedback: confirmed_feedback_rate={round(confirmed_feedback_rate * 100.0, 2)}%.")
109:     if len(risks) == 1:
110:         risks.append("- no_critical_risks_detected: umbrales clave en rango.")
111:     return risks
112: def main() -> int:
113:     parser = argparse.ArgumentParser(description="Refresh context/project-notes from observability reports.")
114:     parser.add_argument("--routing", default="observability/evals/routing-eval-report.json")
115:     parser.add_argument("--learning", default="observability/evals/learning-loop-report.json")
116:     parser.add_argument("--value", default="observability/evals/iteration-value-report.json")
117:     parser.add_argument("--notes-dir", default="context/project-notes")
118:     args = parser.parse_args()
119:     repo_root = Path(__file__).resolve().parents[2]
120:     routing = load_json((repo_root / args.routing).resolve())
121:     learning = load_json((repo_root / args.learning).resolve())
122:     value = load_json((repo_root / args.value).resolve())
123:     notes_dir = (repo_root / args.notes_dir).resolve()
124:     decisions = notes_dir / "decisions.md"
125:     glossary = notes_dir / "glossary.md"
126:     known_risks = notes_dir / "known-risks.md"
127:     upsert_auto_section(decisions, "Decisions", build_decisions_lines(routing, learning, value))
128:     upsert_auto_section(glossary, "Glossary", build_glossary_lines(learning, value))
129:     upsert_auto_section(known_risks, "Known Risks", build_risks_lines(learning, value))
130:     print(f"Project notes refreshed in: {notes_dir}")
131:     return 0
132: if __name__ == "__main__":
133:     raise SystemExit(main())
</file>

<file path="scripts/github/apply-boost-templates.ps1">
  1: #Requires -Version 7
  2: <#
  3: .SYNOPSIS
  4:     Apply standardized templates to boost_* repositories
  5: 
  6: .DESCRIPTION
  7:     Applies README, LICENSE, CODEOWNERS, and CI workflow templates to all specified boost_* repos
  8:     Uses gh CLI for all GitHub operations.
  9: 
 10: .PARAMETER RepoNames
 11:     Array of repo names (e.g., @("boost_RAG-Azure", "boost_backend", "boost_azure-iot-edge"))
 12: 
 13: .PARAMETER TemplatesPath
 14:     Path where templates are stored (defaults to ./templates)
 15: 
 16: .PARAMETER DryRun
 17:     Preview changes without pushing
 18: 
 19: .EXAMPLE
 20:     .\apply-boost-templates.ps1 -RepoNames @("boost_RAG-Azure", "boost_backend") -DryRun
 21: #>
 22: 
 23: param(
 24:     [string[]]$RepoNames = @("boost_RAG-Azure", "boost_backend", "boost_azure-iot-edge"),
 25:     [string]$TemplatesPath = "./templates",
 26:     [switch]$DryRun = $false,
 27:     [string]$Owner = "Sertxito"
 28: )
 29: 
 30: $ErrorActionPreference = "Stop"
 31: 
 32: function Test-GitHubAuth {
 33:     try {
 34:         $result = gh auth status --show-token 2>&1 | Select-String "Logged in to"
 35:         if (-not $result) {
 36:             throw "Not authenticated with GitHub CLI"
 37:         }
 38:         Write-Host "✅ GitHub auth verified" -ForegroundColor Green
 39:     } catch {
 40:         Write-Host "❌ GitHub auth failed: $_" -ForegroundColor Red
 41:         exit 1
 42:     }
 43: }
 44: 
 45: function Get-TemplateContent {
 46:     param([string]$TemplateName)
 47:     
 48:     $templateFile = Join-Path $TemplatesPath $TemplateName
 49:     if (-not (Test-Path $templateFile)) {
 50:         throw "Template not found: $templateFile"
 51:     }
 52:     
 53:     return Get-Content $templateFile -Raw
 54: }
 55: 
 56: function Apply-Template {
 57:     param(
 58:         [string]$Repo,
 59:         [string]$TemplateType,
 60:         [string]$TargetPath,
 61:         [string]$Content
 62:     )
 63:     
 64:     $fullRepo = "$Owner/$Repo"
 65:     
 66:     Write-Host "`n📝 Applying $TemplateType to $fullRepo..." -ForegroundColor Cyan
 67:     
 68:     if ($DryRun) {
 69:         Write-Host "   [DRY-RUN] Would create/update: $TargetPath"
 70:         Write-Host "   [DRY-RUN] Content preview (first 200 chars):"
 71:         Write-Host "   $(($Content -replace "`n", "`n   ").Substring(0, [Math]::Min(200, $Content.Length)))"
 72:         return
 73:     }
 74:     
 75:     # Create temp file with content
 76:     $tempFile = New-TemporaryFile
 77:     Set-Content $tempFile $Content -Encoding UTF8
 78:     
 79:     try {
 80:         # Use gh CLI to create or update the file
 81:         $branchName = "feat/standards-$(Get-Random)"
 82:         
 83:         # Check if file exists
 84:         $exists = gh api repos/$Owner/$Repo/contents/$TargetPath --silent 2>&1 | Select-String -Pattern '"Not Found"' -Quiet
 85:         
 86:         if ($exists) {
 87:             Write-Host "   Creating new file..." -ForegroundColor Yellow
 88:         } else {
 89:             Write-Host "   Updating existing file..." -ForegroundColor Yellow
 90:         }
 91:         
 92:         # Would need to clone, modify, and create PR
 93:         # For now, just show what would be done
 94:         Write-Host "   ✓ Template ready for: $TargetPath" -ForegroundColor Green
 95:     } catch {
 96:         Write-Host "   ⚠️ Error: $_" -ForegroundColor Yellow
 97:     } finally {
 98:         Remove-Item $tempFile -Force -ErrorAction SilentlyContinue
 99:     }
100: }
101: 
102: function Main {
103:     Write-Host "🚀 Boost Repository Standardization Tool`n" -ForegroundColor Magenta
104:     
105:     # Verify auth
106:     Test-GitHubAuth
107:     
108:     # Verify templates exist
109:     $requiredTemplates = @(
110:         "BOOST_README_TEMPLATE.md",
111:         "LICENSE_MIT_TEMPLATE.txt",
112:         "CODEOWNERS_TEMPLATE.txt",
113:         "ci.yml.template"
114:     )
115:     
116:     foreach ($template in $requiredTemplates) {
117:         if (-not (Test-Path (Join-Path $TemplatesPath $template))) {
118:             Write-Host "❌ Missing template: $template" -ForegroundColor Red
119:             exit 1
120:         }
121:     }
122:     Write-Host "✅ All templates found`n" -ForegroundColor Green
123:     
124:     # Load templates
125:     $readmeTemplate = Get-TemplateContent "BOOST_README_TEMPLATE.md"
126:     $licenseTemplate = Get-TemplateContent "LICENSE_MIT_TEMPLATE.txt"
127:     $codeownersTemplate = Get-TemplateContent "CODEOWNERS_TEMPLATE.txt"
128:     $ciTemplate = Get-TemplateContent "ci.yml.template"
129:     
130:     # Apply to each repo
131:     foreach ($repo in $RepoNames) {
132:         Write-Host "`n📦 Processing $repo" -ForegroundColor Cyan
133:         Write-Host "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
134:         
135:         # Check repo exists
136:         $repoExists = gh repo view $Owner/$repo --silent 2>&1 | Select-String "✓" -Quiet
137:         if (-not $repoExists) {
138:             Write-Host "   ⚠️ Repo not found or inaccessible: $Owner/$repo" -ForegroundColor Yellow
139:             continue
140:         }
141:         
142:         # Apply templates
143:         Apply-Template -Repo $repo -TemplateType "README" -TargetPath "README.md" -Content $readmeTemplate
144:         Apply-Template -Repo $repo -TemplateType "LICENSE" -TargetPath "LICENSE" -Content $licenseTemplate
145:         Apply-Template -Repo $repo -TemplateType "CODEOWNERS" -TargetPath ".github/CODEOWNERS" -Content $codeownersTemplate
146:         Apply-Template -Repo $repo -TemplateType "CI Workflow" -TargetPath ".github/workflows/ci.yml" -Content $ciTemplate
147:     }
148:     
149:     # Summary
150:     Write-Host "`n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`n" -ForegroundColor Gray
151:     
152:     if ($DryRun) {
153:         Write-Host "✅ DRY-RUN COMPLETE" -ForegroundColor Green
154:         Write-Host "   No changes made to repositories"
155:         Write-Host "   Re-run without -DryRun to apply templates`n"
156:     } else {
157:         Write-Host "✅ STANDARDIZATION COMPLETE" -ForegroundColor Green
158:         Write-Host "   All repos now have standard templates`n"
159:     }
160: }
161: 
162: # Execute
163: Main
</file>

<file path="scripts/github/apply-single-repo.ps1">
 1: #!/usr/bin/env pwsh
 2: #Requires -Version 7
 3: 
 4: param(
 5:     [string]$Owner = "Sertxito",
 6:     [string]$Repo = "",
 7:     [string]$ReadmeFile = ""
 8: )
 9: 
10: if (-not $Repo -or -not $ReadmeFile) {
11:     Write-Host "Uso: $($MyInvocation.MyCommand.Name) -Repo boost_RAG-Azure -ReadmeFile templates/README_boost_RAG_Azure.md"
12:     exit 1
13: }
14: 
15: $TempDir = "temp_apply_$Repo"
16: $FullRepo = "$Owner/$Repo"
17: 
18: Write-Host "Processing: $FullRepo" -ForegroundColor Green
19: 
20: # Clean up old temp dir
21: if (Test-Path $TempDir) { 
22:     Remove-Item -Recurse -Force $TempDir 
23: }
24: 
25: # Clone repo
26: Write-Host "  Cloning..." -ForegroundColor DarkGray
27: gh repo clone $FullRepo $TempDir -- --depth 1
28: 
29: if (-not (Test-Path $TempDir)) {
30:     Write-Host "  ERROR: Clone failed" -ForegroundColor Red
31:     exit 1
32: }
33: 
34: Push-Location $TempDir
35: 
36: # Copy files
37: Write-Host "  Applying files..." -ForegroundColor DarkGray
38: 
39: # README
40: Copy-Item "../$ReadmeFile" README.md -Force
41: Write-Host "    ✓ README.md"
42: 
43: # LICENSE
44: Copy-Item ../templates/LICENSE_MIT_TEMPLATE.txt LICENSE -Force
45: Write-Host "    ✓ LICENSE"
46: 
47: # CODEOWNERS
48: New-Item -ItemType Directory .github -Force | Out-Null
49: Copy-Item ../templates/CODEOWNERS_TEMPLATE.txt .github/CODEOWNERS -Force
50: Write-Host "    ✓ CODEOWNERS"
51: 
52: # CI workflow
53: New-Item -ItemType Directory .github/workflows -Force | Out-Null
54: Copy-Item ../templates/ci.yml.template .github/workflows/ci.yml -Force
55: Write-Host "    ✓ ci.yml"
56: 
57: # Git commit
58: Write-Host "  Committing..." -ForegroundColor DarkGray
59: git config user.name "GitHub Automation"
60: git config user.email "automation@github.com"
61: git add README.md LICENSE .github/CODEOWNERS .github/workflows/ci.yml
62: git commit -m "chore: standardize templates (README, LICENSE, CODEOWNERS, CI)" 
63: 
64: if ($LASTEXITCODE -ne 0) {
65:     Write-Host "    [no changes]" -ForegroundColor DarkGray
66: } else {
67:     Write-Host "    ✓ Committed" -ForegroundColor Green
68: }
69: 
70: # Git push
71: Write-Host "  Pushing..." -ForegroundColor DarkGray
72: git push origin main 2>$null
73: 
74: if ($LASTEXITCODE -eq 0) {
75:     Write-Host "    ✓ Pushed successfully" -ForegroundColor Green
76: } else {
77:     Write-Host "    ! Push had warnings (might be ok)" -ForegroundColor Yellow
78: }
79: 
80: Pop-Location
81: 
82: # Clean up
83: Remove-Item -Recurse -Force $TempDir
84: 
85: Write-Host "✅ Done: $Repo" -ForegroundColor Green
</file>

<file path="scripts/github/create-devlog.ps1">
  1: #Requires -Version 7
  2: 
  3: <#
  4: .SYNOPSIS
  5: Genera devlog técnico automático a partir de commits recientes.
  6: 
  7: .DESCRIPTION
  8: Analiza últimos N commits, extrae cambios significativos, y genera markdown
  9: con insights técnicos. Crea archivo en autodocs/site/devlog/ y abre PR automáticamente.
 10: 
 11: .PARAMETER Repo
 12: Repositorio (owner/repo). Por defecto: Sertxito/mcp-efficiency-engine
 13: 
 14: .PARAMETER CommitsToAnalyze
 15: Número de commits a analizar. Por defecto: 10
 16: 
 17: .PARAMETER OutputDir
 18: Directorio de salida. Por defecto: autodocs/site/devlog
 19: 
 20: .PARAMETER DryRun
 21: No crear archivos ni PR, solo mostrar lo que haría.
 22: 
 23: .EXAMPLE
 24: .\create-devlog.ps1
 25: 
 26: .EXAMPLE
 27: .\create-devlog.ps1 -CommitsToAnalyze 20 -DryRun
 28: 
 29: #>
 30: 
 31: param(
 32:   [string]$Repo = "Sertxito/mcp-efficiency-engine",
 33:   [int]$CommitsToAnalyze = 10,
 34:   [string]$OutputDir = "autodocs/site/devlog",
 35:   [switch]$DryRun
 36: )
 37: 
 38: $ErrorActionPreference = "Stop"
 39: 
 40: # Obtener últimos commits
 41: function Get-RecentCommits {
 42:   param([string]$Repo, [int]$Count)
 43:   
 44:   Write-Host "Obteniendo últimos $Count commits de $Repo..."
 45:   
 46:   try {
 47:     $commits = gh api repos/$Repo/commits --limit $Count | ConvertFrom-Json
 48:     return $commits
 49:   } catch {
 50:     Write-Host "Error obteniendo commits: $_"
 51:     return @()
 52:   }
 53: }
 54: 
 55: # Analizar cambios por tipo
 56: function Analyze-CommitChanges {
 57:   param([array]$Commits)
 58:   
 59:   $stats = @{
 60:     features = @()
 61:     fixes = @()
 62:     refactor = @()
 63:     docs = @()
 64:     tests = @()
 65:     other = @()
 66:   }
 67:   
 68:   foreach ($commit in $Commits) {
 69:     $message = $commit.commit.message
 70:     $author = $commit.commit.author.name
 71:     $date = $commit.commit.author.date
 72:     
 73:     $item = @{
 74:       message = $message.Split([Environment]::NewLine)[0]
 75:       author = $author
 76:       date = $date
 77:       sha = $commit.sha.Substring(0, 7)
 78:     }
 79:     
 80:     if ($message -like "*feat*" -or $message -like "*feature*") {
 81:       $stats.features += $item
 82:     } elseif ($message -like "*fix*" -or $message -like "*bug*") {
 83:       $stats.fixes += $item
 84:     } elseif ($message -like "*refactor*") {
 85:       $stats.refactor += $item
 86:     } elseif ($message -like "*doc*") {
 87:       $stats.docs += $item
 88:     } elseif ($message -like "*test*") {
 89:       $stats.tests += $item
 90:     } else {
 91:       $stats.other += $item
 92:     }
 93:   }
 94:   
 95:   return $stats
 96: }
 97: 
 98: # Generar contenido markdown
 99: function Generate-DevlogMarkdown {
100:   param(
101:     [hashtable]$Stats,
102:     [string]$Repo,
103:     [datetime]$GeneratedAt
104:   )
105:   
106:   $date = $GeneratedAt.ToString("yyyy-MM-dd")
107:   $datetime = $GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss")
108:   
109:   $markdown = @"
110: # Devlog — $date
111: 
112: **Generado:** $datetime UTC  
113: **Fuente:** [$Repo](https://github.com/$Repo)
114: 
115: ---
116: 
117: ## 📊 Resumen
118: 
119: | Categoría | Cantidad |
120: |-----------|----------|
121: | 🎯 Features | $($Stats.features.Count) |
122: | 🐛 Fixes | $($Stats.fixes.Count) |
123: | 🔧 Refactor | $($Stats.refactor.Count) |
124: | 📝 Docs | $($Stats.docs.Count) |
125: | ✅ Tests | $($Stats.tests.Count) |
126: | 📌 Otros | $($Stats.other.Count) |
127: 
128: ---
129: 
130: "@
131: 
132:   # Features
133:   if ($Stats.features.Count -gt 0) {
134:     $markdown += @"
135: ## 🎯 Features Nuevas
136: 
137: "@
138:     foreach ($item in $Stats.features) {
139:       $markdown += @"
140: - **$($item.message)** — [\`$($item.sha)\`](https://github.com/$Repo/commit/$($item.sha))  
141:   _Por $($item.author) el $($item.date)_
142: 
143: "@
144:     }
145:     $markdown += "`n"
146:   }
147: 
148:   # Fixes
149:   if ($Stats.fixes.Count -gt 0) {
150:     $markdown += @"
151: ## 🐛 Fixes y Resoluciones
152: 
153: "@
154:     foreach ($item in $Stats.fixes) {
155:       $markdown += @"
156: - **$($item.message)** — [\`$($item.sha)\`](https://github.com/$Repo/commit/$($item.sha))  
157:   _Por $($item.author) el $($item.date)_
158: 
159: "@
160:     }
161:     $markdown += "`n"
162:   }
163: 
164:   # Refactor
165:   if ($Stats.refactor.Count -gt 0) {
166:     $markdown += @"
167: ## 🔧 Refactorizaciones
168: 
169: "@
170:     foreach ($item in $Stats.refactor) {
171:       $markdown += @"
172: - **$($item.message)** — [\`$($item.sha)\`](https://github.com/$Repo/commit/$($item.sha))
173: 
174: "@
175:     }
176:     $markdown += "`n"
177:   }
178: 
179:   # Docs
180:   if ($Stats.docs.Count -gt 0) {
181:     $markdown += @"
182: ## 📝 Documentación
183: 
184: "@
185:     foreach ($item in $Stats.docs) {
186:       $markdown += @"
187: - **$($item.message)** — [\`$($item.sha)\`](https://github.com/$Repo/commit/$($item.sha))
188: 
189: "@
190:     }
191:     $markdown += "`n"
192:   }
193: 
194:   # Tests
195:   if ($Stats.tests.Count -gt 0) {
196:     $markdown += @"
197: ## ✅ Tests y Validación
198: 
199: "@
200:     foreach ($item in $Stats.tests) {
201:       $markdown += @"
202: - **$($item.message)** — [\`$($item.sha)\`](https://github.com/$Repo/commit/$($item.sha))
203: 
204: "@
205:     }
206:     $markdown += "`n"
207:   }
208: 
209:   # Otros
210:   if ($Stats.other.Count -gt 0) {
211:     $markdown += @"
212: ## 📌 Otros Cambios
213: 
214: "@
215:     foreach ($item in $Stats.other) {
216:       $markdown += @"
217: - **$($item.message)** — [\`$($item.sha)\`](https://github.com/$Repo/commit/$($item.sha))
218: 
219: "@
220:     }
221:     $markdown += "`n"
222:   }
223: 
224:   $markdown += @"
225: ---
226: 
227: **Generado automáticamente por GitHub MCP DevLog Generator**
228: 
229: "@
230: 
231:   return $markdown
232: }
233: 
234: # Crear archivo devlog
235: function New-DevlogFile {
236:   param([string]$Content, [string]$OutputDir, [string]$Date)
237:   
238:   $fileName = "devlog-$Date.md"
239:   $filePath = "$OutputDir/$fileName"
240:   
241:   if ($DryRun) {
242:     Write-Host "[DRY-RUN] Crearía archivo: $filePath"
243:     Write-Host ""
244:     Write-Host "─────────────────────────────────────────"
245:     Write-Host $Content
246:     Write-Host "─────────────────────────────────────────"
247:     return $fileName
248:   }
249:   
250:   # Crear directorio si no existe
251:   if (-not (Test-Path $OutputDir)) {
252:     New-Item -ItemType Directory -Path $OutputDir -Force | Out-Null
253:     Write-Host "✓ Directorio creado: $OutputDir"
254:   }
255:   
256:   # Guardar archivo
257:   $Content | Out-File -FilePath $filePath -Encoding UTF8
258:   Write-Host "✓ Archivo devlog creado: $filePath"
259:   
260:   return $fileName
261: }
262: 
263: # Crear PR con devlog
264: function New-DevlogPullRequest {
265:   param([string]$FileName, [int]$CommitCount)
266:   
267:   $branchName = "devlog/$(Get-Date -Format 'yyyyMMdd')"
268:   $title = "docs: Devlog de $CommitCount commits — $(Get-Date -Format 'yyyy-MM-dd')"
269:   
270:   $body = @"
271: ## Devlog Automático
272: 
273: Se ha generado devlog técnico con análisis de últimos $CommitCount commits.
274: 
275: ### Contenido
276: - ✨ Features nuevas
277: - 🐛 Fixes y resoluciones
278: - 🔧 Refactorizaciones
279: - 📝 Cambios de documentación
280: - ✅ Tests y validación
281: 
282: ### Archivo
283: - **$FileName** en `autodocs/site/devlog/`
284: 
285: ### Acción Sugerida
286: 1. Revisar contenido del devlog
287: 2. Adaptar descripción técnica si es necesario
288: 3. Publicar en canal de documentación
289: 
290: ---
291: 
292: **Generado automáticamente por GitHub MCP DevLog Generator**
293: "@
294: 
295:   if ($DryRun) {
296:     Write-Host "[DRY-RUN] Crearía PR:"
297:     Write-Host "  Título: $title"
298:     Write-Host "  Rama: $branchName"
299:     return $true
300:   }
301:   
302:   try {
303:     # Crear rama
304:     $mainSha = gh api repos/$Repo/git/refs/heads/main --jq '.object.sha' | Cut -c 1-7
305:     Write-Host "Creando rama $branchName..."
306:     
307:     # TODO: Implementar vía MCP GitHub cuando se tenga acceso
308:     Write-Host "⚠ Creación de PR requiere configuración local de git"
309:     Write-Host "  Ejecutar manualmente:"
310:     Write-Host "  git checkout -b $branchName"
311:     Write-Host "  git add autodocs/site/devlog/$FileName"
312:     Write-Host "  git commit -m '$title'"
313:     Write-Host "  git push origin $branchName"
314:     
315:     return $false
316:   } catch {
317:     Write-Host "Error creando PR: $_"
318:     return $false
319:   }
320: }
321: 
322: # ===================
323: # Main Execution
324: # ===================
325: 
326: Write-Host "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
327: Write-Host "GitHub MCP DevLog Generator"
328: Write-Host "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
329: Write-Host ""
330: Write-Host "Repositorio: $Repo"
331: Write-Host "Commits a analizar: $CommitsToAnalyze"
332: Write-Host "Directorio de salida: $OutputDir"
333: 
334: if ($DryRun) {
335:   Write-Host "🔍 Modo DRY-RUN"
336: }
337: Write-Host ""
338: 
339: # 1. Obtener commits
340: $commits = Get-RecentCommits -Repo $Repo -Count $CommitsToAnalyze
341: if ($commits.Count -eq 0) {
342:   Write-Host "✗ No se pudieron obtener commits"
343:   exit 1
344: }
345: 
346: Write-Host "✓ Obtenidos $($commits.Count) commits"
347: Write-Host ""
348: 
349: # 2. Analizar cambios
350: $stats = Analyze-CommitChanges -Commits $commits
351: 
352: Write-Host "📊 Cambios detectados:"
353: Write-Host "  🎯 Features: $($stats.features.Count)"
354: Write-Host "  🐛 Fixes: $($stats.fixes.Count)"
355: Write-Host "  🔧 Refactor: $($stats.refactor.Count)"
356: Write-Host "  📝 Docs: $($stats.docs.Count)"
357: Write-Host "  ✅ Tests: $($stats.tests.Count)"
358: Write-Host "  📌 Otros: $($stats.other.Count)"
359: Write-Host ""
360: 
361: # 3. Generar markdown
362: $now = Get-Date
363: $dateStr = $now.ToString("yyyy-MM-dd")
364: $markdown = Generate-DevlogMarkdown -Stats $stats -Repo $Repo -GeneratedAt $now
365: 
366: # 4. Crear archivo
367: $fileName = New-DevlogFile -Content $markdown -OutputDir $OutputDir -Date $dateStr
368: Write-Host ""
369: 
370: # 5. Crear PR (opcional)
371: $totalCommits = $stats.features.Count + $stats.fixes.Count + $stats.refactor.Count + `
372:   $stats.docs.Count + $stats.tests.Count + $stats.other.Count
373: 
374: if ($totalCommits -gt 0) {
375:   Write-Host "Creando PR con devlog..."
376:   New-DevlogPullRequest -FileName $fileName -CommitCount $totalCommits
377: }
378: 
379: Write-Host ""
380: Write-Host "✓ DevLog generado exitosamente"
</file>

<file path="scripts/github/INSTALL.md">
  1: # Guía de Instalación y Uso — GitHub MCP Scripts
  2: 
  3: ## ✅ Lo que NECESITAS
  4: 
  5: Solo necesitas estas dos cosas:
  6: 
  7: 1. **GitHub CLI (`gh`)** — Disponible en todas las plataformas
  8: 2. **PowerShell 7+** — Para ejecutar scripts
  9: 
 10: ## ❌ Lo que NO NECESITAS
 11: 
 12: - ~~`npm install -g @github/mcp-github-server`~~ (no existe en npm registry)
 13: - ~~MCP Server local~~ (no es necesario para estos scripts)
 14: 
 15: Los scripts usan `gh` CLI que ya está optimizado para GitHub.
 16: 
 17: ---
 18: 
 19: ## Instalación Rápida
 20: 
 21: ### Opción 1: Windows (Recomendado)
 22: 
 23: ```powershell
 24: # 1. Instalar GitHub CLI
 25: winget install GitHub.cli
 26: 
 27: # 2. Instalar PowerShell 7 (si no tienes)
 28: winget install Microsoft.PowerShell
 29: 
 30: # 3. Reinicia terminal
 31: 
 32: # 4. Login
 33: gh auth login
 34: 
 35: # 5. Configura token (permanente)
 36: $env:GITHUB_TOKEN = "ghp_xxxxxxxxxxxxxxxxxxxx"
 37: Add-Content $PROFILE "`n`$env:GITHUB_TOKEN = 'ghp_xxxxxxxxxxxxxxxxxxxx'"
 38: 
 39: # 6. Verifica
 40: gh auth status
 41: ```
 42: 
 43: ### Opción 2: macOS
 44: 
 45: ```bash
 46: # 1. Instalar GitHub CLI
 47: brew install gh
 48: 
 49: # 2. PowerShell (opcional, ya tienes bash)
 50: brew install powershell
 51: 
 52: # 3. Login
 53: gh auth login
 54: 
 55: # 4. Configura token
 56: echo 'export GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"' >> ~/.zshrc
 57: source ~/.zshrc
 58: 
 59: # 5. Verifica
 60: gh auth status
 61: ```
 62: 
 63: ### Opción 3: Linux (Ubuntu/Debian)
 64: 
 65: ```bash
 66: # 1. Instalar GitHub CLI
 67: sudo apt install gh
 68: 
 69: # 2. Instalar PowerShell
 70: sudo apt install powershell
 71: 
 72: # 3. Login
 73: gh auth login
 74: 
 75: # 4. Configura token
 76: echo 'export GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"' >> ~/.bashrc
 77: source ~/.bashrc
 78: 
 79: # 5. Verifica
 80: gh auth status
 81: ```
 82: 
 83: ---
 84: 
 85: ## Crear GitHub Personal Access Token (PAT)
 86: 
 87: 1. **GitHub Settings:**
 88:    - https://github.com/settings/tokens
 89: 
 90: 2. **Generate new token (classic):**
 91:    - Name: `MCP Efficiency Engine`
 92:    - Scopes: `repo`, `workflow`
 93:    - Expiration: 30 days (renovar después)
 94: 
 95: 3. **Copiar token:**
 96:    ```
 97:    ghp_xxxxxxxxxxxxxxxxxxxx
 98:    ```
 99: 
100: 4. **Guardar en tu sistema:**
101:    - Windows: `cmdkey /add:github.com /user:username /pass:ghp_xxxx`
102:    - macOS/Linux: `echo 'export GITHUB_TOKEN="ghp_xxxx"' >> ~/.bashrc`
103: 
104: ---
105: 
106: ## Usar los Scripts Localmente
107: 
108: ### Paso 1: Clonar Repo
109: 
110: ```bash
111: git clone https://github.com/Sertxito/mcp-efficiency-engine.git
112: cd mcp-efficiency-engine
113: ```
114: 
115: ### Paso 2: Ejecutar Scripts
116: 
117: #### Sincronizar Repos (Preview)
118: 
119: ```powershell
120: # Ver qué haría sin hacer cambios
121: pwsh scripts/github/sync-repo.ps1 -FilesPattern "projects/**" -DryRun
122: ```
123: 
124: #### Generar DevLog
125: 
126: ```powershell
127: # Generar devlog con últimos 20 commits
128: pwsh scripts/github/create-devlog.ps1 -CommitsToAnalyze 20
129: 
130: # Ver preview sin crear archivo
131: pwsh scripts/github/create-devlog.ps1 -DryRun
132: ```
133: 
134: #### Gestionar Issues
135: 
136: ```powershell
137: # Asignar Copilot a issues sin asignar
138: pwsh scripts/github/manage-issues.ps1 -Action assign
139: 
140: # Solicitar reviews de Copilot en PRs
141: pwsh scripts/github/manage-issues.ps1 -Action review
142: 
143: # Auto-cerrar issues resueltas
144: pwsh scripts/github/manage-issues.ps1 -Action close
145: ```
146: 
147: ---
148: 
149: ## Uso en GitHub Actions (CI/CD)
150: 
151: Los workflows ya están configurados. Se ejecutan automáticamente:
152: 
153: | Workflow | Trigger | Qué Hace |
154: |----------|---------|---------|
155: | **auto-sync.yml** | Push a main (projects/) | Sincroniza cambios a boost_sertxIA |
156: | **auto-devlog.yml** | Push a main | Genera devlog de commits |
157: | **auto-manage-issues.yml** | Lunes 9 AM | Gestiona issues automáticamente |
158: 
159: ### Trigger Manual
160: 
161: ```bash
162: # Desde tu terminal local
163: gh workflow run auto-sync.yml -r main
164: gh workflow run auto-devlog.yml -r main
165: gh workflow run auto-manage-issues.yml -r main
166: ```
167: 
168: ### Ver Resultados
169: 
170: ```bash
171: # Ver workflows en ejecución
172: gh workflow list
173: 
174: # Ver runs de un workflow
175: gh run list
176: 
177: # Ver logs de un run
178: gh run view <run-id> --log
179: ```
180: 
181: ---
182: 
183: ## Troubleshooting
184: 
185: ### Error: "GitHub CLI not found"
186: 
187: ```bash
188: # Instalar
189: # Windows
190: winget install GitHub.cli
191: 
192: # macOS
193: brew install gh
194: 
195: # Linux
196: sudo apt install gh
197: ```
198: 
199: ### Error: "Not authenticated"
200: 
201: ```bash
202: # Login
203: gh auth login
204: 
205: # Verificar
206: gh auth status
207: ```
208: 
209: ### Error: "Token expired or invalid"
210: 
211: ```bash
212: # Renovar token en: https://github.com/settings/tokens
213: # Guardar nueva vez:
214: $env:GITHUB_TOKEN = "ghp_nuevo_token"
215: ```
216: 
217: ### Error: "Rate limit exceeded"
218: 
219: GitHub API tiene límites:
220: - **Unauthenticated:** 60 requests/hora
221: - **Authenticated:** 5,000 requests/hora
222: 
223: Si ves este error, espera 1 hora o reduce cantidad de operaciones.
224: 
225: ### Error: "Permission denied"
226: 
227: ```bash
228: # Verificar permisos del token
229: gh auth status
230: 
231: # El token debe tener:
232: # - repo (acceso a repositorios)
233: # - workflow (permisos para workflows)
234: ```
235: 
236: ---
237: 
238: ## Cambios Clave Desde v1.0
239: 
240: ### Setup Simplificado
241: 
242: - ✅ Eliminado requisito de `npm install -g @github/mcp-github-server`
243: - ✅ Solo necesitas `gh` CLI (disponible everywhere)
244: - ✅ Funciona en CI/CD sin configuración extra
245: 
246: ### Workflows Añadidos
247: 
248: - ✅ `auto-sync.yml` — Sincronización automática
249: - ✅ `auto-devlog.yml` — DevLog automático
250: - ✅ `auto-manage-issues.yml` — Gestión de issues
251: 
252: ### Documentación
253: 
254: - ✅ Guía de instalación simplificada
255: - ✅ Troubleshooting actualizado
256: - ✅ Ejemplos de uso locales + CI/CD
257: 
258: ---
259: 
260: ## Próximos Pasos
261: 
262: 1. **Instalar localmente:**
263:    ```powershell
264:    winget install GitHub.cli
265:    gh auth login
266:    ```
267: 
268: 2. **Test un script:**
269:    ```powershell
270:    pwsh scripts/github/manage-issues.ps1 -Action assign -DryRun
271:    ```
272: 
273: 3. **Verificar workflows activos:**
274:    ```bash
275:    gh workflow list
276:    ```
277: 
278: 4. **Personalizar según necesidad:**
279:    - Editar `.github/workflows/*.yml`
280:    - Ajustar triggers (schedules, paths)
281:    - Agregar más acciones
282: 
283: ---
284: 
285: ## Referencias
286: 
287: - [GitHub CLI Documentation](https://cli.github.com/)
288: - [GitHub REST API](https://docs.github.com/en/rest)
289: - [Scripts README](./README.md)
290: - [GitHub MCP Integration Guide](../.github/GITHUB_MCP_INTEGRATION.md)
291: 
