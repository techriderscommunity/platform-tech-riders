257:         return undefined;
258:       }
259:       return items.find(item => item.email.toLowerCase() === parsed.email?.toLowerCase());
260:     }
261:     catch {
262:       return undefined;
263:     }
264:   }
265:   private persistPortalLocally() {
266:     if (typeof localStorage === 'undefined') {
267:       return;
268:     }
269:     localStorage.setItem('techriders.mvp.ambassadorPortal', JSON.stringify({
270:       bio: this.bio(),
271:       especialidades: this.especialidades(),
272:       disponibilidad: this.disponibilidad(),
273:     }));
274:   }
275:   private resolveUserKey(): string {
276:     return this.authService.user()?.email || this.resolveCurrentEmail();
277:   }
278:   private resolveCurrentEmail(): string {
279:     return this.ambassadorActual()?.email || this.authService.user()?.email || 'local-user@techriders.local';
280:   }
281: }
