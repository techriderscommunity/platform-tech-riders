  1: import { TestBed } from '@angular/core/testing';
  2: import { provideHttpClient } from '@angular/common/http';
  3: import { provideHttpClientTesting, HttpTestingController } from '@angular/common/http/testing';
  4: import { AuthService, type LoginResponse, type UserProfile } from './auth.service';
  5: import { environment } from '@env/environment';
  6: describe('AuthService', () => {
  7:   let service: AuthService;
  8:   let httpMock: HttpTestingController;
  9:   const mockUser: UserProfile = {
 10:     id: 'u1',
 11:     email: 'admin@techriders.es',
 12:     name: 'Admin',
 13:     role: 'admin',
 14:     roles: ['admin'],
 15:   };
 16:   beforeEach(() => {
 17:     localStorage.clear();
 18:     TestBed.configureTestingModule({
 19:       providers: [AuthService, provideHttpClient(), provideHttpClientTesting()],
 20:     });
 21:     service = TestBed.inject(AuthService);
 22:     httpMock = TestBed.inject(HttpTestingController);
 23:   });
 24:   afterEach(() => {
 25:     httpMock.verify();
 26:     localStorage.clear();
 27:   });
 28:   it('should login and persist token + user', () => {
 29:     const mockResponse: LoginResponse = {
 30:       token: 'jwt-token',
 31:       user: mockUser,
 32:     };
 33:     service.login('admin@techriders.es', 'secret').subscribe((response) => {
 34:       expect(response.token).toBe('jwt-token');
 35:     });
 36:     const req = httpMock.expectOne(`${environment.apiUrl}/auth/login`);
 37:     expect(req.request.method).toBe('POST');
 38:     expect(req.request.body.email).toBe('admin@techriders.es');
 39:     req.flush(mockResponse);
 40:     expect(service.isAuthenticated()).toBeTrue();
 41:     expect(service.user()?.role).toBe('admin');
 42:     expect(service.userType()).toBe('admin');
 43:     expect(localStorage.getItem('token')).toBe('jwt-token');
 44:     expect(localStorage.getItem('user')).toContain('admin@techriders.es');
 45:   });
 46:   it('should accept PascalCase backend responses while persisting the session', () => {
 47:     const pascalCaseResponse = {
 48:       Token: 'jwt-token',
 49:       User: {
 50:         Id: 'u1',
 51:         Email: 'admin@techriders.es',
 52:         Name: 'Admin',
 53:         Role: 'admin',
 54:         Roles: ['admin'],
 55:       },
 56:     };
 57:     service.login('admin@techriders.es', 'secret').subscribe((response) => {
 58:       expect(response.token).toBe('jwt-token');
 59:       expect(response.user.email).toBe('admin@techriders.es');
 60:       expect(response.user.role).toBe('admin');
 61:     });
 62:     const req = httpMock.expectOne(`${environment.apiUrl}/auth/login`);
 63:     req.flush(pascalCaseResponse as any);
 64:     expect(service.isAuthenticated()).toBeTrue();
 65:     expect(service.user()?.email).toBe('admin@techriders.es');
 66:     expect(localStorage.getItem('token')).toBe('jwt-token');
 67:   });
 68:   it('should load persisted user from localStorage', () => {
 69:     localStorage.setItem('user', JSON.stringify(mockUser));
 70:     const reloaded = new AuthService({} as any);
 71:     expect(reloaded.isAuthenticated()).toBeTrue();
 72:     expect(reloaded.user()?.id).toBe('u1');
 73:     expect(reloaded.userType()).toBe('admin');
 74:   });
 75:   it('should not fall back to demo credentials when the backend rejects the login', () => {
 76:     service.login('admin@techriders.es', 'wrong-password').subscribe({
 77:       next: () => fail('Expected login to fail when backend rejects the credentials'),
 78:       error: (error) => {
 79:         expect(error.status).toBe(401);
 80:       },
 81:     });
 82:     const req = httpMock.expectOne(`${environment.apiUrl}/auth/login`);
 83:     expect(req.request.method).toBe('POST');
 84:     req.flush({ message: 'Credenciales inválidas.' }, { status: 401, statusText: 'Unauthorized' });
 85:     expect(service.isAuthenticated()).toBeFalse();
 86:     expect(localStorage.getItem('token')).toBeNull();
 87:     expect(localStorage.getItem('user')).toBeNull();
 88:   });
 89:   it('should logout and clear session data', () => {
