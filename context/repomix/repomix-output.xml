<file path="techito/src/app/features/intranet/embajadores/services/embajadores.service.ts">
 1: import { Injectable, inject } from '@angular/core';
 2: import { HttpClient, HttpParams } from '@angular/common/http';
 3: import { map } from 'rxjs/operators';
 4: import { environment } from '\.\./\.\./\.\./\.\./\.\./environments/environment';
 5: import {
 6:   AmbassadorApi,
 7:   AmbassadorPortalApi,
 8:   Embajador,
 9:   PagedResult,
10:   TalkItem,
11:   UpdateAmbassadorPortalPayload,
12: } from '../models/embajadores.models';
13: @Injectable({ providedIn: 'root' })
14: export class EmbajadoresService {
15:   private readonly http = inject(HttpClient);
16:   private readonly baseUrl = `${environment.apiUrl}/ambassadors`;
17:   private readonly intranetBaseUrl = `${environment.apiUrl}/intranet`;
18:   getEmbajadores(page = 1, pageSize = 50, estado?: string) {
19:     const params = new HttpParams();
20:     return this.http.get<AmbassadorApi[]>(this.baseUrl, { params }).pipe(
21:       map((items) => {
22:         const mappedItems = (items ?? []).map((item): Embajador => ({
23:           id: item.Id,
24:           nombre: [item.Name, item.LastName].filter(Boolean).join(' ').trim(),
25:           email: item.Email,
26:           telefono: item.Phone ?? '',
27:           categoria: item.CategoryName ?? item.OtherCategory ?? 'General',
28:           estado: item.IsActive ? 'activo' : 'desactivado',
29:           totalSesiones: 0,
30:           ultimaActividad: item.UpdatedAt ?? item.CreatedAt,
31:         }));
32:         const filteredItems = estado
33:           ? mappedItems.filter((item) => item.estado === estado)
34:           : mappedItems;
35:         const startIndex = Math.max(0, (page - 1) * pageSize);
36:         const pagedItems = filteredItems.slice(startIndex, startIndex + pageSize);
37:         const totalCount = filteredItems.length;
38:         const totalPages = Math.ceil(totalCount / pageSize);
39:         return {
40:           items: pagedItems,
41:           totalCount,
42:           page,
43:           pageSize,
44:           totalPages,
45:           hasNextPage: page < totalPages,
46:           hasPreviousPage: page > 1,
47:         } satisfies PagedResult<Embajador>;
48:       })
49:     );
50:   }
51:   createEmbajador(embajador: { nombre: string; email: string; telefono: string; categoria: string; }) {
52:     return this.http.post<string>(this.baseUrl, embajador);
53:   }
54:   getTalks() {
55:     return this.http.get<AmbassadorApi[]>(this.baseUrl).pipe(
56:       map((items) => (items ?? []).map((embajador): TalkItem => ({
57:         topic: embajador.CategoryName ?? embajador.OtherCategory ?? 'General',
58:         speaker: [embajador.Name, embajador.LastName].filter(Boolean).join(' ').trim(),
59:         date: embajador.UpdatedAt ?? embajador.CreatedAt,
60:         rating: 3,
61:       }))),
62:     );
63:   }
64:   getAmbassadorPortalProfile(userKey: string, email: string) {
65:     return this.http.get<AmbassadorPortalApi>(`${this.intranetBaseUrl}/ambassador-profile`, {
66:       params: {
67:         userKey,
68:         email,
69:       },
70:     });
71:   }
72:   updateAmbassadorPortalProfile(payload: UpdateAmbassadorPortalPayload) {
73:     return this.http.put<AmbassadorPortalApi>(`${this.intranetBaseUrl}/ambassador-profile`, payload);
74:   }
75: }
</file>

