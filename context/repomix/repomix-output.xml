124: ### Pipeline Orchestration
125: 
126: ```bash
127: # Run pipeline and wait for completion
128: RUN_ID=$(az pipelines run --name "$PIPELINE_NAME" --query "id" -o tsv)
129: 
130: while true; do
131:   STATUS=$(az pipelines runs show --run-id $RUN_ID --query "status" -o tsv)
132:   if [[ "$STATUS" != "inProgress" && "$STATUS" != "notStarted" ]]; then
133:     break
134:   fi
135:   sleep 10
136: done
137: 
138: # Check result
139: RESULT=$(az pipelines runs show --run-id $RUN_ID --query "result" -o tsv)
140: if [[ "$RESULT" == "succeeded" ]]; then
141:   echo "Pipeline succeeded"
142: else
143:   echo "Pipeline failed with result: $RESULT"
144:   exit 1
145: fi
146: ```
