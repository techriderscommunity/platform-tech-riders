<file path="techito/src/app/features/intranet/fp-tour/services/eventos.service.ts">
  1: import { Injectable, inject } from '@angular/core';
  2: import { HttpClient, HttpParams } from '@angular/common/http';
  3: import { map } from 'rxjs/operators';
  4: import { environment } from '../../../../../environments/environment';
  5: import { EventoConSesionesApi, EventoListApi, EventoResumen } from '../models/eventos.models';
  6: import { PagedResult } from '../models/sesiones.models';
  7: import { EventoCalendario, SesionEnEvento } from '../calendar-eventos';
  8: function toHHmm(timeOnly: string | null): string {
  9:   if (!timeOnly) return '00:00';
 10:   // TimeOnly llega como "HH:mm:ss" o "HH:mm:ss.fffffff"
 11:   return timeOnly.substring(0, 5);
 12: }
 13: function toFechaStr(dateStr: string): string {
 14:   // ISO date → 'YYYY-MM-DD'
 15:   return dateStr.substring(0, 10);
 16: }
 17: const DEFAULT_EVENTO_CALENDARIO_CATEGORIA: EventoCalendario['categoria'] = 'Colaboradores';
 18: const DEFAULT_EVENTO_RESUMEN_CATEGORIA = 'others';
 19: const EVENT_STATUS = {
 20:   active: 'Active',
 21:   inactive: 'Inactive',
 22: } as const;
 23: @Injectable({ providedIn: 'root' })
 24: export class EventosService {
 25:   private readonly http = inject(HttpClient);
 26:   private readonly baseUrl = `${environment.apiUrl}/events`;
 27:   getEventosConSesiones(page = 1, pageSize = 100): import('rxjs').Observable<PagedResult<EventoCalendario>> {
 28:     const safePage = this.normalizePositiveInt(page, 1);
 29:     const safePageSize = this.normalizePositiveInt(pageSize, 100);
 30:     const params = this.buildPaginationParams(safePage, safePageSize);
 31:     return this.http
 32:       .get<EventoConSesionesApi[]>(this.baseUrl, { params })
 33:       .pipe(map((result) => ({
 34:         items: (result ?? []).map((evento) => this.mapEventoCalendario(evento)),
 35:         totalCount: result?.length ?? 0,
 36:         page: safePage,
 37:         pageSize: safePageSize,
 38:         totalPages: 1,
 39:         hasNextPage: false,
 40:         hasPreviousPage: false,
 41:       })));
 42:   }
 43:   getEventos(page = 1, pageSize = 20): import('rxjs').Observable<PagedResult<EventoResumen>> {
 44:     const safePage = this.normalizePositiveInt(page, 1);
 45:     const safePageSize = this.normalizePositiveInt(pageSize, 20);
 46:     const params = this.buildPaginationParams(safePage, safePageSize);
 47:     return this.http
 48:       .get<EventoListApi[]>(this.baseUrl, { params })
 49:       .pipe(map((result) => ({
 50:         items: (result ?? []).map((evento) => this.mapEventoResumen(evento)),
 51:         totalCount: result?.length ?? 0,
 52:         page: safePage,
 53:         pageSize: safePageSize,
 54:         totalPages: 1,
 55:         hasNextPage: false,
 56:         hasPreviousPage: false,
 57:       })));
 58:   }
 59:   private buildPaginationParams(page: number, pageSize: number): HttpParams {
 60:     return new HttpParams()
 61:       .set('page', String(page))
 62:       .set('pageSize', String(pageSize));
 63:   }
 64:   private mapEventoCalendario(evento: EventoConSesionesApi): EventoCalendario {
 65:     return {
 66:       id: evento.Id,
 67:       titulo: evento.Name,
 68:       fechaInicio: toFechaStr(evento.StartDate),
 69:       fechaFin: toFechaStr(evento.EndDate),
 70:       categoria: this.getCalendarCategory(evento.Name),
 71:       descripcion: evento.Description,
 72:       centro: evento.Location,
 73:       sesiones: (evento.Sessions ?? []).map((sesion): SesionEnEvento => ({
 74:         id: sesion.Id,
 75:         titulo: sesion.Title,
 76:         fecha: toFechaStr(evento.StartDate),
 77:         horaInicio: toHHmm(sesion.StartTime),
 78:         horaFin: toHHmm(sesion.EndTime),
 79:         descripcion: sesion.Description,
 80:         ponente: sesion.Speaker,
 81:         sala: sesion.Room,
 82:       })),
 83:     };
 84:   }
 85:   private mapEventoResumen(evento: EventoListApi): EventoResumen {
 86:     return {
 87:       id: evento.Id,
 88:       titulo: evento.Name,
 89:       ubicacion: evento.Location ?? '',
 90:       categoria: DEFAULT_EVENTO_RESUMEN_CATEGORIA,
 91:       estado: evento.IsActive ? EVENT_STATUS.active : EVENT_STATUS.inactive,
 92:       url: '',
 93:       esPasado: false,
 94:     };
 95:   }
 96:   private getCalendarCategory(nombreEvento: string): EventoCalendario['categoria'] {
 97:     const normalizedName = nombreEvento.toLowerCase();
 98:     if (normalizedName.includes('fptour') || normalizedName.includes('fp tour')) {
 99:       return 'FPTour';
100:     }
101:     if (normalizedName.includes('tajamar')) {
102:       return 'TajamarTech';
103:     }
104:     if (normalizedName.includes('techriders') || normalizedName.includes('tech riders')) {
105:       return 'TechRiders';
106:     }
107:     return DEFAULT_EVENTO_CALENDARIO_CATEGORIA;
108:   }
109:   private normalizePositiveInt(value: number, fallback: number): number {
110:     return Number.isInteger(value) && value > 0 ? value : fallback;
111:   }
112: }
</file>

