  1: import { ChangeDetectionStrategy, Component, DestroyRef, OnInit, inject, signal } from '@angular/core';
  2: import { CommonModule } from '@angular/common';
  3: import { FormsModule } from '@angular/forms';
  4: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
  5: import { catchError, EMPTY, tap } from 'rxjs';
  6: import { Router, RouterLink } from '@angular/router';
  7: import { PublicContentService } from '@core/content/public-content.service';
  8: import { MetricItem } from '@core/content/public-content.models';
  9: import { UiTextField  } from '@shared/ui/text-field/text-field';
 10: import { UiTextarea  } from '@shared/ui/textarea/textarea';
 11: import { UiButton  } from '@shared/ui/button/button';
 12: import { UiSelect, UiSelectOption } from '@shared/ui/select/select';
 13: import { UiMetricsStrip } from '@shared/ui/metrics-strip/metrics-strip';
 14: import { IntakeType, JoinRequestPayload } from './models/unete.models';
 15: import { UneteIntakeService } from './services/unete-intake.service';
 16: @Component({
 17:   selector: 'app-unete',
 18:   standalone: true,
 19:   changeDetection: ChangeDetectionStrategy.OnPush,
 20:   imports: [CommonModule, FormsModule, RouterLink, UiTextField, UiTextarea, UiButton, UiSelect, UiMetricsStrip],
 21:   templateUrl: './unete.html',
 22:   styleUrl: './unete.scss'
 23: })
 24: export class Unete implements OnInit {
 25:   private readonly uneteIntakeService = inject(UneteIntakeService);
 26:   private readonly publicContentService = inject(PublicContentService);
 27:   private readonly destroyRef = inject(DestroyRef);
 28:   private readonly router = inject(Router);
 29:   intakeOptions: UiSelectOption[] = [];
 30:   joinMetrics: MetricItem[] = [];
 31:   // Estado de flujo activo
 32:   flujoActivo = signal<IntakeType>('member');
 33:   // Estado del formulario
 34:   formulario = signal({
 35:     nombre: '',
 36:     email: '',
 37:     requestType: 'member' as IntakeType,
 38:     communityRole: 'member',
 39:     organizacion: '',
 40:     motivacion: '',
 41:     sessionTopic: '',
 42:   });
 43:   enviado = signal(false);
 44:   loading = signal(false);
 45:   error = signal('');
 46:   successMessage = signal('');
 47:   ngOnInit(): void {
 48:     this.publicContentService
 49:       .getPublicContent()
 50:       .pipe(
 51:         tap((content) => {
 52:           this.joinMetrics = content.join.metrics;
 53:           this.intakeOptions = content.join.intakeOptions;
 54:         }),
 55:         catchError(() => EMPTY),
 56:         takeUntilDestroyed(this.destroyRef)
 57:       )
 58:       .subscribe();
 59:   }
 60:   seleccionarFlujo(requestType: IntakeType) {
 61:     this.flujoActivo.set(requestType);
 62:     this.formulario.update(current => ({
 63:       ...current,
 64:       requestType,
 65:       communityRole: this.getCommunityRoleForRequest(requestType)
 66:     }));
 67:   }
 68:   seleccionarFlujoDesdeSelect(value: string) {
 69:     if (value === 'member' || value === 'ambassador' || value === 'session') {
 70:       this.seleccionarFlujo(value);
 71:     }
 72:   }
 73:   flowTitle(): string {
 74:     switch (this.flujoActivo()) {
 75:       case 'ambassador':
 76:         return 'Comparte tu experiencia con impacto';
 77:       case 'session':
 78:         return 'Traemos una sesion adaptada a tu contexto';
 79:       default:
 80:         return 'Empieza por donde estes hoy';
 81:     }
 82:   }
 83:   flowHint(): string {
 84:     switch (this.flujoActivo()) {
 85:       case 'ambassador':
 86:         return 'Si te apetece aportar, difundimos tu conocimiento en formatos que encajen contigo.';
 87:       case 'session':
 88:         return 'Nos cuentas tu necesidad y co-disenamos una sesion util para tu grupo.';
 89:       default:
 90:         return 'No necesitas tenerlo todo claro. Te ayudamos a encontrar tu camino dentro de la comunidad.';
 91:     }
 92:   }
 93:   onSubmit(event: Event) {
 94:     event.preventDefault();
 95:     this.loading.set(true);
 96:     this.error.set('');
 97:     const payload: JoinRequestPayload = {
 98:       name: this.formulario().nombre,
 99:       email: this.formulario().email,
100:       requestType: this.formulario().requestType,
101:       communityRole: this.formulario().communityRole,
102:       audience: null,
103:       organization: this.formulario().organizacion || null,
104:       motivation: this.formulario().motivacion,
105:       sessionTopic: this.formulario().requestType === 'session' ? this.formulario().sessionTopic || null : null,
106:       sessionFormat: this.formulario().requestType === 'session' ? 'por-definir' : null,
107:     };
108:     this.uneteIntakeService.submitJoinRequest(payload).subscribe({
109:       next: () => {
110:         this.persistLocalDraft(payload);
111:         this.loading.set(false);
112:         this.enviado.set(true);
113:         this.successMessage.set(this.buildSuccessMessage(this.formulario().requestType));
114:         this.formulario.set({
115:           nombre: '',
116:           email: '',
117:           requestType: this.flujoActivo(),
118:           communityRole: this.getCommunityRoleForRequest(this.flujoActivo()),
119:           organizacion: '',
120:           motivacion: '',
121:           sessionTopic: '',
122:         });
123:         setTimeout(() => this.enviado.set(false), 3000);
124:       },
125:       error: (err) => {
126:         this.loading.set(false);
127:         this.error.set('Oops, algo salió mal. ¡Reinténtalo en un momento! 🚀');
128:         console.error(err);
129:       }
130:     });
131:   }
132:   updateNombre(value: string) {
133:     this.formulario.update(f => ({ ...f, nombre: value }));
134:   }
135:   updateEmail(value: string) {
136:     this.formulario.update(f => ({ ...f, email: value }));
137:   }
138:   updateOrganizacion(value: string) {
139:     this.formulario.update(f => ({ ...f, organizacion: value }));
140:   }
141:   updateSessionTopic(value: string) {
142:     this.formulario.update(f => ({ ...f, sessionTopic: value }));
143:   }
144:   updateMotivacion(value: string) {
145:     this.formulario.update(f => ({ ...f, motivacion: value }));
146:   }
147:   private getCommunityRoleForRequest(requestType: IntakeType): string {
148:     switch (requestType) {
149:       case 'ambassador':
150:         return 'ambassador';
151:       case 'session':
152:         return 'member';
153:       default:
154:         return 'member';
155:     }
156:   }
157:   irAlPortalAmbassador() {
158:     this.router.navigateByUrl('/intranet/ambassador/portal');
159:   }
160:   private persistLocalDraft(payload: JoinRequestPayload) {
161:     if (typeof localStorage === 'undefined') {
162:       return;
163:     }
164:     if (payload.requestType === 'ambassador') {
165:       localStorage.setItem('techriders.mvp.ambassadorDraft', JSON.stringify(payload));
166:     }
167:     if (payload.requestType === 'member') {
168:       localStorage.setItem('techriders.mvp.memberProfile', JSON.stringify({
169:         nombre: payload.name,
170:         email: payload.email,
171:         bio: payload.motivation,
172:         intereses: 'por-definir',
173:         organizacion: payload.organization,
174:         communityRole: payload.communityRole,
175:       }));
176:     }
177:   }
178:   private buildSuccessMessage(requestType: IntakeType): string {
179:     if (requestType === 'ambassador') {
180:       return 'Solicitud enviada. Si ya tienes acceso a la intranet, el portal Ambassador quedará precargado con tu borrador.';
181:     }
182:     if (requestType === 'session') {
183:       return 'Solicitud enviada. El equipo revisará el contexto y propondrá coordinación para la sesión.';
184:     }
185:       return 'Solicitud enviada. Tu perfil de member ha quedado registrado.';
186:   }
187: }
