  1: from __future__ import annotations
  2: import argparse
  3: import json
  4: import re
  5: from dataclasses import dataclass
  6: from datetime import datetime, timezone
  7: from pathlib import Path
  8: from typing import Any
  9: try:
 10:     import yaml  # type: ignore
 11: except Exception:
 12:     yaml = None
 13: def utc_now() -> str:
 14:     return datetime.now(timezone.utc).isoformat()
 15: def parse_simple_yml(path: Path) -> dict[str, Any]:
 16:     repos: list[dict[str, Any]] = []
 17:     current: dict[str, Any] | None = None
 18:     for line in path.read_text(encoding="utf-8").splitlines():
 19:         st = line.strip()
 20:         if st.startswith("- name:"):
 21:             if current:
 22:                 repos.append(current)
 23:             current = {"name": st.split(":", 1)[1].strip()}
 24:         elif current and ":" in st and not st.startswith("#"):
 25:             k, v = st.split(":", 1)
 26:             k = k.strip()
 27:             v = v.strip().strip('"')
 28:             if k in {"domain", "type", "package_name", "package_path"}:
 29:                 current[k] = v
 30:     if current:
 31:         repos.append(current)
 32:     return {"schema_version": "1.0", "repos": repos}
 33: def load_registry(path: Path) -> dict[str, Any]:
 34:     content = path.read_text(encoding="utf-8")
 35:     # JSON-first support (JSON is valid YAML, but this path avoids extra deps).
 36:     if content.lstrip().startswith("{"):
 37:         return json.loads(content)
 38:     if yaml is not None:
 39:         data = yaml.safe_load(content) or {}
 40:         if isinstance(data, dict):
 41:             return data
 42:     return parse_simple_yml(path)
 43: @dataclass
 44: class ValidationResult:
 45:     errors: list[str]
 46:     warnings: list[str]
 47: def resolve_package_path(repo_root: Path, repo: dict[str, Any]) -> Path:
 48:     package_name = str(repo.get("package_name", "")).strip()
 49:     explicit_path = str(repo.get("package_path", "")).strip()
 50:     if explicit_path:
 51:         path = Path(explicit_path)
 52:         if path.is_absolute():
 53:             return path.resolve()
 54:         return (repo_root / path).resolve()
 55:     return (repo_root / "node_modules" / package_name).resolve()
 56: def validate(registry: dict[str, Any], strict: bool, repo_root: Path) -> ValidationResult:
 57:     errors: list[str] = []
 58:     warnings: list[str] = []
 59:     registry_mode = str(registry.get("registry_mode", "enterprise")).strip().lower() or "enterprise"
 60:     repos = registry.get("repos")
 61:     if not isinstance(repos, list):
 62:         return ValidationResult(errors=["Registry must define a repos list."], warnings=[])
 63:     if not repos:
 64:         if registry_mode == "template":
 65:             warnings.append("Template registry has no repos yet.")
 66:             return ValidationResult(errors=[], warnings=warnings)
 67:         return ValidationResult(errors=["Registry must define a non-empty repos list."], warnings=[])
 68:     schema_version = str(registry.get("schema_version", "1.0"))
 69:     is_v2 = schema_version >= "2.0"
 70:     governance = registry.get("governance", {}) if isinstance(registry.get("governance", {}), dict) else {}
 71:     repo_name_prefix = str(governance.get("repo_name_prefix", "mcpee-")).strip() or "mcpee-"
 72:     names: set[str] = set()
 73:     graph: dict[str, list[str]] = {}
 74:     for repo in repos:
 75:         if not isinstance(repo, dict):
 76:             errors.append("Each repo entry must be an object.")
 77:             continue
 78:         name = str(repo.get("name", "")).strip()
 79:         if not name:
 80:             errors.append("Repo is missing required field: name")
 81:             continue
 82:         if strict or is_v2:
 83:             if not name.startswith(repo_name_prefix):
 84:                 errors.append(
 85:                     f"Repo '{name}' does not satisfy naming contract. Expected prefix '{repo_name_prefix}'."
 86:                 )
 87:         if name in names:
 88:             errors.append(f"Duplicate repo name: {name}")
 89:             continue
 90:         names.add(name)
 91:         for field in ("domain", "type"):
 92:             if not str(repo.get(field, "")).strip():
 93:                 errors.append(f"Repo '{name}' is missing required field: {field}")
 94:         repo_type = str(repo.get("type", "")).strip().lower()
 95:         if repo_type != "npm":
 96:             errors.append(f"Repo '{name}' type must be 'npm'.")
 97:         package_name = str(repo.get("package_name", "")).strip()
 98:         if not package_name:
 99:             errors.append(f"Repo '{name}' is missing required field: package_name")
100:         elif not re.match(r"^(@[A-Za-z0-9._-]+/[A-Za-z0-9._-]+|[A-Za-z0-9._-]+)$", package_name):
101:             errors.append(f"Repo '{name}' package_name is not a valid npm package name: {package_name}")
102:         resolved_package_path = resolve_package_path(repo_root, repo)
103:         if not resolved_package_path.exists():
104:             if bool(repo.get("optional", False)):
105:                 warnings.append(f"Optional repo '{name}' npm package is not installed: {resolved_package_path}")
106:             else:
107:                 errors.append(f"Repo '{name}' npm package is not installed: {resolved_package_path}")
108:         elif not (resolved_package_path / "mcpee.json").exists():
109:             if bool(repo.get("optional", False)):
110:                 warnings.append(f"Optional repo '{name}' package has no mcpee.json: {resolved_package_path}")
111:             else:
112:                 errors.append(f"Repo '{name}' package has no mcpee.json: {resolved_package_path}")
113:         deps = repo.get("dependencies", [])
114:         dep_refs: list[str] = []
115:         if deps:
116:             if not isinstance(deps, list):
117:                 errors.append(f"Repo '{name}' dependencies must be a list.")
118:             else:
119:                 for dep in deps:
120:                     if not isinstance(dep, dict) or not str(dep.get("ref", "")).strip():
121:                         errors.append(f"Repo '{name}' has a dependency without ref.")
122:                         continue
123:                     dep_refs.append(str(dep["ref"]))
124:         graph[name] = dep_refs
125:         if strict or is_v2:
126:             approval = repo.get("approval")
127:             if not isinstance(approval, dict):
128:                 errors.append(f"Repo '{name}' requires approval block in v2/strict mode.")
129:             else:
130:                 if approval.get("status") != "approved":
131:                     errors.append(f"Repo '{name}' is not approved (approval.status must be 'approved').")
132:                 if not str(approval.get("approved_by", "")).strip():
133:                     errors.append(f"Repo '{name}' missing approval.approved_by")
134:                 if not str(approval.get("approved_date", "")).strip():
135:                     errors.append(f"Repo '{name}' missing approval.approved_date")
136:                 if not str(approval.get("review_ticket", "")).strip():
137:                     warnings.append(f"Repo '{name}' missing approval.review_ticket")
138:     for src, dep_refs in graph.items():
139:         for dep in dep_refs:
140:             if dep not in names:
141:                 errors.append(f"Repo '{src}' depends on unknown repo '{dep}'.")
142:     # Cycle detection via DFS colors: 0=unseen, 1=visiting, 2=done
143:     state: dict[str, int] = {name: 0 for name in names}
144:     def visit(node: str) -> None:
145:         if state[node] == 1:
146:             errors.append(f"Dependency cycle detected at '{node}'.")
147:             return
148:         if state[node] == 2:
149:             return
150:         state[node] = 1
151:         for nxt in graph.get(node, []):
152:             if nxt in state:
153:                 visit(nxt)
154:         state[node] = 2
155:     for name in names:
156:         visit(name)
157:     return ValidationResult(errors=errors, warnings=warnings)
158: def write_report(
159:     path: Path,
160:     registry_path: Path,
161:     registry_mode: str,
162:     schema_version: str,
163:     strict: bool,
164:     result: ValidationResult,
165:     repos_count: int,
166: ) -> None:
167:     report = {
168:         "timestamp": utc_now(),
169:         "registry_path": str(registry_path).replace("\\", "/"),
170:         "registry_mode": str(registry_mode),
171:         "schema_version": schema_version,
172:         "strict_mode": strict,
173:         "repos_count": repos_count,
174:         "errors_count": len(result.errors),
175:         "warnings_count": len(result.warnings),
176:         "errors": result.errors,
177:         "warnings": result.warnings,
178:     }
179:     path.parent.mkdir(parents=True, exist_ok=True)
180:     path.write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
181: def main() -> int:
182:     parser = argparse.ArgumentParser(description="Validate repo-registry with strict governance checks.")
183:     parser.add_argument("--registry", default="repo-registry/repos.yml", help="Registry file path")
184:     parser.add_argument("--strict", action="store_true", help="Enable strict governance checks")
185:     args = parser.parse_args()
186:     repo_root = Path(__file__).resolve().parents[2]
187:     registry_path = (repo_root / args.registry).resolve()
188:     if not registry_path.exists():
189:         print(f"Missing registry file: {registry_path}")
190:         return 1
191:     try:
192:         registry = load_registry(registry_path)
193:     except Exception as exc:
194:         print(f"Failed to parse registry file: {exc}")
195:         return 1
196:     registry_mode = str(registry.get("registry_mode", "enterprise")).strip().lower() or "enterprise"
197:     schema_version = str(registry.get("schema_version", "1.0"))
198:     repos_count = len(registry.get("repos", [])) if isinstance(registry.get("repos", []), list) else 0
199:     result = validate(registry=registry, strict=args.strict, repo_root=repo_root)
200:     report_path = repo_root / "repo-intake/generated/reports/repo-registry-validation.json"
201:     write_report(
202:         path=report_path,
203:         registry_path=registry_path,
204:         registry_mode=registry_mode,
205:         schema_version=schema_version,
206:         strict=args.strict,
207:         result=result,
208:         repos_count=repos_count,
209:     )
210:     if result.errors:
211:         print("Repo registry validation failed.")
212:         for err in result.errors:
213:             print(f"- {err}")
214:         print(f"Report: {report_path}")
215:         return 1
216:     print("Repo registry validation OK.")
217:     if result.warnings:
218:         print("Warnings:")
219:         for warn in result.warnings:
220:             print(f"- {warn}")
221:     print(f"Report: {report_path}")
222:     return 0
223: if __name__ == "__main__":
224:     raise SystemExit(main())
