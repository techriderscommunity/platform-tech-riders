<file path="scripts/intake/run-repo-intake.ps1">
 1: param(
 2: 	[switch]$WarnOnly
 3: )
 4: 
 5: Set-StrictMode -Version Latest
 6: $ErrorActionPreference = "Stop"
 7: 
 8: $repoRoot = (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path
 9: Set-Location $repoRoot
10: 
11: $registryPath = Join-Path $repoRoot 'repo-registry\repos.yml'
12: if (-not (Test-Path $registryPath)) {
13: 	Write-Error "Missing repo registry: $registryPath. Run .\\scripts\\intake\\init-template-registry.cmd first."
14: 	exit 1
15: }
16: 
17: $registryRaw = Get-Content -Raw -Path $registryPath
18: $registry = $registryRaw | ConvertFrom-Json -Depth 20
19: $registryMode = 'enterprise'
20: if (($registry.PSObject.Properties.Name -contains 'registry_mode') -and [string]::IsNullOrWhiteSpace([string]$registry.registry_mode) -eq $false) {
21: 	$registryMode = [string]$registry.registry_mode
22: }
23: 
24: $repos = @()
25: if (($registry.PSObject.Properties.Name -contains 'repos') -and $null -ne $registry.repos) {
26: 	$repos = @($registry.repos)
27: }
28: 
29: if ($registryMode -eq 'template') {
30: 	Write-Host "Validating repo registry (template mode)..."
31: 	pwsh -NoProfile -ExecutionPolicy Bypass -File .\scripts\intake\validate-repo-registry.ps1
32: }
33: else {
34: 	Write-Host "Validating repo registry (strict mode)..."
35: 	pwsh -NoProfile -ExecutionPolicy Bypass -File .\scripts\intake\validate-repo-registry.ps1 -Strict
36: }
37: if ($LASTEXITCODE -ne 0) {
38: 	if ($WarnOnly) {
39: 		Write-Warning "Repo registry validation failed. Continuing because WarnOnly is enabled."
40: 		exit 0
41: 	}
42: 	Write-Error "Repo registry validation failed. Aborting intake generation."
43: 	exit $LASTEXITCODE
44: }
45: 
46: Write-Host "Running repo intake generation..."
47: python .\scripts\intake\repo-intake.py
48: if ($LASTEXITCODE -ne 0) {
49: 	if ($WarnOnly) {
50: 		Write-Warning "Repo intake generation failed. Continuing because WarnOnly is enabled."
51: 		exit 0
52: 	}
53: 	Write-Error "Repo intake generation failed."
54: 	exit $LASTEXITCODE
55: }
56: 
57: if ($registryMode -eq 'template' -and $repos.Count -eq 0) {
58: 	Write-Host "Template registry is empty. Intake reports were generated with 0 repositories."
59: 	Write-Host "Edit repo-registry\\repos.yml and rerun .\\scripts\\intake\\run-repo-intake.cmd when you add repos."
60: }
61: 
62: Write-Host "Repo intake completed."
</file>

<file path="scripts/intake/run-routing-evals.py">
  1: from __future__ import annotations
  2: import argparse
  3: import json
  4: import subprocess
  5: import sys
  6: from datetime import datetime, timezone
  7: from pathlib import Path
  8: from typing import Any
  9: def utc_now() -> str:
 10:     return datetime.now(timezone.utc).isoformat()
 11: def load_cases(path: Path) -> list[dict[str, Any]]:
 12:     data = json.loads(path.read_text(encoding="utf-8"))
 13:     cases = data.get("cases", [])
 14:     if not isinstance(cases, list):
 15:         return []
 16:     return [c for c in cases if isinstance(c, dict)]
 17: def parse_event_ids(path: Path) -> set[str]:
 18:     if not path.exists():
 19:         return set()
 20:     ids: set[str] = set()
 21:     for line in path.read_text(encoding="utf-8").splitlines():
 22:         line = line.strip()
 23:         if not line:
 24:             continue
 25:         try:
 26:             obj = json.loads(line)
 27:         except Exception:
 28:             continue
 29:         if not isinstance(obj, dict):
 30:             continue
 31:         event_id = str(obj.get("event_id", "")).strip()
 32:         if event_id:
 33:             ids.add(event_id)
 34:     return ids
 35: def run_case(repo_root: Path, case: dict[str, Any], routing_log: Path) -> tuple[bool, str, str | None]:
 36:     before_ids = parse_event_ids(routing_log)
 37:     cmd = [
 38:         sys.executable,
 39:         str((repo_root / "scripts/intake/resolve-routing.py").resolve()),
 40:         "--input",
 41:         str(case.get("input", "")),
 42:         "--intent",
 43:         str(case.get("intent", "")),
 44:         "--domain",
 45:         str(case.get("domain", "")),
 46:         "--source-type",
 47:         str(case.get("source_type", "technical-docs")),
 48:         "--capability",
 49:         str(case.get("capability", "")),
 50:     ]
 51:     proc = subprocess.run(cmd, cwd=str(repo_root), capture_output=True, text=True)
 52:     output = (proc.stdout or "") + (proc.stderr or "")
 53:     event_id: str | None = None
 54:     after_ids = parse_event_ids(routing_log)
 55:     new_ids = after_ids - before_ids
 56:     if new_ids:
 57:         event_id = sorted(new_ids)[-1]
 58:     return proc.returncode == 0, output, event_id
 59: def record_feedback(repo_root: Path, event_id: str, case_id: str) -> tuple[bool, str]:
 60:     cmd = [
 61:         sys.executable,
 62:         str((repo_root / "scripts/learning/record-learning-feedback.py").resolve()),
 63:         "--event-id",
 64:         event_id,
 65:         "--success",
 66:         "true",
 67:         "--confidence",
 68:         "0.95",
 69:         "--source",
 70:         "ci",
 71:         "--notes",
 72:         f"routing-eval-pass:{case_id}",
 73:     ]
 74:     proc = subprocess.run(cmd, cwd=str(repo_root), capture_output=True, text=True)
 75:     output = (proc.stdout or "") + (proc.stderr or "")
 76:     return proc.returncode == 0, output
 77: def main() -> int:
 78:     parser = argparse.ArgumentParser(description="Run routing eval cases and write JSON report.")
 79:     parser.add_argument("--cases", default="observability/evals/routing-eval-cases.json")
 80:     parser.add_argument("--report", default="observability/evals/routing-eval-report.json")
 81:     args = parser.parse_args()
 82:     repo_root = Path(__file__).resolve().parents[2]
 83:     routing_log = (repo_root / "observability/logs/routing-decisions.jsonl").resolve()
 84:     cases_path = (repo_root / args.cases).resolve()
 85:     if not cases_path.exists():
 86:         print(f"Missing eval cases file: {cases_path}")
 87:         return 1
 88:     cases = load_cases(cases_path)
 89:     results: list[dict[str, Any]] = []
 90:     passed = 0
 91:     for case in cases:
 92:         ok, output, event_id = run_case(repo_root, case, routing_log)
 93:         feedback_ok = False
 94:         feedback_output = ""
 95:         case_id = str(case.get("id", "unknown"))
 96:         if ok and event_id:
 97:             feedback_ok, feedback_output = record_feedback(repo_root, event_id, case_id)
 98:         if ok:
 99:             passed += 1
100:         results.append(
101:             {
102:                 "id": case_id,
103:                 "ok": ok,
104:                 "event_id": event_id,
105:                 "feedback_recorded": feedback_ok,
106:                 "feedback_output": feedback_output,
107:                 "output": output,
108:             }
109:         )
110:     report = {
111:         "timestamp": utc_now(),
112:         "cases_total": len(cases),
113:         "cases_passed": passed,
114:         "cases_failed": len(cases) - passed,
115:         "results": results,
116:     }
117:     report_path = (repo_root / args.report).resolve()
118:     report_path.parent.mkdir(parents=True, exist_ok=True)
119:     report_path.write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
120:     print(f"Routing evals completed: {passed}/{len(cases)} passed")
121:     print(f"Report: {report_path}")
122:     return 0 if passed == len(cases) else 1
123: if __name__ == "__main__":
124:     raise SystemExit(main())
</file>

<file path="scripts/intake/validate-database-routing.py">
 1: from __future__ import annotations
 2: """Validate database routing spec requirements.
 3: Assertions:
 4:   1. intent=sql with domain=dba selects agent=dba.
 5:   2. An event with no resolvable source declares grounded=false.
 6: Exit 0 = pass.  Exit 1 = fail.
 7: """
 8: import json
 9: import subprocess
10: import sys
11: from pathlib import Path
12: REPO_ROOT = Path(__file__).resolve().parents[2]
13: RESOLVE_SCRIPT = REPO_ROOT / "scripts" / "intake" / "resolve-routing.py"
14: def run_routing(**kwargs: str) -> dict:
15:     cmd = [sys.executable, str(RESOLVE_SCRIPT)]
16:     for k, v in kwargs.items():
17:         cmd += [f"--{k.replace('_', '-')}", v]
18:     # Use utf-8 encoding and errors='replace' to handle non-ASCII chars
19:     proc = subprocess.run(
20:         cmd,
21:         cwd=str(REPO_ROOT),
22:         capture_output=True,
23:         text=True,
24:         encoding="utf-8",
25:         errors="replace"
26:     )
27:     # Output can include telemetry lines after the main event JSON.
28:     # Decode only the first valid JSON object from stdout.
29:     stdout = proc.stdout or ""
30:     brace = stdout.find("{")
31:     if brace == -1:
32:         raise ValueError(f"No JSON in output: {stdout[:200]}")
