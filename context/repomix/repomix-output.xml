<file path="techito/src/app/features/intranet/fp-tour/calendar-eventos.html">
 1: <div class="calendar-eventos">
 2:   <!-- Header -->
 3:   <div class="calendar-header">
 4:     <div class="header-top">
 5:       <h2>{{ context().title }}</h2>
 6:       <p class="subtitle">{{ context().subtitle }}</p>
 7:     </div>
 8:     <!-- Controles -->
 9:     <div class="controls">
10:       <app-ui-button class="btn-nav" (click)="mesAnterior()">◀ Anterior</app-ui-button>
11:       <span class="mes-actual">{{ mesActual() }}</span>
12:       <app-ui-button class="btn-nav" (click)="mesSiguiente()">Siguiente ▶</app-ui-button>
13:     </div>
14:   <!-- Estadísticas -->
15:     <div class="stats-row">
16:       <div class="stat">
17:         <span>Total Eventos</span>
18:         <p>{{ totalEventos() }}</p>
19:       </div>
20:       <div class="stat">
21:         <span>Sesiones Este Mes</span>
22:         <p>{{ sesionesEstesMes() }}</p>
23:       </div>
24:     </div>
25:   </div>
26:   <!-- Estado: Cargando -->
27:   @if (loading()) {
28:   <div class="feedback loading">⏳ Cargando calendario...</div>
29:   }
30:   <!-- Estado: Error -->
31:   @if (error()) {
32:   <div class="feedback error">{{ error() }}</div>
33:   }
34:   <!-- Calendario: Sesiones por Día -->
35:   @if (!loading() && !error()) {
36:   <div class="calendario-sesiones">
37:     <!-- Título explicativo -->
38:     <div class="timeline-legend">
39:       <p>📅 <strong>{{ context().legend }}</strong> — Cada fila es un día, bloques horizontales = sesiones organizadas por hora</p>
40:     </div>
41:     <!-- Cada día con sus sesiones -->
42:     @for (dia of eventosAgrupados(); track dia.fecha) {
43:     <div class="dia-sesiones">
44:       <!-- Encabezado del día -->
45:       <div class="dia-header">
46:         <span class="fecha-badge">
47:           {{ dia.fecha | date:'EEE, d MMM yyyy':undefined:'es' }}
48:         </span>
49:       </div>
50:       <!-- Sesiones en este día -->
51:       <div class="dia-eventos">
52:         <!-- Línea de referencia horaria -->
53:         <div class="timeline-ref">
54:           @for (hora of [0, 3, 6, 9, 12, 15, 18, 21]; track hora) {
55:           <div class="hora-marker" [style.left.%]="(hora / 24) * 100">
56:             <span>{{ hora }}:00</span>
57:           </div>
58:           }
59:         </div>
60:         <!-- Bloques de sesiones -->
61:         <div class="sesiones-fila">
62:           @for (sesionEnCarril of dia.sesionesEnCarril; track sesionEnCarril.sesion.id) {
63:           <div class="sesion-bloque"
64:             [style.left.%]="sesionEnCarril.posicionX"
65:             [style.width.%]="sesionEnCarril.ancho"
66:             [style.top]="(sesionEnCarril.carril * 70) + 'px'"
67:             [style.backgroundColor]="getColorCategoria(sesionEnCarril.evento.categoria)"
68:             [style.borderColor]="getColorCategoriaBorde(sesionEnCarril.evento.categoria)"
69:             [title]="sesionEnCarril.sesion.titulo + ' (' + sesionEnCarril.sesion.horaInicio + '-' + sesionEnCarril.sesion.horaFin + ')'">
70:             <div class="sesion-contenido">
71:               <h4>{{ sesionEnCarril.sesion.titulo }}</h4>
72:               <p class="hora">⏰ {{ sesionEnCarril.sesion.horaInicio }} - {{ sesionEnCarril.sesion.horaFin }}</p>
73:               @if (sesionEnCarril.sesion.ponente) {
74:               <p class="ponente">🎤 {{ sesionEnCarril.sesion.ponente }}</p>
75:               }
76:               @if (sesionEnCarril.sesion.sala) {
77:               <p class="sala">🚪 {{ sesionEnCarril.sesion.sala }}</p>
78:               }
79:               <p class="evento-padre">📌 {{ sesionEnCarril.evento.titulo }}</p>
80:             </div>
81:           </div>
82:           }
83:         </div>
84:       </div>
85:     </div>
86:     }
87:     <!-- Estado: Sin sesiones este mes -->
88:     @if (eventosAgrupados().length === 0) {
89:     <div class="empty-state">
90:       <h3>📭 No hay sesiones registradas</h3>
91:       <p>Crea un evento con sesiones para que aparezcan en el calendario.</p>
92:     </div>
93:     }
94:   </div>
95:   }
96: </div>
</file>

