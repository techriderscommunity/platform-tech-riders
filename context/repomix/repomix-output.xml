<file path="techito/src/app/features/calendario-publico/services/public-events.service.ts">
 1: import { Injectable, inject } from '@angular/core';
 2: import { HttpClient } from '@angular/common/http';
 3: import { map, Observable } from 'rxjs';
 4: import { environment } from '@env/environment';
 5: import { EventApiDto } from '../models/public-events-api.models';
 6: import {
 7:   PublicEvent,
 8:   PublicEventModality,
 9:   PublicEventTopic,
10:   PublicEventType,
11: } from '../models/public-event.model';
12: @Injectable({ providedIn: 'root' })
13: export class PublicEventsService {
14:   private readonly http = inject(HttpClient);
15:   private readonly baseUrl = `${environment.apiUrl}/events/next`;
16:   getUpcomingEvents(): Observable<PublicEvent[]> {
17:     return this.http.get<EventApiDto[]>(this.baseUrl).pipe(
18:       map((events) => (events ?? []).map((event) => this.mapToPublicEvent(event)))
19:     );
20:   }
21:   private mapToPublicEvent(event: EventApiDto): PublicEvent {
22:     const title = this.getString(event.Name ?? event.name, 'Evento sin titulo');
23:     const summary = this.getString(event.Description ?? event.description, 'Sin descripcion disponible.');
24:     const place = this.getString(event.Location ?? event.location, 'Por confirmar');
25:     const startDate = this.getString(event.StartDate ?? event.startDate, '');
26:     const combinedText = `${title} ${summary} ${place}`.toLowerCase();
27:     return {
28:       title,
29:       summary,
30:       type: this.inferType(combinedText),
31:       modality: this.inferModality(combinedText),
32:       topic: this.inferTopic(combinedText),
33:       date: this.toIsoDate(startDate),
34:       place,
35:       url: '/events',
36:     };
37:   }
38:   private toIsoDate(dateText: string): string {
39:     if (!dateText) {
40:       return '';
41:     }
42:     return dateText.substring(0, 10);
43:   }
44:   private inferType(text: string): PublicEventType {
45:     if (text.includes('podcast')) return 'Podcast';
46:     if (text.includes('workshop') || text.includes('taller')) return 'Workshop';
47:     if (text.includes('woman tech') || text.includes('women tech')) return 'Woman Tech';
48:     if (text.includes('empleo') || text.includes('cv') || text.includes('entrevista')) return 'Empleabilidad';
49:     if (text.includes('orienta') || text.includes('itinerario') || text.includes('carrera')) return 'Orientacion';
50:     return 'Sesion tecnica';
51:   }
52:   private inferModality(text: string): PublicEventModality {
53:     if (text.includes('streaming') || text.includes('online') || text.includes('remoto')) return 'Online';
54:     if (text.includes('hibrid') || text.includes('híbrido')) return 'Hibrido';
55:     return 'Presencial';
56:   }
57:   private inferTopic(text: string): PublicEventTopic {
58:     if (text.includes('azure')) return 'Azure';
59:     if (text.includes('.net') || text.includes('dotnet') || text.includes('api')) return '.NET';
60:     if (text.includes('dato') || text.includes('data')) return 'Datos';
61:     if (text.includes('ciber') || text.includes('owasp') || text.includes('seguridad')) return 'Ciberseguridad';
62:     if (text.includes('soft skill') || text.includes('comunicacion') || text.includes('feedback')) return 'Soft Skills';
63:     if (text.includes('empleo') || text.includes('career') || text.includes('carrera')) return 'Carrera';
64:     return 'Comunidad';
65:   }
66:   private getString(value: string | null | undefined, fallback: string): string {
67:     const text = (value ?? '').trim();
68:     return text.length > 0 ? text : fallback;
69:   }
70: }
</file>

