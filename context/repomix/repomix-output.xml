  6: using TechRiders.Infrastructure.Data;
  7: namespace TechRiders.Api.Controllers;
  8: [ApiController]
  9: [Route("api/[controller]")]
 10: [Produces("application/json")]
 11: public sealed class AuthController : BaseApiController
 12: {
 13:     private readonly TechRidersDbContext _dbContext;
 14:     private readonly IConfiguration _configuration;
 15:     public AuthController(TechRidersDbContext dbContext, IConfiguration configuration)
 16:     {
 17:         _dbContext = dbContext;
 18:         _configuration = configuration;
 19:     }
 20:     [HttpPost("register")]
 21:     [AllowAnonymous]
 22:     [ProducesResponseType(typeof(RegisterResponse), StatusCodes.Status200OK)]
 23:     [ProducesResponseType(StatusCodes.Status400BadRequest)]
 24:     public async Task<ActionResult<RegisterResponse>> Register([FromBody] RegisterRequest request, CancellationToken cancellationToken)
 25:     {
 26:         if (!ModelState.IsValid)
 27:         {
 28:             return ValidationProblem(ModelState);
 29:         }
 30:         try
 31:         {
 32:             var user = await LocalAuthService.RegisterAsync(
 33:                 _dbContext,
 34:                 request.Nickname,
 35:                 request.Name,
 36:                 request.LastName,
 37:                 request.Email,
 38:                 request.Password,
 39:                 cancellationToken);
 40:             var profile = LocalAuthService.BuildUserProfile(user);
 41:             var token = LocalAuthService.CreateToken(user, _configuration);
 42:             return Ok(new RegisterResponse
 43:             {
 44:                 Token = token,
 45:                 Message = "Cuenta creada correctamente.",
 46:                 Email = user.Email,
 47:                 User = new LocalUserProfile
 48:                 {
 49:                     Id = profile.Id,
 50:                     Email = profile.Email,
 51:                     Name = profile.Name,
 52:                     Role = profile.Role,
 53:                     Roles = profile.Roles
 54:                 }
 55:             });
 56:         }
 57:         catch (InvalidOperationException ex)
 58:         {
 59:             return BadRequest(new { message = ex.Message });
 60:         }
 61:         catch (ArgumentException ex)
 62:         {
 63:             return BadRequest(new { message = ex.Message });
 64:         }
 65:     }
 66:     [HttpPost("login")]
 67:     [AllowAnonymous]
 68:     [ProducesResponseType(typeof(LocalLoginResponse), StatusCodes.Status200OK)]
 69:     [ProducesResponseType(StatusCodes.Status401Unauthorized)]
 70:     public async Task<ActionResult<LocalLoginResponse>> Login([FromBody] LoginRequest request, CancellationToken cancellationToken)
 71:     {
 72:         if (!ModelState.IsValid)
 73:         {
 74:             return ValidationProblem(ModelState);
 75:         }
 76:         var user = await LocalAuthService.AuthenticateAsync(_dbContext, request.Email, request.Password, cancellationToken);
 77:         if (user is null)
 78:         {
 79:             return Unauthorized(new { message = "Credenciales inválidas." });
 80:         }
 81:         var profile = LocalAuthService.BuildUserProfile(user);
 82:         var token = LocalAuthService.CreateToken(user, _configuration);
 83:         return Ok(new LocalLoginResponse
 84:         {
 85:             Token = token,
 86:             User = new LocalUserProfile
 87:             {
 88:                 Id = profile.Id,
 89:                 Email = profile.Email,
 90:                 Name = profile.Name,
 91:                 Role = profile.Role,
 92:                 Roles = profile.Roles
 93:             }
 94:         });
 95:     }
 96:     [HttpPost("forgot-password")]
 97:     [AllowAnonymous]
 98:     [ProducesResponseType(typeof(ForgotPasswordResponse), StatusCodes.Status200OK)]
 99:     public async Task<ActionResult<ForgotPasswordResponse>> ForgotPassword([FromBody] ForgotPasswordRequest request, CancellationToken cancellationToken)
100:     {
101:         if (!ModelState.IsValid)
102:         {
103:             return ValidationProblem(ModelState);
104:         }
105:         var response = await LocalAuthService.RequestPasswordResetAsync(_dbContext, request.Email, cancellationToken);
106:         return Ok(response);
107:     }
108:     [HttpPost("reset-password")]
109:     [AllowAnonymous]
110:     [ProducesResponseType(StatusCodes.Status200OK)]
111:     [ProducesResponseType(StatusCodes.Status400BadRequest)]
112:     public async Task<ActionResult> ResetPassword([FromBody] ResetPasswordRequest request, CancellationToken cancellationToken)
113:     {
114:         if (!ModelState.IsValid)
115:         {
116:             return ValidationProblem(ModelState);
117:         }
118:         var success = await LocalAuthService.ResetPasswordAsync(_dbContext, request.Email, request.Token, request.NewPassword, cancellationToken);
119:         if (!success)
120:         {
121:             return BadRequest(new { message = "El token es inválido o ha expirado." });
122:         }
123:         return Ok(new { message = "Contraseña actualizada correctamente." });
124:     }
125: }
