 23:         if self._telemetry is None:
 24:             repo_root = Path(__file__).resolve().parents[2]
 25:             self._telemetry = build_telemetry_collector(repo_root)
 26:         return self._telemetry
 27:     def validate(self, wiki_nodes: Dict[str, Dict[str, Any]]) -> Dict[str, Any]:
 28:         collector = self._collector()
 29:         errors: List[Dict[str, Any]] = []
 30:         warnings: List[Dict[str, Any]] = []
 31:         info: List[Dict[str, Any]] = []
 32:         slug_registry: Dict[str, str] = {}
 33:         with collector.start_execution(operation="wiki-validator", session_id="autodocs"):
 34:             with collector.start_span(name="wiki.validate", kind="INTERNAL", attributes={"node_count": len(wiki_nodes)}):
 35:                 if not self.schema_path.exists():
 36:                     warnings.append(self._issue("schema", "schema_missing", "Schema file not found", "warning"))
 37:                     collector.record_event("WarningGenerated", {"warning": "schema_missing", "schema_path": str(self.schema_path)}, level="WARNING")
 38:                 for node_key, node in wiki_nodes.items():
 39:                     self._validate_required(node_key, node, errors)
 40:                     self._validate_kind(node_key, node, errors)
 41:                     self._validate_section(node_key, node, errors)
 42:                     self._validate_slug(node_key, node, slug_registry, errors)
 43:                     self._validate_sources(node_key, node, warnings)
 44:                     self._validate_summary(node_key, node, warnings)
 45:                     self._validate_relations(node_key, node, wiki_nodes, errors)
 46:                 quality_score = self._quality_score(total=len(wiki_nodes), errors=len(errors), warnings=len(warnings))
 47:                 info.append(self._issue("summary", "quality_score", f"quality_score={quality_score}", "info"))
 48:                 collector.record_metric("warning_count", float(len(warnings)), unit="count")
 49:                 collector.record_metric("error_count", float(len(errors)), unit="count")
 50:                 collector.record_metric("quality_score", float(quality_score), unit="score")
 51:                 collector.record_event(
 52:                     "MetricCalculated",
 53:                     {
 54:                         "node_count": len(wiki_nodes),
 55:                         "error_count": len(errors),
 56:                         "warning_count": len(warnings),
 57:                         "quality_score": quality_score,
 58:                     },
 59:                 )
 60:         signature = hashlib.sha256(
 61:             json.dumps(wiki_nodes, sort_keys=True, ensure_ascii=True, separators=(",", ":")).encode("utf-8")
 62:         ).hexdigest()
 63:         return {
 64:             "generated_at": f"sha256:{signature}",
 65:             "schema_path": "autodocs/schema/wiki-node.schema.json",
 66:             "summary": {
 67:                 "node_count": len(wiki_nodes),
 68:                 "error_count": len(errors),
 69:                 "warning_count": len(warnings),
 70:                 "info_count": len(info),
 71:                 "quality_score": quality_score,
 72:             },
 73:             "errors": errors,
 74:             "warnings": warnings,
 75:             "info": info,
 76:         }
 77:     def write_reports(self, json_path: Path, markdown_path: Path, report: Dict[str, Any]) -> None:
 78:         json_path.parent.mkdir(parents=True, exist_ok=True)
 79:         with json_path.open("w", encoding="utf-8") as handle:
 80:             json.dump(report, handle, indent=2, ensure_ascii=True)
 81:         markdown = self._render_markdown_report(report)
 82:         with markdown_path.open("w", encoding="utf-8") as handle:
 83:             handle.write(markdown)
 84:     def _validate_required(self, node_key: str, node: Dict[str, Any], errors: List[Dict[str, Any]]) -> None:
 85:         required = ["title", "slug", "kind", "summary", "source_refs", "navigation"]
 86:         for field in required:
 87:             value = node.get(field)
 88:             if value in (None, "", [], {}):
 89:                 errors.append(self._issue(node_key, "required", f"Missing required field: {field}", "error"))
 90:     def _validate_kind(self, node_key: str, node: Dict[str, Any], errors: List[Dict[str, Any]]) -> None:
 91:         kind = str(node.get("kind", "")).strip()
 92:         if kind and kind not in self.allowed_kinds:
 93:             errors.append(self._issue(node_key, "kind", f"Unsupported kind: {kind}", "error"))
 94:     def _validate_section(self, node_key: str, node: Dict[str, Any], errors: List[Dict[str, Any]]) -> None:
 95:         navigation = node.get("navigation", {}) if isinstance(node.get("navigation", {}), dict) else {}
 96:         section = str(navigation.get("section", "")).strip()
 97:         if section and section not in self.allowed_sections:
 98:             errors.append(self._issue(node_key, "section", f"Unsupported section: {section}", "error"))
 99:     def _validate_slug(
100:         self,
101:         node_key: str,
102:         node: Dict[str, Any],
103:         slug_registry: Dict[str, str],
104:         errors: List[Dict[str, Any]],
105:     ) -> None:
106:         slug = str(node.get("slug", "")).strip()
107:         if not slug:
108:             return
109:         owner = slug_registry.get(slug)
110:         if owner and owner != node_key:
111:             errors.append(self._issue(node_key, "slug_duplicate", f"Duplicate slug: {slug}", "error"))
112:             return
113:         slug_registry[slug] = node_key
114:     def _validate_sources(self, node_key: str, node: Dict[str, Any], warnings: List[Dict[str, Any]]) -> None:
115:         source_refs = node.get("source_refs", [])
116:         if not isinstance(source_refs, list) or not source_refs:
117:             warnings.append(self._issue(node_key, "sources", "Node has no source refs", "warning"))
118:     def _validate_summary(self, node_key: str, node: Dict[str, Any], warnings: List[Dict[str, Any]]) -> None:
119:         summary = str(node.get("summary", "")).strip()
120:         if len(summary) < 24:
121:             warnings.append(self._issue(node_key, "summary", "Summary is too short", "warning"))
122:     def _validate_relations(
123:         self,
124:         node_key: str,
125:         node: Dict[str, Any],
126:         wiki_nodes: Dict[str, Dict[str, Any]],
127:         errors: List[Dict[str, Any]],
128:     ) -> None:
129:         relations = node.get("relations", [])
130:         if not isinstance(relations, list):
131:             errors.append(self._issue(node_key, "relations", "Relations must be a list", "error"))
132:             return
133:         for relation in relations:
134:             if not isinstance(relation, dict):
135:                 errors.append(self._issue(node_key, "relations", "Relation must be an object", "error"))
136:                 continue
137:             target = str(relation.get("target", "")).strip()
138:             if target and target not in wiki_nodes:
139:                 errors.append(self._issue(node_key, "relation_target", f"Relation target not found: {target}", "error"))
140:     def _quality_score(self, total: int, errors: int, warnings: int) -> int:
141:         if total <= 0:
142:             return 100
143:         penalty = errors * 20 + warnings * 5
144:         score = max(0, 100 - penalty)
145:         return score
146:     def _issue(self, node: str, code: str, message: str, severity: str) -> Dict[str, str]:
147:         return {
148:             "node": node,
149:             "code": code,
150:             "severity": severity,
151:             "message": message,
152:         }
153:     def _render_markdown_report(self, report: Dict[str, Any]) -> str:
154:         summary = report.get("summary", {}) if isinstance(report.get("summary", {}), dict) else {}
155:         lines = [
156:             "# AutoDocs Validation Report",
157:             "",
158:             f"- generated_at: {report.get('generated_at', '')}",
159:             f"- schema_path: {report.get('schema_path', '')}",
160:             f"- node_count: {summary.get('node_count', 0)}",
161:             f"- error_count: {summary.get('error_count', 0)}",
162:             f"- warning_count: {summary.get('warning_count', 0)}",
163:             f"- quality_score: {summary.get('quality_score', 0)}",
164:             "",
165:         ]
166:         lines.extend(self._render_issue_block("Errors", report.get("errors", [])))
167:         lines.extend(self._render_issue_block("Warnings", report.get("warnings", [])))
168:         lines.extend(self._render_issue_block("Info", report.get("info", [])))
169:         return "\n".join(lines)
170:     def _render_issue_block(self, title: str, issues: Any) -> List[str]:
171:         lines = [f"## {title}", ""]
172:         if not isinstance(issues, list) or not issues:
173:             lines.append("- none")
174:             lines.append("")
175:             return lines
176:         for issue in issues:
177:             if not isinstance(issue, dict):
178:                 continue
179:             lines.append(f"- [{issue.get('severity', '')}] {issue.get('node', '')}: {issue.get('message', '')}")
180:         lines.append("")
181:         return lines
</file>

