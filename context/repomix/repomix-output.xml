  1: from __future__ import annotations
  2: """Validate security posture against security-policy.md.
  3: Checks:
  4:   1. security-policy.md exists and contains required rule keywords.
  5:   2. No secret-like patterns in observable artefacts (logs, snapshots, repomix output).
  6:   3. Routing events with hitl_required=true have a valid HITL structure.
  7: Exit 0 = all checks pass.  Exit 1 = one or more failures.
  8: """
  9: import json
 10: import re
 11: import sys
 12: from pathlib import Path
 13: # ---------------------------------------------------------------------------
 14: # Config
 15: # ---------------------------------------------------------------------------
 16: REPO_ROOT = Path(__file__).resolve().parents[2]
 17: SECURITY_POLICY_PATH = REPO_ROOT / "policies" / "security-policy.md"
 18: REQUIRED_POLICY_KEYWORDS = [
 19:     "secretos",
 20:     "tokens",
 21:     "credenciales",
 22:     "confirmacion",
 23:     "sensible",
 24: ]
 25: SECRET_PATTERN = re.compile(
 26:     r"""(?xi)
 27:     (?:
 28:         (?:api[_\-]?key|api[_\-]?secret|access[_\-]?token|auth[_\-]?token|
 29:            client[_\-]?secret|private[_\-]?key|password|passwd|
 30:            bearer\s+[a-z0-9\-._~+/]+=*)
 31:         \s*[=:]\s*['"]?[a-z0-9\-._~+/]{16,}['"]?
 32:     )
 33:     |
 34:     -----BEGIN\s+(?:RSA\s+)?PRIVATE\s+KEY-----
 35:     """,
 36:     re.IGNORECASE,
 37: )
 38: SCAN_PATHS = [
 39:     REPO_ROOT / "observability" / "logs",
 40:     REPO_ROOT / "context" / "repomix",
 41: ]
 42: ROUTING_LOG = REPO_ROOT / "observability" / "logs" / "routing-decisions.jsonl"
 43: # ---------------------------------------------------------------------------
 44: # Checks
 45: # ---------------------------------------------------------------------------
 46: def check_policy_exists() -> list[str]:
 47:     errors: list[str] = []
 48:     if not SECURITY_POLICY_PATH.exists():
 49:         errors.append(f"MISSING: {SECURITY_POLICY_PATH.relative_to(REPO_ROOT)}")
 50:         return errors
 51:     content = SECURITY_POLICY_PATH.read_text(encoding="utf-8").lower()
 52:     for kw in REQUIRED_POLICY_KEYWORDS:
 53:         if kw not in content:
 54:             errors.append(f"security-policy.md missing required keyword: '{kw}'")
 55:     return errors
 56: def check_no_secrets_in_artefacts() -> list[str]:
 57:     errors: list[str] = []
 58:     for base in SCAN_PATHS:
 59:         if not base.exists():
 60:             continue
 61:         for path in base.rglob("*"):
 62:             if not path.is_file():
 63:                 continue
 64:             # Skip binary files larger than 1 MB
 65:             if path.stat().st_size > 1_048_576:
 66:                 continue
 67:             try:
 68:                 text = path.read_text(encoding="utf-8", errors="ignore")
 69:             except Exception:
 70:                 continue
 71:             for m in SECRET_PATTERN.finditer(text):
 72:                 line_no = text[: m.start()].count("\n") + 1
 73:                 rel = path.relative_to(REPO_ROOT)
 74:                 errors.append(f"POTENTIAL SECRET at {rel}:{line_no} → {m.group()[:60]!r}")
 75:     return errors
 76: def check_hitl_events() -> list[str]:
 77:     errors: list[str] = []
 78:     if not ROUTING_LOG.exists():
 79:         return errors
 80:     for raw in ROUTING_LOG.read_text(encoding="utf-8").splitlines():
 81:         raw = raw.strip()
 82:         if not raw:
 83:             continue
 84:         try:
 85:             event = json.loads(raw)
 86:         except Exception:
 87:             continue
 88:         if not isinstance(event, dict):
 89:             continue
 90:         hitl = event.get("hitl")
 91:         if not isinstance(hitl, dict):
 92:             continue
 93:         required = hitl.get("required")
 94:         if required is not True:
 95:             continue
 96:         # High-risk events must declare an action (not "none")
 97:         action = str(hitl.get("action", "none")).lower()
 98:         if action == "none":
 99:             eid = event.get("event_id", "unknown")
100:             errors.append(f"Event {eid}: hitl.required=true but action='none' (HITL not routed)")
101:     return errors
102: # ---------------------------------------------------------------------------
103: # Runner
104: # ---------------------------------------------------------------------------
105: def main() -> int:
106:     all_errors: list[str] = []
107:     print("=== validate-security: checking security posture ===")
108:     policy_errors = check_policy_exists()
109:     if policy_errors:
110:         print("[FAIL] Policy check:")
111:         for e in policy_errors:
112:             print(f"  - {e}")
113:     else:
114:         print("[OK] security-policy.md present and contains required keywords")
115:     all_errors.extend(policy_errors)
116:     secret_errors = check_no_secrets_in_artefacts()
117:     if secret_errors:
118:         print("[FAIL] Secret scan:")
119:         for e in secret_errors:
120:             print(f"  - {e}")
121:     else:
122:         print("[OK] No secret-like patterns found in observable artefacts")
123:     all_errors.extend(secret_errors)
124:     hitl_errors = check_hitl_events()
125:     if hitl_errors:
126:         print("[FAIL] HITL routing check:")
127:         for e in hitl_errors:
128:             print(f"  - {e}")
129:     else:
130:         print("[OK] All high-risk routing events have valid HITL routing")
131:     all_errors.extend(hitl_errors)
132:     print()
133:     if all_errors:
134:         print(f"validate-security FAILED: {len(all_errors)} issue(s) found")
135:         return 1
136:     print("validate-security PASSED: all security checks OK")
137:     return 0
138: if __name__ == "__main__":
139:     raise SystemExit(main())
</file>

