<file path="techito/src/app/core/auth/auth.service.ts">
  1: import { Injectable, signal } from '@angular/core';
  2: import { HttpClient } from '@angular/common/http';
  3: import { Observable, map, tap } from 'rxjs';
  4: import { environment } from '@env/environment';
  5: export type AppRole =
  6:   | 'member'
  7:   | 'admin'
  8:   | 'superadmin'
  9:   | 'staff'
 10:   | 'coordinador'
 11:   | 'empresa'
 12:   | 'junior'
 13:   | 'colaborador'
 14:   | 'embajador'
 15:   | 'young-riders'
 16:   | 'centro';
 17: export interface UserProfile {
 18:   id: string;
 19:   email: string;
 20:   name: string;
 21:   role: AppRole;
 22:   roles: AppRole[];
 23: }
 24: export interface LoginResponse {
 25:   token: string;
 26:   user: UserProfile;
 27: }
 28: @Injectable({ providedIn: 'root' })
 29: export class AuthService {
 30:   private readonly baseUrl = environment.apiUrl;
 31:   private currentUser = signal<UserProfile | null>(null);
 32:   readonly userType = signal<AppRole | null>(null);
 33:   readonly user = this.currentUser.asReadonly();
 34:   readonly isAuthenticated = () => this.currentUser() !== null;
 35:   constructor(private http: HttpClient) {
 36:     this.loadUser();
 37:   }
 38:   login(email: string, password: string): Observable<LoginResponse> {
 39:     return this.http.post<unknown>(`${this.baseUrl}/auth/login`, { email, password })
 40:       .pipe(
 41:         map((response) => this.normalizeLoginResponse(response)),
 42:         tap((response) => this.persistSession(response)),
 43:       );
 44:   }
 45:   hasRole(required: AppRole | AppRole[]): boolean {
 46:     const user = this.currentUser();
 47:     if (!user) return false;
 48:     const requiredRoles = Array.isArray(required) ? required : [required];
 49:     const userRoles = user.roles?.length ? user.roles : [user.role];
 50:     return requiredRoles.some(requiredRole =>
 51:       userRoles.some(role => role === requiredRole)
 52:     );
 53:   }
 54:   getDefaultRoute(): string {
 55:     if (this.hasRole('superadmin')) return '/intranet/staff';
 56:     if (this.hasRole('staff') || this.hasRole('coordinador')) return '/intranet/staff';
 57:     if (this.hasRole('admin')) return '/intranet/admin';
 58:     if (this.hasRole('empresa')) return '/intranet/company';
 59:     if (this.hasRole(['embajador', 'colaborador'])) return '/intranet/ambassador/portal';
 60:     return '/intranet/junior';
 61:   }
 62:   logout(): void {
 63:     this.currentUser.set(null);
 64:     this.userType.set(null);
 65:     if (this.isBrowser()) {
 66:       localStorage.removeItem('token');
 67:       localStorage.removeItem('user');
 68:     }
 69:   }
 70:   private loadUser(): void {
 71:     if (!this.isBrowser()) return;
 72:     const userJson = localStorage.getItem('user');
 73:     if (userJson) {
 74:       const parsed = JSON.parse(userJson) as Partial<UserProfile>;
 75:       const normalized = this.normalizeUser(parsed);
 76:       this.currentUser.set(normalized);
 77:       this.userType.set(normalized.role);
 78:     }
 79:   }
 80:   private normalizeUser(user: Partial<UserProfile>): UserProfile {
 81:     const fallbackRole = (user.role ?? 'junior') as AppRole;
 82:     const normalizedRoles = (user.roles ?? [])
 83:       .filter((role): role is AppRole => !!role)
 84:       .map(role => role as AppRole);
 85:     if (!normalizedRoles.includes(fallbackRole)) {
 86:       normalizedRoles.push(fallbackRole);
 87:     }
 88:     return {
 89:       id: user.id ?? '',
 90:       email: user.email ?? '',
 91:       name: user.name ?? '',
 92:       role: this.resolvePrimaryRole(normalizedRoles),
 93:       roles: normalizedRoles,
 94:     };
 95:   }
 96:   private normalizeLoginResponse(response: unknown): LoginResponse {
 97:     const payload = (response ?? {}) as Partial<LoginResponse> & {
 98:       Token?: string;
 99:       User?: Partial<UserProfile> & {
100:         Id?: string;
101:         Email?: string;
102:         Name?: string;
103:         Role?: string;
104:         Roles?: Array<string | AppRole>;
105:       };
106:     };
107:     const token = (payload.token ?? payload.Token ?? '').toString();
108:     const user = {
109:       id: payload.user?.id ?? payload.User?.Id ?? '',
110:       email: payload.user?.email ?? payload.User?.Email ?? '',
111:       name: payload.user?.name ?? payload.User?.Name ?? '',
112:       role: (payload.user?.role ?? payload.User?.Role ?? 'junior') as AppRole,
113:       roles: (payload.user?.roles ?? payload.User?.Roles ?? []) as AppRole[],
114:     };
115:     return { token, user: this.normalizeUser(user) };
116:   }
117:   private persistSession(response: LoginResponse): void {
118:     const normalized = this.normalizeUser(response.user);
119:     this.currentUser.set(normalized);
120:     this.userType.set(normalized.role);
121:     if (this.isBrowser()) {
122:       localStorage.setItem('token', response.token);
123:       localStorage.setItem('user', JSON.stringify(normalized));
124:     }
125:   }
126:   private resolvePrimaryRole(roles: AppRole[]): AppRole {
127:     const priority: AppRole[] = ['superadmin', 'staff', 'coordinador', 'admin', 'empresa', 'junior', 'colaborador', 'embajador', 'member', 'young-riders', 'centro'];
128:     const matched = priority.find(role => roles.includes(role));
129:     return matched ?? 'junior';
130:   }
131:   private isBrowser(): boolean {
132:     return typeof localStorage !== 'undefined';
133:   }
134: }
</file>

