107: }
108: /* ===== TABLES ===== */
109: .table {
110:   width: 100%;
111:   border-collapse: collapse;
112:   border-spacing: 0;
113:   border: 1px solid var(--border-default);
114:   border-radius: var(--radius-lg);
115:   overflow: hidden;
116:   thead {
117:     background: var(--bg-secondary);
118:   }
119:   th,
120:   td {
121:     text-align: left;
122:     padding: var(--space-3);
123:     border-bottom: 1px solid var(--border-muted);
124:   }
125:   th {
126:     color: var(--text-primary);
127:     font-size: var(--font-size-sm);
128:     font-weight: var(--font-weight-bold);
129:     letter-spacing: 0.02em;
130:   }
131:   td {
132:     color: var(--text-secondary);
133:     font-size: var(--font-size-base);
134:     line-height: var(--line-height-normal);
135:   }
136:   tbody tr {
137:     transition: background-color var(--transition-fast);
138:     &:hover {
139:       background: var(--tr-blue-alpha-06);
140:     }
141:   }
142:   tbody tr:last-child td {
143:     border-bottom: none;
144:   }
145: }
146: .table-responsive {
147:   width: 100%;
148:   overflow-x: auto;
149: }
150: /* ===== FORM ELEMENTS ===== */
151: input[type="text"],
152: input[type="email"],
153: input[type="password"],
154: input[type="number"],
155: input[type="tel"],
156: input[type="url"],
157: textarea,
158: select {
159:   width: 100%;
160:   padding: var(--input-md-padding, var(--space-2) var(--space-3));
161:   border: 1px solid var(--border-default);
162:   border-radius: 4px;
163:   background-color: var(--input-background);
164:   color: var(--input-text-color);
165:   font-family: inherit;
166:   font-size: var(--font-size-base);
167:   min-height: var(--control-min-height);
168:   transition: all 0.2s ease;
169:   &::placeholder {
170:     color: var(--input-placeholder-color);
171:   }
172:   &:focus {
173:     outline: none;
174:     border-color: var(--tr-blue);
175:     box-shadow: 0 0 0 3px var(--tr-blue-alpha-10);
176:   }
177:   &:disabled {
178:     background-color: var(--bg-tertiary);
179:     opacity: 0.7;
180:   }
181: }
182: textarea {
183:   resize: vertical;
184:   min-height: 120px;
185: }
186: .form-group {
187:   margin-bottom: var(--space-4);
188:   display: flex;
189:   flex-direction: column;
190:   gap: var(--space-2);
191: }
192: label {
193:   font-size: var(--font-size-sm);
194:   font-weight: 500;
195:   color: var(--text-primary);
196: }
197: /* ===== UTILITIES ===== */
198: .flex {
199:   display: flex;
200:   &-col {
201:     flex-direction: column;
202:   }
203:   &-center {
204:     align-items: center;
205:     justify-content: center;
206:   }
207:   &-between {
208:     justify-content: space-between;
209:   }
210:   &-wrap {
211:     flex-wrap: wrap;
212:   }
213: }
214: .grid {
215:   display: grid;
216:   gap: var(--space-4);
217:   &-cols-2 {
218:     grid-template-columns: repeat(2, 1fr);
219:   }
220:   &-cols-3 {
221:     grid-template-columns: repeat(3, 1fr);
222:   }
223:   &-auto-fit {
224:     grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
225:   }
226:   @media (max-width: 768px) {
227:     &-cols-2,
228:     &-cols-3 {
229:       grid-template-columns: 1fr;
230:     }
231:   }
232: }
233: .container {
234:   width: 100%;
235:   max-width: var(--page-content-max);
236:   margin: 0 auto;
237:   padding: 0 var(--page-inline-padding);
238: }
239: .section {
240:   padding: var(--space-8) 0;
241: }
242: /* Spacing utilities */
243: .gap-1 { gap: var(--space-1); }
244: .gap-2 { gap: var(--space-2); }
245: .gap-3 { gap: var(--space-3); }
246: .gap-4 { gap: var(--space-4); }
247: .gap-6 { gap: var(--space-6); }
248: .gap-8 { gap: var(--space-8); }
249: .mt-1 { margin-top: var(--space-1); }
250: .mt-2 { margin-top: var(--space-2); }
251: .mt-3 { margin-top: var(--space-3); }
252: .mt-4 { margin-top: var(--space-4); }
253: .mt-6 { margin-top: var(--space-6); }
254: .mt-8 { margin-top: var(--space-8); }
255: .mb-1 { margin-bottom: var(--space-1); }
256: .mb-2 { margin-bottom: var(--space-2); }
257: .mb-3 { margin-bottom: var(--space-3); }
258: /* ===== STATE INDICATORS ===== */
259: @keyframes spin {
260:   from {
261:     transform: rotate(0deg);
262:   }
263:   to {
264:     transform: rotate(360deg);
265:   }
266: }
267: .is-loading {
268:   position: relative;
269:   pointer-events: none;
270:   opacity: 0.8;
271:   &::after {
272:     content: '';
273:     position: absolute;
274:     top: 50%;
275:     left: 50%;
276:     width: 16px;
277:     height: 16px;
278:     margin: -8px 0 0 -8px;
279:     border: 2px solid var(--tr-blue-alpha-20);
280:     border-top-color: var(--tr-blue);
281:     border-radius: 50%;
282:     animation: spin 0.8s linear infinite;
283:   }
284: }
285: .is-error {
286:   border-color: var(--accent-error) !important;
287:   background-color: rgba(229, 57, 53, 0.06);
288: }
289: .is-success {
290:   border-color: var(--accent-success) !important;
291:   background-color: rgba(0, 170, 68, 0.06);
292: }
293: input:readonly,
294: textarea:readonly,
295: select:readonly {
296:   background-color: var(--bg-tertiary);
297:   opacity: 0.7;
298: }
299: /* ===== ACCESSIBILITY ===== */
300: :focus-visible {
301:   outline: 3px solid var(--tr-blue);
302:   outline-offset: 2px;
303: }
304: @media (prefers-reduced-motion: reduce) {
305:   *,
306:   *::before,
307:   *::after {
308:     animation-duration: 0.01ms !important;
309:     animation-iteration-count: 1 !important;
310:     transition-duration: 0.01ms !important;
311:   }
312: }
313: @media (prefers-contrast: more) {
314:   :root {
315:     --border-default: rgba(0, 102, 204, 0.25);
316:   }
317:   input,
318:   textarea,
319:   select {
320:     border-width: 2px;
321:   }
322:   .btn {
323:     font-weight: 600;
324:     border-width: 2px;
325:   }
326: }
</file>

