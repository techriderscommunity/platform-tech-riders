<file path="techito/src/app/features/intranet/administracion/admin-configuracion.html">
 1: <div class="admin-configuracion">
 2:   <div class="page-header">
 3:     <a routerLink="/intranet" class="btn-back">← Volver a Intranet</a>
 4:     <h1>Administracion · Configuracion</h1>
 5:     <p>Parametros transversales de Intranet para categorias, estados y reglas operativas.</p>
 6:   </div>
 7:   <app-ui-metrics-strip [items]="configMetrics()"></app-ui-metrics-strip>
 8:   <section class="card">
 9:     <h2>Catalogo de configuracion</h2>
10:     @if (feedback()) {
11:     <p class="feedback">{{ feedback() }}</p>
12:     }
13:     @if (loading()) {
14:     <p>Cargando configuracion...</p>
15:     }
16:     @if (error()) {
17:     <p>{{ error() }}</p>
18:     }
19:     <div class="table-responsive">
20:     <table class="config-table">
21:       <thead>
22:         <tr>
23:           <th>Clave</th>
24:           <th>Modulo</th>
25:           <th>Valor</th>
26:           <th>Estado</th>
27:           <th>Accion</th>
28:         </tr>
29:       </thead>
30:       <tbody>
31:         @if (!loading() && items().length === 0) {
32:         <tr>
33:           <td colspan="5">No hay configuracion registrada.</td>
34:         </tr>
35:         }
36:         @for (item of items(); track item.key) {
37:         <tr>
38:           <td>{{ item.key }}</td>
39:           <td>
40:             <input
41:               class="table-input"
42:               type="text"
43:               [value]="item.modulo"
44:               (input)="updateModulo(item.key, $any($event.target).value)"
45:             />
46:           </td>
47:           <td>
48:             <input
49:               class="table-input"
50:               type="text"
51:               [value]="item.valor"
52:               (input)="updateValor(item.key, $any($event.target).value)"
53:             />
54:           </td>
55:           <td>
56:             <span class="badge" [class.revision]="item.estado === 'revision'">{{ item.estado }}</span>
57:           </td>
58:           <td>
59:             <div class="config-actions">
60:               <select
61:                 class="table-select"
62:                 [value]="item.estado"
63:                 (change)="updateEstado(item.key, $any($event.target).value)"
64:               >
65:                 <option value="activo">activo</option>
66:                 <option value="revision">revision</option>
67:               </select>
68:               <button type="button" class="save-btn" [disabled]="isSaving(item.key)" (click)="saveRow(item)">
69:                 {{ isSaving(item.key) ? 'Guardando...' : 'Guardar' }}
70:               </button>
71:             </div>
72:           </td>
73:         </tr>
74:         }
75:       </tbody>
76:     </table>
77:     </div>
78:   </section>
79: </div>
</file>

