129:     {
130:         var builder = await DistributedApplicationTestingBuilder
131:             .CreateAsync<Projects.AppHost>();
132: 
133:         await using var app = await builder.BuildAsync();
134:         await app.StartAsync();
135: 
136:         var client = app.CreateHttpClient("api");
137:         var response = await client.GetAsync("/products");
138: 
