<file path="techito/src/app/core/events/public-events.service.ts">
 1: import { HttpClient, HttpParams } from '@angular/common/http';
 2: import { Injectable, inject } from '@angular/core';
 3: import { environment } from '@env/environment';
 4: import { map } from 'rxjs/operators';
 5: import { EventoListApi, EventoResumen, PagedResult } from './public-events.models';
 6: const DEFAULT_EVENTO_RESUMEN_CATEGORIA = 'others';
 7: const EVENT_STATUS = {
 8:   active: 'Active',
 9:   inactive: 'Inactive',
10: } as const;
11: @Injectable({ providedIn: 'root' })
12: export class PublicEventsService {
13:   private readonly http = inject(HttpClient);
14:   private readonly baseUrl = `${environment.apiUrl}/events`;
15:   getEventos(page = 1, pageSize = 20) {
16:     const safePage = this.normalizePositiveInt(page, 1);
17:     const safePageSize = this.normalizePositiveInt(pageSize, 20);
18:     const params = new HttpParams()
19:       .set('page', String(safePage))
20:       .set('pageSize', String(safePageSize));
21:     return this.http
22:       .get<EventoListApi[]>(this.baseUrl, { params })
23:       .pipe(map((result) => ({
24:         items: (result ?? []).map((evento): EventoResumen => ({
25:           id: evento.Id,
26:           titulo: evento.Name,
