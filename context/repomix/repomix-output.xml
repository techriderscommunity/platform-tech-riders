197: function Convert-ToNullableDouble {
198:     param([string]$Value)
199: 
200:     if ([string]::IsNullOrWhiteSpace($Value)) {
201:         return $null
202:     }
203: 
204:     $normalized = $Value.Trim().Replace(',', '.')
205:     $parsed = 0.0
206:     if ([double]::TryParse($normalized, [System.Globalization.NumberStyles]::Float, [System.Globalization.CultureInfo]::InvariantCulture, [ref]$parsed)) {
207:         return [double]$parsed
208:     }
209: 
210:     return $null
211: }
