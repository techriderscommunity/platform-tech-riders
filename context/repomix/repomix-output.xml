 88: function Get-TokenMetricsFromText {
 89:     param([string]$Text)
 90: 
 91:     $prompt = Get-PatternSum -Text $Text -Pattern '(?:prompt_tokens|input_tokens)\s*[:=]\s*([0-9]+(?:[\.,][0-9]+)?)'
 92:     $context = Get-PatternSum -Text $Text -Pattern '(?:context_tokens)\s*[:=]\s*([0-9]+(?:[\.,][0-9]+)?)'
 93:     $response = Get-PatternSum -Text $Text -Pattern '(?:completion_tokens|output_tokens|response_tokens)\s*[:=]\s*([0-9]+(?:[\.,][0-9]+)?)'
 94:     $total = Get-PatternSum -Text $Text -Pattern '(?:total_tokens|tokens_total)\s*[:=]\s*([0-9]+(?:[\.,][0-9]+)?)'
 95:     $cost = Get-PatternSum -Text $Text -Pattern '(?:total_cost_usd|cost_estimated_usd|cost_usd|total_cost)\s*[:=]\s*([0-9]+(?:[\.,][0-9]+)?)'
 96: 
 97:     $source = 'logs'
 98:     $probeStatusMatch = [regex]::Match(($Text ?? ''), '(?:probe_status)\s*[:=]\s*([^\r\n]+)', [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
 99:     if ($probeStatusMatch.Success -and $probeStatusMatch.Groups.Count -gt 1) {
100:         $source = ('probe-' + $probeStatusMatch.Groups[1].Value.Trim())
101:     }
102: 
103:     # Compatibility with RAG CLI output format: "Tokens: 1234"
104:     if ($null -eq $total) {
105:         $tokensAlt = Get-PatternSum -Text $Text -Pattern '(?:Tokens)\s*:\s*([0-9]+(?:[\.,][0-9]+)?)'
106:         if ($null -ne $tokensAlt) {
107:             $total = $tokensAlt
108:         }
109:     }
110:     if ($null -eq $prompt -and $null -eq $context -and $null -eq $response -and $null -eq $total -and $null -eq $cost) {
111:         $source = 'logs-no-token-pattern'
112:         $total = 0
113:         $cost = 0
114:     }
115: 
116:     return [ordered]@{
117:         tokens_prompt = $prompt
118:         tokens_context = $context
119:         tokens_response = $response
120:         tokens_total = $total
121:         cost_estimated_usd = $cost
122:         source = $source
123:     }
124: }
