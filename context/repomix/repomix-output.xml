<file path="backend/TechRiders.Infrastructure/Repositories/AmbassadorRepository.cs">
  1: using Microsoft.EntityFrameworkCore;
  2: using TechRiders.Domain.Entities;
  3: using TechRiders.Domain.Interfaces;
  4: using TechRiders.Infrastructure.Data;
  5: namespace TechRiders.Infrastructure.Repositories;
  6: public class AmbassadorRepository : Repository<User>, IAmbassadorRepository
  7: {
  8:     private const string AmbassadorRoleName = "ambassador";
  9:     private const string AmbassadorRoleNameEs = "embajador";
 10:     public AmbassadorRepository(TechRidersDbContext context) : base(context) { }
 11:     public async Task<IEnumerable<User>> GetActiveAmbassadorsAsync(CancellationToken cancellationToken = default)
 12:     {
 13:         return await AmbassadorsQuery()
 14:             .OrderBy(u => u.LastName).ThenBy(u => u.Name)
 15:             .ToListAsync(cancellationToken);
 16:     }
 17:     public async Task<IEnumerable<User>> SearchAmbassadorsAsync(string searchTerm, CancellationToken cancellationToken = default)
 18:     {
 19:         if (string.IsNullOrWhiteSpace(searchTerm))
 20:         {
 21:             return await GetActiveAmbassadorsAsync(cancellationToken);
 22:         }
 23:         var normalized = searchTerm.Trim();
 24:         return await AmbassadorsQuery()
 25:             .Where(u => EF.Functions.Like(u.Name, $"%{normalized}%") ||
 26:                         EF.Functions.Like(u.LastName, $"%{normalized}%") ||
 27:                         EF.Functions.Like(u.Email, $"%{normalized}%") ||
 28:                         (u.Nickname != null && EF.Functions.Like(u.Nickname, $"%{normalized}%")))
 29:             .OrderBy(u => u.LastName).ThenBy(u => u.Name)
 30:             .ToListAsync(cancellationToken);
 31:     }
 32:     public async Task<IEnumerable<User>> GetAmbassadorsByCategoryAsync(int categoryId, CancellationToken cancellationToken = default)
 33:     {
 34:         var userIdsInCategory = _context.Set<IntranetUserCategory>()
 35:             .Where(uc => uc.Active && uc.CategoryId == categoryId)
 36:             .Select(uc => uc.UserId);
 37:         return await AmbassadorsQuery()
 38:             .Where(u => userIdsInCategory.Contains(u.Id))
 39:             .OrderBy(u => u.LastName).ThenBy(u => u.Name)
 40:             .ToListAsync(cancellationToken);
 41:     }
 42:     public async Task<IEnumerable<User>> GetWorkingAmbassadorsAsync(CancellationToken cancellationToken = default)
 43:     {
 44:         return await AmbassadorsQuery()
 45:             .Where(u => u.IsWorking)
 46:             .OrderBy(u => u.LastName).ThenBy(u => u.Name)
 47:             .ToListAsync(cancellationToken);
 48:     }
 49:     public async Task<User?> GetAmbassadorWithDetailsAsync(Guid ambassadorId, CancellationToken cancellationToken = default)
 50:     {
 51:         return await AmbassadorsQuery()
 52:             .FirstOrDefaultAsync(u => u.Id == ambassadorId, cancellationToken);
 53:     }
 54:     public async Task<bool> IsAmbassadorAsync(Guid userId, CancellationToken cancellationToken = default)
 55:     {
 56:         return await AmbassadorsQuery()
 57:             .AnyAsync(u => u.Id == userId, cancellationToken);
 58:     }
 59:     public async Task EnsureAmbassadorRoleAsync(User user, CancellationToken cancellationToken = default)
 60:     {
 61:         var ambassadorRole = await GetOrCreateAmbassadorRoleAsync(cancellationToken);
 62:         var hasRole = await _context.Set<UserRole>()
 63:             .AnyAsync(ur => ur.UserId == user.Id && ur.RoleId == ambassadorRole.Id, cancellationToken);
 64:         if (!hasRole)
 65:         {
 66:             await _context.Set<UserRole>().AddAsync(new UserRole
 67:             {
 68:                 UserId = user.Id,
 69:                 RoleId = ambassadorRole.Id
 70:             }, cancellationToken);
 71:         }
 72:     }
 73:     public async Task RemoveAmbassadorRoleAsync(Guid userId, CancellationToken cancellationToken = default)
 74:     {
 75:         var ambassadorRoleIds = await _context.Set<Role>()
 76:             .Where(r => r.Name.ToLower() == AmbassadorRoleName || r.Name.ToLower() == AmbassadorRoleNameEs)
 77:             .Select(r => r.Id)
 78:             .ToListAsync(cancellationToken);
 79:         if (ambassadorRoleIds.Count == 0)
 80:         {
 81:             return;
 82:         }
 83:         var userRoles = await _context.Set<UserRole>()
 84:             .Where(ur => ur.UserId == userId && ambassadorRoleIds.Contains(ur.RoleId))
 85:             .ToListAsync(cancellationToken);
 86:         if (userRoles.Count > 0)
 87:         {
 88:             _context.Set<UserRole>().RemoveRange(userRoles);
 89:         }
 90:     }
 91:     public async Task<int> CountActiveAmbassadorsAsync(CancellationToken cancellationToken = default)
 92:     {
 93:         return await AmbassadorsQuery().CountAsync(cancellationToken);
 94:     }
 95:     private IQueryable<User> AmbassadorsQuery()
 96:     {
 97:         return _dbSet
 98:             .Include(u => u.UserRoles)
 99:                 .ThenInclude(ur => ur.Role)
100:             .Include(u => u.UserCategories)
101:                 .ThenInclude(uc => uc.Category)
102:             .Where(u => u.IsActive &&
103:                         u.UserRoles.Any(ur => ur.Role.Name.ToLower() == AmbassadorRoleName ||
104:                                               ur.Role.Name.ToLower() == AmbassadorRoleNameEs));
105:     }
106:     private async Task<Role> GetOrCreateAmbassadorRoleAsync(CancellationToken cancellationToken)
107:     {
108:         var role = await _context.Set<Role>()
109:             .FirstOrDefaultAsync(r => r.Name.ToLower() == AmbassadorRoleName || r.Name.ToLower() == AmbassadorRoleNameEs, cancellationToken);
110:         if (role != null)
111:         {
112:             return role;
113:         }
114:         role = new Role
115:         {
116:             Id = Guid.NewGuid(),
117:             Name = "Ambassador",
118:             Description = "Users who represent the ambassador profile"
119:         };
120:         await _context.Set<Role>().AddAsync(role, cancellationToken);
121:         return role;
122:     }
123: }
</file>

