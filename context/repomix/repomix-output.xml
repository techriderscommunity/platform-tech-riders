<file path="techito/src/app/features/eventos/eventos.ts">
  1: import { ChangeDetectionStrategy, Component, DestroyRef, computed, inject, OnInit, signal } from '@angular/core';
  2: import { RouterLink } from '@angular/router';
  3: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
  4: import { catchError, EMPTY, tap } from 'rxjs';
  5: import { EventoResumen } from '@core/events/public-events.models';
  6: import { PublicEventsService } from '@core/events/public-events.service';
  7: import { PublicContentService } from '@core/content/public-content.service';
  8: import { GalleryGroupItem, ParticipationModeItem } from '@core/content/public-content.models';
  9: import { UiCarouselItem, UiMediaCarousel  } from '@shared/ui/media-carousel/media-carousel';
 10: import { UiMetricsStrip } from '@shared/ui/metrics-strip/metrics-strip';
 11: import { UiProgressCards } from '@shared/ui/progress-cards/progress-cards';
 12: import { PodcastService } from './services/podcast.service';
 13: @Component({
 14:   selector: 'app-eventos',
 15:   standalone: true,
 16:   changeDetection: ChangeDetectionStrategy.OnPush,
 17:   imports: [RouterLink, UiMediaCarousel, UiMetricsStrip, UiProgressCards],
 18:   templateUrl: './eventos.html',
 19:   styleUrl: './eventos.scss'
 20: })
 21: export class Eventos implements OnInit {
 22:   private readonly publicEventsService = inject(PublicEventsService);
 23:   private readonly publicContentService = inject(PublicContentService);
 24:   private readonly podcastService = inject(PodcastService);
 25:   private readonly destroyRef = inject(DestroyRef);
 26:   readonly eventos = signal<EventoResumen[]>([]);
 27:   readonly loadingEventos = signal(false);
 28:   readonly proximosEventos = computed(() => this.eventos().filter(evento => !evento.esPasado));
 29:   readonly eventosPasados = computed(() => this.eventos().filter(evento => evento.esPasado));
 30:   readonly totalEventos = computed(() => this.eventos().length);
 31:   readonly totalProximos = computed(() => this.proximosEventos().length);
 32:   readonly totalPasados = computed(() => this.eventosPasados().length);
 33:   readonly eventosMetrics = computed(() => [
 34:     { value: String(this.totalEventos()), label: 'Total publicados', icon: '📊' },
 35:     { value: String(this.totalProximos()), label: 'Próximos', icon: '📅' },
 36:     { value: String(this.totalPasados()), label: 'Histórico', icon: '🗂️' },
 37:   ]);
 38:   readonly loadingTalks = signal(false);
 39:   participationModes: ParticipationModeItem[] = [];
 40:   readonly participationCards = computed(() => this.participationModes.map((mode, index) => ({
 41:     title: mode.title,
 42:     detail: mode.detail,
 43:     progress: 70 + (index * 7),
 44:     status: 'Participación',
 45:     ctaLabel: 'Más info',
 46:     ctaLink: '/join',
 47:   })));
 48:   readonly talksPodcastUrl = 'https://www.youtube.com/@TechRidersMedia/podcasts';
 49:   private talksHistoricoFallback: UiCarouselItem[] = [];
 50:   readonly talksHistorico = signal<UiCarouselItem[]>([]);
 51:   galerias: GalleryGroupItem[] = [];
 52:   ngOnInit(): void {
 53:     this.publicContentService
 54:       .getPublicContent()
 55:       .pipe(
 56:         tap((content) => {
 57:           this.participationModes = content.events.participationModes;
 58:           this.galerias = content.events.galleryGroups;
 59:           this.talksHistoricoFallback = content.events.talksFallback.map((item) => ({
 60:             kind: 'video',
 61:             title: item.title,
 62:             src: item.src,
 63:           }));
 64:           this.talksHistorico.set(this.talksHistoricoFallback);
 65:           this.loadTalksHistorico();
 66:         }),
 67:         catchError(() => EMPTY),
 68:         takeUntilDestroyed(this.destroyRef)
 69:       )
 70:       .subscribe();
 71:     this.loadingEventos.set(true);
 72:     this.publicEventsService
 73:       .getEventos(1, 60)
 74:       .pipe(
 75:         tap((result) => {
 76:           this.eventos.set(result.items);
 77:           this.loadingEventos.set(false);
 78:         }),
 79:         catchError(() => {
 80:           this.loadingEventos.set(false);
 81:           return EMPTY;
 82:         }),
 83:         takeUntilDestroyed(this.destroyRef)
 84:       )
 85:       .subscribe();
 86:   }
 87:   private loadTalksHistorico(): void {
 88:     this.loadingTalks.set(true);
 89:     this.podcastService
 90:       .getLatestVideos(8)
 91:       .pipe(
 92:         tap((items) => {
 93:           if (items.length === 0) {
 94:             this.talksHistorico.set(this.talksHistoricoFallback);
 95:           } else if (items.length < 5) {
 96:             const existingSrc = new Set(items.map((item) => item.src));
 97:             const missingFromFallback = this.talksHistoricoFallback.filter((item) => !existingSrc.has(item.src));
 98:             this.talksHistorico.set([...items, ...missingFromFallback].slice(0, 8));
 99:           } else {
100:             this.talksHistorico.set(items);
101:           }
102:           this.loadingTalks.set(false);
103:         }),
104:         catchError(() => {
105:           this.talksHistorico.set(this.talksHistoricoFallback);
106:           this.loadingTalks.set(false);
107:           return EMPTY;
108:         }),
109:         takeUntilDestroyed(this.destroyRef)
110:       )
111:       .subscribe();
112:   }
113: }
</file>

