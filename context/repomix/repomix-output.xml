  1: using Microsoft.Extensions.Logging;
  2: using TechRiders.Application.DTOs.Requests.Ambassador;
  3: using TechRiders.Application.DTOs.Responses.Ambassador;
  4: using TechRiders.Application.Interfaces;
  5: using TechRiders.Domain.Entities;
  6: using TechRiders.Domain.Interfaces;
  7: namespace TechRiders.Application.Services;
  8: /// <summary>
  9: /// Orchestrates ambassador flows while keeping business logic isolated from
 10: /// persistence and HTTP concerns.
 11: /// </summary>
 12: public class AmbassadorService : IAmbassadorService
 13: {
 14:     private readonly IUnitOfWork _unitOfWork;
 15:     private readonly ILogger<AmbassadorService> _logger;
 16:     public AmbassadorService(
 17:         IUnitOfWork unitOfWork,
 18:         ILogger<AmbassadorService> logger)
 19:     {
 20:         _unitOfWork = unitOfWork;
 21:         _logger = logger;
 22:     }
 23:     public async Task<IEnumerable<AmbassadorResponse>> GetAllAmbassadorsAsync(CancellationToken cancellationToken = default)
 24:     {
 25:         _logger.LogInformation("Getting all active ambassadors");
 26:         var ambassadors = await _unitOfWork.Ambassadors.GetActiveAmbassadorsAsync(cancellationToken);
 27:         return await MapUsersToResponsesAsync(ambassadors, cancellationToken);
 28:     }
 29:     public async Task<AmbassadorResponse?> GetAmbassadorByIdAsync(Guid id, CancellationToken cancellationToken = default)
 30:     {
 31:         _logger.LogInformation("Getting ambassador with ID: {AmbassadorId}", id);
 32:         var ambassador = await _unitOfWork.Ambassadors.GetAmbassadorWithDetailsAsync(id, cancellationToken);
 33:         if (ambassador == null)
 34:         {
 35:             _logger.LogWarning("Ambassador with ID {AmbassadorId} not found or inactive", id);
 36:             return null;
 37:         }
 38:         var responses = await MapUsersToResponsesAsync([ambassador], cancellationToken);
 39:         return responses.FirstOrDefault();
 40:     }
 41:     public async Task<IEnumerable<AmbassadorResponse>> SearchAmbassadorsAsync(
 42:         string searchTerm,
 43:         CancellationToken cancellationToken = default)
 44:     {
 45:         _logger.LogInformation("Searching ambassadors with term: {SearchTerm}", searchTerm);
 46:         var ambassadors = await _unitOfWork.Ambassadors.SearchAmbassadorsAsync(searchTerm, cancellationToken);
 47:         return await MapUsersToResponsesAsync(ambassadors, cancellationToken);
 48:     }
 49:     public async Task<IEnumerable<AmbassadorResponse>> GetAmbassadorsByCategoryAsync(
 50:         int categoryId,
 51:         CancellationToken cancellationToken = default)
 52:     {
 53:         _logger.LogInformation("Getting ambassadors by category ID: {CategoryId}", categoryId);
 54:         var ambassadors = await _unitOfWork.Ambassadors.GetAmbassadorsByCategoryAsync(categoryId, cancellationToken);
 55:         return await MapUsersToResponsesAsync(ambassadors, cancellationToken);
 56:     }
 57:     public async Task<IEnumerable<AmbassadorResponse>> GetWorkingAmbassadorsAsync(CancellationToken cancellationToken = default)
 58:     {
 59:         _logger.LogInformation("Getting working ambassadors");
 60:         var ambassadors = await _unitOfWork.Ambassadors.GetWorkingAmbassadorsAsync(cancellationToken);
 61:         return await MapUsersToResponsesAsync(ambassadors, cancellationToken);
 62:     }
 63:     public async Task<AmbassadorResponse> CreateAmbassadorAsync(
 64:         CreateAmbassadorRequest request,
 65:         CancellationToken cancellationToken = default)
 66:     {
 67:         _logger.LogInformation("Creating new ambassador: {Name} {LastName}", request.Name, request.LastName);
 68:         if (request.CategoryId.HasValue)
 69:         {
 70:             var categoryExists = await _unitOfWork.Categories.ExistsAsync(request.CategoryId.Value, cancellationToken);
 71:             if (!categoryExists)
 72:             {
 73:                 _logger.LogWarning("Category with ID {CategoryId} does not exist", request.CategoryId.Value);
 74:                 throw new InvalidOperationException($"Category with ID {request.CategoryId.Value} does not exist");
 75:             }
 76:         }
 77:         var ambassadorUser = new User
 78:         {
 79:             Id = Guid.NewGuid(),
 80:             Nickname = string.IsNullOrWhiteSpace(request.Nickname) ? request.Email.Split('@')[0] : request.Nickname,
 81:             Name = request.Name,
 82:             LastName = request.LastName,
 83:             Email = request.Email,
 84:             Phone = request.Phone,
 85:             Locality = request.Locality,
 86:             IsWorking = request.IsWorking,
 87:             About = request.About,
 88:             LinkedIn = request.LinkedIn,
 89:             Instagram = request.Instagram,
 90:             Github = request.Github,
 91:             IsActive = true
 92:         };
 93:         await _unitOfWork.Ambassadors.AddAsync(ambassadorUser, cancellationToken);
 94:         await _unitOfWork.Ambassadors.EnsureAmbassadorRoleAsync(ambassadorUser, cancellationToken);
 95:         if (request.CategoryId.HasValue)
 96:         {
 97:             await UpsertIntranetCategoryAsync(
 98:                 ambassadorUser.Id,
 99:                 request.CategoryId.Value,
100:                 request.OtherCategory,
101:                 cancellationToken);
102:         }
103:         await _unitOfWork.SaveChangesAsync(cancellationToken);
104:         _logger.LogInformation("Ambassador created successfully with user ID: {AmbassadorId}", ambassadorUser.Id);
105:         var createdAmbassador = await _unitOfWork.Ambassadors.GetAmbassadorWithDetailsAsync(ambassadorUser.Id, cancellationToken)
106:             ?? ambassadorUser;
107:         var responses = await MapUsersToResponsesAsync([createdAmbassador], cancellationToken);
108:         return responses.First();
109:     }
110:     public async Task<AmbassadorResponse?> UpdateAmbassadorAsync(
111:         Guid id,
112:         UpdateAmbassadorRequest request,
113:         CancellationToken cancellationToken = default)
114:     {
115:         _logger.LogInformation("Updating ambassador with ID: {AmbassadorId}", id);
116:         var ambassador = await _unitOfWork.Ambassadors.GetAmbassadorWithDetailsAsync(id, cancellationToken);
117:         if (ambassador == null)
118:         {
119:             _logger.LogWarning("Ambassador with ID {AmbassadorId} not found or inactive", id);
120:             return null;
121:         }
122:         if (request.CategoryId.HasValue)
123:         {
124:             var categoryExists = await _unitOfWork.Categories.ExistsAsync(request.CategoryId.Value, cancellationToken);
125:             if (!categoryExists)
126:             {
127:                 _logger.LogWarning("Category with ID {CategoryId} does not exist", request.CategoryId.Value);
128:                 throw new InvalidOperationException($"Category with ID {request.CategoryId.Value} does not exist");
129:             }
130:         }
131:         if (!string.IsNullOrWhiteSpace(request.Nickname)) ambassador.Nickname = request.Nickname;
132:         if (!string.IsNullOrWhiteSpace(request.Name)) ambassador.Name = request.Name;
133:         if (!string.IsNullOrWhiteSpace(request.LastName)) ambassador.LastName = request.LastName;
134:         if (!string.IsNullOrWhiteSpace(request.Email)) ambassador.Email = request.Email;
135:         if (request.Phone != null) ambassador.Phone = request.Phone;
136:         if (request.Locality != null) ambassador.Locality = request.Locality;
137:         if (request.IsWorking.HasValue) ambassador.IsWorking = request.IsWorking.Value;
138:         if (request.About != null) ambassador.About = request.About;
139:         if (request.LinkedIn != null) ambassador.LinkedIn = request.LinkedIn;
140:         if (request.Instagram != null) ambassador.Instagram = request.Instagram;
141:         if (request.Github != null) ambassador.Github = request.Github;
142:         await _unitOfWork.Ambassadors.EnsureAmbassadorRoleAsync(ambassador, cancellationToken);
143:         if (request.CategoryId.HasValue)
144:         {
145:             await UpsertIntranetCategoryAsync(
146:                 ambassador.Id,
147:                 request.CategoryId.Value,
148:                 request.OtherCategory,
149:                 cancellationToken);
150:         }
151:         ambassador.UpdatedAt = DateTime.UtcNow;
152:         await _unitOfWork.Ambassadors.UpdateAsync(ambassador, cancellationToken);
153:         await _unitOfWork.SaveChangesAsync(cancellationToken);
154:         _logger.LogInformation("Ambassador updated successfully: {AmbassadorId}", id);
155:         var updatedAmbassador = await _unitOfWork.Ambassadors.GetAmbassadorWithDetailsAsync(id, cancellationToken)
156:             ?? ambassador;
157:         var responses = await MapUsersToResponsesAsync([updatedAmbassador], cancellationToken);
158:         return responses.First();
159:     }
160:     public async Task<bool> DeleteAmbassadorAsync(Guid id, CancellationToken cancellationToken = default)
161:     {
162:         _logger.LogInformation("Deleting ambassador with ID: {AmbassadorId}", id);
163:         var isAmbassador = await _unitOfWork.Ambassadors.IsAmbassadorAsync(id, cancellationToken);
164:         if (!isAmbassador)
165:         {
166:             _logger.LogWarning("Ambassador with ID {AmbassadorId} not found or already inactive", id);
167:             return false;
168:         }
169:         await _unitOfWork.Ambassadors.RemoveAmbassadorRoleAsync(id, cancellationToken);
170:         var intranetCategories = await _unitOfWork.IntranetUserCategories
171:             .FindAsync(uc => uc.UserId == id && uc.Active, cancellationToken);
172:         foreach (var category in intranetCategories)
173:         {
174:             category.Active = false;
175:             category.UpdatedAt = DateTime.UtcNow;
176:             await _unitOfWork.IntranetUserCategories.UpdateAsync(category, cancellationToken);
177:         }
178:         await _unitOfWork.SaveChangesAsync(cancellationToken);
179:         _logger.LogInformation("Ambassador role removed successfully for user: {AmbassadorId}", id);
180:         return true;
181:     }
182:     private async Task<IEnumerable<AmbassadorResponse>> MapUsersToResponsesAsync(
183:         IEnumerable<User> users,
184:         CancellationToken cancellationToken)
185:     {
186:         var userList = users.ToList();
187:         if (userList.Count == 0)
188:         {
189:             return [];
190:         }
191:         var userIds = userList.Select(u => u.Id).ToArray();
192:         var activeCategories = (await _unitOfWork.IntranetUserCategories
193:             .FindAsync(uc => userIds.Contains(uc.UserId) && uc.Active, cancellationToken))
194:             .GroupBy(uc => uc.UserId)
195:             .ToDictionary(g => g.Key, g => g.First());
196:         var categoryNames = new Dictionary<int, string>();
197:         var categoryIds = activeCategories.Values.Select(c => c.CategoryId).Distinct().ToArray();
198:         if (categoryIds.Length > 0)
199:         {
200:             var allCategories = await _unitOfWork.Categories.GetAllAsync(cancellationToken);
201:             categoryNames = allCategories
202:                 .Where(c => categoryIds.Contains(c.Id))
203:                 .ToDictionary(c => c.Id, c => c.Name);
204:         }
205:         return userList.Select(user =>
206:         {
207:             activeCategories.TryGetValue(user.Id, out var activeCategory);
208:             var categoryName = activeCategory != null && categoryNames.TryGetValue(activeCategory.CategoryId, out var name)
209:                 ? name
210:                 : null;
211:             return new AmbassadorResponse
212:             {
213:                 Id = user.Id,
214:                 Nickname = user.Nickname,
215:                 Name = user.Name,
216:                 LastName = user.LastName,
217:                 Email = user.Email,
218:                 Phone = user.Phone,
219:                 Locality = user.Locality,
220:                 IsWorking = user.IsWorking,
221:                 CategoryId = activeCategory?.CategoryId,
222:                 CategoryName = categoryName,
223:                 OtherCategory = activeCategory?.Description,
224:                 About = user.About,
225:                 Skill = null,
226:                 LinkedIn = user.LinkedIn,
227:                 Instagram = user.Instagram,
228:                 Github = user.Github,
229:                 CreatedAt = user.CreatedAt,
230:                 UpdatedAt = user.UpdatedAt,
231:                 IsActive = user.IsActive
232:             };
233:         }).ToArray();
234:     }
235:     private async Task UpsertIntranetCategoryAsync(
236:         Guid userId,
237:         int categoryId,
238:         string? otherCategory,
239:         CancellationToken cancellationToken)
240:     {
241:         var selectedCategory = await _unitOfWork.Categories.GetByIdAsync(categoryId, cancellationToken)
242:             ?? throw new InvalidOperationException($"Category with ID {categoryId} does not exist");
243:         var existingCategory = (await _unitOfWork.IntranetUserCategories
244:                 .FindAsync(uc => uc.UserId == userId && uc.Active, cancellationToken))
245:             .FirstOrDefault();
246:         if (existingCategory == null)
247:         {
248:             await _unitOfWork.IntranetUserCategories.AddAsync(new IntranetUserCategory
249:             {
250:                 Id = Guid.NewGuid(),
251:                 UserId = userId,
252:                 CategoryId = categoryId,
253:                 Category = selectedCategory.Name,
254:                 Description = otherCategory,
255:                 Active = true,
256:                 IsActive = true
257:             }, cancellationToken);
258:             return;
259:         }
260:         existingCategory.CategoryId = categoryId;
261:         existingCategory.Category = selectedCategory.Name;
262:         existingCategory.Description = otherCategory;
263:         existingCategory.UpdatedAt = DateTime.UtcNow;
264:         await _unitOfWork.IntranetUserCategories.UpdateAsync(existingCategory, cancellationToken);
265:     }
266: }
</file>

