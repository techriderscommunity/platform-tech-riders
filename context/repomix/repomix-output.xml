272:   <meta name="viewport" content="width=device-width, initial-scale=1.0" />
273:   <title>{App Name} — Architecture Diagrams</title>
274:   <style>
275:     :root {
276:       --bg: #ffffff;
277:       --bg-alt: #f6f8fa;
