<file path="techito/src/app/core/http/auth.interceptor.ts">
 1: import { HttpInterceptorFn } from '@angular/common/http';
 2: export const authInterceptor: HttpInterceptorFn = (req, next) => {
 3:   if (typeof localStorage === 'undefined') {
 4:     return next(req);
 5:   }
 6:   const token = localStorage.getItem('token');
 7:   if (!token) {
 8:     return next(req);
 9:   }
10:   return next(req.clone({
11:     setHeaders: { Authorization: `Bearer ${token}` }
12:   }));
13: };
</file>

<file path="techito/src/app/core/http/error.interceptor.ts">
 1: import { HttpInterceptorFn, HttpErrorResponse } from '@angular/common/http';
 2: import { inject } from '@angular/core';
 3: import { Router } from '@angular/router';
 4: import { catchError, throwError } from 'rxjs';
 5: import { AuthService } from '../auth/auth.service';
 6: export const errorInterceptor: HttpInterceptorFn = (req, next) => {
 7:   const router = inject(Router);
 8:   const auth = inject(AuthService);
 9:   return next(req).pipe(
10:     catchError((error: HttpErrorResponse) => {
11:       if (error.status === 401) {
12:         auth.logout();
13:         router.navigate(['/login']);
14:       }
15:       if (error.status === 403) {
16:         if (auth.isAuthenticated()) {
17:           router.navigateByUrl(auth.getDefaultRoute());
18:         } else {
19:           router.navigate(['/login']);
20:         }
21:       }
22:       const message = error.error?.message ?? error.message ?? 'Error inesperado';
23:       return throwError(() => ({ status: error.status, message }));
24:     })
25:   );
26: };
</file>

