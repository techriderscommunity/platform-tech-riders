 1: from __future__ import annotations
 2: import json
 3: from pathlib import Path
 4: class JsonExporter:
 5:     name = "json"
 6:     def __init__(self, telemetry_dir: Path) -> None:
 7:         self.telemetry_dir = telemetry_dir
 8:         self.telemetry_dir.mkdir(parents=True, exist_ok=True)
 9:         self.traces_file = self.telemetry_dir / "traces.jsonl"
10:         self.metrics_file = self.telemetry_dir / "metrics.jsonl"
11:     def _append_lines(self, file_path: Path, entries: list[dict]) -> None:
12:         if not entries:
13:             return
14:         with file_path.open("a", encoding="utf-8") as handle:
15:             for entry in entries:
16:                 handle.write(json.dumps(entry, ensure_ascii=False, separators=(",", ":")))
17:                 handle.write("\n")
18:     def export(self, records: list[dict]) -> None:
19:         traces = [r for r in records if str(r.get("type", "")) in {"event", "span"}]
20:         metrics = [r for r in records if str(r.get("type", "")) == "metric"]
21:         self._append_lines(self.traces_file, traces)
22:         self._append_lines(self.metrics_file, metrics)
23:     def flush(self) -> None:
24:         return
25:     def shutdown(self) -> None:
26:         return
