11: {
12:     public CandidaturaRepository(TechRidersDbContext context) : base(context)
13:     {
14:     }
15:     /// <summary>
16:     /// Obtiene todas las candidaturas para una oferta
17:     /// </summary>
18:     public async Task<IEnumerable<Candidatura>> GetByOfertaIdAsync(Guid ofertaId, CancellationToken cancellationToken = default)
