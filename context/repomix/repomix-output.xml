321:     $lines += ("Started: {0}" -f $Started.ToString('o'))
322:     $lines += ("Ended: {0}" -f $Ended.ToString('o'))
323:     $lines += ("Duration (sec): {0}" -f $durationSec)
324:     $lines += ("Steps OK: {0}" -f $okCount)
325:     $lines += ("Steps Failed/Timeout: {0}" -f $failedCount)
326:     $lines += ""
327:     $lines += "## Step Summary"
328:     $lines += ""
329:     $lines += "| # | Step | Status | Exit | Seconds | Required |"
330:     $lines += "|---|---|---|---:|---:|---|"
331: 
332:     $index = 1
333:     foreach ($result in $Results) {
334:         $lines += ("| {0} | {1} | {2} | {3} | {4} | {5} |" -f $index, $result.name, $result.status, $result.exit_code, $result.duration_sec, $result.required)
335:         $index++
336:     }
337: 
338:     $lines += ""
339:     $lines += "## Guion Hablado (listo para demo en directo)"
340:     $lines += ""
341: 
342:     foreach ($result in $Results) {
343:         $lines += ("### {0}" -f $result.name)
344:         if (-not [string]::IsNullOrWhiteSpace([string]$result.question)) {
345:             $lines += ("- Pregunta: {0}" -f $result.question)
346:         }
347:         if (@($result.flow).Count -gt 0) {
348:             $lines += ("- Flujo: {0}" -f ((@($result.flow) | ForEach-Object { [string]$_ }) -join ' -> '))
349:         }
350:         $lines += ("- Voy a hacer: {0}" -f $result.name)
351:         $lines += ("- Vamos a lanzarlo: {0}" -f $result.command)
352:         $lines += ("- Se ejecuta en: {0}" -f $result.working_dir)
353: 
354:         if ($result.status -eq 'ok') {
355:             $lines += "- Ha hecho: ejecucion correcta sin errores operativos."
356:             $lines += "- Obtenemos este resultado: OK, bloque validado para continuar la historia."
357:         }
358:         elseif ($result.status -eq 'timeout') {
359:             $lines += "- Ha hecho: se alcanzo el tiempo maximo definido para este bloque."
360:             $lines += "- Obtenemos este resultado: TIMEOUT controlado; usamos logs para explicar causa y mitigacion."
361:         }
362:         elseif ($result.status -eq 'dry-run') {
