<file path="scripts/ops/telemetry-benchmark.py">
  1: from __future__ import annotations
  2: import argparse
  3: import json
  4: import os
  5: import statistics
  6: import subprocess
  7: import time
  8: from datetime import datetime, timezone
  9: from pathlib import Path
 10: from typing import Any
 11: def utc_now() -> str:
 12:     return datetime.now(timezone.utc).isoformat()
 13: def build_command(python_exe: str) -> list[str]:
 14:     return [
 15:         python_exe,
 16:         "scripts/intake/resolve-routing.py",
 17:         "--input",
 18:         "telemetry benchmark",
 19:         "--intent",
 20:         "feature",
 21:         "--domain",
 22:         "backend",
 23:         "--source-type",
 24:         "code",
 25:         "--input-tokens",
 26:         "120",
 27:         "--output-tokens",
 28:         "45",
 29:         "--estimated-cost-usd",
 30:         "0.0032",
 31:         "--model",
 32:         "GPT-5.3-Codex",
 33:         "--local-tools",
 34:         "2",
 35:         "--remote-tools",
 36:         "1",
 37:     ]
 38: def run_variant(*, repo_root: Path, iterations: int, telemetry_enabled: bool, python_exe: str) -> dict[str, Any]:
 39:     durations_ms: list[float] = []
 40:     failures = 0
 41:     for _ in range(iterations):
 42:         env = os.environ.copy()
 43:         env["TELEMETRY_ENABLED"] = "true" if telemetry_enabled else "false"
 44:         env["TELEMETRY_EXPORTERS"] = "console,json"
 45:         start = time.perf_counter()
 46:         proc = subprocess.run(
 47:             build_command(python_exe),
 48:             cwd=str(repo_root),
 49:             env=env,
 50:             stdout=subprocess.DEVNULL,
 51:             stderr=subprocess.DEVNULL,
 52:             check=False,
 53:         )
 54:         elapsed_ms = (time.perf_counter() - start) * 1000.0
 55:         durations_ms.append(elapsed_ms)
 56:         if proc.returncode != 0:
 57:             failures += 1
 58:     avg_ms = statistics.mean(durations_ms) if durations_ms else 0.0
 59:     p95_ms = statistics.quantiles(durations_ms, n=20)[18] if len(durations_ms) >= 20 else max(durations_ms, default=0.0)
 60:     return {
 61:         "telemetry_enabled": telemetry_enabled,
 62:         "iterations": iterations,
 63:         "failures": failures,
 64:         "avg_ms": round(avg_ms, 3),
 65:         "min_ms": round(min(durations_ms) if durations_ms else 0.0, 3),
 66:         "max_ms": round(max(durations_ms) if durations_ms else 0.0, 3),
 67:         "p95_ms": round(p95_ms, 3),
 68:     }
 69: def main() -> int:
 70:     parser = argparse.ArgumentParser(description="Benchmark telemetry overhead on/off using resolve-routing as workload.")
 71:     parser.add_argument("--iterations", type=int, default=10)
 72:     parser.add_argument("--python", default="py")
 73:     parser.add_argument("--python-arg", default="-3")
 74:     parser.add_argument("--out", default="observability/evals/telemetry-overhead-benchmark.json")
 75:     args = parser.parse_args()
 76:     repo_root = Path(__file__).resolve().parents[2]
 77:     iterations = max(2, int(args.iterations))
 78:     python_exe = args.python
 79:     # Windows default launcher pattern: py -3
 80:     if args.python == "py" and args.python_arg:
 81:         python_exe = f"{args.python} {args.python_arg}"  # handled below
 82:     if " " in python_exe:
 83:         tokens = python_exe.split()
 84:         base = tokens[0]
 85:         extra = tokens[1:]
 86:     else:
 87:         base = python_exe
 88:         extra = []
 89:     def build_python() -> str:
 90:         if not extra:
 91:             return base
 92:         return base
 93:     # Probe python command in current environment.
 94:     probe = subprocess.run([base, *extra, "--version"], cwd=str(repo_root), stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
 95:     if probe.returncode != 0:
 96:         print("Unable to resolve python interpreter for benchmark")
 97:         return 1
 98:     def command_python() -> str:
 99:         return base
100:     # Wrap variant runner to include optional extra interpreter args.
101:     def run_with_variant(telemetry_enabled: bool) -> dict[str, Any]:
102:         durations_ms: list[float] = []
103:         failures = 0
104:         for _ in range(iterations):
105:             env = os.environ.copy()
106:             env["TELEMETRY_ENABLED"] = "true" if telemetry_enabled else "false"
107:             env["TELEMETRY_EXPORTERS"] = "console,json"
108:             cmd = [base, *extra, *build_command(command_python())[1:]]
109:             start = time.perf_counter()
110:             proc = subprocess.run(
111:                 cmd,
112:                 cwd=str(repo_root),
113:                 env=env,
114:                 stdout=subprocess.DEVNULL,
115:                 stderr=subprocess.DEVNULL,
116:                 check=False,
117:             )
118:             elapsed_ms = (time.perf_counter() - start) * 1000.0
119:             durations_ms.append(elapsed_ms)
120:             if proc.returncode != 0:
121:                 failures += 1
122:         avg_ms = statistics.mean(durations_ms) if durations_ms else 0.0
123:         p95_ms = statistics.quantiles(durations_ms, n=20)[18] if len(durations_ms) >= 20 else max(durations_ms, default=0.0)
124:         return {
125:             "telemetry_enabled": telemetry_enabled,
126:             "iterations": iterations,
127:             "failures": failures,
128:             "avg_ms": round(avg_ms, 3),
129:             "min_ms": round(min(durations_ms) if durations_ms else 0.0, 3),
130:             "max_ms": round(max(durations_ms) if durations_ms else 0.0, 3),
131:             "p95_ms": round(p95_ms, 3),
132:         }
133:     enabled = run_with_variant(True)
134:     disabled = run_with_variant(False)
135:     overhead_ms = enabled["avg_ms"] - disabled["avg_ms"]
136:     overhead_pct = ((overhead_ms / disabled["avg_ms"]) * 100.0) if disabled["avg_ms"] > 0 else 0.0
137:     report = {
138:         "timestamp": utc_now(),
139:         "workload": "scripts/intake/resolve-routing.py",
140:         "iterations": iterations,
141:         "with_telemetry": enabled,
142:         "without_telemetry": disabled,
143:         "overhead": {
144:             "avg_ms": round(overhead_ms, 3),
145:             "avg_pct": round(overhead_pct, 3),
146:         },
147:     }
148:     out_path = (repo_root / args.out).resolve()
149:     out_path.parent.mkdir(parents=True, exist_ok=True)
150:     out_path.write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
151:     print(json.dumps(report, indent=2, ensure_ascii=False))
152:     print(f"Benchmark report: {out_path}")
153:     return 0
154: if __name__ == "__main__":
155:     raise SystemExit(main())
</file>

<file path="scripts/ops/trace-command.py">
 1: from __future__ import annotations
 2: import argparse
 3: import subprocess
 4: import sys
 5: from pathlib import Path
 6: def _bootstrap_repo_root() -> Path:
 7:     repo_root = Path(__file__).resolve().parents[2]
 8:     if str(repo_root) not in sys.path:
 9:         sys.path.insert(0, str(repo_root))
10:     return repo_root
11: def _parse_args() -> argparse.Namespace:
12:     parser = argparse.ArgumentParser(description="Run a command wrapped with telemetry execution/span.")
13:     parser.add_argument("--operation", required=True, help="Telemetry operation name.")
14:     parser.add_argument("--session-id", default="mcpee-cli", help="Telemetry session identifier.")
15:     parser.add_argument("--cwd", default=".", help="Working directory for the command.")
16:     parser.add_argument("command", nargs=argparse.REMAINDER, help="Command to execute after --.")
17:     return parser.parse_args()
18: def _normalize_command(raw: list[str]) -> list[str]:
19:     cmd = list(raw)
20:     if cmd and cmd[0] == "--":
21:         cmd = cmd[1:]
22:     return cmd
23: def main() -> int:
24:     args = _parse_args()
25:     command = _normalize_command(args.command)
26:     if not command:
27:         print("trace-command.py: missing command to execute", file=sys.stderr)
28:         return 2
29:     repo_root = _bootstrap_repo_root()
30:     from telemetry import build_telemetry_collector
31:     collector = build_telemetry_collector(repo_root)
32:     cwd = Path(args.cwd).resolve()
33:     exit_code = 0
34:     try:
35:         with collector.start_execution(operation=args.operation, session_id=args.session_id, model="mcpee-cli"):
36:             with collector.start_span(
37:                 name="subprocess",
38:                 kind="TOOL",
39:                 attributes={
40:                     "cwd": str(cwd),
41:                     "command": command[0],
42:                     "args_count": len(command) - 1,
43:                 },
44:             ):
45:                 completed = subprocess.run(command, cwd=str(cwd), check=False)
46:                 exit_code = int(completed.returncode)
47:                 collector.record_metric("subprocess_exit_code", float(exit_code), unit="code")
48:                 if exit_code != 0:
49:                     raise RuntimeError(f"command failed with exit code {exit_code}")
50:     except RuntimeError:
51:         pass
52:     return exit_code
53: if __name__ == "__main__":
54:     raise SystemExit(main())
</file>

<file path="scripts/ops/uninstall-terminal-telemetry-hook.ps1">
 1: param(
 2:     [switch]$AllHosts,
 3:     [switch]$CurrentProcess
 4: )
 5: 
 6: Set-StrictMode -Version Latest
 7: $ErrorActionPreference = 'Stop'
 8: 
 9: function Remove-FromProfile {
10:     param([string]$ProfilePath)
11: 
12:     if (-not (Test-Path $ProfilePath)) {
13:         return
14:     }
15: 
16:     $content = Get-Content -Path $ProfilePath -Raw -ErrorAction SilentlyContinue
17:     if ($null -eq $content) {
18:         return
19:     }
20: 
21:     if ($content -match 'MCPEE_TERMINAL_TELEMETRY_START') {
22:         $updated = [regex]::Replace(
23:             $content,
24:             '(?s)\r?\n?# >>> MCPEE_TERMINAL_TELEMETRY_START >>>.*?# <<< MCPEE_TERMINAL_TELEMETRY_END <<<\r?\n?',
25:             "`r`n"
26:         )
27:         Set-Content -Path $ProfilePath -Value $updated -Encoding UTF8
28:         Write-Host "[ok] Hook eliminado de: $ProfilePath"
29:     }
30: }
31: 
32: if ($CurrentProcess) {
33:     Remove-Item Function:\global:prompt -ErrorAction SilentlyContinue
34:     if (Test-Path Function:\global:MCPEE_ORIGINAL_PROMPT) {
35:         Set-Item -Path Function:\global:prompt -Value ((Get-Command MCPEE_ORIGINAL_PROMPT -CommandType Function).ScriptBlock) -Force
36:         Remove-Item Function:\global:MCPEE_ORIGINAL_PROMPT -ErrorAction SilentlyContinue
37:     }
38: 
39:     Remove-Item Function:\global:Invoke-McpeeTerminalTelemetry -ErrorAction SilentlyContinue
40:     Remove-Item Function:\global:Get-McpeeTelemetryPythonCommand -ErrorAction SilentlyContinue
41:     Remove-Variable MCPEE_TELEMETRY_REPO_ROOT -Scope Global -ErrorAction SilentlyContinue
42:     Remove-Variable MCPEE_TELEMETRY_SESSION_ID -Scope Global -ErrorAction SilentlyContinue
43:     Remove-Variable MCPEE_TELEMETRY_LAST_HISTORY_ID -Scope Global -ErrorAction SilentlyContinue
44:     Remove-Variable MCPEE_TELEMETRY_LAST_STAMP -Scope Global -ErrorAction SilentlyContinue
45:     Write-Host '[ok] Hook desactivado en la sesion actual.'
46: }
47: 
48: Remove-FromProfile -ProfilePath $PROFILE.CurrentUserCurrentHost
49: if ($AllHosts) {
50:     Remove-FromProfile -ProfilePath $PROFILE.CurrentUserAllHosts
51: }
52: 
53: Write-Host '[ok] Telemetria global de terminal desactivada.'
</file>

