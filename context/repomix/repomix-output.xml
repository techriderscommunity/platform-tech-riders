338: ## Scripting Patterns for Idempotent Operations
339: 
340: ### Create or Update Pattern
341: 
342: ```bash
343: # Ensure pipeline exists, update if different
344: ensure_pipeline() {
345:   local name=$1
346:   local yaml_path=$2
347: 
348:   PIPELINE=$(az pipelines list --query "[?name=='$name']" -o json)
349: 
350:   if [[ -z "$PIPELINE" ]]; then
351:     echo "Creating pipeline: $name"
352:     az pipelines create --name "$name" --yaml-path "$yaml_path"
353:   else
354:     echo "Pipeline exists: $name"
355:   fi
356: }
357: ```
358: 
359: ### Ensure Variable Group
360: 
361: ```bash
362: # Create variable group with idempotent updates
363: ensure_variable_group() {
364:   local vg_name=$1
365:   shift
366:   local variables=("$@")
367: 
368:   VG_ID=$(az pipelines variable-group list --query "[?name=='$vg_name'].id" -o tsv)
369: 
370:   if [[ -z "$VG_ID" ]]; then
371:     echo "Creating variable group: $vg_name"
372:     VG_ID=$(az pipelines variable-group create \
373:       --name "$vg_name" \
374:       --variables "${variables[@]}" \
375:       --authorize true \
376:       --query "id" -o tsv)
377:   else
378:     echo "Variable group exists: $vg_name (ID: $VG_ID)"
379:   fi
380: 
381:   echo "$VG_ID"
382: }
383: ```
384: 
385: ### Ensure Service Connection
386: 
387: ```bash
388: # Check if service connection exists, create if not
389: ensure_service_connection() {
390:   local name=$1
391:   local project=$2
392: 
393:   SC_ID=$(az devops service-endpoint list \
394:     --project "$project" \
395:     --query "[?name=='$name'].id" \
396:     -o tsv)
397: 
398:   if [[ -z "$SC_ID" ]]; then
399:     echo "Service connection not found. Creating..."
400:     # Create logic here
401:   else
402:     echo "Service connection exists: $name"
403:     echo "$SC_ID"
404:   fi
405: }
406: ```
407: 
408: ### Idempotent Work Item Creation
409: 
410: ```bash
411: # Create work item only if doesn't exist with same title
412: create_work_item_if_new() {
413:   local title=$1
414:   local type=$2
415: 
416:   WI_ID=$(az boards query \
417:     --wiql "SELECT ID FROM WorkItems WHERE [System.WorkItemType]='$type' AND [System.Title]='$title'" \
418:     --query "[0].id" -o tsv)
419: 
420:   if [[ -z "$WI_ID" ]]; then
421:     echo "Creating work item: $title"
422:     WI_ID=$(az boards work-item create --title "$title" --type "$type" --query "id" -o tsv)
423:   else
424:     echo "Work item exists: $title (ID: $WI_ID)"
425:   fi
426: 
427:   echo "$WI_ID"
428: }
429: ```
430: 
431: ### Bulk Idempotent Operations
432: 
433: ```bash
434: # Ensure multiple pipelines exist
435: declare -a PIPELINES=(
436:   "ci-pipeline:azure-pipelines.yml"
437:   "deploy-pipeline:deploy.yml"
438:   "test-pipeline:test.yml"
439: )
440: 
441: for pipeline in "${PIPELINES[@]}"; do
442:   IFS=':' read -r name yaml <<< "$pipeline"
443:   ensure_pipeline "$name" "$yaml"
444: done
445: ```
446: 
447: ### Configuration Synchronization
448: 
449: ```bash
450: # Sync variable groups from config file
451: sync_variable_groups() {
452:   local config_file=$1
453: 
454:   while IFS=',' read -r vg_name variables; do
455:     ensure_variable_group "$vg_name" "$variables"
456:   done < "$config_file"
457: }
458: 
459: # config.csv format:
460: # prod-vars,API_URL=prod.com,API_KEY=secret123
461: # dev-vars,API_URL=dev.com,API_KEY=secret456
462: ```
