<file path="techito/src/app/features/intranet/embajadores/staff.ts">
 1: import { ChangeDetectionStrategy, Component, signal, computed, inject, DestroyRef } from '@angular/core';
 2: import { FormsModule } from '@angular/forms';
 3: import { NgxChartsModule } from '@swimlane/ngx-charts';
 4: import { PublicContentService } from '@core/content/public-content.service';
 5: import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
 6: import { tap, catchError } from 'rxjs/operators';
 7: import { of } from 'rxjs';
 8: import { TalkItem } from './models/embajadores.models';
 9: import { EmbajadoresService } from './services/embajadores.service';
10: import { UiSelect, UiSelectOption  } from '@shared/ui/select/select';
11: @Component({
12:   selector: 'app-staff',
13:   standalone: true,
14:   changeDetection: ChangeDetectionStrategy.OnPush,
15:   imports: [FormsModule, NgxChartsModule, UiSelect],
16:   templateUrl: './staff.html',
17:   styleUrl: './staff.scss'
18: })
19: export class Staff {
20:   private readonly embajadoresService = inject(EmbajadoresService);
21:   private readonly publicContentService = inject(PublicContentService);
22:   private readonly destroyRef = inject(DestroyRef);
23:   periodOptions: Array<{ label: string; value: string }> = [];
24:   periodSelectOptions: UiSelectOption[] = [];
25:   readonly selectedPeriod = signal('month');
26:   readonly loading = signal(true);
27:   readonly talks = signal<TalkItem[]>([]);
28:   readonly filteredTalks = computed(() => {
29:     const now = new Date();
30:     const period = this.selectedPeriod();
31:     if (period === 'month') {
32:       return this.talks().filter(t => {
33:         const d = new Date(t.date);
34:         return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
35:       });
36:     }
37:     if (period === 'year') {
38:       return this.talks().filter(t => new Date(t.date).getFullYear() === now.getFullYear());
39:     }
40:     return this.talks();
41:   });
42:   readonly totalTalks = computed(() => this.filteredTalks().length);
43:   readonly uniqueTopics = computed(() => Array.from(new Set(this.filteredTalks().map(t => t.topic))).length);
44:   readonly uniqueSpeakers = computed(() => Array.from(new Set(this.filteredTalks().map(t => t.speaker))).length);
45:   readonly avgRating = computed(() => {
46:     const ft = this.filteredTalks();
47:     if (!ft.length) return '0';
48:     return (ft.reduce((sum, t) => sum + t.rating, 0) / ft.length).toFixed(2);
49:   });
50:   readonly topicChartData = computed(() => {
51:     const topicCounts: { [key: string]: number } = {};
52:     this.filteredTalks().forEach(t => { topicCounts[t.topic] = (topicCounts[t.topic] || 0) + 1; });
53:     return Object.keys(topicCounts).map(topic => ({ name: topic, value: topicCounts[topic] }));
54:   });
55:   readonly speakerChartData = computed(() => {
56:     const speakerCounts: { [key: string]: number } = {};
57:     this.filteredTalks().forEach(t => { speakerCounts[t.speaker] = (speakerCounts[t.speaker] || 0) + 1; });
58:     return Object.keys(speakerCounts).map(speaker => ({ name: speaker, value: speakerCounts[speaker] }));
59:   });
60:   readonly colorScheme = 'vivid';
61:   constructor() {
62:     this.publicContentService
63:       .getPublicContent()
64:       .pipe(
65:         tap((content) => {
66:           this.periodSelectOptions = content.intranet.staffPeriodOptions;
67:           this.periodOptions = content.intranet.staffPeriodOptions.map((option) => ({
68:             label: option.label,
69:             value: option.value,
70:           }));
71:         }),
72:         catchError(() => of(null)),
73:         takeUntilDestroyed(this.destroyRef)
74:       )
75:       .subscribe();
76:     this.loadTalks();
77:   }
78:   private loadTalks() {
79:     this.embajadoresService.getTalks()
80:       .pipe(
81:         tap((result) => {
82:           this.talks.set(result ?? []);
83:           this.loading.set(false);
84:         }),
85:         catchError(() => {
86:           this.loading.set(false);
87:           return of([] as TalkItem[]);
88:         }),
89:         takeUntilDestroyed(this.destroyRef)
90:       )
91:       .subscribe();
92:   }
93:   formatPercentLabel(data: { value: number }): string {
94:     const chartData = this.topicChartData();
95:     const total = chartData.reduce((sum, d) => sum + d.value, 0);
96:     const percent = total ? ((data.value / total) * 100).toFixed(1) : '0';
97:     return `${percent}%`;
98:   }
99: }
</file>

