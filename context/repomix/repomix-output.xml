 53: function Get-PatternSum {
 54:     param(
 55:         [string]$Text,
 56:         [string]$Pattern
 57:     )
 58: 
 59:     if ([string]::IsNullOrWhiteSpace($Text)) {
 60:         return $null
 61:     }
 62: 
 63:     $matches = [regex]::Matches($Text, $Pattern, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
 64:     if ($matches.Count -eq 0) {
 65:         return $null
 66:     }
 67: 
 68:     $sum = 0.0
 69:     $found = $false
 70:     foreach ($m in $matches) {
 71:         if ($m.Groups.Count -lt 2) {
 72:             continue
 73:         }
 74:         $n = Convert-ToNullableDouble -Value $m.Groups[1].Value
 75:         if ($null -ne $n) {
 76:             $sum += $n
 77:             $found = $true
 78:         }
 79:     }
 80: 
 81:     if (-not $found) {
 82:         return $null
 83:     }
 84: 
 85:     return [math]::Round($sum, 6)
 86: }
