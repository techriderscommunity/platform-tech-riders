<file path="techito/src/app/core/auth/auth.guard.ts">
 1: import { inject } from '@angular/core';
 2: import { CanActivateFn, Router } from '@angular/router';
 3: import { AppRole, AuthService } from './auth.service';
 4: function toLoginModal(router: Router, returnUrl: string) {
 5:   return router.createUrlTree(['/'], {
 6:     queryParams: {
 7:       login: '1',
 8:       returnUrl,
 9:     },
10:   });
11: }
12: export const authGuard: CanActivateFn = (_, state) => {
13:   const auth = inject(AuthService);
14:   const router = inject(Router);
15:   if (auth.isAuthenticated()) {
16:     return true;
17:   }
18:   return toLoginModal(router, state.url || '/');
19: };
20: export function roleGuard(requiredRole: AppRole | AppRole[]): CanActivateFn {
21:   return (_, state) => {
22:     const auth = inject(AuthService);
23:     const router = inject(Router);
24:     if (!auth.isAuthenticated()) {
25:       return toLoginModal(router, state.url || '/');
26:     }
27:     if (auth.hasRole(requiredRole)) {
28:       return true;
29:     }
30:     // Autenticado pero rol incorrecto → redirigir a su área
31:     return router.parseUrl(auth.getDefaultRoute());
32:   };
33: }
</file>

