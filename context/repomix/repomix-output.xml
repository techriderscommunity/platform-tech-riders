 2: import json
 3: from pathlib import Path
 4: from typing import Any, Dict
 5: class BaseWikiProvider:
 6:     provider_id = "base"
 7:     def __init__(self, generated_root: Path) -> None:
 8:         self.generated_root = generated_root
 9:     def gather_knowledge(self) -> Dict[str, Any]:
10:         raise NotImplementedError
11:     def _load_json_file(self, path: Path) -> Dict[str, Any]:
12:         with path.open("r", encoding="utf-8") as handle:
13:             parsed = json.load(handle)
14:         if isinstance(parsed, dict):
15:             return parsed
16:         return {}
17:     def _checksum(self, payload: Dict[str, Any]) -> str:
18:         raw = json.dumps(payload, sort_keys=True, ensure_ascii=True).encode("utf-8")
19:         return hashlib.sha256(raw).hexdigest()
</file>

<file path="scripts/wiki/providers/codegraph_provider.py">
 1: from pathlib import Path
 2: from typing import Any, Dict, List
 3: from scripts.wiki.providers.base_provider import BaseWikiProvider
 4: class CodeGraphProvider(BaseWikiProvider):
 5:     provider_id = "codegraph"
 6:     def __init__(self, generated_root: Path) -> None:
 7:         super().__init__(generated_root)
 8:     def gather_knowledge(self) -> Dict[str, Any]:
 9:         entities: List[Dict[str, Any]] = []
10:         for boost_dir in self.generated_root.iterdir():
11:             if not boost_dir.is_dir():
12:                 continue
13:             capability_path = boost_dir / "capabilities" / "capability.json"
14:             manifest_path = boost_dir / "context-manifests" / "manifest.json"
15:             if not capability_path.exists() or not manifest_path.exists():
16:                 continue
17:             capability = self._load_json_file(capability_path)
18:             if str(capability.get("engine", "")).lower() != "codegraph":
19:                 continue
20:             manifest = self._load_json_file(manifest_path)
21:             payload = {
22:                 "boost": boost_dir.name,
23:                 "capability": capability,
24:                 "manifest": manifest,
25:             }
26:             relations = []
27:             for dependency in capability.get("dependencies", []):
28:                 relations.append({"target": str(dependency), "type": "depends_on"})
29:             entity_id = str(capability.get("repo", boost_dir.name))
30:             entities.append(
31:                 {
32:                     "id": entity_id,
33:                     "type": "boost_capability",
34:                     "checksum": self._checksum(payload),
35:                     "raw_data": payload,
36:                     "relations": relations,
37:                 }
38:             )
39:         return {"provider_id": self.provider_id, "entities": entities}
</file>

