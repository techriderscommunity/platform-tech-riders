126: function Get-SumOrZero {
127:     param([array]$Values)
128: 
129:     if ($null -eq $Values -or $Values.Count -eq 0) {
130:         return 0
131:     }
132: 
133:     $sum = (@($Values) | Measure-Object -Sum).Sum
134:     if ($null -eq $sum) {
135:         return 0
136:     }
137: 
138:     return [double]$sum
139: }
