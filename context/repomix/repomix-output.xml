 365: function Invoke-Step {
 366:     param(
 367:         [string]$Name,
 368:         [scriptblock]$Action,
 369:         [bool]$Required = $true
 370:     )
 371: 
 372:     $start = Get-Date
 373:     $success = $false
 374:     $message = 'ok'
 375: 
 376:     try {
 377:         & $Action
 378:         $success = $true
 379:         Write-Host "[ok] $Name" -ForegroundColor Green
 380:     }
 381:     catch {
 382:         $message = $_.Exception.Message
 383:         if ($Required) {
 384:             $script:HasFailures = $true
 385:             Write-Host "[fail] $Name -> $message" -ForegroundColor Red
 386:         }
 387:         else {
 388:             Write-Host "[info] $Name -> $message" -ForegroundColor DarkYellow
 389:         }
 390:     }
 391: 
 392:     $duration = ((Get-Date) - $start).TotalSeconds
 393:     $script:Steps += (New-StepResult -Name $Name -Required $Required -Success $success -DurationSec $duration -Message $message)
 394: }
