314:     $failedCount = @($Results | Where-Object { $_.status -eq 'failed' -or $_.status -eq 'timeout' }).Count
315:     $durationSec = [math]::Round((($Ended - $Started).TotalSeconds), 2)
316: 
317:     $lines = @()
318:     $lines += "# Demo Session Report"
319:     $lines += ""
