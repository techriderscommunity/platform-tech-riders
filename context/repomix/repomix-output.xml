 31: 
 32:     $dirs = @(Get-ChildItem -Path $Root -Directory -ErrorAction SilentlyContinue |
 33:         Where-Object { $_.Name -like "*-$Suffix" } |
 34:         Sort-Object LastWriteTime -Descending)
 35: 
 36:     if (-not $dirs -or $dirs.Count -eq 0) {
