{
  "name": "techito",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:e2e": "ng serve --host 127.0.0.1 --port 4300 --configuration development",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "audit:shared-ui": "node ./tools/audit-shared-ui.mjs",
    "enforce:shared-ui": "node ./tools/audit-shared-ui.mjs --strict",
    "e2e": "playwright test",
    "verify:precommit": "npm run -s enforce:shared-ui && npm run -s test:unit:ci && npm run -s e2e",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium",
    "storybook": "ng run techito:storybook",
    "build-storybook": "ng run techito:build-storybook",
    "sync-content": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./tools/sync-content.ps1",
    "serve:ssr:techito": "node dist/techito/server/server.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "overrides": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "less": "4.8.1",
    "uuid": "14.0.1"
  },
  "dependencies": {
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-server": "22.1.1",
    "@angular/router": "22.1.1",
    "@angular/ssr": "22.1.3",
    "@swimlane/ngx-charts": "25.0.0",
    "@types/dompurify": "^3.0.5",
    "dompurify": "3.4.13",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "rehype": "^13.0.2",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.3",
    "@angular/animations": "22.1.1",
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@angular/platform-browser-dynamic": "22.1.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/angular": "10.5.7",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.19.41",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "storybook": "10.5.7",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
